<%- include('partials/main-header') %>

<style>
  /* İMAJ YÖNETİMİ - LÜKS LIGHT MODE & FULL SCREEN OVERRIDES */
  body { background: #f8fafc !important; color: #0f172a; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.imaj-page { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }

  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');
  
  :root {
    --im-primary: #1e40af; /* Derin Lacivert (Otorite) */
    --im-dark: #1e3a8a;
    --im-accent: #3b82f6; /* Parlak Safir Mavi */
    --text-main: #0f172a;
    --text-muted: #475569;
    --bg-light: #f8fafc;
    --bg-card: #ffffff;
  }

  /* 1. HERO SECTION */
  .im-hero {
    position: relative;
    height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%);
    overflow: hidden;
  }
  .im-hero::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image: repeating-linear-gradient(90deg, transparent, transparent 100px, rgba(30, 64, 175, 0.03) 100px, rgba(30, 64, 175, 0.03) 101px);
    z-index: 0;
  }
  
  .im-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 20px;
    animation: fadeUp 1s ease-out;
  }
  .im-badge {
    display: inline-block;
    padding: 8px 24px;
    border-radius: 30px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: var(--im-primary);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
  }
  .im-title {
    font-family: 'Playfair Display', serif;
    font-size: 4.5rem;
    line-height: 1.1;
    margin: 0 0 20px 0;
    color: var(--text-main);
  }
  .im-title i {
    color: var(--im-primary);
    font-style: italic;
  }
  .im-subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 400;
    max-width: 700px;
    margin: 0 auto 50px auto;
    line-height: 1.8;
  }
  .im-stats {
    display: flex; justify-content: center; gap: 50px; flex-wrap: wrap;
  }
  .im-stat {
    display: flex; flex-direction: column; align-items: center;
  }
  .im-stat-n { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--im-dark); font-weight: 800; }
  .im-stat-l { font-family: 'Outfit', sans-serif; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-top: 5px; }

  /* 2. KATEGORİLER */
  .im-nav {
    display: flex; justify-content: center; gap: 15px; margin-bottom: 60px; flex-wrap: wrap; margin-top: -30px; position: relative; z-index: 10;
  }
  .im-nav-item {
    padding: 12px 28px; border-radius: 30px; text-decoration: none; font-family: 'Outfit', sans-serif;
    font-weight: 600; font-size: 0.95rem; color: var(--text-muted); border: 1px solid #e2e8f0; background: #fff; transition: all 0.3s;
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
  }
  .im-nav-item.active { background: var(--im-primary); color: #fff; border-color: var(--im-primary); box-shadow: 0 10px 20px rgba(30, 64, 175, 0.2); }
  .im-nav-item:hover:not(.active) { background: #f1f5f9; color: var(--text-main); transform: translateY(-2px); }

  /* 3. MODÜLLER (KARTLAR) */
  .im-section { max-width: 1400px; margin: 0 auto; padding: 60px 5%; }
  .sec-header { display: flex; align-items: center; gap: 20px; margin-bottom: 50px; }
  .sec-icon { background: #eff6ff; border: 1px solid #bfdbfe; width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; }
  .sec-title h2 { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--text-main); margin: 0 0 5px 0; }
  .sec-title p { font-family: 'Outfit', sans-serif; font-size: 1.05rem; color: var(--text-muted); margin: 0; }

  .im-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; }
  
  .card-module {
    background: var(--bg-card); border: 1px solid #e2e8f0; border-radius: 24px; padding: 40px;
    text-decoration: none; position: relative; overflow: hidden; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.02); display: flex; flex-direction: column;
  }
  .card-module::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.8), rgba(255,255,255,0)); z-index: 1; pointer-events: none;
  }
  .card-module::after {
    content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 4px;
    background: var(--im-accent); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease;
  }
  .card-module:hover { transform: translateY(-10px); border-color: #bfdbfe; box-shadow: 0 20px 40px rgba(30, 64, 175, 0.08); }
  .card-module:hover::after { transform: scaleX(1); }

  .cm-content { position: relative; z-index: 2; display: flex; flex-direction: column; flex-grow: 1; }
  .cm-tag { font-family: 'Outfit'; font-size: 0.75rem; font-weight: 800; color: var(--im-primary); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 15px; }
  .cm-icon { font-size: 3rem; margin-bottom: 25px; filter: drop-shadow(0 5px 10px rgba(59,130,246,0.2)); }
  .cm-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-main); margin: 0 0 15px 0; }
  .cm-desc { font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--text-muted); line-height: 1.7; margin: 0 0 30px 0; flex-grow: 1; }
  .cm-btn { font-family: 'Outfit', sans-serif; font-size: 0.95rem; font-weight: 700; color: var(--text-main); display: inline-flex; align-items: center; gap: 10px; transition: 0.3s; }
  .card-module:hover .cm-btn { color: var(--im-accent); gap: 15px; }

  /* 4. EDITORIAL MAKALE */
  .im-article { background: linear-gradient(45deg, #ffffff, #eff6ff); border-top: 1px solid #e0f2fe; border-bottom: 1px solid #e0f2fe; padding: 100px 5%; margin-top: 80px; }
  .article-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; align-items: center; }
  .article-text h2 { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--text-main); margin-bottom: 25px; line-height: 1.2; }
  .article-text p { font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 20px; }
  
  .article-quote { background: #f8fafc; border-left: 4px solid var(--im-primary); padding: 40px; border-radius: 0 24px 24px 0; box-shadow: 10px 10px 30px rgba(0,0,0,0.03); }
  .quote-text { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--im-dark); font-style: italic; line-height: 1.6; margin-bottom: 20px; }
  .quote-author { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 800; color: var(--im-accent); text-transform: uppercase; letter-spacing: 1px; }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

  @media(max-width: 900px) {
    .im-title { font-size: 3.2rem; }
    .article-grid { grid-template-columns: 1fr; }
  }
</style>

<div class="imaj-page">

  <!-- 1. HERO -->
  <section class="im-hero">
    <div class="im-hero-content">
      <div class="im-badge">Kişisel Marka ve Stil</div>
      <h1 class="im-title">İmaj <i>Yönetimi</i></h1>
      <p class="im-subtitle">İletişim ağzınızı açtığınızda değil, odaya adım attığınız an başlar. Kıyafetinizle ilk 7 saniyeyi kazanmayı, doğru renklerle otorite kurmayı ve profesyonel stilin şifrelerini öğrenin.</p>
      
      <div class="im-stats">
        <div class="im-stat"><span class="im-stat-n">6</span><span class="im-stat-l">Profesyonel Modül</span></div>
        <div class="im-stat"><span class="im-stat-n">100ms</span><span class="im-stat-l">Karar Süresi</span></div>
        <div class="im-stat"><span class="im-stat-n">%55</span><span class="im-stat-l">Görsel Etki</span></div>
      </div>
    </div>
  </section>

  <!-- 2. KATEGORİLER -->
  <nav class="im-nav">
    <a href="/giyim" class="im-nav-item active">Tüm Eğitimler</a>
    <a href="/giyim/dresscode" class="im-nav-item">Dress Code</a>
    <a href="/giyim/renk" class="im-nav-item">Renk Psikolojisi</a>
    <a href="/giyim/vucut-tipi" class="im-nav-item">Vücut Tipi</a>
    <a href="/giyim/aksesuar" class="im-nav-item">Aksesuar Sanatı</a>
    <a href="/giyim/stil" class="im-nav-item">Stil Testi</a>
    <a href="/giyim/outfit" class="im-nav-item">Outfit Lab (Simülasyon)</a>
  </nav>

  <!-- 3. EĞİTİM MODÜLLERİ -->
  <section class="im-section">
    <div class="sec-header">
      <div class="sec-icon">👔</div>
      <div class="sec-title">
        <h2>Temel Giyim Prensipleri</h2>
        <p>Profesyonel imajın yıkılmaz temel taşları</p>
      </div>
    </div>

    <div class="im-grid">
      <a href="/giyim/dresscode" class="card-module">
        <div class="cm-content">
          <div class="cm-tag">01 — Kurallar ve Sınırlar</div>
          <div class="cm-icon">🎩</div>
          <h3 class="cm-title">Dress Code Rehberi</h3>
          <p class="cm-desc">Business Casual'dan Black Tie'a kadar tüm küresel kıyafet kodları. Hangi davete ne giyilmeli? Otorite boşluğu yaratmamak için altın kurallar.</p>
          <div class="cm-btn">İncele <span>→</span></div>
        </div>
      </a>

      <a href="/giyim/renk" class="card-module">
        <div class="cm-content">
          <div class="cm-tag">02 — Renklerin Gücü</div>
          <div class="cm-icon">🎨</div>
          <h3 class="cm-title">Renk Psikolojisi</h3>
          <p class="cm-desc">Mavi neden güven verir? Kırmızı nerede risklidir? Ten alt tonunuza göre sizi enerjik ya da solgun gösterecek renklerin stratejik yönetimi.</p>
          <div class="cm-btn">İncele <span>→</span></div>
        </div>
      </a>

      <a href="/giyim/vucut-tipi" class="card-module">
        <div class="cm-content">
          <div class="cm-tag">03 — Form ve Orantı</div>
          <div class="cm-icon">👗</div>
          <h3 class="cm-title">Vücut Tipine Göre Giyim</h3>
          <p class="cm-desc">Elma, armut, ters üçgen veya kum saati... Vücut tipinizin güçlü yanlarını öne çıkaran, kusurları zarifçe gizleyen kesim ve kalıpları öğrenin.</p>
          <div class="cm-btn">İncele <span>→</span></div>
        </div>
      </a>
    </div>

    <div class="sec-header" style="margin-top: 80px;">
      <div class="sec-icon">✨</div>
      <div class="sec-title">
        <h2>İleri Seviye Stil ve Simülasyonlar</h2>
        <p>Stili kişiselleştirme ve pratiğe dökme laboratuvarı</p>
      </div>
    </div>

    <div class="im-grid">
      <a href="/giyim/aksesuar" class="card-module">
        <div class="cm-content">
          <div class="cm-tag">04 — Detayların Zarafeti</div>
          <div class="cm-icon">⌚</div>
          <h3 class="cm-title">Aksesuar Sanatı</h3>
          <p class="cm-desc">"Az ama öz" ilkesiyle kombini ucuzlatmadan değer katan saat, kravat, mendil ve takı seçiminin incelikleri.</p>
          <div class="cm-btn">İncele <span>→</span></div>
        </div>
      </a>

      <a href="/giyim/stil" class="card-module">
        <div class="cm-content">
          <div class="cm-tag">05 — Kimlik Analizi</div>
          <div class="cm-icon">🔍</div>
          <h3 class="cm-title">Stil Testi</h3>
          <p class="cm-desc">Kişiliğiniz ve yaşam tarzınız hangi stile uyuyor? Klasik, minimalist, preppy veya bohem... 15 soruluk testle imaj imzanızı bulun.</p>
          <div class="cm-btn">Teste Başla <span>→</span></div>
        </div>
      </a>

      <a href="/giyim/outfit" class="card-module">
        <div class="cm-content">
          <div class="cm-tag">06 — İnteraktif Deneyim</div>
          <div class="cm-icon">🧪</div>
          <h3 class="cm-title">Outfit Lab (Simülasyon)</h3>
          <p class="cm-desc">Farklı senaryolara (yönetim kurulu toplantısı, ilk buluşma, kokteyl) göre doğru kıyafeti seçme simülasyonu.</p>
          <div class="cm-btn" style="color: var(--im-primary);"><i class="fa-solid fa-gamepad"></i> Oynamaya Başla</div>
        </div>
      </a>
    </div>
  </section>

  <!-- 4. EDITORIAL MAKALE -->
  <section class="im-article">
    <div class="article-grid">
      <div class="article-text">
        <h2>İmaj Yönetimi Neden Hayatidir?</h2>
        <p>Princeton Üniversitesi araştırmacılarının yaptığı bir çalışmaya göre, insanlar bir yüzü veya silueti gördükten sonra sadece <strong>100 milisaniye</strong> içinde güvenilirlik, yetkinlik ve çekicilik gibi kritik yargılara varmaktadır.</p>
        <p>Siz ağzınızı açıp ne kadar zeki olduğunuzu kanıtlamadan önce, kıyafetiniz, duruşunuz ve renkleriniz karşı tarafın bilinçaltında hükmü çoktan vermiştir.</p>
        <p>Gerçek imaj yönetimi asla marka giymek veya gösteriş yapmak değildir. O, sizin sahip olduğunuz içsel değerlerinizi, yetkinliklerinizi ve profesyonel kimliğinizi <strong>görsel ve dışsal bir dille</strong> doğru tercüme etme becerisidir.</p>
      </div>
      <div class="article-quote">
        <div class="quote-text">"Giyim tarzınız, kendi değerlerinizi henüz konuşmadan tüm dünyaya duyuran ilk savunma avukatınızdır."</div>
        <div class="quote-author">— Anna Wintour</div>
      </div>
    </div>
  </section>

</div>

<%- include('partials/main-footer') %>