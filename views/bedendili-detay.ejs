<%- include('partials/main-header') %>

<link rel="stylesheet" href="/retorik.css?v=6" />
<style>
  .beden-page { display: block !important; }
  .ret-cat-pill { text-decoration: none; }
  .ret-cat-pill.active { background: #3b82f6; border-color: #3b82f6; color: #fff; }
  .ret-ex-icon { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border-color:#bfdbfe; }
</style>

<main class="main-content">
  <div class="content-wrapper">
    <div id="bedendili-container" class="beden-page">

      <!-- ══ KATEGORİLER ══ -->
      <div style="margin-top:20px;margin-bottom:30px;text-align:center;">
        <div class="ret-cat-pills">
          <a href="/bedendili" class="ret-cat-pill">Tümü</a>
          <a href="/bedendili/yuz" class="ret-cat-pill <%= activeCat === 'yuz' ? 'active' : '' %>">Yüz ve Mimikler</a>
          <a href="/bedendili/eller" class="ret-cat-pill <%= activeCat === 'eller' ? 'active' : '' %>">El ve Kollar</a>
          <a href="/bedendili/durus" class="ret-cat-pill <%= activeCat === 'durus' ? 'active' : '' %>">Postür ve Güç</a>
          <a href="/bedendili/mesafe" class="ret-cat-pill <%= activeCat === 'mesafe' ? 'active' : '' %>">Alan Yönetimi</a>
        </div>
      </div>

      <section class="ret-exercise-section" data-category="<%= activeCat %>">
        <div class="ret-ex-header">
          <div class="ret-ex-icon <%= activeCat %>">👤</div>
          <div>
            <div class="ret-ex-title"><%= meta.h1 %></div>
            <div class="ret-ex-subtitle"><%= exercises.length %> detaylı çalışma bölümü</div>
          </div>
        </div>
        <div class="ret-exercises-grid">
          <% exercises.forEach((ex, index) => { %>
            <div class="ret-ex-card <%= ex.cat %>">
              <div class="ret-ex-card-header">
                <div class="ret-ex-card-num <%= ex.cat %>" style="background:#dbeafe;color:#2563eb"><%= ex.num %></div>
                <span class="ret-ex-card-badge <%= ex.badgeCls %>" style="background:#f1f5f9;color:#475569;border-color:#e2e8f0"><%= ex.badge %></span>
              </div>
              <h4 style="color:#0f172a"><%= ex.title %></h4>
              <p style="color:#475569"><%= ex.desc %></p>

              <div class="ret-steps">
                <% ex.steps.forEach((step, i) => { %>
                  <div class="ret-step" style="background:#f8fafc;border-color:#e2e8f0">
                    <div class="ret-step-num" style="background:#bfdbfe;color:#1d4ed8"><%= i + 1 %></div>
                    <div class="ret-step-text" style="color:#334155"><%= step %></div>
                  </div>
                <% }); %>
              </div>

              <div class="ret-quiz-box" data-correct="<%= ex.quiz.correct %>" style="background:#fff;border-color:#e2e8f0">
                <div class="ret-quiz-question" style="color:#0f172a;border-left-color:#3b82f6"><%= ex.quiz.q %></div>
                <div class="ret-quiz-options">
                  <% ex.quiz.opts.forEach((opt, i) => { %>
                    <div class="ret-quiz-option" style="background:#f8fafc;color:#475569;border-color:#e2e8f0" onclick="handleQuiz(this, <%= ex.quiz.correct %>, <%= i %>)">
                      <span class="opt-letter" style="background:#e2e8f0;color:#475569;border:none"><%= String.fromCharCode(65 + i) %></span> <%= opt %>
                    </div>
                  <% }); %>
                </div>
                <div class="ret-quiz-feedback"></div>
              </div>

              <div class="ret-scenario" style="background:#f8fafc;border-color:#e2e8f0">
                <div class="ret-scenario-label" style="background:#3b82f6;color:#fff"><%= ex.scenario.label %></div>
                <div class="ret-scenario-text" style="color:#334155"><%= ex.scenario.text %></div>
                <div class="ret-scenario-analysis" style="border-top-color:#e2e8f0">
                  <h5 style="color:#1d4ed8">Analiz</h5>
                  <p style="color:#475569"><%= ex.scenario.analysis %></p>
                </div>
              </div>

              <textarea class="ret-practice-area" style="background:#fff;border-color:#cbd5e1;color:#0f172a" placeholder="<%= ex.practice %>"></textarea>
              <div style="margin-top:15px">
                <button class="ret-complete-btn" style="border-color:#3b82f6;color:#3b82f6" onclick="this.innerHTML='✓ Tamamlandı';this.style.background='#10B981';this.style.color='#fff';this.style.borderColor='#10b981'">✓ Tamamla</button>
              </div>
            </div>
          <% }); %>
        </div>
      </section>

    </div>
  </div>
</main>

<%- include('partials/main-footer') %>
  
<script>
  function handleQuiz(el, correctIdx, currentIdx) {
    const box = el.closest('.ret-quiz-box');
    const feedback = box.querySelector('.ret-quiz-feedback');
    
    // Reset others
    box.querySelectorAll('.ret-quiz-option').forEach(o => {
      o.style.background = '#f8fafc';
      o.style.color = '#475569';
      o.style.borderColor = '#e2e8f0';
    });

    if (currentIdx === correctIdx) {
      el.style.background = 'rgba(16, 185, 129, 0.1)';
      el.style.borderColor = '#10B981';
      el.style.color = '#047857';
      feedback.textContent = '✅ Doğru cevap!';
      feedback.style.color = '#10B981';
      feedback.style.background = '#ecfdf5';
      feedback.style.borderColor = '#34d399';
    } else {
      el.style.background = 'rgba(239, 68, 68, 0.1)';
      el.style.borderColor = '#EF4444';
      el.style.color = '#B91C1C';
      feedback.textContent = '❌ Yanlış cevap, tekrar deneyin.';
      feedback.style.color = '#EF4444';
      feedback.style.background = '#fef2f2';
      feedback.style.borderColor = '#f87171';
    }
    feedback.style.display = 'block';
  }
</script>
