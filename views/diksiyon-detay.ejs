%>

<!-- HERO -->
<section class="dks-hero">
  <div class="particles">
    <% for(let i=0; i<20; i++) { %>
      <div class="particle" style="left:<%= Math.random()*100 %>%;top:<%= Math.random()*100 %>%;animation-delay:<%= Math.random()*4 %>s;width:<%= 2+Math.random()*3 %>px;height:<%= 2+Math.random()*3 %>px;"></div>
    <% } %>
  </div>
  <div class="hero-emoji"><%= exercise.emoji %></div>
  <div class="hero-badge"><%= ci.label %></div>
  <h1 class="hero-title"><%= exercise.title %></h1>
  <div class="hero-meta">
    <div class="hero-meta-item"><span>⏱️</span> <%= exercise.dur %></div>
    <div class="hero-meta-item"><span>📊</span> <%= exercise.level %></div>
    <div class="hero-meta-item"><span>🔄</span> <%= exercise.freq %></div>
  </div>
</section>

<div class="dks-wrap">

  <a href="/" class="back-btn">← Tüm Egzersizlere Dön</a>

  <!-- Description -->
  <div class="glass reveal">
    <div class="section-label">Açıklama</div>
    <p class="desc-text"><%= exercise.desc %></p>
  </div>

  <!-- Phrase (if exists) -->
  <% if (exercise.phrase) { %>
  <div class="phrase-block reveal">
    <div class="section-label" style="justify-content: center;">Pratik Cümlesi</div>
    <p class="phrase-text"><%= exercise.phrase %></p>
  </div>
  <% } %>

  <!-- Benefits / Mistakes -->
  <div class="bm-grid reveal">
    <div class="bm-card bm-benefits">
      <div class="bm-title">✨ Faydaları</div>
      <ul class="bm-list">
        <% exercise.benefits.forEach(b => { %>
          <li><%= b %></li>
        <% }); %>
      </ul>
    </div>
    <div class="bm-card bm-mistakes">
      <div class="bm-title">⚠️ Sık Yapılan Hatalar</div>
      <ul class="bm-list">
        <% exercise.mistakes.forEach(m => { %>
          <li><%= m %></li>
        <% }); %>
      </ul>
    </div>
  </div>

  <!-- Steps Timeline -->
  <div class="glass reveal">
    <div class="section-label">Adım Adım Rehber</div>
    <div class="steps-timeline">
      <% exercise.steps.forEach((s, i) => { %>
        <div class="step-item">
          <div class="step-num"><%= i + 1 %></div>
          <div class="step-text"><%= s %></div>
        </div>
      <% }); %>
    </div>
  </div>

  <!-- Variations -->
  <% if (exercise.variations && exercise.variations.length > 0) { %>
  <div class="glass reveal">
    <div class="section-label">Varyasyonlar</div>
    <% exercise.variations.forEach(v => { %>
      <div class="var-item"><%= v %></div>
    <% }); %>
  </div>
  <% } %>

  <!-- Tip -->
  <% if (exercise.tip) { %>
  <div class="tip-box reveal">
    <span class="tip-icon">💡</span>
    <span><%= exercise.tip.replace('💡 ', '') %></span>
  </div>
  <% } %>

  <!-- Related Exercises -->
  <% if (relatedExercises && relatedExercises.length > 0) { %>
  <div class="glass reveal">
    <div class="section-label">İlişkili Egzersizler</div>
    <div class="related-grid">
      <% relatedExercises.forEach(r => { %>
        <a href="/egzersiz/<%= r.slug %>" class="related-card">
          <span class="related-emoji"><%= r.emoji %></span>
          <div class="related-info">
            <strong><%= r.title %></strong>
            <span><%= r.dur %> · <%= r.level %></span>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
  <% } %>

</div>

<script>
// Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.15 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>


