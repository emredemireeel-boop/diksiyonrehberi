<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ── Hero ────────────────────── */
  .dks-hero {
    min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 100px 24px 60px; position: relative; overflow: hidden;
  }
  .dks-hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% 30%, <%= catColor %>22, transparent 70%);
  }
  .dks-hero::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 120px;
    background: linear-gradient(to top, #f8fafc, transparent);
  }
  .hero-emoji { font-size: 5rem; margin-bottom: 16px; filter: drop-shadow(0 0 30px <%= catColor %>66); animation: float 3s ease-in-out infinite; }
  @keyframes float { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-12px); } }

  .hero-badge { display: inline-flex; align-items: center; gap: 8px; padding: 6px 18px; border-radius: 30px; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: <%= catColor %>; background: <%= catColor %>18; border: 1px solid <%= catColor %>44; margin-bottom: 16px; }
  .hero-title { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 900; color: #fff; margin-bottom: 12px; line-height: 1.15; text-shadow: 0 0 40px <%= catColor %>33; }
  .hero-meta { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
  .hero-meta-item { display: flex; align-items: center; gap: 6px; color: #475569; font-size: .9rem; background: rgba(15,23,42,0.05); padding: 8px 16px; border-radius: 12px; border: 1px solid rgba(15,23,42,0.06); }
  .hero-meta-item span:first-child { font-size: 1.1rem; }

  /* ── Particle BG ────────────── */
  .particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .particle { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: <%= catColor %>; opacity: 0; animation: sparkle 4s ease-in-out infinite; }
  @keyframes sparkle { 0%{ opacity: 0; transform: translateY(0) scale(0); } 30%{ opacity: .7; transform: translateY(-30px) scale(1); } 100%{ opacity: 0; transform: translateY(-80px) scale(0); } }

  /* ── Container ──────────────── */
  .dks-wrap { max-width: 900px; margin: 0 auto; padding: 0 20px 80px; position: relative; z-index: 1; }

  /* ── Glass Card ─────────────── */
  .glass { background: rgba(15,23,42,0.03); backdrop-filter: blur(16px); border: 1px solid rgba(15,23,42,0.06); border-radius: 20px; padding: 32px; margin-bottom: 32px; transition: transform .35s, box-shadow .35s; }
  .glass:hover { transform: translateY(-4px); box-shadow: 0 20px 60px rgba(15,23,42,0.3), 0 0 30px <%= catColor %>11; }

  .section-label { font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 3px; color: <%= catColor %>; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
  .section-label::before { content: ''; width: 16px; height: 2px; background: <%= catColor %>; border-radius: 2px; }

  .desc-text { font-size: 1.05rem; line-height: 1.8; color: #334155; }

  /* ── Steps Timeline ─────────── */
  .steps-timeline { position: relative; padding-left: 36px; }
  .steps-timeline::before { content: ''; position: absolute; left: 14px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, <%= catColor %>, <%= catColor %>33); border-radius: 2px; }
  .step-item { position: relative; margin-bottom: 24px; opacity: 0; transform: translateX(-20px); animation: slideIn .5s ease forwards; }
  .step-item:nth-child(1) { animation-delay: .1s; }
  .step-item:nth-child(2) { animation-delay: .2s; }
  .step-item:nth-child(3) { animation-delay: .3s; }
  .step-item:nth-child(4) { animation-delay: .4s; }
  .step-item:nth-child(5) { animation-delay: .5s; }
  .step-item:nth-child(6) { animation-delay: .6s; }
  .step-item:nth-child(7) { animation-delay: .7s; }
  .step-item:nth-child(8) { animation-delay: .8s; }
  @keyframes slideIn { to { opacity: 1; transform: translateX(0); } }

  .step-num { position: absolute; left: -36px; top: 4px; width: 28px; height: 28px; border-radius: 50%; background: <%= catColor %>; color: #f8fafc; font-size: .8rem; font-weight: 900; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px <%= catColor %>55; }
  .step-text { background: rgba(15,23,42,0.04); border: 1px solid rgba(15,23,42,0.06); border-radius: 14px; padding: 16px 20px; font-size: .95rem; line-height: 1.7; color: #e2e8f0; transition: background .3s, border-color .3s; }
  .step-text:hover { background: rgba(15,23,42,0.07); border-color: <%= catColor %>44; }

  /* ── Benefits / Mistakes ────── */
  .bm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px; }
  @media(max-width:700px) { .bm-grid { grid-template-columns: 1fr; } }
  .bm-card { border-radius: 18px; padding: 28px; }
  .bm-benefits { background: linear-gradient(135deg, rgba(16,185,129,0.08), rgba(16,185,129,0.02)); border: 1px solid rgba(16,185,129,0.2); }
  .bm-mistakes { background: linear-gradient(135deg, rgba(239,68,68,0.08), rgba(239,68,68,0.02)); border: 1px solid rgba(239,68,68,0.2); }
  .bm-title { font-size: .85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 16px; }
  .bm-benefits .bm-title { color: #34d399; }
  .bm-mistakes .bm-title { color: #f87171; }
  .bm-list { list-style: none; padding: 0; margin: 0; }
  .bm-list li { padding: 8px 0; font-size: .92rem; color: #334155; display: flex; align-items: flex-start; gap: 10px; line-height: 1.6; }
  .bm-list li::before { flex-shrink: 0; font-size: 1rem; margin-top: 2px; }
  .bm-benefits .bm-list li::before { content: '✅'; }
  .bm-mistakes .bm-list li::before { content: '❌'; }

  /* ── Phrase Block ───────────── */
  .phrase-block { background: linear-gradient(135deg, <%= catColor %>12, <%= catColor %>05); border: 2px solid <%= catColor %>33; border-radius: 20px; padding: 36px; text-align: center; margin-bottom: 32px; position: relative; overflow: hidden; }
  .phrase-block::before { content: '"'; position: absolute; top: -10px; left: 20px; font-size: 8rem; color: <%= catColor %>15; font-family: serif; line-height: 1; }
  .phrase-text { font-size: 1.25rem; font-weight: 600; color: #0f172a; line-height: 1.8; font-style: italic; position: relative; z-index: 1; }

  /* ── Variations ─────────────── */
  .var-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px; border-radius: 12px; background: rgba(15,23,42,0.03); margin-bottom: 10px; font-size: .93rem; color: #334155; line-height: 1.6; transition: background .3s; }
  .var-item:hover { background: rgba(15,23,42,0.06); }

  /* ── Tip Box ────────────────── */
  .tip-box { background: linear-gradient(135deg, rgba(251,191,36,0.08), rgba(251,191,36,0.02)); border: 1px solid rgba(251,191,36,0.25); border-radius: 18px; padding: 24px 28px; font-size: .95rem; color: #fbbf24; line-height: 1.7; display: flex; align-items: flex-start; gap: 14px; margin-bottom: 32px; }
  .tip-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: 2px; }

  /* ── Related Cards ──────────── */
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
  .related-card { display: flex; align-items: center; gap: 14px; padding: 18px 20px; border-radius: 16px; background: rgba(15,23,42,0.04); border: 1px solid rgba(15,23,42,0.06); cursor: pointer; text-decoration: none; transition: all .3s; }
  .related-card:hover { background: rgba(15,23,42,0.08); border-color: <%= catColor %>44; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(15,23,42,0.2); }
  .related-emoji { font-size: 2rem; }
  .related-info { display: flex; flex-direction: column; }
  .related-info strong { color: #fff; font-size: .95rem; margin-bottom: 3px; }
  .related-info span { color: #64748b; font-size: .8rem; }

  /* ── Back Button ────────────── */
  .back-btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 14px; background: rgba(15,23,42,0.05); border: 1px solid rgba(15,23,42,0.1); color: #475569; font-size: .9rem; font-weight: 600; text-decoration: none; transition: all .3s; margin-bottom: 40px; }
  .back-btn:hover { background: rgba(15,23,42,0.1); color: #fff; transform: translateX(-4px); }

  /* ── Scroll Reveal ──────────── */
  .reveal { opacity: 0; transform: translateY(30px); transition: all .6s cubic-bezier(.16,1,.3,1); }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>

