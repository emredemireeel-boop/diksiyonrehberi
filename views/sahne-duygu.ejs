<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; transition: background-color 0.4s ease; }
  .main-header, .main-footer { display: none !important; }

  .d-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
  
  .instruction-panel { background: rgba(168,85,247,0.08); border: 1px solid rgba(168,85,247,0.15); padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 40px; z-index: 10; backdrop-filter: blur(10px); }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #7c3aed; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #64748b; margin: 0; max-width: 600px; line-height: 1.5; }

  .sentence-box { font-size: 2.5rem; font-weight: 800; text-align: center; max-width: 800px; line-height: 1.4; color: #0f172a; margin-bottom: 40px; }
  
  .emotion-badge { font-size: 4rem; font-weight: 900; padding: 20px 60px; border-radius: 40px; text-transform: uppercase; letter-spacing: 4px; box-shadow: 0 20px 50px rgba(0,0,0,0.08); transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275); transform: scale(0.8); opacity: 0; }
  .emotion-badge.show { transform: scale(1); opacity: 1; }

  .progress-container { width: 100%; max-width: 600px; height: 6px; background: rgba(15,23,42,0.1); border-radius: 10px; overflow: hidden; margin-top: 40px; }
  .progress-bar { height: 100%; width: 100%; background: #a855f7; transition: width 0.1s linear; }

  .controls { display: flex; gap: 20px; margin-top: 40px; }
  .btn-control {
    background: #a855f7; color: #ffffff; border: none; padding: 16px 40px; border-radius: 30px;
    font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 10px 20px rgba(168, 85, 247, 0.2);
  }
  .btn-control:hover { background: #9333ea; transform: translateY(-2px); box-shadow: 0 15px 30px rgba(168, 85, 247, 0.3); }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(15,23,42,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #0f172a; }

</style>

<a href="/sahne" class="btn-back">← Sahne'ye Dön</a>

<div class="d-container">
  
  <div class="instruction-panel" id="instructionPanel">
    <h1 class="instruction-title">Duygu Bukalemunu</h1>
    <p class="instruction-desc">Sıradan bir cümleyi okuyun. Her 4 saniyede bir cümlenin altındaki duygu değişecek. Metni asla değiştirmeden, sadece ses tonunuzla ve mimiklerinizle o duyguyu verin.</p>
  </div>

  <div class="sentence-box">
    "Dün akşam masanın üzerindeki mektubu gördüm ve kapıya doğru yürüdüm."
  </div>

  <div class="emotion-badge" id="emotionBadge">BAŞLA</div>

  <div class="progress-container">
    <div class="progress-bar" id="progressBar"></div>
  </div>

  <div class="controls">
    <button class="btn-control" id="btnAction" onclick="toggleSim()">Simülasyonu Başlat</button>
  </div>

</div>

<script>
  const emotions = [
    { label: "ÖFKELİ", bg: "#7f1d1d", color: "#fca5a5" },
    { label: "NEŞELİ", bg: "#166534", color: "#86efac" },
    { label: "KORKMUŞ", bg: "#1e1b4b", color: "#a5b4fc" },
    { label: "ŞÜPHELİ", bg: "#4a044e", color: "#f0abfc" },
    { label: "SİNSİ", bg: "#064e3b", color: "#6ee7b7" },
    { label: "AĞLAMAKLI", bg: "#1e3a8a", color: "#93c5fd" },
    { label: "COŞKULU", bg: "#9a3412", color: "#fdba74" }
  ];

  let isRunning = false;
  let emotionInterval = null;
  let progressInterval = null;
  let timeLeft = 4000;
  
  const badge = document.getElementById('emotionBadge');
  const bar = document.getElementById('progressBar');
  const btnAction = document.getElementById('btnAction');

  function pickRandomEmotion() {
    const r = Math.floor(Math.random() * emotions.length);
    return emotions[r];
  }

  function changeEmotion() {
    badge.classList.remove('show');
    
    setTimeout(() => {
      const em = pickRandomEmotion();
      document.body.style.backgroundColor = em.bg;
      badge.style.backgroundColor = em.color;
      badge.style.color = em.bg;
      badge.textContent = em.label;
      badge.classList.add('show');
      
      timeLeft = 4000;
      bar.style.width = '100%';
    }, 200);
  }

  function toggleSim() {
    if (isRunning) {
      clearInterval(emotionInterval);
      clearInterval(progressInterval);
      isRunning = false;
      btnAction.textContent = 'Simülasyonu Başlat';
      document.body.style.backgroundColor = '#0f172a';
      badge.classList.remove('show');
      bar.style.width = '100%';
    } else {
      isRunning = true;
      btnAction.textContent = 'Durdur';
      document.getElementById('instructionPanel').style.opacity = '0.2';
      
      changeEmotion();
      
      emotionInterval = setInterval(() => {
        changeEmotion();
      }, 4000);

      progressInterval = setInterval(() => {
        timeLeft -= 50;
        const pct = (timeLeft / 4000) * 100;
        bar.style.width = pct + '%';
      }, 50);
    }
  }
</script>
