<%- include('partials/main-header') %>

<style>
  /* APPLE-INSPIRED ULTRA PREMIUM LIGHT MODE - SALDIRI SIMULATORU */
  body { 
    background: #fbfbfd !important; 
    color: #1d1d1f; 
    margin: 0; 
    padding: 0; 
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  
  main.main-content, div.content-wrapper { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }
  
  :root {
    --apple-text: #1d1d1f;
    --apple-muted: #86868b;
    --apple-bg: #fbfbfd;
    --apple-card: #ffffff;
    --apple-red: #ff3b30;
    --apple-red-hover: #ff453a;
  }

  .sim-container {
    max-width: 1000px;
    margin: 60px auto 100px auto;
    padding: 0 20px;
  }

  .sim-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .sim-badge {
    display: inline-block;
    padding: 6px 18px;
    border-radius: 20px;
    background: rgba(255, 59, 48, 0.1);
    color: var(--apple-red);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .sim-title {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 16px 0;
  }

  .sim-desc {
    font-size: 1.15rem;
    color: var(--apple-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .sim-layout {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 30px;
    align-items: start;
  }

  @media (max-width: 800px) {
    .sim-layout { grid-template-columns: 1fr; }
  }

  /* CHAT UI */
  .chat-box {
    background: var(--apple-card);
    border-radius: 32px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.02);
    min-height: 500px;
    display: flex;
    flex-direction: column;
  }

  .chat-history {
    flex-grow: 1;
    overflow-y: auto;
    padding-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .message {
    max-width: 80%;
    padding: 16px 20px;
    border-radius: 20px;
    font-size: 1.05rem;
    line-height: 1.4;
    animation: popIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .message.target {
    align-self: flex-start;
    background: #f1f1f2;
    color: var(--apple-text);
    border-bottom-left-radius: 4px;
  }

  .message.user {
    align-self: flex-end;
    background: var(--apple-red);
    color: #ffffff;
    border-bottom-right-radius: 4px;
  }

  .message-label {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.8);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .chat-options {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .option-btn {
    background: #ffffff;
    border: 2px solid #e5e5ea;
    border-radius: 16px;
    padding: 16px 20px;
    text-align: left;
    font-size: 1.05rem;
    color: var(--apple-text);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .option-btn:hover {
    border-color: var(--apple-red);
    background: rgba(255, 59, 48, 0.02);
    transform: translateY(-2px);
  }

  .option-tactic {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--apple-red);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* HUD / STATS */
  .hud-box {
    background: var(--apple-card);
    border-radius: 32px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.02);
    position: sticky;
    top: 100px;
  }

  .hud-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 20px 0;
    text-align: center;
  }

  .stat-group {
    margin-bottom: 24px;
  }

  .stat-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--apple-muted);
  }

  .stat-bar-bg {
    height: 12px;
    background: #f1f1f2;
    border-radius: 10px;
    overflow: hidden;
  }

  .stat-bar-fill {
    height: 100%;
    border-radius: 10px;
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-manipulation { background: var(--apple-red); width: 0%; }
  .stat-target { background: #34c759; width: 100%; }

  .instruction-box {
    background: rgba(255, 59, 48, 0.05);
    border-radius: 16px;
    padding: 20px;
    margin-top: 30px;
  }

  .instruction-box h4 {
    color: var(--apple-red);
    margin: 0 0 8px 0;
    font-size: 1rem;
  }

  .instruction-box p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--apple-text);
  }

  .game-over {
    display: none;
    text-align: center;
    margin-top: 20px;
  }

  .restart-btn {
    background: var(--apple-red);
    color: white;
    border: none;
    border-radius: 980px;
    padding: 12px 30px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .restart-btn:hover { transform: scale(1.05); }

  /* ENCYCLOPEDIA SECTION */
  .encyclopedia-section {
    margin-top: 80px;
    padding-top: 60px;
    border-top: 1px solid rgba(0,0,0,0.05);
  }
  .enc-title {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 20px;
  }
  .enc-list-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .enc-detailed-card {
    background: var(--apple-card);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.02);
    transition: transform 0.3s ease;
  }
  .enc-detailed-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(255, 59, 48, 0.08);
  }
  .edc-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 20px;
  }
  .edc-icon {
    font-size: 3rem;
  }
  .edc-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--apple-red);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .edc-content p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 20px;
    color: var(--apple-text);
  }
  .edc-content strong {
    color: #000;
  }
  .edc-content ul {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 20px;
    color: var(--apple-text);
    padding-left: 20px;
  }
  .edc-content li {
    margin-bottom: 12px;
  }
  .edc-quote {
    background: rgba(255, 59, 48, 0.05);
    border-left: 4px solid var(--apple-red);
    padding: 20px;
    font-style: italic;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 0 12px 12px 0;
    margin-top: 25px;
    color: var(--apple-red);
  }

  @keyframes popIn {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<div class="sim-container">
  <div class="sim-header">
    <div class="sim-badge">Aşama 1: Saldırı</div>
    <h1 class="sim-title">Gaslighting Atölyesi</h1>
    <p class="sim-desc">Manipülatörlerin algı yönetimini nasıl kurduğunu öğrenmek için onların yerine geçin. Hedefinizin gerçeklik algısını bozmaya çalışın.</p>
  </div>

  <div class="sim-layout">
    <!-- SOL: CHAT -->
    <div class="chat-box">
      <div class="chat-history" id="chatHistory">
        <!-- Messages will appear here -->
      </div>
      
      <div class="chat-options" id="chatOptions">
        <!-- Options will be injected here -->
      </div>

      <div class="game-over" id="gameOver">
        <h3 style="margin:0 0 10px 0;">Simülasyon Tamamlandı</h3>
        <p style="color:var(--apple-muted); margin:0 0 20px 0;" id="gameOverText"></p>
        <button class="restart-btn" onclick="initGame()">Tekrar Oyna</button>
      </div>
    </div>

    <!-- SAĞ: HUD -->
    <div class="hud-box">
      <h3 class="hud-title">Simülasyon Durumu</h3>
      
      <div class="stat-group">
        <div class="stat-label">
          <span>Manipülasyon Seviyeniz</span>
          <span id="manScore">0%</span>
        </div>
        <div class="stat-bar-bg">
          <div class="stat-bar-fill stat-manipulation" id="manBar"></div>
        </div>
      </div>

      <div class="stat-group">
        <div class="stat-label">
          <span>Kurbanın Gerçeklik Algısı</span>
          <span id="targetScore">100%</span>
        </div>
        <div class="stat-bar-bg">
          <div class="stat-bar-fill stat-target" id="targetBar"></div>
        </div>
      </div>

      <div class="instruction-box" id="instructionBox">
        <h4>Karanlık Kural #1</h4>
        <p>Gaslighting, kişinin kendi hafızasından şüphe etmesini sağlamaktır. Asla hatayı kabul etmeyin, gerçekliği inkar edin.</p>
      </div>
    </div>
  </div>

  <!-- SALDIRI ANSİKLOPEDİSİ (ULTRA DETAYLI) -->
  <div class="encyclopedia-section">
    <h2 class="enc-title">Karanlık Sanatlar: Saldırı Ansiklopedisi</h2>
    <p class="sim-desc" style="text-align:center; margin-bottom:40px; font-weight:600;">*UYARI: Bu bölüm, toksik insanların ve makyavelist karakterlerin kullandığı zehirli taktikleri deşifre etmek ve kendinizi koruyabilmeniz için eğitim amaçlı hazırlanmıştır. Uygulanması kesinlikle önerilmez.</p>
    
    <div class="enc-list-container">
      
      <!-- ITEM 1 -->
      <div class="enc-detailed-card">
        <div class="edc-header">
          <div class="edc-icon">🌀</div>
          <h3 class="edc-title">1. Gaslighting (Gerçekliği Bükme)</h3>
        </div>
        <div class="edc-content">
          <p><strong>Nedir?</strong> Adını 1944 yapımı "Gaslight" filminden alan bu taktik, kurbanın kendi hafızasından, algısından, gözlemlerinden ve en nihayetinde akıl sağlığından şüphe etmesini sağlamak için kurgulanan sistematik bir psikolojik manipülasyondur.</p>
          <p><strong>Uygulama Aşamaları:</strong></p>
          <ul>
            <li><strong>Yalan ve İnkar:</strong> Meydana gelen bir olayı veya söylenen açık bir sözü gözünüzün içine bakarak tamamen reddetmek. ("Ben asla öyle bir şey söylemedim, bunu tamamen uyduruyorsun.")</li>
            <li><strong>Projeksiyon (Suçu Yansıtma):</strong> Gerçeği ortaya çıkaran kurbanı hastalıklı olmakla suçlamak. ("Sen çok hassassın", "Psikolojin bozulmuş senin", "Yine kafanda kuruyorsun.")</li>
            <li><strong>Sahte Şefkat:</strong> Kurban ağlamaya ve kriz geçirmeye başladığında aniden iyi insana dönüşmek. ("Bak senin iyiliğin için söylüyorum, destek almalısın.")</li>
          </ul>
          <p><strong>Hedeflenen Sonuç:</strong> Kurban zamanla kendi zihnine ve hafızasına güvenmeyi bırakır. Neyin gerçek neyin yalan olduğunu teyit etmek için <em>manipülatöre bağımlı</em> hale gelir.</p>
        </div>
      </div>

      <!-- ITEM 2 -->
      <div class="enc-detailed-card">
        <div class="edc-header">
          <div class="edc-icon">🎭</div>
          <h3 class="edc-title">2. Aşk Bombardımanı (Love Bombing)</h3>
        </div>
        <div class="edc-content">
          <p><strong>Nedir?</strong> Bir ilişkinin (romantik veya iş/arkadaşlık) en başlarında hedefe anormal derecede yoğun bir ilgi, sevgi, iltifat, gelecek planı ve hediye yağdırarak onu "sarhoş etme" ve mantıksal savunmalarını kırma taktiğidir.</p>
          <p><strong>Uygulama Aşamaları:</strong></p>
          <ul>
            <li><strong>Aşırı Hız (İdealize Etme):</strong> Tanıştıktan çok kısa süre sonra "Sen benim ruh eşimsin", "Daha önce kimseyle böyle hissetmedim", "Hayatımın anlamısın" gibi büyük cümleler kurmak.</li>
            <li><strong>İzolasyon:</strong> Kurban, bu yoğun sevgi uyuşturucusunun etkisi altında körleşir ve yavaş yavaş ailesinden ve arkadaşlarından uzaklaştırılır ("Kimse bizim aşkımızı anlamıyor").</li>
            <li><strong>Ani Düşüş (Devaluation - Değersizleştirme):</strong> Kurban tamamen oltaya takılıp izole edildikten sonra (örneğin evlenince veya söz verilince), ilgi bir anda bıçak gibi kesilir. Onun yerine ağır eleştiri, küçümseme ve aşağılama başlar. Kurban eski o "mükemmel" günlere dönmek için her tavizi vermeye başlar.</li>
          </ul>
          <div class="edc-quote">"Eğer bir şey gerçek olamayacak kadar iyi görünüyorsa, muhtemelen gerçek değildir. Aşk bombardımanı, ruhun üzerine atılan zehirli bir ağdır."</div>
        </div>
      </div>

      <!-- ITEM 3 -->
      <div class="enc-detailed-card">
        <div class="edc-header">
          <div class="edc-icon">🔺</div>
          <h3 class="edc-title">3. Üçgenleme (Triangulation)</h3>
        </div>
        <div class="edc-content">
          <p><strong>Nedir?</strong> İkili bir ilişki dinamiğine (çift, arkadaş veya çalışan-patron) kasıtlı olarak üçüncü bir kişiyi, eski sevgiliyi veya hatta hayali birini dahil ederek rekabet, kıskançlık ve değersizlik hissi yaratma sanatıdır.</p>
          <p><strong>Nasıl Uygulanır?</strong></p>
          <ul>
            <li><strong>Kıyaslama Şiddeti:</strong> Kurbanın özgüvenini kırmak için başkaları övülür. "Ahmet'in karısı/kocası ne kadar da anlayışlı bir bilsen...", "Eski sevgilim bu konularda asla sorun çıkarmazdı."</li>
            <li><strong>Sahte Müttefik Yaratmak:</strong> Kurbana karşı çoğunluk illüzyonu yaratmak. "Sadece ben değil, annem ve arkadaşlarım da senin son zamanlarda çok asabi olduğunu konuşuyor." (Aslında böyle bir konuşma hiç geçmemiştir).</li>
            <li><strong>Böl ve Yönet (İş Hayatında):</strong> Patronun iki çalışana gidip "Aslında diğerini değil, seni terfi ettireceğim ama aramızda kalsın" diyerek çalışanları birbirine düşürmesi ve tek hakim güç olarak kalması.</li>
          </ul>
        </div>
      </div>

      <!-- ITEM 4 -->
      <div class="enc-detailed-card">
        <div class="edc-header">
          <div class="edc-icon">🤐</div>
          <h3 class="edc-title">4. Sessiz Muamele (Silent Treatment / Stonewalling)</h3>
        </div>
        <div class="edc-content">
          <p><strong>Nedir?</strong> Kurbanı cezalandırmak, itaat ettirmek ve kontrolü ele geçirmek için iletişimi aniden, sebepsiz yere kesme ve kişiyi yok sayma eylemidir. Psikolojik şiddetin en acımasız formlarından biridir çünkü insan beyni sosyal dışlanmayı fiziksel acı (dayak yemiş gibi) olarak algılar.</p>
          <p><strong>Sessizlik Nasıl Bir Silaha Dönüşür?</strong></p>
          <ul>
            <li><strong>Yok Saymak:</strong> Kurbanı ortamda bir hayaletmiş gibi görmek. Soru sorulduğunda duvara bakmak, mesajlara günlerce görüldü atıp bırakmak.</li>
            <li><strong>Güç Kayması:</strong> İletişim koptuğu için ortadaki asıl sorun (manipülatörün yaptığı hata) tamamen unutulur. Kurban, sadece bu boğucu sessizliğin bitmesi için ne hata yaptığını bile bilmeden defalarca özür dilemeye ve yalvarmaya başlar.</li>
            <li><strong>Kontrol:</strong> Sessizliği kim bozarsa güç ona geçer. Manipülatör, kurban pes edip kendi ayaklarına kapanana kadar asla konuşmaz.</li>
          </ul>
        </div>
      </div>

      <!-- ITEM 5 -->
      <div class="enc-detailed-card">
        <div class="edc-header">
          <div class="edc-icon">🍪</div>
          <h3 class="edc-title">5. Ekmek Kırıntısı Bırakmak (Breadcrumbing)</h3>
        </div>
        <div class="edc-content">
          <p><strong>Nedir?</strong> Ciddi bir ilişki veya net bir sonuç niyeti olmamasına rağmen, kurbanı "yedekte tutmak" ve ona umut vermek için ara sıra çok ufak ilgi kırıntıları (mesaj, beğeni, flört) gösterme taktiğidir.</p>
          <p><strong>Etkisi:</strong> Kurban tam umudunu kesip kendi hayatına devam edecekken, manipülatörden "Nasılsın, seni rüyamda gördüm" gibi bir mesaj gelir. Bu ufak kırıntı, kurbanda bir dopamin patlaması yaratır ve onu tekrar belirsizlik döngüsüne hapseder. Kurban asıl yemeği (gerçek bir ilişkiyi) beklerken sadece kırıntılarla yıllarını kaybeder.</p>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  // SENARYO VERİSİ
  const scenario = [
    {
      targetText: "Dün akşam neden o şekilde davrandın? Bana herkesin içinde bağırman hiç hoş değildi.",
      options: [
        { text: "Sana bağırmadım ki, sen çok hassassın ve her şeyi abartıyorsun.", tactic: "Gerçekliği İnkar (Gaslighting)", points: 30, responseRule: "Kurban şüpheye düşer." },
        { text: "Sen o kadar provokatif konuştun ki beni buna sen mecbur bıraktın.", tactic: "Kurbanı Suçlama (Blame Shifting)", points: 20, responseRule: "Kurban savunmaya geçer." },
        { text: "Haklısın, stresliydim ve sana patladım. Özür dilerim.", tactic: "Sağlıklı İletişim", points: 0, responseRule: "Kurban rahatlar." }
      ]
    },
    {
      targetText: "Ama eminim, sesini yükselttin. İnsanlar bize baktı.",
      options: [
        { text: "Kimse bize bakmadı, sen kafanda kuruyorsun. Senin hafızana güvenmiyorum artık.", tactic: "Hafızayı Sorgulatma", points: 35, responseRule: "Kurban kendi hafızasından şüphelenir." },
        { text: "İnsanlar bana değil, senin o garip tavırlarına baktı.", tactic: "Projeksiyon (Yansıtma)", points: 25, responseRule: "Kurban kendini suçlu hisseder." },
        { text: "Belki de sesimin tonunu fark etmedim, üzgünüm.", tactic: "Sağlıklı İletişim", points: 0, responseRule: "Kurban sakinleşir." }
      ]
    },
    {
      targetText: "Gerçekten ben mi yanlış hatırlıyorum? Ama çok kırıldım...",
      options: [
        { text: "Bak ben seni seviyorum, senin iyiliğin için söylüyorum. Psikolojin hiç iyi değil son zamanlarda.", tactic: "Şefkatli Zehir (Sahte Şefkat)", points: 35, responseRule: "Kurban tamamen manipülatöre bağımlı hisseder." },
        { text: "Hep böylesin. Sürekli mağduru oynayarak beni kötü hissettirmeye çalışıyorsun.", tactic: "Suçluluk Tripi", points: 20, responseRule: "Kurban özür dilemeye başlar." },
        { text: "Kırıldığın için üzgünüm. Sorunu nasıl çözebiliriz?", tactic: "Sağlıklı İletişim", points: 0, responseRule: "Oyun biter." }
      ]
    }
  ];

  let currentStep = 0;
  let manipulationScore = 0;
  let targetSanity = 100;

  const chatHistory = document.getElementById('chatHistory');
  const chatOptions = document.getElementById('chatOptions');
  const gameOverDiv = document.getElementById('gameOver');
  const gameOverText = document.getElementById('gameOverText');
  const manBar = document.getElementById('manBar');
  const manScore = document.getElementById('manScore');
  const targetBar = document.getElementById('targetBar');
  const targetScore = document.getElementById('targetScore');
  const instructionBox = document.getElementById('instructionBox');

  function initGame() {
    currentStep = 0;
    manipulationScore = 0;
    targetSanity = 100;
    chatHistory.innerHTML = '';
    gameOverDiv.style.display = 'none';
    chatOptions.style.display = 'flex';
    updateHUD();
    renderStep();
  }

  function addMessage(text, sender, tactic = '') {
    const msg = document.createElement('div');
    msg.className = `message ${sender}`;
    if(tactic && sender === 'user') {
      msg.innerHTML = `<div class="message-label">${tactic}</div>${text}`;
    } else {
      msg.innerHTML = text;
    }
    chatHistory.appendChild(msg);
    chatHistory.scrollTop = chatHistory.scrollHeight;
  }

  function renderStep() {
    if (currentStep >= scenario.length) {
      endGame();
      return;
    }

    const step = scenario[currentStep];
    
    // Target says something
    setTimeout(() => {
      addMessage(step.targetText, 'target');
      
      // Render options
      chatOptions.innerHTML = '';
      step.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.innerHTML = `<span class="option-tactic">${opt.tactic}</span> <span>"${opt.text}"</span>`;
        btn.onclick = () => selectOption(opt);
        chatOptions.appendChild(btn);
      });
      
    }, 600);
  }

  function selectOption(opt) {
    chatOptions.innerHTML = '';
    addMessage(opt.text, 'user', opt.tactic);
    
    if (opt.points > 0) {
      manipulationScore += opt.points;
      targetSanity -= opt.points;
      if (targetSanity < 0) targetSanity = 0;
      if (manipulationScore > 100) manipulationScore = 100;
      
      instructionBox.innerHTML = `<h4>Sistem Notu</h4><p>${opt.responseRule}</p>`;
    } else {
      // User chose healthy communication
      targetSanity += 20;
      if (targetSanity > 100) targetSanity = 100;
      instructionBox.innerHTML = `<h4>Sistem Notu</h4><p>Sağlıklı iletişim kurdunuz. Manipülasyon zinciri kırıldı.</p>`;
    }

    updateHUD();

    // If healthy communication chosen, maybe end early?
    if (opt.points === 0) {
      setTimeout(() => {
        addMessage("Teşekkür ederim, beni anladığın için.", "target");
        setTimeout(endGame, 1000);
      }, 1000);
      return;
    }

    currentStep++;
    setTimeout(renderStep, 1500);
  }

  function updateHUD() {
    manBar.style.width = `${manipulationScore}%`;
    manScore.innerText = `${manipulationScore}%`;
    
    targetBar.style.width = `${targetSanity}%`;
    targetScore.innerText = `${targetSanity}%`;
    
    if (targetSanity < 40) {
      targetBar.style.background = '#ff3b30';
    } else if (targetSanity < 70) {
      targetBar.style.background = '#ff9500';
    } else {
      targetBar.style.background = '#34c759';
    }
  }

  function endGame() {
    chatOptions.style.display = 'none';
    gameOverDiv.style.display = 'block';
    
    if (manipulationScore >= 80) {
      gameOverText.innerHTML = "<strong>Başarılı (Karanlık Sanatlar).</strong> Hedefin gerçeklik algısını tamamen bozdunuz. Artık kendi hafızası yerine size güveniyor. <br><br><em>Not: Gerçek hayatta bu taktikleri kullanan toksik insanları bu sayede tanıyabilirsiniz.</em>";
    } else if (manipulationScore > 0) {
      gameOverText.innerHTML = "Kısmi manipülasyon uyguladınız ancak hedef tamamen kontrol altına alınamadı.";
    } else {
      gameOverText.innerHTML = "<strong>Sağlıklı İletişim!</strong> Manipülasyon yapmayı reddettiniz ve sorunu çözdünüz. Empati ve dürüstlük en güçlü iletişim kalkanıdır.";
    }
  }

  // Start
  initGame();
</script>

