<%- include('partials/main-header') %>

<style>
  /* ♟️ Leadership Boardroom Light Theme ♟️ */
  body { background: #fefce8; color: #422006; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ♟️ Hero Section ♟️ */
  .ld-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #fef3c7 0%, #fefce8 80%);
  }
  .ld-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fefce8,transparent); }

  /* Corporate Grid Background */
  .ld-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; opacity: 0.15; background-image: linear-gradient(#b45309 1px, transparent 1px), linear-gradient(90deg, #b45309 1px, transparent 1px); background-size: 40px 40px; transform: perspective(500px) rotateX(60deg) scale(2); transform-origin: top; animation: gridMove 20s linear infinite; }
  @keyframes gridMove { 0% { background-position: 0 0; } 100% { background-position: 0 40px; } }

  .ld-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: floatChess 4s ease-in-out infinite; filter: drop-shadow(0 15px 25px rgba(180,83,9,0.3)); }
  @keyframes floatChess { 0%,100%{ transform:translateY(0) scale(1); } 50%{ transform:translateY(-15px) scale(1.05); } }

  .ld-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #b45309; background: #fef3c7; border:1px solid #fde68a; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(180,83,9,0.15); }
  .ld-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #422006; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .ld-title span { background: linear-gradient(135deg, #d97706, #b45309); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .ld-subtitle { color: #b45309; font-size:1.2rem; max-width:750px; line-height:1.8; z-index:2; position:relative; font-weight: 500; }

  /* ♟️ Container ♟️ */
  .ld-wrap { max-width:1100px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* ♟️ Premium Cards ♟️ */
  .ld-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(180, 83, 9, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .ld-card:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(180, 83, 9, 0.1); border-color: rgba(180, 83, 9, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #b45309; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* ♟️ Crisis Room Simulator ♟️ */
  .crisis-box { background: #422006; border-radius: 24px; padding: 40px; color: white; display: flex; flex-direction: column; gap: 30px; position: relative; overflow: hidden; }
  .crisis-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; }
  .crisis-alert { color: #ef4444; font-weight: 800; font-size: 1.2rem; display: flex; align-items: center; gap: 10px; animation: pulseAlert 2s infinite; }
  @keyframes pulseAlert { 0%,100%{ opacity: 1; } 50%{ opacity: 0.5; } }
  
  .crisis-scenario { font-size: 1.2rem; color: #fef3c7; line-height: 1.6; font-weight: 500; font-style: italic; }
  
  .crisis-opts { display: grid; grid-template-columns: 1fr; gap: 15px; }
  .c-opt-btn { text-align: left; padding: 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); border-radius: 16px; color: white; font-size: 1.1rem; cursor: pointer; transition: all 0.2s; line-height: 1.5; }
  .c-opt-btn:hover { background: rgba(255,255,255,0.1); border-color: #fcd34d; }
  .c-opt-btn.correct { background: #166534; border-color: #22c55e; }
  .c-opt-btn.wrong { background: #7f1d1d; border-color: #ef4444; }
  
  .crisis-feedback { min-height: 60px; font-weight: 600; color: #fcd34d; font-size: 1.1rem; line-height: 1.5; }

  /* ♟️ SBI Feedback Simulator ♟️ */
  .sbi-box { background: #fffbeb; border: 1px solid #fde68a; border-radius: 24px; padding: 40px; }
  .sbi-intro { margin-bottom: 30px; color: #78350f; line-height: 1.6; font-size: 1.05rem; }
  
  .sbi-builder { display: flex; flex-direction: column; gap: 15px; }
  .sbi-slot { background: white; border: 2px dashed #d97706; border-radius: 12px; padding: 20px; min-height: 80px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: #92400e; font-weight: 500; text-align: center; transition: all 0.3s; cursor: pointer; }
  .sbi-slot.filled { border-style: solid; background: #fef3c7; }
  
  .sbi-options { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .sbi-piece { padding: 12px 20px; background: white; border: 1px solid #d97706; border-radius: 40px; color: #b45309; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .sbi-piece:hover { background: #fef3c7; transform: translateY(-2px); }
  .sbi-piece.used { opacity: 0.5; pointer-events: none; }

  .sbi-check-btn { margin-top: 30px; padding: 15px 30px; background: #b45309; color: white; font-weight: 800; border: none; border-radius: 12px; font-size: 1.1rem; cursor: pointer; transition: all 0.3s; box-shadow: 0 8px 15px rgba(180,83,9,0.3); display: none; }
  .sbi-check-btn:hover { background: #92400e; transform: scale(1.05); }

  .sbi-feedback { margin-top: 20px; font-weight: 600; color: #b45309; font-size: 1.1rem; }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #fde68a; color:#b45309; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#fef3c7; color:#78350f; transform:translateX(-4px); border-color: #fcd34d; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="ld-hero">
  <div class="ld-bg"></div>
  <div class="ld-icon">♟️</div>
  <div class="ld-badge">Yönetim Kurulu & Karar Merkezi</div>
  <h1 class="ld-title">Liderlik <span>Psikolojisi</span></h1>
  <p class="ld-subtitle">İnsanları yönetemezsiniz, onlara liderlik edersiniz. Duygusal zeka (EQ), yapıcı geri bildirim ve kriz yönetimiyle ekiplerinize nasıl ilham vereceğinizi keşfedin.</p>
</section>

<div class="ld-wrap">
  <a href="/diksiyon?cat=liderlik" class="back-btn">← Tüm Liderlik Prensiplerini Gör (25 Madde)</a>

  <!-- ♟️ CRISIS ROOM SIMULATOR ♟️ -->
  <div class="ld-card reveal" style="background:#422006; border:none;">
    <div class="section-label" style="color:#fcd34d;">⚠️ Kriz Odası (Crisis Room)</div>
    <p style="color:#fef3c7; font-size:1.05rem; line-height:1.6; margin-bottom:30px;">
      Gerçek liderlik her şey yolundayken değil, kaos anında ortaya çıkar. Komutan paniklerse asker ölür. Aşağıdaki krizi okuyun ve Duygusal Zeka'yı (EQ) kullanarak ekibi kurtaracak kararı verin.
    </p>

    <div class="crisis-box">
      <div class="crisis-header">
        <div class="crisis-alert">🚨 KRİZ DURUMU</div>
        <div style="color:#92400e; font-weight:bold;">Zaman daralıyor...</div>
      </div>
      
      <div class="crisis-scenario" id="cScen">
        "Şirketinizin tarihindeki en büyük ürün lansmanına sadece 2 saat kaldı. Ancak baş yazılımcı panik atak geçiriyor, sistemde bir çökme var ve ekibinizdeki diğer kişiler birbirini suçlamaya (Çatışma) başladı. Tüm gözler sizin üzerinizde. Ne yaparsınız?"
      </div>
      
      <div class="crisis-opts" id="cOpts">
        <button class="c-opt-btn" onclick="checkCrisis(this, false, 'Yanlış. Panik ortamında bağırarak otorite kurmak sadece korkuyu artırır. Oksijeni tükenmiş bir odaya ateş atmış olursunuz.')">A) Masaya yumruğunuzu vurur, "Sorumlusu kimse lansmandan sonra hesap verecek, şimdi hemen işinize dönün ve şunu çözün!" diye bağırırsınız.</button>
        <button class="c-opt-btn" onclick="checkCrisis(this, true, 'Doğru! Önce duruma değil, İNSANLARA müdahale ettiniz (EQ). Sakinliğiniz (Pause) ekibe oksijen oldu, suçlamayı kesip çözüme odaklanmalarını sağladınız.')">B) Derin bir nefes alır, herkesi durdurur ve sakince: "Sistemin çökmesi dünyanın sonu değil, bunu birlikte çözeceğiz. Ahmet sen kodlara bak, Ayşe sen dış iletişimi ayarla. Ben buradayım." dersiniz.</button>
        <button class="c-opt-btn" onclick="checkCrisis(this, false, 'Yanlış. Mikroyönetim (Micromanagement). Lider işi yapan değil, işi yöneten kişidir. Siz kod yazarsanız takıma kim liderlik edecek?')">C) "Tamam, çekilin ben çözerim" deyip baş yazılımcının klavyesini alır ve kodlara kendiniz müdahale etmeye başlarsınız.</button>
      </div>
      
      <div class="crisis-feedback" id="cBack"></div>
    </div>
  </div>

  <!-- ♟️ SBI FEEDBACK SIMULATOR ♟️ -->
  <div class="ld-card reveal">
    <div class="section-label">🗣️ SBI Modeli (Geri Bildirim) Simülatörü</div>
    
    <div class="sbi-box">
      <div class="sbi-intro">
        Liderler eleştirmez, geri bildirim verir. Savunma yaratmayan bilimsel bir geri bildirim formülü vardır: <strong>SBI (Situation - Behavior - Impact)</strong>.<br><br>
        <strong>S (Durum):</strong> Nerede ve ne zaman oldu?<br>
        <strong>B (Davranış):</strong> Sadece gözlemlenen net eylem nedir? (Yorum katmadan)<br>
        <strong>I (Etki):</strong> Bu davranışın takıma veya sonuca etkisi ne oldu?<br><br>
        <em>Görev: Dün sabahki toplantıda sürekli sözünüzü kesen çalışana SBI modeliyle geri bildirim cümlesi kurun. Aşağıdaki parçaları doğru sırayla (S - B - I) kutulara yerleştirin.</em>
      </div>
      
      <div class="sbi-builder">
        <div class="sbi-slot" id="slot-1" onclick="emptySlot(1)">1. Situation (Durum) <br><span style="font-size:0.8rem; font-weight:normal;">[Buraya Tıkla]</span></div>
        <div class="sbi-slot" id="slot-2" onclick="emptySlot(2)">2. Behavior (Davranış) <br><span style="font-size:0.8rem; font-weight:normal;">[Buraya Tıkla]</span></div>
        <div class="sbi-slot" id="slot-3" onclick="emptySlot(3)">3. Impact (Etki) <br><span style="font-size:0.8rem; font-weight:normal;">[Buraya Tıkla]</span></div>
      </div>
      
      <div class="sbi-options" id="sbiOpts">
        <div class="sbi-piece" data-type="I" onclick="fillSlot(this)">...bu durum toplantının odak noktasını kaybetmemize ve zamanı aşmamıza neden oldu. (Etki)</div>
        <div class="sbi-piece" data-type="B" onclick="fillSlot(this)">...sunum yaparken 3 kez sözümü kestin ve araya girdin. (Davranış)</div>
        <div class="sbi-piece" data-type="S" onclick="fillSlot(this)">Dün sabahki strateji toplantısında... (Durum)</div>
        <div class="sbi-piece" data-type="X" onclick="fillSlot(this)">...sen çok saygısız bir insansın ve kimseyi dinlemiyorsun. (Zehirli Yorum)</div>
      </div>

      <button class="sbi-check-btn" id="sbiBtn" onclick="checkSBI()">Formülü Kontrol Et</button>
      <div class="sbi-feedback" id="sbiBack"></div>
    </div>
  </div>

</div>

<script>
// ♟️ Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// ♟️ Crisis Room Logic
function checkCrisis(btn, isCorrect, exp) {
  const btns = document.getElementById('cOpts').querySelectorAll('.c-opt-btn');
  btns.forEach(b => b.style.pointerEvents = 'none');
  
  const fb = document.getElementById('cBack');
  if(isCorrect) {
    btn.classList.add('correct');
    fb.innerHTML = `✅ ${exp}`;
    fb.style.color = '#22c55e';
  } else {
    btn.classList.add('wrong');
    // find correct
    btns[1].style.borderColor = '#22c55e'; // B is correct
    fb.innerHTML = `❌ ${exp}`;
    fb.style.color = '#ef4444';
  }
}

// ♟️ SBI Simulator Logic
let slots = { 1: null, 2: null, 3: null };

function fillSlot(piece) {
  if(piece.classList.contains('used')) return;
  
  // Find first empty slot
  let target = 0;
  if(!slots[1]) target = 1;
  else if(!slots[2]) target = 2;
  else if(!slots[3]) target = 3;
  
  if(target === 0) return; // full
  
  slots[target] = piece;
  piece.classList.add('used');
  
  const sElement = document.getElementById('slot-' + target);
  sElement.innerHTML = piece.innerText;
  sElement.classList.add('filled');
  
  checkIfFull();
}

function emptySlot(num) {
  if(!slots[num]) return;
  const piece = slots[num];
  piece.classList.remove('used');
  slots[num] = null;
  
  const labels = ["1. Situation (Durum)", "2. Behavior (Davranış)", "3. Impact (Etki)"];
  const sElement = document.getElementById('slot-' + num);
  sElement.innerHTML = `${labels[num-1]} <br><span style="font-size:0.8rem; font-weight:normal;">[Buraya Tıkla]</span>`;
  sElement.classList.remove('filled');
  
  document.getElementById('sbiBtn').style.display = 'none';
  document.getElementById('sbiBack').innerText = '';
}

function checkIfFull() {
  if(slots[1] && slots[2] && slots[3]) {
    document.getElementById('sbiBtn').style.display = 'block';
  }
}

function checkSBI() {
  const type1 = slots[1].getAttribute('data-type');
  const type2 = slots[2].getAttribute('data-type');
  const type3 = slots[3].getAttribute('data-type');
  
  const fb = document.getElementById('sbiBack');
  
  if(type1 === 'S' && type2 === 'B' && type3 === 'I') {
    fb.innerHTML = `✅ Mükemmel Geri Bildirim! "Kişiliğe" saldırmadınız, sadece "Durum, Davranış ve Etkiyi" net bir şekilde ortaya koydunuz. Karşı taraf savunmaya geçmeden hatasını anlayacaktır.`;
    fb.style.color = '#166534';
  } else if (type1 === 'X' || type2 === 'X' || type3 === 'X') {
    fb.innerHTML = `❌ Dikkat! Cümlenin içine "Sen çok saygısızsın" gibi bir (Zehirli Yorum) eklediniz. Liderler yoruma değil eyleme odaklanır. Tıklayarak çıkarın ve tekrar deneyin.`;
    fb.style.color = '#b91c1c';
  } else {
    fb.innerHTML = `❌ Sıralama veya içerik yanlış. Doğru formül: Durum (Situation) -> Davranış (Behavior) -> Etki (Impact). Kutulara tıklayarak boşaltıp tekrar deneyin.`;
    fb.style.color = '#b91c1c';
  }
}
</script>

<%- include('partials/main-footer') %>
