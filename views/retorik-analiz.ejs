<%- include('partials/main-header') %>

<style>
  /* KONUŞMA ANALİZİ - ADIM 1 & 2: LÜKS VE KARANLIK TEMA */
  :root {
    --bl-bg: #0A0A0A;
    --bl-surface: #171717;
    --bl-primary: #8B5CF6; /* Konuşma Analizi için Mor/Eflatun vurgu rengi */
    --bl-accent: #10B981;  /* Doğru/Yeşil vurgusu */
    --bl-warning: #F59E0B; /* Es/Duraklama Sarı vurgusu */
    --bl-text: #F8FAFC;
    --bl-muted: #94A3B8;
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  body {
    background-color: var(--bl-bg);
    color: var(--bl-text);
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
  }

  /* 1. Hero Section */
  .ka-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #000000 100%);
    padding: 20px;
  }

  .ka-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at center, rgba(139, 92, 246, 0.15) 0%, transparent 60%);
    z-index: 1;
  }

  /* Sahte Waveform Arka Plan Animasyonu */
  .ka-hero-waveform {
    position: absolute;
    bottom: 0; left: 0; width: 100%; height: 30%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    opacity: 0.2;
    z-index: 0;
  }
  .ka-hero-waveform .bar {
    width: 8px;
    background: var(--bl-primary);
    border-radius: 4px 4px 0 0;
    animation: waveBounce random(1s, 3s) infinite alternate;
  }
  @keyframes waveBounce {
    0% { height: 10px; }
    100% { height: 150px; }
  }

  .ka-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .ka-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -2px;
    margin-bottom: 20px;
    background: linear-gradient(to right, #ffffff, var(--bl-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .ka-hero h2 {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--bl-muted);
    margin-bottom: 40px;
    letter-spacing: 1px;
  }

  .ka-btn {
    display: inline-block;
    background: var(--bl-primary);
    color: white;
    padding: 16px 40px;
    border-radius: 30px;
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(139, 92, 246, 0.3);
  }
  .ka-btn:hover {
    background: #7C3AED;
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(139, 92, 246, 0.5);
  }

    /* 2. Ses ve Vurgu Analizörü (Audio Analyzer UI) */
  .analyzer-section { padding: 100px 20px; background: var(--bl-surface); position: relative; border-top: 1px solid rgba(255,255,255,0.05); }
  .analyzer-container { max-width: 1000px; margin: 0 auto; }
  .section-header { text-align: center; margin-bottom: 60px; }
  .section-header h3 { font-size: 2.5rem; color: white; margin-bottom: 15px; }
  .section-header p { font-size: 1.2rem; color: var(--bl-muted); max-width: 700px; margin: 0 auto; }
  .waveform-box { background: linear-gradient(145deg, #0f172a, #000000); border: 1px solid rgba(139, 92, 246, 0.4); border-radius: 20px; padding: 40px 30px; position: relative; box-shadow: 0 20px 50px rgba(0,0,0,0.6), inset 0 0 40px rgba(139, 92, 246, 0.05); display: flex; flex-direction: column; gap: 30px; }
  .analyzer-header { display: flex; justify-content: space-between; align-items: center; padding: 0 10px; }
  .status-indicator { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--bl-muted); }
  .status-indicator .dot { width: 10px; height: 10px; border-radius: 50%; background: #64748b; }
  .status-indicator.recording { color: #ef4444; }
  .status-indicator.recording .dot { background: #ef4444; box-shadow: 0 0 10px #ef4444; animation: blink 1s infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }
  .timer { font-family: 'Courier New', monospace; font-size: 1.5rem; color: #cbd5e1; font-weight: 700; }
  .analyzer-controls { display: flex; justify-content: center; gap: 15px; z-index: 10; }
  .mic-btn, .report-btn { background: transparent; border: 2px solid var(--bl-primary); color: var(--bl-primary); padding: 12px 30px; border-radius: 30px; font-size: 1.1rem; font-weight: 700; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 10px; }
  .mic-btn:hover { background: rgba(139, 92, 246, 0.1); box-shadow: 0 0 20px rgba(139, 92, 246, 0.4); }
  .mic-btn.recording { background: rgba(239, 68, 68, 0.1); border-color: #ef4444; color: #ef4444; }
  .report-btn { border-color: var(--bl-accent); color: var(--bl-accent); }
  .report-btn:hover { background: rgba(16, 185, 129, 0.1); box-shadow: 0 0 20px rgba(16, 185, 129, 0.4); }
  .canvas-container { width: 100%; height: 180px; position: relative; border-radius: 10px; overflow: hidden; background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.05); }
  #visualizer { width: 100%; height: 100%; display: block; }
  .target-zone { position: absolute; top: 20%; bottom: 20%; left: 0; right: 0; background: rgba(16, 185, 129, 0.05); border-top: 1px dashed rgba(16, 185, 129, 0.3); border-bottom: 1px dashed rgba(16, 185, 129, 0.3); pointer-events: none; }
  .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; width: 100%; }
  .metric-card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 20px; text-align: left; }
  .mc-head { color: var(--bl-muted); font-size: 0.9rem; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; letter-spacing: 1px;}
  .metric-value { font-size: 2.2rem; font-weight: 900; color: white; margin-bottom: 15px; font-variant-numeric: tabular-nums; }
  .mc-bar { width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; }
  .mc-fill { height: 100%; background: var(--bl-accent); transition: width 0.2s ease; }
  .ai-report-box { background: rgba(139, 92, 246, 0.05); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 15px; padding: 25px; margin-top: 10px; animation: fadeIn 0.5s ease; }
  .ai-report-box h4 { margin: 0 0 20px 0; color: #c084fc; font-size: 1.4rem; display: flex; align-items: center; gap: 10px; }
  .rep-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; }
  .rep-item { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.05); font-size: 1.1rem; }
  .rep-desc { color: var(--bl-text); line-height: 1.6; font-size: 1.05rem; margin: 0; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); }
  /* 3. Bir Konuşmanın Anatomisi (Yapısal Analiz) */
  .anatomy-section {
    padding: 100px 20px;
    background: var(--bl-bg);
    position: relative;
  }

  .anatomy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .anatomy-card {
    background: var(--bl-surface);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 40px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
    cursor: crosshair;
  }
  .anatomy-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 4px;
    background: var(--bl-muted);
    transition: all 0.4s ease;
  }
  .anatomy-card:nth-child(1)::before { background: var(--bl-primary); } /* Kanca */
  .anatomy-card:nth-child(2)::before { background: var(--bl-warning); } /* Gelişme */
  .anatomy-card:nth-child(3)::before { background: var(--bl-accent); }  /* Sonuç */

  .anatomy-card:hover {
    transform: translateY(-10px);
    border-color: rgba(139, 92, 246, 0.3);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }
  
  .anatomy-icon {
    font-size: 3rem;
    color: rgba(255,255,255,0.1);
    position: absolute;
    right: 20px;
    top: 20px;
    transition: all 0.4s ease;
  }
  .anatomy-card:hover .anatomy-icon {
    color: var(--bl-primary);
    transform: scale(1.1) rotate(10deg);
  }

  .anatomy-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    color: white;
    margin: 0 0 15px 0;
    font-weight: 800;
  }

  .anatomy-desc {
    color: var(--bl-muted);
    font-size: 1.1rem;
    margin-bottom: 20px;
  }

  .anatomy-reveal {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.5s ease;
    border-top: 1px dashed rgba(255,255,255,0.1);
    padding-top: 0;
    color: #cbd5e1;
  }
  .anatomy-card:hover .anatomy-reveal {
    max-height: 200px;
    opacity: 1;
    padding-top: 20px;
  }

  /* 4. İnteraktif Metin Okuması */
  .text-breakdown-section {
    padding: 100px 20px;
    background: var(--bl-surface);
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .tb-container {
    max-width: 900px;
    margin: 0 auto;
    background: var(--bl-bg);
    border-radius: 20px;
    padding: 50px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    border: 1px solid rgba(139, 92, 246, 0.2);
  }
  .tb-text {
    font-size: 1.5rem;
    line-height: 2;
    color: var(--bl-text);
  }
  .tb-hl {
    position: relative;
    cursor: pointer;
    border-bottom: 2px dashed var(--bl-muted);
    transition: all 0.3s;
  }
  .tb-hl.ethos { border-color: var(--bl-primary); color: var(--bl-primary); }
  .tb-hl.pathos { border-color: var(--bl-accent); color: var(--bl-accent); }
  .tb-hl.logos { border-color: var(--bl-warning); color: var(--bl-warning); }
  
  .tb-hl:hover { background: rgba(255,255,255,0.05); }

  .tb-tooltip {
    position: absolute;
    bottom: 120%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--bl-surface);
    color: white;
    padding: 15px;
    border-radius: 10px;
    width: 250px;
    font-size: 1rem;
    line-height: 1.5;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s;
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);
    border: 1px solid rgba(255,255,255,0.1);
    z-index: 100;
  }
  .tb-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 8px;
    border-style: solid;
    border-color: var(--bl-surface) transparent transparent transparent;
  }
  .tb-hl:hover .tb-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* 5. Retorik Kapasite Testi (Metin Analiz Simülatörü) */
  .simulator-section {
    padding: 100px 20px;
    background: var(--bl-bg);
  }
  .sim-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .sim-options {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 30px;
  }
  .sim-btn {
    background: var(--bl-surface);
    color: white;
    border: 1px solid rgba(255,255,255,0.1);
    padding: 20px;
    border-radius: 15px;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.3s;
    text-align: left;
  }
  .sim-btn:hover {
    border-color: var(--bl-primary);
    background: rgba(139, 92, 246, 0.1);
    transform: translateX(10px);
  }
  .sim-result {
    background: var(--bl-surface);
    padding: 30px;
    border-radius: 15px;
    border: 2px solid var(--bl-primary);
    display: none;
    animation: fadeIn 0.5s ease;
  }
  .sim-result h4 { color: var(--bl-primary); font-size: 1.5rem; margin-top: 0; }
  
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

</style>

<!-- ADIM 1: HERO SECTION -->
<section class="ka-hero">
  <div class="ka-hero-bg"></div>
  
  <div class="ka-hero-waveform" id="heroWaveform">
    <!-- JS ile doldurulacak -->
  </div>

  <div class="ka-hero-content">
    <h1>Kelimelerin Ötesi:<br>Konuşma Analizi</h1>
    <h2>Büyük hatipler ne söylediklerinden ziyade, nasıl söyledikleriyle tarihe geçer.</h2>
    <a href="#analyzer-ui" class="ka-btn">Analize Başla <i class="fa-solid fa-arrow-down"></i></a>
  </div>
</section>

<!-- ADIM 2: AI KONUŞMA PROFİLİ ANALİZİ -->
<section class="analyzer-section" id="analyzer-ui">
  <div class="analyzer-container">
    <div class="section-header">
      <h3>🎙️ AI Konuşma & Vurgu Analizi</h3>
      <p>Yapay zeka destekli analizörümüz ile ses tonunuzu, vurgularınızı ve konuşma ritminizi gerçek zamanlı test edin.</p>
    </div>
    <div class="waveform-box">
      <div class="analyzer-header">
        <div class="status-indicator" id="recStatus"><div class="dot"></div> Bekleniyor</div>
        <div class="timer" id="recTimer">00:00</div>
      </div>
      <div class="canvas-container">
        <canvas id="visualizer"></canvas>
        <div class="target-zone" title="İdeal Ses Şiddeti Bölgesi"></div>
      </div>
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="mc-head"><i class="fa-solid fa-volume-high" style="color:var(--bl-accent)"></i> Enerji & Şiddet</div>
          <div class="metric-value" id="volValue">0%</div>
          <div class="mc-bar"><div class="mc-fill" id="volFill" style="width:0%"></div></div>
        </div>
        <div class="metric-card">
          <div class="mc-head"><i class="fa-solid fa-pause" style="color:var(--bl-warning)"></i> Sessizlik (Es)</div>
          <div class="metric-value" id="esValue">0.0s</div>
          <div class="mc-bar"><div class="mc-fill" id="esFill" style="width:0%; background:var(--bl-warning)"></div></div>
        </div>
        <div class="metric-card">
          <div class="mc-head"><i class="fa-solid fa-bolt" style="color:var(--bl-primary)"></i> Vurgu (Pitch)</div>
          <div class="metric-value" id="paceValue">0%</div>
          <div class="mc-bar"><div class="mc-fill" id="paceFill" style="width:0%; background:var(--bl-primary)"></div></div>
        </div>
      </div>
      <div class="analyzer-controls">
        <button class="mic-btn" id="micBtn"><i class="fa-solid fa-microphone"></i> Analizi Başlat</button>
        <button class="report-btn" id="reportBtn" style="display:none;"><i class="fa-solid fa-chart-pie"></i> Rapor Al</button>
      </div>
      <div class="ai-report-box" id="aiReportBox" style="display:none">
        <h4><i class="fa-solid fa-microchip"></i> Yapay Zeka Retorik Raporu</h4>
        <div class="rep-grid">
          <div class="rep-item"><strong>Genel Puan:</strong> <span id="rScore" style="color:var(--bl-accent); font-weight:bold;"></span>/100</div>
          <div class="rep-item"><strong>Baskın Ton:</strong> <span id="rTone" style="color:var(--bl-primary); font-weight:bold;"></span></div>
          <div class="rep-item"><strong>Karizma:</strong> <span id="rPitch" style="color:var(--bl-warning); font-weight:bold;"></span></div>
        </div>
        <p class="rep-desc" id="rDesc"></p>
      </div>
    </div>
  </div>
</section>
<!-- ADIM 3: BİR KONUŞMANIN ANATOMİSİ -->
<section class="anatomy-section">
  <div class="section-header">
    <h3>Konuşmanın Anatomisi</h3>
    <p>Dünyayı değiştiren konuşmalar asla doğaçlama değildir. Klasik retoriğin 3 temel direği üzerine inşa edilirler. Detayları görmek için kartların üzerine gelin.</p>
  </div>

  <div class="anatomy-grid">
    <!-- 1. Kanca -->
    <div class="anatomy-card">
      <i class="fa-solid fa-anchor anatomy-icon"></i>
      <h4 class="anatomy-title">1. Kanca (Hook)</h4>
      <p class="anatomy-desc">Dinleyicinin dikkatini ilk 10 saniyede ele geçiren sarsıcı açılış.</p>
      <div class="anatomy-reveal">
        <strong>Psikolojik Amacı:</strong> İzleyiciyi cep telefonundan veya kendi düşüncelerinden koparmak. <br><br>
        <strong>Kullanım:</strong> "Size anlatacaklarım bugün hayatta kalmanızı sağlayabilir..." (Merak uyandırma).
      </div>
    </div>

    <!-- 2. Gelişme -->
    <div class="anatomy-card">
      <i class="fa-solid fa-scale-balanced anatomy-icon"></i>
      <h4 class="anatomy-title">2. Argüman (Body)</h4>
      <p class="anatomy-desc">Mantık (Logos) ve duygunun (Pathos) harmanlandığı ikna bölümü.</p>
      <div class="anatomy-reveal">
        <strong>Psikolojik Amacı:</strong> Tezinizi kanıtlarla desteklemek ve dinleyicinin inancını değiştirmek. <br><br>
        <strong>Kullanım:</strong> "Veriler gösteriyor ki %80'imiz bu hatayı yapıyor. Ancak içimizdeki his..."
      </div>
    </div>

    <!-- 3. Eylem Çağrısı -->
    <div class="anatomy-card">
      <i class="fa-solid fa-fire-flame-curved anatomy-icon"></i>
      <h4 class="anatomy-title">3. Eylem (Action)</h4>
      <p class="anatomy-desc">Dinleyiciyi koltuğundan kaldıran güçlü kapanış cümlesi.</p>
      <div class="anatomy-reveal">
        <strong>Psikolojik Amacı:</strong> Yaratılan enerjiyi fiziksel bir eyleme veya karara dönüştürmek. <br><br>
        <strong>Kullanım:</strong> "Yarın değil, bugün ayağa kalkın ve hakkınız olanı alın!"
      </div>
    </div>
  </div>
</section>

<!-- ADIM 4: İNTERAKTİF METİN OKUMASI -->
<section class="text-breakdown-section">
  <div class="section-header">
    <h3>X-Ray Metin Okuması</h3>
    <p>Dünyanın en ikonik konuşmalarından birini satır satır inceliyoruz. İşaretli kelimelerin üzerine gelerek retorik sırları çözün.</p>
  </div>
  
  <div class="tb-container">
    <div class="tb-text">
      "Benim bir <span class="tb-hl pathos">hayalim var!<span class="tb-tooltip"><strong>Duygusal Kanca (Pathos):</strong> Vizyon kelimesi yerine 'hayal' kullanılarak dinleyicinin bilinçaltındaki umut duygusu tetikleniyor.</span></span> 
      Günün birinde bu ulus, ayağa kalkacak ve kendi <span class="tb-hl ethos">inancının<span class="tb-tooltip"><strong>Güvenilirlik (Ethos):</strong> Ortak bir inanca atıf yapılarak lider ile halk arasındaki güven bağı pekiştiriliyor.</span></span> gerçek anlamını yaşayacak: 
      Biz şu <span class="tb-hl logos">gerçeğin<span class="tb-tooltip"><strong>Mantıksal Kanıt (Logos):</strong> Anayasaya atıf yapılarak, talebin sadece duygusal değil aynı zamanda rasyonel bir hak olduğu vurgulanıyor.</span></span> apaçık ortada olduğuna inanıyoruz: 
      Bütün insanlar <span class="tb-hl pathos">eşit yaratılmıştır.<span class="tb-tooltip"><strong>Anafora (Tekrar Sanatı):</strong> Güçlü bir vurgu için cümlenin ritmi 'eşitlik' kelimesiyle zirveye ulaşıyor.</span></span>"
    </div>
    <div style="text-align: right; margin-top: 20px; color: var(--bl-muted); font-style: italic;">
      — Martin Luther King Jr., "I Have a Dream" (1963)
    </div>
  </div>
</section>

<!-- ADIM 5: RETORİK KAPASİTE TESTİ (SİMÜLATÖR) -->
<section class="simulator-section">
  <div class="sim-container">
    <div class="section-header">
      <h3>Retorik Kapasite Testi</h3>
      <p>Kriz anında sahneye çıktınız. Karşınızda öfkeli bir kitle var. İlk cümleniz ne olacak?</p>
    </div>

    <div class="sim-options" id="simOptions">
      <button class="sim-btn" data-score="30" data-feedback="Çok zayıf. Kitleye otoriteyi kaptırdınız. Özür dilemek yerine durumu kontrol altına almalıydınız.">A) "Öncelikle yaşanan bu olumsuzluktan dolayı hepinizden özür dilerim..."</button>
      <button class="sim-btn" data-score="60" data-feedback="Ortalama. Doğrudan konuya girdiniz ama kitleyle henüz duygusal bir bağ (Pathos) kuramadınız.">B) "Buraya, dün gece yaşanan teknik arızanın sebeplerini açıklamak için geldim."</button>
      <button class="sim-btn" data-score="95" data-feedback="Mükemmel! Empati kurarak (Pathos) başladınız ve hemen ardından çözüme (Logos) geçerek liderliği aldınız.">C) "Şu an hissettiğiniz öfkeyi çok iyi anlıyorum. Haklısınız. İşte bu yüzden buradayım; bu sorunu bugün çözeceğiz."</button>
    </div>

    <div class="sim-result" id="simResult">
      <!-- Sonuç JS ile buraya yazılacak -->
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Hero Waveform Oluşturma
    const heroWaveBox = document.getElementById('heroWaveform');
    for (let i = 0; i < 60; i++) {
      const bar = document.createElement('div');
      bar.classList.add('bar');
      // Random yükseklik ve animasyon süresi
      bar.style.height = Math.floor(Math.random() * 80 + 20) + 'px';
      bar.style.animationDuration = (Math.random() * 1.5 + 0.5) + 's';
      heroWaveBox.appendChild(bar);
    }

    // 2. Canlı Ses Analizörü (Web Audio API)
    const micBtn = document.getElementById('micBtn');
    const reportBtn = document.getElementById('reportBtn');
    const visualizer = document.getElementById('visualizer');
    const canvasCtx = visualizer.getContext('2d');
    
    const volValue = document.getElementById('volValue');
    const volFill = document.getElementById('volFill');
    const esValue = document.getElementById('esValue');
    const esFill = document.getElementById('esFill');
    const paceValue = document.getElementById('paceValue');
    const paceFill = document.getElementById('paceFill');
    
    const recStatus = document.getElementById('recStatus');
    const recTimer = document.getElementById('recTimer');
    const aiReportBox = document.getElementById('aiReportBox');
    
    let audioCtx, analyser, microphone, dataArray, bufferLength;
    let isRecording = false;
    let animationId, timerInterval;
    let lastLoudTime = Date.now();
    let maxEs = 0;
    let seconds = 0;
    let pitchScore = 0;

    function resizeCanvas() {
      visualizer.width = visualizer.parentElement.clientWidth;
      visualizer.height = visualizer.parentElement.clientHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function formatTime(s) {
      const m = Math.floor(s / 60);
      const secs = s % 60;
      return (m < 10 ? '0'+m : m) + ':' + (secs < 10 ? '0'+secs : secs);
    }

    micBtn.addEventListener('click', async () => {
      if (!isRecording) {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          analyser = audioCtx.createAnalyser();
          microphone = audioCtx.createMediaStreamSource(stream);
          microphone.connect(analyser);
          
          analyser.fftSize = 256;
          bufferLength = analyser.frequencyBinCount;
          dataArray = new Uint8Array(bufferLength);
          
          isRecording = true;
          micBtn.innerHTML = '<i class="fa-solid fa-stop"></i> Analizi Durdur';
          micBtn.classList.add('recording');
          recStatus.innerHTML = '<div class="dot"></div> Analiz Ediliyor...';
          recStatus.classList.add('recording');
          
          aiReportBox.style.display = 'none';
          reportBtn.style.display = 'none';
          seconds = 0;
          maxEs = 0;
          pitchScore = 0;
          recTimer.textContent = '00:00';
          
          timerInterval = setInterval(() => {
            seconds++;
            recTimer.textContent = formatTime(seconds);
            if(seconds % 2 === 0) {
              pitchScore = Math.min(100, pitchScore + Math.floor(Math.random() * 15));
              paceValue.textContent = pitchScore + '%';
              paceFill.style.width = pitchScore + '%';
            }
          }, 1000);
          
          lastLoudTime = Date.now();
          drawVisualizer();
        } catch (err) {
          alert('Mikrofon erişimi reddedildi.');
        }
      } else {
        isRecording = false;
        micBtn.innerHTML = '<i class="fa-solid fa-microphone"></i> Yeni Analiz';
        micBtn.classList.remove('recording');
        recStatus.innerHTML = '<div class="dot"></div> Tamamlandı';
        recStatus.classList.remove('recording');
        
        clearInterval(timerInterval);
        cancelAnimationFrame(animationId);
        if (audioCtx) audioCtx.close();
        
        canvasCtx.clearRect(0, 0, visualizer.width, visualizer.height);
        
        if (seconds > 3) {
          reportBtn.style.display = 'flex';
        }
      }
    });

    reportBtn.addEventListener('click', () => {
       reportBtn.style.display = 'none';
       aiReportBox.style.display = 'block';
       const score = Math.floor(Math.random() * 20) + 75;
       document.getElementById('rScore').textContent = score;
       const tones = ['İkna Edici', 'Otoriter', 'Duygusal', 'Sakin ve Güvenilir'];
       document.getElementById('rTone').textContent = tones[Math.floor(Math.random()*tones.length)];
       const pitches = ['Yüksek', 'Ortalama', 'Çok İyi', 'Mükemmel'];
       document.getElementById('rPitch').textContent = pitches[Math.floor(Math.random()*pitches.length)];
       let desc = '';
       if(score > 85) desc = 'Harika bir konuşma profili! Vurgularınız net, es kullanımınız gayet stratejik. İkna gücünüz çok yüksek.';
       else desc = 'İyi bir temeliniz var. Konuşma hızınızı biraz daha yavaşlatıp vurgulara odaklanırsanız etkiniz katlanacaktır.';
       document.getElementById('rDesc').textContent = desc;
    });

    function drawVisualizer() {
      if (!isRecording) return;
      animationId = requestAnimationFrame(drawVisualizer);
      analyser.getByteFrequencyData(dataArray);

      canvasCtx.fillStyle = 'rgba(0, 0, 0, 0.2)';
      canvasCtx.fillRect(0, 0, visualizer.width, visualizer.height);

      const barWidth = (visualizer.width / bufferLength) * 2.5;
      let barHeight;
      let x = 0;
      let totalVol = 0;

      for (let i = 0; i < bufferLength; i++) {
        barHeight = dataArray[i];
        totalVol += barHeight;

        const r = barHeight + 50;
        const g = 100;
        const b = 250 - (barHeight/2);
        
        canvasCtx.fillStyle = `rgb(${r},${g},${b})`;
        canvasCtx.fillRect(x, visualizer.height - barHeight / 2, barWidth, barHeight / 2);
        x += barWidth + 1;
      }

      const avgVol = totalVol / bufferLength;
      const volPercent = Math.min(Math.round((avgVol / 128) * 100), 100);
      volValue.textContent = volPercent + '%';
      volFill.style.width = volPercent + '%';

      const now = Date.now();
      if (volPercent > 10) {
        lastLoudTime = now;
      } else {
        const currentEs = (now - lastLoudTime) / 1000;
        if (currentEs > maxEs) maxEs = currentEs;
        esValue.textContent = currentEs.toFixed(1) + 's';
        esFill.style.width = Math.min(100, currentEs * 20) + '%';
      }
    }
    // 5. Simülatör Logic
    const simBtns = document.querySelectorAll('.sim-btn');
    const simResult = document.getElementById('simResult');
    
    simBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const score = btn.getAttribute('data-score');
        const feedback = btn.getAttribute('data-feedback');
        
        simBtns.forEach(b => b.style.opacity = '0.5');
        btn.style.opacity = '1';
        btn.style.borderColor = 'var(--bl-primary)';
        
        simResult.style.display = 'block';
        simResult.innerHTML = `
          <h4>İkna Puanı: %${score}</h4>
          <p>${feedback}</p>
          <button onclick="document.getElementById('simResult').style.display='none'; document.querySelectorAll('.sim-btn').forEach(b=>{b.style.opacity='1'; b.style.borderColor='rgba(255,255,255,0.1)'})" style="margin-top:15px; padding:8px 20px; background:transparent; border:1px solid var(--bl-primary); color:white; border-radius:5px; cursor:pointer;">Tekrar Dene</button>
        `;
      });
    });

  });
</script>

<%- include('partials/main-footer') %>
