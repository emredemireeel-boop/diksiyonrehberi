<%- include('partials/main-header') %>

<style>
  /* HIKAYE DETAY - PREMIUM LIGHT MODE */
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.hikaye-page { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }

  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');
  
  :root {
    --hk-primary: #d97706; /* amber-600 */
    --hk-primary-light: #fef3c7; /* amber-100 */
    --hk-dark: #78350f; /* amber-900 */
    --hk-accent: #0f766e; /* teal-700 */
    --text-main: #1c1917; /* stone-900 */
    --text-muted: #57534e; /* stone-600 */
    --bg-light: #fafaf9; /* stone-50 */
    --bg-card: #ffffff;
  }

  /* ═══════════════════════════ HEADER AREA ═══════════════════════════ */
  .hd-header {
    background: linear-gradient(180deg, #fefce8 0%, #fafaf9 100%);
    padding: 100px 5% 60px 5%;
    text-align: center;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #fef3c7;
  }
  .hd-header::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--hk-primary) 0.5px, transparent 0.5px);
    background-size: 30px 30px; opacity: 0.08; z-index: 0;
  }
  .hd-content { position: relative; z-index: 2; max-width: 800px; margin: 0 auto; }
  .hd-back { display: inline-flex; align-items: center; gap: 8px; color: var(--hk-accent); font-family: 'Outfit'; font-weight: 700; text-decoration: none; margin-bottom: 20px; transition: 0.3s; }
  .hd-back:hover { transform: translateX(-5px); color: #0d9488; }
  .hd-title { font-family: 'Playfair Display', serif; font-size: 3.5rem; color: var(--text-main); margin: 0 0 15px 0; line-height: 1.2; }
  .hd-subtitle { font-family: 'Outfit', sans-serif; font-size: 1.2rem; color: var(--text-muted); line-height: 1.6; }

  /* ═══════════════════════════ EXERCISE CARDS ═══════════════════════════ */
  .hd-container { max-width: 1000px; margin: 0 auto; padding: 60px 5%; }
  
  .hd-card {
    background: var(--bg-card);
    border: 1px solid #e5e7eb;
    border-radius: 24px;
    padding: 50px;
    margin-bottom: 50px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.03);
    position: relative;
    overflow: hidden;
  }
  .hd-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 6px; height: 100%;
    background: linear-gradient(180deg, var(--hk-primary), var(--hk-accent));
  }
  
  .ex-header { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 30px; }
  .ex-num { 
    font-family: 'Playfair Display', serif; font-size: 3.5rem; font-weight: 800; 
    color: var(--hk-primary-light); line-height: 1; margin-top: -10px;
  }
  .ex-title-wrap { flex-grow: 1; }
  .ex-title { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--text-main); margin: 0 0 10px 0; }
  .ex-desc { font-family: 'Outfit', sans-serif; font-size: 1.15rem; color: var(--text-muted); line-height: 1.7; margin: 0; }
  
  .ret-badge { font-family: 'Outfit'; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; padding: 6px 16px; border-radius: 20px; white-space: nowrap; }
  .ret-badge.blue { background: #e0f2fe; color: #0284c7; }
  .ret-badge.red { background: #fee2e2; color: #dc2626; }
  .ret-badge.green { background: #dcfce7; color: #16a34a; }
  .ret-badge.yellow { background: #fef9c3; color: #ca8a04; }
  .ret-badge.purple { background: #f3e8ff; color: #9333ea; }
  
  /* Sections inside card */
  .hd-section-title { font-family: 'Outfit', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 30px 0 15px 0; display: flex; align-items: center; gap: 10px; text-transform: uppercase; letter-spacing: 1px; }
  
  .hd-list { list-style: none; padding: 0; margin: 0; }
  .hd-list li { position: relative; padding-left: 35px; margin-bottom: 15px; font-size: 1.05rem; color: var(--text-muted); line-height: 1.6; }
  .hd-list li::before { 
    content: '→'; position: absolute; left: 0; top: 2px; color: var(--hk-primary); 
    font-weight: bold; font-family: 'Outfit'; 
  }
  
  .hd-list.benefit-list li::before { content: '✓'; color: #10b981; }
  .hd-list.mistake-list li::before { content: '✗'; color: #ef4444; }

  /* Tip Box */
  .hd-tip {
    background: #f0fdf4; border: 1px solid #bbf7d0; padding: 25px; border-radius: 16px;
    margin: 30px 0; display: flex; gap: 20px; align-items: flex-start;
  }
  .hd-tip-icon { font-size: 1.8rem; color: #22c55e; }
  .hd-tip-text { font-family: 'Outfit', sans-serif; font-size: 1.05rem; color: #166534; line-height: 1.6; font-style: italic; }

  /* Scenario Box */
  .hd-scenario {
    background: #f8fafc; border: 1px solid #e2e8f0; padding: 30px; border-radius: 16px;
    margin: 30px 0; position: relative;
  }
  .hd-scenario::before { content: '🎬'; position: absolute; top: -15px; left: 30px; font-size: 1.5rem; background: #fff; padding: 0 10px; }
  .sb-label { font-family: 'Outfit'; font-size: 0.85rem; font-weight: 800; color: #3b82f6; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; }
  .sb-text { font-family: 'Playfair Display', serif; font-size: 1.25rem; color: var(--text-main); font-style: italic; margin-bottom: 20px; line-height: 1.6; }
  .sb-analysis { font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--text-muted); border-top: 1px solid #e2e8f0; padding-top: 20px; line-height: 1.6; }

  /* Practice Box */
  .hd-practice {
    background: linear-gradient(135deg, #fffbeb, #fefce8); border: 1px solid #fde68a;
    padding: 30px; border-radius: 16px; margin: 30px 0;
  }
  .pb-title { font-family: 'Outfit', sans-serif; font-size: 1.1rem; font-weight: 800; color: var(--hk-dark); margin-bottom: 15px; display: flex; align-items: center; gap: 10px; text-transform: uppercase; letter-spacing: 1px; }
  .pb-text { font-family: 'Inter', sans-serif; font-size: 1.05rem; color: #92400e; line-height: 1.7; }

  /* Quiz Box */
  .hd-quiz {
    background: #ffffff; border: 2px dashed #cbd5e1; padding: 30px; border-radius: 16px;
    margin-top: 40px; text-align: center;
  }
  .q-title { font-family: 'Outfit'; font-size: 0.9rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; }
  .q-question { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--text-main); margin-bottom: 25px; line-height: 1.4; }
  .q-opts { display: flex; flex-direction: column; gap: 12px; max-width: 600px; margin: 0 auto; }
  .q-opt { 
    background: #f8fafc; border: 1px solid #e2e8f0; padding: 18px 25px; border-radius: 12px; 
    cursor: pointer; font-family: 'Outfit', sans-serif; font-size: 1.05rem; font-weight: 600; color: #334155; 
    transition: all 0.3s; text-align: left;
  }
  .q-opt:hover { border-color: var(--hk-primary); background: #fffbeb; transform: translateX(5px); }
  .q-opt.correct { border-color: #10b981; background: #d1fae5; color: #065f46; transform: none; }
  .q-opt.wrong { border-color: #ef4444; background: #fee2e2; color: #991b1b; transform: none; }
  .q-feedback { margin-top: 25px; padding: 20px; border-radius: 12px; font-family: 'Inter', sans-serif; font-size: 1rem; line-height: 1.6; display: none; text-align: left; max-width: 600px; margin-left: auto; margin-right: auto; }
  .q-feedback.success { background: #d1fae5; color: #065f46; display: block; border-left: 4px solid #10b981; }
  .q-feedback.error { background: #fee2e2; color: #991b1b; display: block; border-left: 4px solid #ef4444; }

  @media(max-width: 768px) {
    .hd-card { padding: 30px 20px; }
    .ex-header { flex-direction: column; gap: 10px; }
    .ex-num { font-size: 2.5rem; }
    .hd-title { font-size: 2.5rem; }
    .ret-badge { align-self: flex-start; }
  }
</style>

<div class="hikaye-page">
  <div class="hd-header">
    <div class="hd-content">
      <a href="/hikaye" class="hd-back"><i class="fa-solid fa-arrow-left"></i> Akademiye Dön</a>
      <h1 class="hd-title"><%= meta.h1 %></h1>
      <p class="hd-subtitle">Aşağıdaki adımları ve prensipleri sırayla inceleyerek sıradan bir anlatıcıdan, iz bırakan bir hikaye ustasına dönüşün.</p>
    </div>
  </div>

  <div class="hd-container">
    <% exercises.forEach((ex, i) => { %>
      <div class="hd-card">
        <div class="ex-header">
          <div class="ex-num"><%= ex.num %></div>
          <div class="ex-title-wrap">
            <h2 class="ex-title"><%= ex.title %></h2>
            <p class="ex-desc"><%= ex.desc %></p>
          </div>
          <span class="ret-badge <%= ex.badgeCls %>"><%= ex.badge %></span>
        </div>

        <% if (ex.benefits && ex.benefits.length > 0) { %>
          <div class="hd-section-title">🎯 Kazanımlar</div>
          <ul class="hd-list benefit-list">
            <% ex.benefits.forEach(ben => { %>
              <li><%= ben %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if (ex.mistakes && ex.mistakes.length > 0) { %>
          <div class="hd-section-title">⚠️ Sık Yapılan Hatalar</div>
          <ul class="hd-list mistake-list">
            <% ex.mistakes.forEach(mis => { %>
              <li><%= mis %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if (ex.tip) { %>
          <div class="hd-tip">
            <div class="hd-tip-icon">💡</div>
            <div class="hd-tip-text"><%= ex.tip %></div>
          </div>
        <% } %>

        <% if (ex.steps && ex.steps.length > 0) { %>
          <div class="hd-section-title">🛠️ Yapısal Araçlar ve Adımlar</div>
          <ul class="hd-list">
            <% ex.steps.forEach(step => { %>
              <li><%- step %></li>
            <% }) %>
          </ul>
        <% } %>

        <% if (ex.scenario) { %>
          <div class="hd-scenario">
            <div class="sb-label"><%= ex.scenario.label %></div>
            <div class="sb-text">"<%= ex.scenario.text %>"</div>
            <div class="sb-analysis"><strong>Analiz:</strong> <%= ex.scenario.analysis %></div>
          </div>
        <% } %>

        <% if (ex.practice) { %>
          <div class="hd-practice">
            <div class="pb-title">🎯 Saha Görevi (Pratik)</div>
            <div class="pb-text"><%= ex.practice %></div>
          </div>
        <% } %>

        <% if (ex.quiz) { %>
          <div class="hd-quiz" id="quiz-<%= ex.id %>">
            <div class="q-title">Refleks Testi</div>
            <div class="q-question"><%= ex.quiz.q %></div>
            <div class="q-opts">
              <% ex.quiz.opts.forEach((opt, optIdx) => { %>
                <button class="q-opt" onclick="checkQuiz('<%= ex.id %>', <%= optIdx %>, <%= ex.quiz.correct %>)"><%= opt %></button>
              <% }) %>
            </div>
            <div class="q-feedback" id="feedback-<%= ex.id %>"></div>
          </div>
          <script>
            window['quizData_<%= ex.id %>'] = {
              ok: <%- JSON.stringify(ex.quiz.ok) %>,
              fail: <%- JSON.stringify(ex.quiz.fail) %>
            };
          </script>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>

<script>
  function checkQuiz(quizId, selectedIdx, correctIdx) {
    const box = document.getElementById('quiz-' + quizId);
    const opts = box.querySelectorAll('.q-opt');
    const feedback = document.getElementById('feedback-' + quizId);
    const data = window['quizData_' + quizId];
    
    opts.forEach(btn => {
      btn.classList.remove('correct', 'wrong');
      btn.disabled = true;
      btn.style.cursor = 'default';
    });
    feedback.className = 'q-feedback';
    
    if (selectedIdx === correctIdx) {
      opts[selectedIdx].classList.add('correct');
      feedback.classList.add('success');
      feedback.innerHTML = '<strong>✅ DOĞRU:</strong><br><br>' + data.ok;
    } else {
      opts[selectedIdx].classList.add('wrong');
      opts[correctIdx].classList.add('correct');
      feedback.classList.add('error');
      feedback.innerHTML = '<strong>❌ YANLIŞ:</strong><br><br>' + data.fail;
    }
  }
</script>

<%- include('partials/main-footer') %>