<script>
  // ═══════════════ PARTICLE SYSTEM ═══════════════
  (function initParticles() {
    const field = document.getElementById('particleField');
    for (let i = 0; i < 30; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.animationDuration = (8 + Math.random() * 15) + 's';
      p.style.animationDelay = (Math.random() * 10) + 's';
      p.style.width = (2 + Math.random() * 3) + 'px';
      p.style.height = p.style.width;
      const colors = ['#c084fc', '#7c3aed', '#22d3ee', '#34d399', '#fbbf24'];
      p.style.background = colors[Math.floor(Math.random() * colors.length)];
      p.style.boxShadow = `0 0 8px ${p.style.background}`;
      field.appendChild(p);
    }
  })();

  // ═══════════════ CINEMA INTRO ═══════════════
  setTimeout(() => {
    document.getElementById('cinemaIntro').classList.add('hidden');
  }, 2800);

  // ═══════════════ GAME DATA ═══════════════
  const cases = [
    {
      title: "TV Tartışması",
      context: "Küresel Isınma ve Karbon Salınımı",
      dialogue: [
        { speaker: "Bilim İnsanı", side: "a", text: "Veriler gösteriyor ki, fosil yakıt tüketimini önümüzdeki 10 yıl içinde %30 azaltmazsak geri dönülemez bir eşiği geçeceğiz." },
        { speaker: "Sanayici", side: "b", text: 'Senin tuzun kuru tabii! <span class="fallacy-target">İnsanları işsiz bırakıp hepimizi mağaralara geri döndürmek istiyorsunuz!</span>' }
      ],
      question: "Sanayicinin kullandığı bu savunma mekanizması hangi safsatadır?",
      options: [
        { letter: "A", text: "Saman Adam (Strawman)", correct: true, fb: "Doğru! Bilim insanı '%30 azaltalım' dedi, sanayici ise bunu 'hepimizi mağaralara döndürmek' şeklinde uydurma ve abartılı bir pozisyona (saman adam) çevirerek ona saldırdı." },
        { letter: "B", text: "Otoriteye Başvurma", correct: false, fb: "Yanlış. Burada bir otorite veya uzmana atıf yapılmamıştır." },
        { letter: "C", text: "Yanlış Neden", correct: false, fb: "Yanlış. İki olayın art arda gelmesinden bahsedilmiyor." },
        { letter: "D", text: "Sürü Psikolojisi", correct: false, fb: "Yanlış. Çoğunluğun ne düşündüğüne dair bir argüman yok." }
      ]
    },
    {
      title: "Sosyal Medya Linci",
      context: "Yeni Moda Zayıflama Çayı",
      dialogue: [
        { speaker: "Diyetisyen", side: "a", text: "Bu çayın içindeki maddelerin karaciğere zarar verdiğine dair 3 yeni klinik araştırma yayınlandı." },
        { speaker: "Influencer", side: "b", text: 'Benim 2 milyon takipçim var ve <span class="fallacy-target">yüz binlerce insan bunu içip zayıfladı. Herkes memnunsak, o araştırmalar saçmalıktır.</span>' }
      ],
      question: "Influencer'ın argümanını çürüten safsata türü nedir?",
      options: [
        { letter: "A", text: "Kişiye Saldırı", correct: false, fb: "Yanlış. Influencer diyetisyenin şahsına hakaret etmiyor." },
        { letter: "B", text: "Kaygan Zemin", correct: false, fb: "Yanlış. Burada bir felaket senaryosu zinciri bulunmuyor." },
        { letter: "C", text: "Sürü Psikolojisi (Bandwagon)", correct: true, fb: "Mükemmel! Bir şeyin çok kişi tarafından yapılması (yüz binlerce insanın içmesi) o şeyin biyolojik veya bilimsel olarak doğru/sağlıklı olduğunu kanıtlamaz." },
        { letter: "D", text: "Kırmızı Ringa Balığı", correct: false, fb: "Yanlış. Konu hala zayıflama çayı, konu saptırılmıyor." }
      ]
    },
    {
      title: "Bütçe Toplantısı",
      context: "Okula Yeni Bilgisayar Laboratuvarı Kurulması",
      dialogue: [
        { speaker: "Veli", side: "a", text: "Çocukların kodlama öğrenmesi için yeni bilgisayarlara bütçe ayırmalıyız." },
        { speaker: "Müdür", side: "b", text: '<span class="fallacy-target">Ya okulun çatısını tamir ettiririz ya da bilgisayar alırız. İkisi birden olamaz,</span> çatı daha önemli!' }
      ],
      question: "Müdürün veliyi köşeye sıkıştırmak için kullandığı safsata hangisidir?",
      options: [
        { letter: "A", text: "Sahte İkilem (False Dilemma)", correct: true, fb: "Harika! Müdür durumu sadece 2 seçenek varmış gibi sunuyor. Oysa bütçe bölünebilir, bağış toplanabilir veya farklı kaynaklar bulunabilir." },
        { letter: "B", text: "Saman Adam", correct: false, fb: "Yanlış. Velinin argümanı çarpıtılmamıştır." },
        { letter: "C", text: "Kaygan Zemin", correct: false, fb: "Yanlış. Geleceğe dair bir felaket senaryosu yok." },
        { letter: "D", text: "Otoriteye Başvurma", correct: false, fb: "Yanlış. Herhangi bir sahte otoriteden bahsedilmiyor." }
      ]
    },
    {
      title: "Ofis Dedikodusu",
      context: "Şirketteki Yeni Güvenlik Kuralları",
      dialogue: [
        { speaker: "Çalışan A", side: "a", text: "İnternet kısıtlamaları işimizi çok yavaşlatıyor, kaynaklara erişemiyoruz." },
        { speaker: "İK Müdürü", side: "b", text: '<span class="fallacy-target">Eğer interneti serbest bırakırsak, herkes işte oyun oynar, verim düşer, şirket batar ve hepimiz işsiz kalırız!</span>' }
      ],
      question: "İK Müdürünün kullandığı korkutma taktiği hangi safsatadır?",
      options: [
        { letter: "A", text: "Kırmızı Ringa Balığı", correct: false, fb: "Yanlış. Konu internet erişimi, alakasız bir konu açılmadı." },
        { letter: "B", text: "Kaygan Zemin (Slippery Slope)", correct: true, fb: "Tebrikler! Ufak bir kısıtlama kaldırma eylemi, kanıtsız bir şekilde 'şirketin batması' gibi uç bir felaket senaryosuna (domino taşı gibi) bağlanmıştır." },
        { letter: "C", text: "Kişiye Saldırı", correct: false, fb: "Yanlış. Çalışana hakaret edilmedi." },
        { letter: "D", text: "Sahte İkilem", correct: false, fb: "Yanlış. İki zıt seçenek dayatılmadı." }
      ]
    }
  ];

  let currentLevel = 0;
  let score = 0;
  let streak = 0;
  let maxStreak = 0;
  let correctCount = 0;

  // ═══════════════ LOAD LEVEL ═══════════════
  function loadLevel() {
    if (currentLevel >= cases.length) {
      showVictory();
      return;
    }

    const c = cases[currentLevel];

    // HUD
    document.getElementById('hudLevel').textContent = `${currentLevel + 1} / ${cases.length}`;
    document.getElementById('hudProgressFill').style.width = `${((currentLevel) / cases.length) * 100}%`;

    // Case Header
    document.getElementById('caseNumber').innerHTML = `Dosya No: ${String(currentLevel + 1).padStart(3, '0')}`;
    document.getElementById('caseName').textContent = c.title;
    document.getElementById('caseContext').innerHTML = `<span>📋</span><span>${c.context}</span>`;

    // Dialogue
    const dStage = document.getElementById('dialogueStage');
    dStage.innerHTML = '';
    c.dialogue.forEach((d, i) => {
      const card = document.createElement('div');
      card.className = `msg-card speaker-${d.side}`;
      card.style.animationDelay = `${0.1 + i * 0.3}s`;
      card.innerHTML = `
        <div class="msg-dot"></div>
        <div class="msg-speaker">${d.speaker}</div>
        <div class="msg-bubble">${d.text}</div>
      `;
      dStage.appendChild(card);
    });

    // Question
    document.getElementById('questionText').innerHTML = c.question;

    // Options
    const grid = document.getElementById('optionsGrid');
    grid.innerHTML = '';
    c.options.forEach(o => {
      const card = document.createElement('div');
      card.className = 'opt-card';
      card.innerHTML = `
        <div class="opt-letter">${o.letter}</div>
        <div class="opt-text">${o.text}</div>
      `;
      card.onclick = () => selectAnswer(card, o, c.options);
      grid.appendChild(card);
    });

    // Reset feedback
    const fb = document.getElementById('feedbackPanel');
    fb.style.display = 'none';
    fb.className = 'feedback-panel';
  }

  // ═══════════════ SELECT ANSWER ═══════════════
  function selectAnswer(card, opt, allOpts) {
    const allCards = document.querySelectorAll('.opt-card');
    allCards.forEach(c => c.classList.add('disabled'));

    const fb = document.getElementById('feedbackPanel');
    fb.style.display = 'block';

    if (opt.correct) {
      card.classList.add('correct');
      fb.classList.add('success');
      document.getElementById('fbIcon').textContent = '🏆';
      document.getElementById('fbTitleText').textContent = 'Harika Tespit!';
      
      // Score
      score += 100;
      streak++;
      correctCount++;
      if (streak > maxStreak) maxStreak = streak;

      // Bonus for streak
      if (streak >= 3) {
        score += 50;
        document.getElementById('fbTitleText').textContent = `🔥 ${streak}x Seri Bonusu! Harika Tespit!`;
      }

      showScorePopup(`+${streak >= 3 ? 150 : 100}`, true);
      
    } else {
      card.classList.add('wrong');
      fb.classList.add('error');
      document.getElementById('fbIcon').textContent = '❌';
      document.getElementById('fbTitleText').textContent = 'Yanlış Analiz';
      streak = 0;

      // Highlight correct
      const correctOpt = allOpts.find(o => o.correct);
      allCards.forEach(c => {
        if (c.querySelector('.opt-text').textContent === correctOpt.text) {
          c.classList.remove('disabled');
          c.classList.add('correct');
        }
      });

      showScorePopup('✕', false);
    }

    document.getElementById('fbBody').textContent = opt.fb;
    document.getElementById('hudScore').textContent = score;
    document.getElementById('hudStreak').textContent = streak;
  }

  // ═══════════════ SCORE POPUP ═══════════════
  function showScorePopup(text, isCorrect) {
    const popup = document.getElementById('scorePopup');
    popup.textContent = text;
    popup.className = `score-popup ${isCorrect ? 'correct-pop' : 'wrong-pop'} show`;
    setTimeout(() => {
      popup.classList.remove('show');
    }, 900);
  }

  // ═══════════════ NEXT LEVEL ═══════════════
  function nextLevel() {
    currentLevel++;

    if (currentLevel >= cases.length) {
      showVictory();
      return;
    }

    // Scene transition
    const st = document.getElementById('sceneTransition');
    document.getElementById('stText').textContent = `Dosya #${String(currentLevel + 1).padStart(3, '0')} yükleniyor…`;
    st.classList.add('active');

    setTimeout(() => {
      loadLevel();
    }, 500);

    setTimeout(() => {
      st.classList.remove('active');
    }, 1000);
  }

  // ═══════════════ VICTORY ═══════════════
  function showVictory() {
    document.getElementById('gameStage').style.display = 'none';
    document.getElementById('hudProgressFill').style.width = '100%';
    
    const vs = document.getElementById('victoryScreen');
    vs.style.display = 'block';
    vs.style.animation = 'fadeSlideUp 0.8s ease forwards';

    document.getElementById('finalScore').textContent = score;
    document.getElementById('finalCorrect').textContent = `${correctCount}/${cases.length}`;
    document.getElementById('finalStreak').textContent = maxStreak;
  }

  // ═══════════════ INIT ═══════════════
  loadLevel();

</script>

