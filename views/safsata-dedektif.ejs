<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; overflow-x: hidden; }
  .det-container { padding: 40px 20px; max-width: 1000px; margin: 0 auto; min-height: 85vh; display: flex; flex-direction: column; align-items: center; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; text-align: center; }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 40px; text-align: center; max-width: 600px; }

  /* Game Area */
  .game-board { width: 100%; max-width: 800px; background: #1e293b; border-radius: 20px; border: 1px solid #334155; position: relative; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.5); display: flex; flex-direction: column; }
  
  /* Top HUD */
  .hud { background: #0f172a; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; }
  .hud-level { font-size: 0.9rem; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; }
  .hud-score { font-size: 1.2rem; font-weight: 900; color: #10b981; }

  /* Case File */
  .case-area { padding: 40px 30px; background: #1e293b; flex-grow: 1; }
  .case-title { font-size: 1.5rem; font-weight: 800; color: #f8fafc; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
  .case-context { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 10px; font-size: 0.9rem; color: #94a3b8; margin-bottom: 30px; border-left: 3px solid #64748b; }
  
  /* Dialogue Box */
  .dialogue { display: flex; flex-direction: column; gap: 15px; margin-bottom: 40px; }
  .msg { padding: 15px 20px; border-radius: 15px; max-width: 85%; line-height: 1.5; font-size: 1.05rem; }
  .msg-a { background: #334155; color: #e2e8f0; align-self: flex-start; border-bottom-left-radius: 0; }
  .msg-b { background: #0284c7; color: #ffffff; align-self: flex-end; border-bottom-right-radius: 0; box-shadow: 0 5px 15px rgba(2, 132, 199, 0.3); }
  .msg-b span.target { background: rgba(255,255,255,0.2); padding: 2px 5px; border-radius: 4px; font-weight: 700; border-bottom: 2px dashed #facc15; }
  
  .speaker { font-size: 0.75rem; font-weight: 800; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; }

  /* Question Area */
  .q-area { padding: 30px; background: #0f172a; border-top: 1px solid #334155; }
  .q-text { font-size: 1.1rem; font-weight: 700; color: #e2e8f0; margin-bottom: 20px; text-align: center; }
  
  .opts-grid { display: grid; grid-template-columns: 1fr; gap: 15px; }
  @media (min-width: 600px) { .opts-grid { grid-template-columns: 1fr 1fr; } }
  
  .opt-btn { background: #1e293b; border: 2px solid #334155; padding: 15px; border-radius: 12px; color: #cbd5e1; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.2s; }
  .opt-btn:hover:not(:disabled) { background: #334155; border-color: #64748b; transform: translateY(-2px); }
  .opt-btn.correct { background: rgba(16, 185, 129, 0.1); border-color: #10b981; color: #10b981; }
  .opt-btn.wrong { background: rgba(244, 63, 94, 0.1); border-color: #f43f5e; color: #f43f5e; }
  .opt-btn:disabled { cursor: not-allowed; opacity: 0.7; }

  /* Feedback overlay */
  .feedback-box { margin-top: 20px; padding: 20px; border-radius: 12px; font-size: 0.95rem; line-height: 1.6; display: none; animation: fadeIn 0.5s forwards; }
  .feedback-box.success { background: rgba(16, 185, 129, 0.1); border: 1px solid #10b981; color: #a7f3d0; }
  .feedback-box.error { background: rgba(244, 63, 94, 0.1); border: 1px solid #f43f5e; color: #fecdd3; }

  .next-btn { background: #38bdf8; color: #0f172a; border: none; padding: 12px 25px; border-radius: 8px; font-weight: 800; text-transform: uppercase; cursor: pointer; margin-top: 15px; display: inline-block; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .game-over { text-align: center; padding: 50px; display: none; }
  .go-icon { font-size: 4rem; margin-bottom: 20px; }
</style>

<div class="det-container">
  <h1>Safsata Dedektifi</h1>
  <p class="desc">Diyaloglar arasına gizlenmiş mantık hatalarını bulun. Karşı tarafın hileli zihin oyunlarını çökerterek puan kazanın.</p>

  <div class="game-board" id="gameBoard">
    <div class="hud">
      <div class="hud-level" id="hudLevel">Vaka 1 / 4</div>
      <div class="hud-score">Skor: <span id="scoreVal">0</span></div>
    </div>

    <div class="case-area">
      <div class="case-title" id="cTitle">Vaka #1: TV Tartışması</div>
      <div class="case-context" id="cContext">Konu: Küresel Isınma ve Karbon Salınımı</div>
      
      <div class="dialogue" id="cDialogue">
        <!-- Injected -->
      </div>
    </div>

    <div class="q-area">
      <div class="q-text" id="qText">Kırmızı ile işaretli kısımda yapılan safsata nedir?</div>
      <div class="opts-grid" id="qOpts">
        <!-- Injected -->
      </div>
      
      <div class="feedback-box" id="feedbackBox">
        <div id="fbText"></div>
        <button class="next-btn" id="btnNext" onclick="nextLevel()">Sıradaki Vaka ➔</button>
      </div>
    </div>
  </div>

  <div class="game-board game-over" id="gameOver">
    <div class="go-icon">🏆</div>
    <h2 style="font-size:2.5rem; color:#10b981; margin:0 0 10px 0;">Görev Tamamlandı!</h2>
    <p style="color:#94a3b8; font-size:1.1rem; margin-bottom:30px;">Tüm vakaları başarıyla analiz ettiniz. Artık kimse sizi ucuz mantık oyunlarıyla kandıramaz.</p>
    <a href="/safsata/kalkan" style="background:#38bdf8; color:#0f172a; padding:15px 30px; border-radius:12px; text-decoration:none; font-weight:800;">Sıradaki Eğitime Geç: Zihinsel Kalkan</a>
  </div>

</div>

<script>
  const cases = [
    {
      title: "Vaka #1: TV Tartışması",
      context: "Konu: Küresel Isınma ve Karbon Salınımı",
      dialogue: [
        { speaker: "Bilim İnsanı", class: "msg-a", text: "Veriler gösteriyor ki, fosil yakıt tüketimini önümüzdeki 10 yıl içinde %30 azaltmazsak geri dönülemez bir eşiği geçeceğiz." },
        { speaker: "Sanayici", class: "msg-b", text: "Senin tuzun kuru tabii! <span class='target'>İnsanları işsiz bırakıp hepimizi mağaralara geri döndürmek istiyorsunuz!</span>" }
      ],
      question: "Sanayicinin kullandığı bu savunma mekanizması hangi safsatadır?",
      options: [
        { id: "o1", text: "Saman Adam (Strawman)", correct: true, fb: "Doğru! Bilim insanı '%30 azaltalım' dedi, sanayici ise bunu 'hepimizi mağaralara döndürmek' şeklinde uydurma ve abartılı bir pozisyona (saman adam) çevirerek ona saldırdı." },
        { id: "o2", text: "Otoriteye Başvurma", correct: false, fb: "Yanlış. Burada bir otorite veya uzmana atıf yapılmamıştır." },
        { id: "o3", text: "Yanlış Neden", correct: false, fb: "Yanlış. İki olayın art arda gelmesinden bahsedilmiyor." },
        { id: "o4", text: "Sürü Psikolojisi", correct: false, fb: "Yanlış. Çoğunluğun ne düşündüğüne dair bir argüman yok." }
      ]
    },
    {
      title: "Vaka #2: Sosyal Medya Linci",
      context: "Konu: Yeni Moda Zayıflama Çayı",
      dialogue: [
        { speaker: "Diyetisyen", class: "msg-a", text: "Bu çayın içindeki maddelerin karaciğere zarar verdiğine dair 3 yeni klinik araştırma yayınlandı." },
        { speaker: "Influencer", class: "msg-b", text: "Benim 2 milyon takipçim var ve <span class='target'>yüz binlerce insan bunu içip zayıfladı. Herkes memnunsak, o araştırmalar saçmalıktır.</span>" }
      ],
      question: "Influencer'ın argümanını çürüten safsata türü nedir?",
      options: [
        { id: "o1", text: "Kişiye Saldırı", correct: false, fb: "Yanlış. Influencer diyetisyenin şahsına hakaret etmiyor." },
        { id: "o2", text: "Kaygan Zemin", correct: false, fb: "Yanlış. Burada bir felaket senaryosu zinciri bulunmuyor." },
        { id: "o3", text: "Sürü Psikolojisi (Bandwagon)", correct: true, fb: "Mükemmel! Bir şeyin çok kişi tarafından yapılması (yüz binlerce insanın içmesi) o şeyin biyolojik veya bilimsel olarak doğru/sağlıklı olduğunu kanıtlamaz." },
        { id: "o4", text: "Kırmızı Ringa Balığı", correct: false, fb: "Yanlış. Konu hala zayıflama çayı, konu saptırılmıyor." }
      ]
    },
    {
      title: "Vaka #3: Bütçe Toplantısı",
      context: "Konu: Okula Yeni Bilgisayar Laboratuvarı Kurulması",
      dialogue: [
        { speaker: "Veli", class: "msg-a", text: "Çocukların kodlama öğrenmesi için yeni bilgisayarlara bütçe ayırmalıyız." },
        { speaker: "Müdür", class: "msg-b", text: "<span class='target'>Ya okulun çatısını tamir ettiririz ya da bilgisayar alırız. İkisi birden olamaz,</span> çatı daha önemli!" }
      ],
      question: "Müdürün veliyi köşeye sıkıştırmak için kullandığı safsata hangisidir?",
      options: [
        { id: "o1", text: "Sahte İkilem (False Dilemma)", correct: true, fb: "Harika! Müdür durumu sadece 2 seçenek varmış gibi sunuyor. Oysa bütçe bölünebilir, bağış toplanabilir veya farklı kaynaklar bulunabilir." },
        { id: "o2", text: "Saman Adam", correct: false, fb: "Yanlış. Velinin argümanı çarpıtılmamıştır." },
        { id: "o3", text: "Kaygan Zemin", correct: false, fb: "Yanlış. Geleceğe dair bir felaket senaryosu yok." },
        { id: "o4", text: "Otoriteye Başvurma", correct: false, fb: "Yanlış. Herhangi bir sahte otoriteden bahsedilmiyor." }
      ]
    },
    {
      title: "Vaka #4: Ofis Dedikodusu",
      context: "Konu: Şirketteki Yeni Güvenlik Kuralları",
      dialogue: [
        { speaker: "Çalışan A", class: "msg-a", text: "İnternet kısıtlamaları işimizi çok yavaşlatıyor, kaynaklara erişemiyoruz." },
        { speaker: "İK Müdürü", class: "msg-b", text: "<span class='target'>Eğer interneti serbest bırakırsak, herkes işte oyun oynar, verim düşer, şirket batar ve hepimiz işsiz kalırız!</span>" }
      ],
      question: "İK Müdürünün kullandığı korkutma taktiği hangi safsatadır?",
      options: [
        { id: "o1", text: "Kırmızı Ringa Balığı", correct: false, fb: "Yanlış. Konu internet erişimi, alakasız bir konu açılmadı." },
        { id: "o2", text: "Kaygan Zemin (Slippery Slope)", correct: true, fb: "Tebrikler! Ufak bir kısıtlama kaldırma eylemi, kanıtsız bir şekilde 'şirketin batması' gibi uç bir felaket senaryosuna (domino taşı gibi) bağlanmıştır." },
        { id: "o3", text: "Kişiye Saldırı", correct: false, fb: "Yanlış. Çalışana hakaret edilmedi." },
        { id: "o4", text: "Sahte İkilem", correct: false, fb: "Yanlış. İki zıt seçenek dayatılmadı." }
      ]
    }
  ];

  let currentLevel = 0;
  let score = 0;

  function loadLevel() {
    if (currentLevel >= cases.length) {
      document.getElementById('gameBoard').style.display = 'none';
      document.getElementById('gameOver').style.display = 'block';
      return;
    }

    const c = cases[currentLevel];
    document.getElementById('hudLevel').textContent = `Vaka ${currentLevel + 1} / ${cases.length}`;
    document.getElementById('cTitle').textContent = c.title;
    document.getElementById('cContext').textContent = c.context;
    
    // Render Dialogue
    const dCont = document.getElementById('cDialogue');
    dCont.innerHTML = '';
    c.dialogue.forEach(d => {
      dCont.innerHTML += `
        <div class="msg ${d.class}">
          <div class="speaker">${d.speaker}</div>
          ${d.text}
        </div>
      `;
    });

    document.getElementById('qText').innerHTML = c.question;

    // Render Options
    const qOpts = document.getElementById('qOpts');
    qOpts.innerHTML = '';
    c.options.forEach(o => {
      const btn = document.createElement('button');
      btn.className = 'opt-btn';
      btn.textContent = o.text;
      btn.onclick = () => selectOption(btn, o, c.options);
      qOpts.appendChild(btn);
    });

    const fbBox = document.getElementById('feedbackBox');
    fbBox.style.display = 'none';
    fbBox.className = 'feedback-box';
  }

  function selectOption(btn, opt, allOpts) {
    // Disable all
    const buttons = document.getElementById('qOpts').querySelectorAll('.opt-btn');
    buttons.forEach(b => b.disabled = true);

    const fbBox = document.getElementById('feedbackBox');
    const fbText = document.getElementById('fbText');

    fbBox.style.display = 'block';

    if (opt.correct) {
      btn.classList.add('correct');
      fbBox.classList.add('success');
      fbText.innerHTML = `<strong>🏆 Harika Tespit!</strong><br>${opt.fb}`;
      score += 100;
      document.getElementById('scoreVal').textContent = score;
    } else {
      btn.classList.add('wrong');
      fbBox.classList.add('error');
      fbText.innerHTML = `<strong>❌ Yanlış Analiz.</strong><br>${opt.fb}`;
      
      // Highlight correct one
      const correctOpt = allOpts.find(o => o.correct);
      const correctBtn = Array.from(buttons).find(b => b.textContent === correctOpt.text);
      correctBtn.style.borderColor = '#10b981';
      correctBtn.style.color = '#10b981';
    }
  }

  function nextLevel() {
    currentLevel++;
    loadLevel();
  }

  // Init
  loadLevel();

</script>

<%- include('partials/main-footer') %>
