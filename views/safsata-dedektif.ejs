<%- include('partials/main-header') %>

<style>
  

  /* ═══════════════════════════════════════════════════════════
     SAFSATA DEDEKTİFİ — Surrealist Competition Grade Design
     ═══════════════════════════════════════════════════════════ */

  :root {
    --det-bg: #0a0a14;
    --det-surface: #131320;
    --det-glass: #131320;
    --det-border: rgba(120, 80, 255, 0.15);
    --det-glow: #7c3aed;
    --det-glow2: #c084fc;
    --det-cyan: #22d3ee;
    --det-amber: #fbbf24;
    --det-emerald: #34d399;
    --det-rose: #fb7185;
    --det-text: #f1f5f9;
    --det-text2: #cbd5e1;
    --det-text3: #94a3b8;
    --noise: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
  }

  body { background: #0a0a14 !important; color: #f1f5f9 !important; font-family: "Inter", sans-serif; overflow-x: hidden; margin: 0; padding: 0; }

  /* ── Cosmic Background ── */
  .cosmic-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .cosmic-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 60% at 20% 10%, rgba(124, 58, 237, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 90%, rgba(34, 211, 238, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 50% 50%, rgba(251, 191, 36, 0.04) 0%, transparent 50%);
    animation: cosmicPulse 12s ease-in-out infinite alternate;
  }
  .cosmic-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--noise);
    background-size: 256px 256px;
    opacity: 0.6;
  }

  @keyframes cosmicPulse {
    0% { opacity: 0.7; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.05); }
  }

  /* ── Floating Particles ── */
  .particle-field {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--det-glow2);
    border-radius: 50%;
    opacity: 0;
    animation: particleFloat linear infinite;
    box-shadow: 0 0 6px var(--det-glow2);
  }
  @keyframes particleFloat {
    0% { opacity: 0; transform: translateY(100vh) scale(0); }
    10% { opacity: 0.8; }
    90% { opacity: 0.4; }
    100% { opacity: 0; transform: translateY(-10vh) scale(1); }
  }

  /* ── Scanning Lines (CRT Effect) ── */
  .scan-lines {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255,255,255,0.008) 2px,
      rgba(255,255,255,0.008) 4px
    );
  }

  /* ══════════════════════════════════
     MAIN CONTAINER
     ══════════════════════════════════ */
  .det-world {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 20px 60px;
  }

  /* ── Cinematic Intro Overlay ── */
  .cinema-intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #050510;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 1s ease, visibility 1s ease;
  }
  .cinema-intro.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .cinema-badge {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: var(--det-glow2);
    opacity: 0;
    animation: typeReveal 0.8s ease forwards;
    animation-delay: 0.3s;
    margin-bottom: 20px;
  }
  .cinema-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4rem;
    font-weight: 900;
    color: transparent;
    background: linear-gradient(135deg, #c084fc, #7c3aed, #22d3ee);
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
    animation: titleGlitch 1.2s ease forwards;
    animation-delay: 0.8s;
    text-align: center;
    line-height: 1.1;
  }
  .cinema-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: var(--det-text2);
    opacity: 0;
    animation: fadeSlideUp 0.8s ease forwards;
    animation-delay: 1.6s;
    margin-top: 15px;
  }
  .cinema-line {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--det-glow), transparent);
    opacity: 0;
    animation: lineExpand 1s ease forwards;
    animation-delay: 2.2s;
    margin-top: 25px;
  }

  @keyframes typeReveal {
    from { opacity: 0; transform: translateY(10px); letter-spacing: 12px; }
    to { opacity: 1; transform: translateY(0); letter-spacing: 6px; }
  }
  @keyframes titleGlitch {
    0% { opacity: 0; transform: scale(0.8) translateY(20px); filter: blur(10px); }
    60% { opacity: 1; transform: scale(1.02) translateY(-3px); filter: blur(0); }
    80% { transform: scale(0.99) translateY(1px) skewX(-1deg); }
    100% { opacity: 1; transform: scale(1) translateY(0) skewX(0); }
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes lineExpand {
    from { opacity: 0; width: 0; }
    to { opacity: 1; width: 120px; }
  }

  /* ══════════════════════════════════
     HEADER SECTION
     ══════════════════════════════════ */
  .det-header {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
    opacity: 0;
    animation: fadeSlideUp 1s ease forwards;
    animation-delay: 3s;
  }
  .det-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    border-radius: 50px;
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--det-glow2);
    margin-bottom: 20px;
    backdrop-filter: blur(10px);
  }
  .det-header-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--det-emerald);
    box-shadow: 0 0 10px var(--det-emerald);
    animation: livePulse 2s ease-in-out infinite;
  }
  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  .det-hero-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.1;
    margin: 0 0 15px;
    color: transparent;
    background: linear-gradient(135deg, #e0d4ff, #c084fc, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .det-hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: var(--det-text2);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ══════════════════════════════════
     HUD BAR (Score + Level + Timer)
     ══════════════════════════════════ */
  .hud-bar {
    width: 100%;
    max-width: 960px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 30px;
    padding: 16px 28px;
    background: var(--det-glass);
    backdrop-filter: blur(20px);
    border: 1px solid var(--det-border);
    border-radius: 20px;
    box-shadow: 
      0 8px 32px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(255,255,255,0.04);
    opacity: 0;
    animation: fadeSlideUp 0.8s ease forwards;
    animation-delay: 3.2s;
  }
  .hud-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hud-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }
  .hud-icon.level { background: rgba(124, 58, 237, 0.15); color: var(--det-glow2); }
  .hud-icon.score { background: rgba(52, 211, 153, 0.15); color: var(--det-emerald); }
  .hud-icon.streak { background: rgba(251, 191, 36, 0.15); color: var(--det-amber); }
  .hud-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--det-text3);
    font-weight: 700;
  }
  .hud-value {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--det-text);
  }
  .hud-value.glow-score {
    color: var(--det-emerald);
    text-shadow: 0 0 15px rgba(52, 211, 153, 0.4);
  }

  /* Progress Bar */
  .hud-progress {
    flex: 1;
    max-width: 200px;
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
  }
  .hud-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--det-glow), var(--det-cyan));
    border-radius: 10px;
    transition: width 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 0 10px var(--det-glow);
    position: relative;
  }
  .hud-progress-fill::after {
    content: '';
    position: absolute;
    right: 0;
    top: -2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 15px var(--det-cyan), 0 0 30px var(--det-glow);
  }

  /* ══════════════════════════════════
     MAIN GAME BOARD
     ══════════════════════════════════ */
  .game-stage {
    width: 100%;
    max-width: 960px;
    opacity: 0;
    animation: fadeSlideUp 1s ease forwards;
    animation-delay: 3.4s;
  }

  /* ── Case File Card ── */
  .case-file {
    background: var(--det-glass);
    backdrop-filter: blur(30px);
    border: 1px solid var(--det-border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 
      0 30px 80px rgba(0,0,0,0.5),
      0 0 0 1px rgba(255,255,255,0.03),
      inset 0 1px 0 rgba(255,255,255,0.05);
    position: relative;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .case-file::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--det-glow), var(--det-cyan), transparent);
    border-radius: 2px;
    z-index: 5;
  }

  /* Case Header */
  .case-header {
    padding: 30px 35px 25px;
    background: linear-gradient(180deg, rgba(124, 58, 237, 0.06) 0%, transparent 100%);
    border-bottom: 1px solid var(--det-border);
    position: relative;
  }
  .case-number {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--det-glow2);
    opacity: 0.7;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .case-number::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--det-border), transparent);
  }
  .case-name {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--det-text);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .case-context-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.15);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.8rem;
    color: var(--det-cyan);
    font-weight: 600;
  }

  /* ── Dialogue Area ── */
  .dialogue-stage {
    padding: 35px;
    position: relative;
  }
  .dialogue-stage::before {
    content: '';
    position: absolute;
    left: 35px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--det-border), transparent);
  }

  /* Message Bubbles */
  .msg-card {
    position: relative;
    padding-left: 40px;
    margin-bottom: 28px;
    opacity: 0;
    animation: msgAppear 0.6s ease forwards;
  }
  .msg-card:nth-child(1) { animation-delay: 0.1s; }
  .msg-card:nth-child(2) { animation-delay: 0.4s; }
  .msg-card:nth-child(3) { animation-delay: 0.7s; }

  @keyframes msgAppear {
    from { opacity: 0; transform: translateX(-15px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .msg-dot {
    position: absolute;
    left: -5px;
    top: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid;
    background: var(--det-bg);
    z-index: 2;
  }
  .msg-card.speaker-a .msg-dot { border-color: var(--det-cyan); box-shadow: 0 0 12px rgba(34, 211, 238, 0.3); }
  .msg-card.speaker-b .msg-dot { border-color: var(--det-rose); box-shadow: 0 0 12px rgba(251, 113, 133, 0.3); }

  .msg-speaker {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
    font-weight: 700;
  }
  .msg-card.speaker-a .msg-speaker { color: var(--det-cyan); }
  .msg-card.speaker-b .msg-speaker { color: var(--det-rose); }

  .msg-bubble {
    padding: 20px 24px;
    border-radius: 16px;
    font-size: 1.05rem;
    line-height: 1.7;
    position: relative;
  }
  .msg-card.speaker-a .msg-bubble {
    background: rgba(34, 211, 238, 0.04);
    border: 1px solid rgba(34, 211, 238, 0.12);
    color: var(--det-text);
  }
  .msg-card.speaker-b .msg-bubble {
    background: rgba(251, 113, 133, 0.04);
    border: 1px solid rgba(251, 113, 133, 0.12);
    color: var(--det-text);
  }

  /* Target Highlight - The fallacy */
  .fallacy-target {
    position: relative;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(251, 113, 133, 0.15));
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 700;
    border-bottom: 2px solid var(--det-amber);
    cursor: default;
    transition: all 0.3s;
  }
  .fallacy-target:hover {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.25), rgba(251, 113, 133, 0.25));
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.15);
  }
  .fallacy-target::before {
    content: '⚠';
    position: absolute;
    top: -18px;
    left: 5px;
    font-size: 0.7rem;
    animation: warningPulse 2s ease-in-out infinite;
  }
  @keyframes warningPulse {
    0%, 100% { opacity: 0.5; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-3px); }
  }

  /* ── Question Zone ── */
  .question-zone {
    padding: 35px;
    background: linear-gradient(0deg, rgba(124, 58, 237, 0.04), transparent);
    border-top: 1px solid var(--det-border);
    position: relative;
  }

  .q-prompt {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 28px;
  }
  .q-prompt-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--det-glow), #9333ea);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: 0 8px 25px rgba(124, 58, 237, 0.3);
  }
  .q-prompt-text {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--det-text);
    line-height: 1.5;
    padding-top: 6px;
  }

  /* Options Grid */
  .options-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .options-grid { grid-template-columns: 1fr 1fr; }
  }

  .opt-card {
    position: relative;
    padding: 18px 22px;
    border-radius: 16px;
    border: 1px solid var(--det-border);
    background: rgba(255,255,255,0.02);
    color: var(--det-text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 14px;
    backdrop-filter: blur(5px);
  }
  .opt-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .opt-card:hover:not(.disabled) {
    border-color: var(--det-glow2);
    transform: translateY(-3px) scale(1.01);
    box-shadow: 
      0 15px 40px rgba(124, 58, 237, 0.15),
      0 0 0 1px rgba(192, 132, 252, 0.2);
    background: rgba(124, 58, 237, 0.06);
  }
  .opt-letter {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--det-glow2);
    flex-shrink: 0;
    transition: all 0.3s;
  }

  /* States */
  .opt-card.correct {
    border-color: var(--det-emerald) !important;
    background: rgba(52, 211, 153, 0.08) !important;
    box-shadow: 0 0 40px rgba(52, 211, 153, 0.15), 0 15px 50px rgba(52, 211, 153, 0.1);
    transform: scale(1.02);
  }
  .opt-card.correct .opt-letter {
    background: var(--det-emerald);
    border-color: var(--det-emerald);
    color: #050510;
  }
  .opt-card.wrong {
    border-color: var(--det-rose) !important;
    background: rgba(251, 113, 133, 0.06) !important;
    box-shadow: 0 0 20px rgba(251, 113, 133, 0.1);
  }
  .opt-card.wrong .opt-letter {
    background: var(--det-rose);
    border-color: var(--det-rose);
    color: #050510;
  }
  .opt-card.disabled {
    cursor: not-allowed;
    opacity: 0.45;
    pointer-events: none;
  }
  .opt-card.disabled.correct,
  .opt-card.disabled.wrong {
    opacity: 1;
    pointer-events: none;
  }

  /* ── Feedback Panel ── */
  .feedback-panel {
    margin-top: 25px;
    padding: 25px 28px;
    border-radius: 18px;
    display: none;
    animation: feedbackReveal 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    position: relative;
    overflow: hidden;
  }
  .feedback-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
  }
  .feedback-panel.success {
    background: rgba(52, 211, 153, 0.06);
    border: 1px solid rgba(52, 211, 153, 0.2);
  }
  .feedback-panel.success::before { background: linear-gradient(90deg, var(--det-emerald), #22d3ee); }
  .feedback-panel.error {
    background: rgba(251, 113, 133, 0.06);
    border: 1px solid rgba(251, 113, 133, 0.2);
  }
  .feedback-panel.error::before { background: linear-gradient(90deg, var(--det-rose), var(--det-amber)); }

  @keyframes feedbackReveal {
    from { opacity: 0; transform: translateY(15px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .fb-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .fb-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
  }
  .feedback-panel.success .fb-icon { background: rgba(52, 211, 153, 0.15); }
  .feedback-panel.error .fb-icon { background: rgba(251, 113, 133, 0.15); }

  .fb-title-text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 800;
  }
  .feedback-panel.success .fb-title-text { color: var(--det-emerald); }
  .feedback-panel.error .fb-title-text { color: var(--det-rose); }

  .fb-body { background: #0a0a14 !important; color: #f1f5f9 !important; font-family: "Inter", sans-serif; overflow-x: hidden; margin: 0; padding: 0; }

  /* ── Next Button ── */
  .next-action {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 14px 32px;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--det-glow), #9333ea);
    color: #f1f5f9;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(124, 58, 237, 0.3);
    position: relative;
    overflow: hidden;
  }
  .next-action::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent, rgba(255,255,255,0.15), transparent);
    transform: translateX(-100%);
    transition: transform 0.5s;
  }
  .next-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(124, 58, 237, 0.4);
  }
  .next-action:hover::before {
    transform: translateX(100%);
  }

  /* ══════════════════════════════════
     GAME OVER SCREEN
     ══════════════════════════════════ */
  .victory-screen {
    display: none;
    width: 100%;
    max-width: 700px;
    text-align: center;
    padding: 60px 40px;
    background: var(--det-glass);
    backdrop-filter: blur(30px);
    border: 1px solid var(--det-border);
