  .pair-words { font-size:1.3rem; font-weight:700; color:#fff; margin-bottom:6px; }
  .pair-words .s-w { color:#06b6d4; }
  .pair-words .ss-w { color:#a855f7; }
  .pair-explain { font-size:.8rem; color:#64748b; display:none; }
  .pair-card.revealed .pair-explain { display:block; }

  /* ���� Tekerleme ������������������������������ */
  .teker-text { font-size:1.2rem; font-weight:600; color:#e2e8f0; line-height:2; text-align:center; padding:20px; border-radius:16px; background:rgba(255,255,255,.03); margin:16px 0; }
  .s-mark { color:#06b6d4; font-weight:900; text-decoration:underline; text-underline-offset:4px; }
  .ss-mark { color:#a855f7; font-weight:900; text-decoration:underline; text-underline-offset:4px; }

  /* ���� Speed Chrono �������������������������� */
  .chrono-display { font-size:4rem; font-weight:900; font-variant-numeric:tabular-nums; color:#fff; margin:16px 0; }
  .chrono-display .ms { font-size:2rem; color:#64748b; }
  .chrono-controls { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
  .chrono-btn { padding:12px 28px; border-radius:12px; font-size:.9rem; font-weight:700; border:none; cursor:pointer; transition:all .3s; }
  .chrono-start { background:linear-gradient(135deg,#10b981,#059669); color:#fff; }
  .chrono-stop { background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; }
  .chrono-reset { background:rgba(255,255,255,.06); color:#94a3b8; border:1px solid rgba(255,255,255,.1); }
  .chrono-btn:hover { transform:translateY(-2px); }

  /* ���� Weekly Plan ���������������������������� */
  .week-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:8px; }
  @media(max-width:700px) { .week-grid { grid-template-columns:repeat(4,1fr); } }
  .day-card { padding:16px 8px; border-radius:14px; text-align:center; background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.06); cursor:pointer; transition:all .3s; }
  .day-card:hover { background:rgba(255,255,255,.07); }
  .day-card.done { background:rgba(16,185,129,.1); border-color:#10b981; }
  .day-num { font-size:.7rem; color:#64748b; text-transform:uppercase; font-weight:700; letter-spacing:1px; }
  .day-icon { font-size:1.5rem; margin:6px 0; }
  .day-task { font-size:.72rem; color:#94a3b8; line-height:1.4; }

  /* ���� Back Button ���������������������������� */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); color:#94a3b8; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(255,255,255,.1); color:#fff; transform:translateX(-4px); }

  /* ���� Scroll Reveal ������������������������ */
  .reveal { opacity:0; transform:translateY(30px); transition:all .6s cubic-bezier(.16,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

