<style>
  body { background: #0a0a14; color: #f1f5f9; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ���� Hero �������������������������������������������� */
  .sh-hero {
    min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 110px 24px 60px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 80% 60% at 50% 30%, #6366f122, transparent 70%);
  }
  .sh-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:120px; background:linear-gradient(to top,#0a0a14,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: sFloat 6s ease-in-out infinite; }
  @keyframes sFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.3; } 50%{ transform:translateY(-35px) scale(1.3); opacity:.7; } }

  .sh-icons { font-size: 5rem; margin-bottom: 10px; animation: sPulse 3s ease-in-out infinite; }
  .sh-icons .vs { font-size: 2rem; color: #64748b; margin: 0 8px; vertical-align: middle; }
  @keyframes sPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.05); } }

  .sh-badge { display:inline-flex; align-items:center; gap:8px; padding:6px 20px; border-radius:30px; font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:3px; color:#818cf8; background:#6366f118; border:1px solid #6366f144; margin-bottom:16px; }
  .sh-title { font-size:clamp(2.2rem,5vw,3.5rem); font-weight:900; color:#fff; margin-bottom:8px; line-height:1.1; }
  .sh-title .s-col { background:linear-gradient(135deg,#06b6d4,#22d3ee); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .sh-title .ss-col { background:linear-gradient(135deg,#a855f7,#c084fc); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .sh-subtitle { color:#94a3b8; font-size:1.05rem; max-width:620px; line-height:1.7; }

  /* ���� Container �������������������������������� */
  .sh-wrap { max-width:960px; margin:0 auto; padding:0 20px 80px; }

  /* ���� Glass Cards ���������������������������� */
  .glass { background:rgba(255,255,255,.03); backdrop-filter:blur(16px); border:1px solid rgba(255,255,255,.06); border-radius:20px; padding:32px; margin-bottom:32px; transition:transform .35s,box-shadow .35s; }
  .glass:hover { transform:translateY(-4px); box-shadow:0 20px 60px rgba(0,0,0,.3),0 0 30px #6366f111; }
  .section-label { font-size:.75rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color:#818cf8; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
  .section-label::before { content:''; width:16px; height:2px; background:#818cf8; border-radius:2px; }

  /* ���� Dual Anatomy ������������������������ */
  .dual-anatomy { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin:20px 0; }
  @media(max-width:700px) { .dual-anatomy { grid-template-columns:1fr; } }
  .anatomy-card { padding:24px; border-radius:18px; text-align:center; position:relative; overflow:hidden; }
  .anatomy-s { background:linear-gradient(135deg,#06b6d411,#06b6d405); border:2px solid #06b6d433; }
  .anatomy-ss { background:linear-gradient(135deg,#a855f711,#a855f705); border:2px solid #a855f733; }
  .anatomy-card h3 { font-size:2.5rem; font-weight:900; margin-bottom:8px; }
  .anatomy-s h3 { color:#06b6d4; }
  .anatomy-ss h3 { color:#a855f7; }
  .anatomy-card p { font-size:.9rem; color:#94a3b8; line-height:1.6; }
  .anatomy-card .pos { font-size:.85rem; color:#cbd5e1; margin-top:10px; padding:10px; background:rgba(255,255,255,.04); border-radius:10px; }

  .anatomy-card svg { width:180px; height:120px; margin:12px auto; display:block; }
  .tongue-s { fill:#06b6d4; }
  .tongue-ss { fill:#a855f7; }

  /* ���� Reflex Game ���������������������������� */
  .reflex-arena { background:linear-gradient(135deg,#0f0a1a,#0f172a); border:2px solid #6366f133; border-radius:24px; padding:40px; text-align:center; position:relative; overflow:hidden; min-height:300px; }
  .reflex-arena::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at 50% 50%,#6366f108,transparent 60%); pointer-events: none; }

  .reflex-word { font-size:3.5rem; font-weight:900; color:#fff; letter-spacing:4px; margin:30px 0 20px; position:relative; z-index:1; min-height:60px; }
  .reflex-score { display:flex; justify-content:center; gap:40px; margin-bottom:20px; }
  .reflex-stat { text-align:center; }
  .reflex-stat .num { font-size:2rem; font-weight:900; }
  .reflex-stat .lbl { font-size:.75rem; color:#64748b; text-transform:uppercase; letter-spacing:1px; }
  .correct .num { color:#10b981; }
  .wrong .num { color:#ef4444; }
  .streak .num { color:#f59e0b; }

  .reflex-btns { display:flex; gap:16px; justify-content:center; margin-top:16px; }
  .reflex-btn { padding:16px 48px; border-radius:16px; font-size:1.5rem; font-weight:900; border:none; cursor:pointer; transition:all .2s; letter-spacing:3px; }
  .reflex-btn:hover { transform:translateY(-3px); }
  .reflex-btn:active { transform:scale(.95); }
  .btn-s { background:linear-gradient(135deg,#06b6d4,#0891b2); color:#fff; box-shadow:0 6px 24px #06b6d444; }
  .btn-ss { background:linear-gradient(135deg,#a855f7,#9333ea); color:#fff; box-shadow:0 6px 24px #a855f744; }

  .reflex-feedback { font-size:1.2rem; font-weight:700; min-height:32px; margin-top:12px; }
  .fb-correct { color:#10b981; }
  .fb-wrong { color:#ef4444; }

  .reflex-start-btn { padding:16px 40px; border-radius:16px; background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; font-size:1.1rem; font-weight:700; border:none; cursor:pointer; transition:all .3s; box-shadow:0 4px 20px #6366f144; }
  .reflex-start-btn:hover { transform:translateY(-2px); box-shadow:0 8px 30px #6366f166; }

  /* ���� Minimal Pairs ���������������������� */
  .pair-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:14px; }
  .pair-card { padding:18px; border-radius:14px; background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.06); text-align:center; cursor:pointer; transition:all .3s; }
