<%- include('partials/main-header') %>

<style>
  /* 📊 Presentation Design Light Theme 📊 */
  body { background: #eff6ff; color: #1e3a8a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 📊 Hero Section 📊 */
  .pr-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #dbeafe 0%, #eff6ff 80%);
  }
  .pr-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#eff6ff,transparent); }

  /* Tech Keynote Background */
  .pr-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; }
  .grid-floor { position:absolute; bottom:0; left:0; width:100%; height:50%; background-image: linear-gradient(#2563eb 1px, transparent 1px), linear-gradient(90deg, #2563eb 1px, transparent 1px); background-size: 50px 50px; transform: perspective(500px) rotateX(60deg); opacity: 0.1; animation: gridAdvance 10s linear infinite; }
  @keyframes gridAdvance { 0% { background-position: 0 0; } 100% { background-position: 0 50px; } }

  .pr-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: floatScreen 4s ease-in-out infinite; filter: drop-shadow(0 15px 25px rgba(37,99,235,0.3)); }
  @keyframes floatScreen { 0%,100%{ transform:translateY(0) scale(1); } 50%{ transform:translateY(-15px) scale(1.05); } }

  .pr-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #2563eb; background: #dbeafe; border:1px solid #bfdbfe; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(37,99,235,0.15); }
  .pr-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #1e3a8a; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .pr-title span { background: linear-gradient(135deg, #3b82f6, #2563eb); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .pr-subtitle { color: #1d4ed8; font-size:1.2rem; max-width:750px; line-height:1.8; z-index:2; position:relative; font-weight: 500; }

  /* 📊 Container 📊 */
  .pr-wrap { max-width:1100px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 📊 Premium Cards 📊 */
  .pr-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(37, 99, 235, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .pr-card:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(37, 99, 235, 0.1); border-color: rgba(37, 99, 235, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #2563eb; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* 📊 Data Storytelling Converter 📊 */
  .data-box { background: #1e3a8a; border-radius: 24px; padding: 40px; color: white; display: grid; grid-template-columns: 1fr; gap: 30px; }
  .data-intro { font-size: 1.05rem; color: #bfdbfe; line-height: 1.6; }
  
  .data-bad { padding: 25px; background: rgba(255,255,255,0.05); border-left: 4px solid #ef4444; border-radius: 0 16px 16px 0; }
  .db-title { font-weight: 800; color: #fca5a5; margin-bottom: 10px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
  .db-text { font-size: 1.2rem; font-family: monospace; color: #fee2e2; }

  .data-opts { display: grid; grid-template-columns: 1fr; gap: 15px; }
  .d-opt { padding: 20px; background: rgba(0,0,0,0.3); border: 2px solid rgba(255,255,255,0.1); border-radius: 12px; cursor: pointer; transition: all 0.2s; font-size: 1.1rem; color: #eff6ff; line-height: 1.5; }
  .d-opt:hover { border-color: #60a5fa; background: rgba(59,130,246,0.1); }
  .d-opt.correct { background: #166534; border-color: #22c55e; }
  .d-opt.wrong { background: #7f1d1d; border-color: #ef4444; }
  
  .data-feedback { min-height: 50px; font-weight: 600; font-size: 1.1rem; line-height: 1.5; color: #93c5fd; }

  /* 📊 Pecha Kucha 20x20 Simulator 📊 */
  .pk-box { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 24px; padding: 40px; text-align: center; }
  .pk-intro { color: #166534; line-height: 1.6; font-size: 1.05rem; margin-bottom: 30px; }
  
  .pk-screen { width: 100%; max-width: 600px; height: 350px; margin: 0 auto 30px; background: #000; border-radius: 16px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
  .pk-image { width: 100%; height: 100%; object-fit: cover; opacity: 0.5; transition: opacity 0.5s; }
  
  .pk-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 2; }
  .pk-slide-num { font-size: 1.5rem; font-weight: 800; color: white; background: rgba(0,0,0,0.5); padding: 5px 15px; border-radius: 20px; margin-bottom: 10px; }
  .pk-timer { font-size: 6rem; font-weight: 900; color: white; text-shadow: 0 4px 20px rgba(0,0,0,0.5); font-variant-numeric: tabular-nums; }
  
  .pk-progress { position: absolute; bottom: 0; left: 0; height: 8px; background: #22c55e; width: 0%; transition: width 1s linear; }

  .pk-btn { padding: 15px 40px; background: #16a34a; color: white; border: none; border-radius: 40px; font-weight: 800; font-size: 1.2rem; cursor: pointer; transition: all 0.3s; box-shadow: 0 8px 15px rgba(22,163,74,0.3); }
  .pk-btn:hover { background: #15803d; transform: translateY(-3px); }
  .pk-btn.stop { background: #ef4444; box-shadow: 0 8px 15px rgba(239,68,68,0.3); display: none; }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #bfdbfe; color:#2563eb; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#dbeafe; color:#1d4ed8; transform:translateX(-4px); border-color: #93c5fd; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="pr-hero">
  <div class="pr-bg"><div class="grid-floor"></div></div>
  <div class="pr-icon">📊</div>
  <div class="pr-badge">Sunum Tasarım Atölyesi</div>
  <h1 class="pr-title">Sunum <span>Tasarımı</span></h1>
  <p class="pr-subtitle">Slaytlarınız not defteriniz değildir, seyirciye verdiğiniz görsel uyarandır. Veri hikayeleştirme (Data Storytelling) ve Steve Jobs tarzı minimalizmle unutulmaz sahneler yaratın.</p>
</section>

<div class="pr-wrap">
  <a href="/diksiyon?cat=sunum" class="back-btn">← Tüm Sunum Tasarım İlkelerini Gör (25 Madde)</a>

  <!-- 📊 DATA STORYTELLING 📊 -->
  <div class="pr-card reveal" style="background:#1e3a8a; border:none;">
    <div class="section-label" style="color:#93c5fd;">📈 Data Storytelling (Veri Hikayeleştirme)</div>
    
    <div class="data-box">
      <div class="data-intro">
        İnsanlar rakamları hatırlamaz, rakamların onlara ne hissettirdiğini (hikayesini) hatırlar. Slaytınıza devasa bir pasta grafik koyup okumak, seyirciyi sıkar. <strong>Göreviniz:</strong> Aşağıdaki sıkıcı kurumsal veriyi, duygusal ve akılda kalıcı bir "Hikaye Cümlesine" dönüştüren seçeneği bulmak.
      </div>
      
      <div class="data-bad">
        <div class="db-title">❌ SIKICI SLAYT METNİ:</div>
        <div class="db-text">"2023 Q3 raporlarına göre, ürünümüzün kullanım oranı %400 artmış olup, günlük aktif kullanıcı sayısı 2.4 milyona ulaşarak 10.000 saatlik zaman tasarrufu sağlamıştır."</div>
      </div>
      
      <div class="data-opts" id="dOpts">
        <div class="d-opt" onclick="checkData(this, false, 'Yanlış. Bu sadece verilerin biraz daha kısa yazılmış hali. Hala sıkıcı ve akılda kalmıyor.')">A) Q3'te %400 büyüdük. 2.4 Milyon kullanıcıya ulaştık ve 10.000 saat tasarruf ettik.</div>
        <div class="d-opt" onclick="checkData(this, true, 'Doğru! (Data Storytelling). 2.4 milyon, %400 gibi karmaşık verileri attınız. İnsanların anlayabileceği tek bir metafora (10.000 saat = Her gün 1 yıl) dönüştürdünüz. Steve Jobs bunu sürekli yapardı.')">B) Ürünümüz öylesine hızla büyüdü ki, bugün sadece 1 gün içinde müşterilerimize toplam '1 Yıllık' boş zaman hediye etmiş olduk.</div>
        <div class="d-opt" onclick="checkData(this, false, 'Yanlış. Bu kurumsal bir pazarlama sloganı, veri hikayeleştirme değil. Rakamın ağırlığı tamamen kayboldu.')">C) Geleceğin teknolojisiyle zamanınızı geri veriyoruz. Bizi seçtiğiniz için 2.4 milyon kişiye teşekkürler.</div>
      </div>
      
      <div class="data-feedback" id="dBack"></div>
    </div>
  </div>

  <!-- 📊 PECHA KUCHA SIMULATOR 📊 -->
  <div class="pr-card reveal">
    <div class="section-label">⏱️ Pecha Kucha (20x20) Simülatörü</div>
    
    <div class="pk-box">
      <div class="pk-intro">
        <strong>Pecha Kucha</strong>, Japonya'dan çıkan bir sunum formatıdır. Slaytınızda 20 görsel vardır. Her görsel ekranda tam <strong>20 saniye</strong> kalır ve <strong>otomatik olarak</strong> bir sonrakine geçer. Geri dönemezsiniz, slaytı durduramazsınız. Tam 6 dakika 40 saniye boyunca akışa ayak uydurmak zorundasınız.<br><br>
        <em>Aşağıdaki "Başla" butonuna basın ve rastgele bir konu (örn: Tatil Anınız) anlatmaya başlayın. Slaytlar (renkler) her 20 saniyede bir merhametsizce değişecek!</em>
      </div>
      
      <div class="pk-screen" id="pkScreen">
        <div class="pk-overlay">
          <div class="pk-slide-num" id="pkNum">Slayt 1 / 20</div>
          <div class="pk-timer" id="pkTime">20</div>
        </div>
        <div class="pk-progress" id="pkProg"></div>
      </div>
      
      <button class="pk-btn" id="pkStart" onclick="startPk()">Sunuma Başla 🎤</button>
      <button class="pk-btn stop" id="pkStop" onclick="stopPk()">Durdur 🛑</button>
    </div>
  </div>

</div>

<script>
// 📊 Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 📊 Data Storytelling Logic
function checkData(btn, isCorrect, exp) {
  const btns = document.getElementById('dOpts').querySelectorAll('.d-opt');
  btns.forEach(b => b.style.pointerEvents = 'none');
  
  const fb = document.getElementById('dBack');
  if(isCorrect) {
    btn.classList.add('correct');
    fb.innerHTML = `✅ ${exp}`;
    fb.style.color = '#4ade80';
  } else {
    btn.classList.add('wrong');
    btns[1].style.borderColor = '#4ade80'; 
    fb.innerHTML = `❌ ${exp}`;
    fb.style.color = '#f87171';
  }
}

// 📊 Pecha Kucha Timer
let pkInterval;
let pkTimeLeft = 20;
let pkSlide = 1;
const colors = ["#ef4444", "#f97316", "#eab308", "#22c55e", "#06b6d4", "#3b82f6", "#8b5cf6", "#d946ef", "#f43f5e", "#14b8a6"];

function startPk() {
  document.getElementById('pkStart').style.display = 'none';
  document.getElementById('pkStop').style.display = 'inline-block';
  
  pkSlide = 1;
  pkTimeLeft = 20;
  updatePkUI();
  
  clearInterval(pkInterval);
  pkInterval = setInterval(() => {
    pkTimeLeft--;
    
    // Progress bar (0 to 100% over 20s)
    const pct = ((20 - pkTimeLeft) / 20) * 100;
    document.getElementById('pkProg').style.width = pct + '%';
    
    document.getElementById('pkTime').innerText = pkTimeLeft;
    
    if(pkTimeLeft <= 0) {
      pkSlide++;
      if(pkSlide > 20) {
        stopPk();
        document.getElementById('pkNum').innerText = "TEBRİKLER! BİTTİ.";
        return;
      }
      pkTimeLeft = 20;
      updatePkUI();
    }
  }, 1000);
}

function updatePkUI() {
  document.getElementById('pkTime').innerText = pkTimeLeft;
  document.getElementById('pkNum').innerText = `Slayt ${pkSlide} / 20`;
  document.getElementById('pkScreen').style.backgroundColor = colors[(pkSlide-1) % colors.length];
  document.getElementById('pkProg').style.width = '0%';
}

function stopPk() {
  clearInterval(pkInterval);
  document.getElementById('pkStart').style.display = 'inline-block';
  document.getElementById('pkStart').innerText = 'Tekrar Dene 🔄';
  document.getElementById('pkStop').style.display = 'none';
  document.getElementById('pkTime').innerText = '--';
  document.getElementById('pkProg').style.width = '0%';
}
</script>

<%- include('partials/main-footer') %>
