<%- include('partials/main-header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');

  body { background: #f8fafc !important; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; margin: 0; padding: 0; }
  .vucut-container { display: flex; flex-direction: column; lg:flex-row; gap: 40px; padding: 40px 20px; max-width: 1400px; margin: 0 auto; min-height: 85vh; }
  
  .panel-left { flex: 1; max-width: 500px; }
  .panel-right { flex: 1.5; display: flex; justify-content: center; align-items: center; position: relative; }
  
  h1 { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 800; margin-bottom: 10px; color: #1e3a8a; line-height: 1.1; }
  p.desc { font-family: 'Outfit', sans-serif; color: #64748b; font-size: 1.1rem; line-height: 1.6; margin-bottom: 40px; }

  /* Controls */
  .control-group { margin-bottom: 40px; background: #ffffff; padding: 30px; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
  .c-label { font-family: 'Outfit', sans-serif; font-size: 0.9rem; font-weight: 800; color: #2563eb; text-transform: uppercase; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; letter-spacing: 1px; }
  .c-label::before { content: ''; display: inline-block; width: 8px; height: 8px; background: #2563eb; border-radius: 50%; }
  
  .btn-row { display: flex; flex-direction: column; gap: 12px; }
  .c-btn { background: #f8fafc; color: #475569; border: 1px solid #e2e8f0; padding: 18px 24px; border-radius: 16px; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 1.05rem; display: flex; align-items: center; justify-content: space-between; }
  .c-btn:hover { background: #eff6ff; border-color: #bfdbfe; color: #1e3a8a; transform: translateX(5px); }
  .c-btn.active { background: #1e3a8a; border-color: #1e3a8a; color: #ffffff; box-shadow: 0 10px 20px rgba(30, 58, 138, 0.2); }
  .c-btn.active::after { content: '✓'; font-weight: 800; }

  /* Right Panel: Lookbook Visualizer */
  .visual-box { background: #ffffff; border-radius: 32px; width: 100%; height: 750px; position: relative; box-shadow: 0 20px 50px rgba(30, 58, 138, 0.08); border: 1px solid #e2e8f0; overflow: hidden; display: flex; justify-content: center; align-items: flex-end; }
  
  .look-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; opacity: 0; transition: opacity 0.8s ease; }
  .look-img.active { opacity: 1; }

  /* SVG Overlay for drawing illusion lines */
  .svg-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
  .illusion-line { stroke: #fbbf24; stroke-width: 3; stroke-dasharray: 6, 6; fill: none; opacity: 0; transition: opacity 0.4s; }
  .illusion-line.show { opacity: 1; animation: dash 2s linear infinite; }
  
  @keyframes dash { to { stroke-dashoffset: -24; } }

  /* Analysis Card Overlay */
  .analysis-card { position: absolute; bottom: 30px; right: 30px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); padding: 25px 30px; border-radius: 20px; border-left: 5px solid #2563eb; max-width: 320px; box-shadow: 0 15px 40px rgba(0,0,0,0.1); opacity: 0; transform: translateY(30px); transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); z-index: 20; }
  .analysis-card.show { opacity: 1; transform: translateY(0); }
  .an-title { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: #1e3a8a; margin: 0 0 10px 0; font-weight: 800; }
  .an-text { font-family: 'Outfit', sans-serif; font-size: 0.95rem; color: #475569; line-height: 1.6; margin: 0; }

  /* Toggle Switches for Illusions */
  .toggle-row { display: flex; align-items: center; justify-content: space-between; padding: 20px; background: #f8fafc; border-radius: 16px; margin-bottom: 12px; border: 1px solid #e2e8f0; cursor: pointer; transition: all 0.3s; }
  .toggle-row:hover { border-color: #bfdbfe; background: #eff6ff; }
  .toggle-text h4 { font-family: 'Outfit', sans-serif; margin: 0 0 5px 0; color: #1e3a8a; font-size: 1.1rem; font-weight: 700; }
  .toggle-text p { font-family: 'Outfit', sans-serif; margin: 0; color: #64748b; font-size: 0.85rem; line-height: 1.4; max-width: 250px; }
  
  .switch { position: relative; display: inline-block; width: 54px; height: 28px; flex-shrink: 0; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #cbd5e1; transition: .4s; border-radius: 34px; }
  .slider:before { position: absolute; content: ""; height: 20px; width: 20px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
  input:checked + .slider { background-color: #2563eb; }
  input:checked + .slider:before { transform: translateX(26px); }

  @media (min-width: 1024px) {
    .vucut-container { flex-direction: row; }
  }
</style>

<div class="vucut-container">
  
  <!-- Left: Controls -->
  <div class="panel-left">
    <h1>Optik İllüzyon Lab</h1>
    <p class="desc">Giyim, gözü yönlendirme sanatıdır. Kusurları gizlemek için değil, dikkati en güçlü yönlerinize çekmek için oranları "hacklemeyi" öğrenin.</p>

    <!-- Body Shape -->
    <div class="control-group">
      <span class="c-label">Vücut Tipi Seçimi</span>
      <div class="btn-row">
        <div class="c-btn active" onclick="setBodyShape('classic')" id="btn-classic">Standart & Atletik Profil</div>
        <div class="c-btn" onclick="setBodyShape('oval')" id="btn-oval">Oval (Göbekli) Profil</div>
        <div class="c-btn" onclick="setBodyShape('triangle')" id="btn-triangle">Dar Omuz & Geniş Basen</div>
      </div>
    </div>

    <!-- Illusions -->
    <div class="control-group" id="illusions-container">
      <span class="c-label">İmaj Stratejileri</span>
      
      <label class="toggle-row illusion-toggle" data-target="classic" style="display:none;">
        <div class="toggle-text">
          <h4>Mükemmel Kalıp (Fit)</h4>
          <p>Potluk yapmayan kesim, otorite ve disiplin mesajı verir.</p>
        </div>
        <div class="switch">
          <input type="checkbox" id="chk-fit" onchange="toggleIllusion('fit')">
          <span class="slider"></span>
        </div>
      </label>

      <label class="toggle-row illusion-toggle" data-target="oval" style="display:none;">
        <div class="toggle-text">
          <h4>Dikey Çizgiler (Pinstripe)</h4>
          <p>Gözü yukarıdan aşağıya çekerek göbeği gizler, boyu uzatır.</p>
        </div>
        <div class="switch">
          <input type="checkbox" id="chk-cizgi" onchange="toggleIllusion('cizgi')">
          <span class="slider"></span>
        </div>
      </label>
      
      <label class="toggle-row illusion-toggle" data-target="oval" style="display:none;">
        <div class="toggle-text">
          <h4>Açık Ceket Sütunu</h4>
          <p>Karnı ikiye bölerek ortada ince uzun bir sütun yaratır.</p>
        </div>
        <div class="switch">
          <input type="checkbox" id="chk-ceket" onchange="toggleIllusion('ceket')">
          <span class="slider"></span>
        </div>
      </label>

      <label class="toggle-row illusion-toggle" data-target="triangle" style="display:none;">
        <div class="toggle-text">
          <h4>Kruvaze (Double-Breasted)</h4>
          <p>Yatay çizgiler ve düğmeler ile omuz/göğüs genişliğini artırır.</p>
        </div>
        <div class="switch">
          <input type="checkbox" id="chk-kruvaze" onchange="toggleIllusion('kruvaze')">
          <span class="slider"></span>
        </div>
      </label>

      <label class="toggle-row illusion-toggle" data-target="triangle" style="display:none;">
        <div class="toggle-text">
          <h4>Geniş Yaka (Peak Lapel)</h4>
          <p>Yukarı bakan geniş yakalar, omuzları olduğundan geniş gösterir.</p>
        </div>
        <div class="switch">
          <input type="checkbox" id="chk-yaka" onchange="toggleIllusion('yaka')">
          <span class="slider"></span>
        </div>
      </label>

    </div>

  </div>

  <!-- Right: Lookbook Visualizer -->
  <div class="panel-right">
    <div class="visual-box">
      
      <img src="/images/vucut-tipi/classic.png" class="look-img" id="img-classic" alt="Klasik Takım">
      <img src="/images/vucut-tipi/oval.png" class="look-img" id="img-oval" alt="Dikey Çizgili Takım">
      <img src="/images/vucut-tipi/triangle.png" class="look-img" id="img-triangle" alt="Kruvaze Takım">

      <!-- Interactive Overlay Graphics -->
      <svg class="svg-overlay" id="svg-overlay">
        <!-- Lines for Oval -->
        <line x1="50%" y1="20%" x2="50%" y2="80%" class="illusion-line" id="line-cizgi" />
        <rect x="35%" y="40%" width="30%" height="40%" class="illusion-line" id="rect-ceket" />
        
        <!-- Lines for Triangle -->
        <path d="M 30% 25% L 70% 25% L 50% 50% Z" class="illusion-line" id="poly-kruvaze" />
        <path d="M 40% 30% L 20% 15% M 60% 30% L 80% 15%" class="illusion-line" id="line-yaka" />

        <!-- Lines for Classic -->
        <circle cx="50%" cy="50%" r="50" class="illusion-line" id="circle-fit" />
      </svg>

      <!-- Dynamic Analysis Card -->
      <div class="analysis-card" id="anCard">
        <h3 class="an-title" id="anTitle">Analiz</h3>
        <p class="an-text" id="anText">Detay</p>
      </div>

    </div>
  </div>

</div>

<script>
  let currentShape = 'classic';

  const analyses = {
    'fit': { title: 'Mükemmel Oturuş', text: 'Giysinin omuz dikişleri tam omuz kemiğinde bitiyor, belde hafifçe daralıyor. Bu "terzi elinden çıkmış" görünüm, karşınızdaki kişiye detaylara önem veren, disiplinli biri olduğunuz sinyalini verir.' },
    'cizgi': { title: 'Dikey Yönlendirme', text: 'Göz doğası gereği çizgileri takip eder. Pinstripe (ince dik çizgili) desenler, gözü yatay eksenden dikey eksene çeker. Bu optik illüzyon kişiyi anında 5 kilo daha zayıf ve 5 cm daha uzun gösterir.' },
    'ceket': { title: 'İç Sütun Etkisi', text: 'Koyu renk bir ceket önü açık bırakıldığında, göbeğin üstünden geçen beyaz gömlek "ince ve uzun" bir iç sütun (column of color) oluşturur. Genişlik hissi karanlık bölgede kaybolur.' },
    'kruvaze': { title: 'Genişletici Yatay Algı', text: 'Kruvaze ceketlerin üst üste binen yapısı ve paralel düğmeleri, gözü yatay olarak hareket etmeye zorlar. Bu yatay hareket, dar omuzları ve göğsü matematiksel olarak genişletir.' },
    'yaka': { title: 'Peak Lapel (Sivri Yaka)', text: 'Omuza doğru bir "ok" gibi yukarıyı işaret eden geniş sivri yakalar (Peak Lapel), izleyicinin gözünü doğrudan omuz uçlarına yönlendirerek çok daha atletik bir "T" vücut illüzyonu yaratır.' }
  };

  function setBodyShape(shape) {
    currentShape = shape;
    
    // Update Buttons
    document.querySelectorAll('.c-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-' + shape).classList.add('active');

    // Update Images
    document.querySelectorAll('.look-img').forEach(img => img.classList.remove('active'));
    document.getElementById('img-' + shape).classList.add('active');

    // Hide all toggles & lines
    document.querySelectorAll('.illusion-toggle').forEach(t => t.style.display = 'none');
    document.querySelectorAll('input[type="checkbox"]').forEach(c => c.checked = false);
    document.querySelectorAll('.illusion-line').forEach(l => l.classList.remove('show'));
    
    // Hide Analysis Card
    document.getElementById('anCard').classList.remove('show');

    // Show toggles specific to this shape
    document.querySelectorAll(`.illusion-toggle[data-target="${shape}"]`).forEach(t => {
      t.style.display = 'flex';
    });
  }

  function toggleIllusion(id) {
    const isChecked = document.getElementById(`chk-${id}`).checked;
    
    // Turn off all other lines and checkboxes first (exclusive view)
    document.querySelectorAll('input[type="checkbox"]').forEach(c => {
      if(c.id !== `chk-${id}`) c.checked = false;
    });
    document.querySelectorAll('.illusion-line').forEach(l => l.classList.remove('show'));

    if(isChecked) {
      // Show line
      const lineObj = document.getElementById(`line-${id}`) || document.getElementById(`rect-${id}`) || document.getElementById(`poly-${id}`) || document.getElementById(`circle-${id}`);
      if(lineObj) lineObj.classList.add('show');

      // Show Card
      document.getElementById('anTitle').innerText = analyses[id].title;
      document.getElementById('anText').innerText = analyses[id].text;
      document.getElementById('anCard').classList.add('show');
    } else {
      document.getElementById('anCard').classList.remove('show');
    }
  }

  // Initialize
  window.onload = () => {
    setBodyShape('classic');
  };

</script>

<%- include('partials/main-footer') %>
