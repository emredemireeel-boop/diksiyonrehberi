<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .r-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
  
  .instruction-panel { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.15); padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 40px; z-index: 10; backdrop-filter: blur(10px); transition: all 0.3s; }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #b45309; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #64748b; margin: 0; max-width: 600px; line-height: 1.5; }

  .rulet-box { background: #0f172a; color: #f8fafc; padding: 40px; border-radius: 24px; font-size: 2.2rem; font-weight: 800; text-align: center; max-width: 900px; width: 90%; min-height: 150px; display: flex; align-items: center; justify-content: center; line-height: 1.4; box-shadow: 0 20px 50px rgba(0,0,0,0.1); border: 4px solid #f59e0b; margin-bottom: 40px; transition: transform 0.1s; }
  
  .timer-display { font-size: 3rem; font-weight: 900; color: #b45309; font-variant-numeric: tabular-nums; margin-bottom: 20px; text-shadow: 0 0 20px rgba(180, 83, 9, 0.2); }
  .counter-display { font-size: 1.2rem; font-weight: 700; color: #64748b; margin-bottom: 30px; letter-spacing: 2px; text-transform: uppercase; }

  .controls { display: flex; gap: 20px; }
  .btn-control {
    background: #f59e0b; color: #ffffff; border: none; padding: 18px 40px; border-radius: 30px;
    font-size: 1.2rem; font-weight: 900; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 10px 20px rgba(245, 158, 11, 0.2);
  }
  .btn-control:hover { background: #d97706; transform: translateY(-2px); box-shadow: 0 15px 30px rgba(245, 158, 11, 0.3); }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(15,23,42,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #0f172a; }

  /* Confetti effect placeholder */
  .result-screen { display: none; flex-direction: column; align-items: center; justify-content: center; position: absolute; inset: 0; background: #0f172a; z-index: 20; }
  .result-title { font-size: 4rem; font-weight: 900; color: #10b981; margin-bottom: 20px; }
  .result-score { font-size: 2rem; color: #ffffff; margin-bottom: 40px; }

</style>

<a href="/sahne" class="btn-back">← Sahne'ye Dön</a>

<div class="r-container">
  
  <div class="instruction-panel" id="instructionPanel">
    <h1 class="instruction-title">Artikülasyon Ruleti</h1>
    <p class="instruction-desc">Sahne öncesi dilinizi ve dudaklarınızı ısıtmak için hız testi. Başla butonuna bastığınızda ekrana art arda 5 zorlu tekerleme gelecek. Hata yapmadan en hızlı sürede okuyup "Geç" butonuna basın.</p>
  </div>

  <div class="timer-display" id="timer">00.00</div>
  <div class="counter-display" id="counter">Hazır mısın?</div>

  <div class="rulet-box" id="ruletBox">
    Başlamak için aşağıdaki butona basın.
  </div>

  <div class="controls">
    <button class="btn-control" id="btnAction" onclick="handleAction()">Başla</button>
  </div>

</div>

<div class="result-screen" id="resultScreen">
  <div class="result-title">Tebrikler!</div>
  <div class="result-score" id="resultScore">Toplam Süre: 14.5 sn</div>
  <button class="btn-control" onclick="location.reload()" style="background:#10b981; color:#ffffff; box-shadow:0 10px 20px rgba(16,185,129,0.3)">Tekrar Oyna</button>
</div>

<script>
  const TEKERLEMELER = [
    "Şu köşe yaz köşesi, şu köşe kış köşesi, ortada su şişesi.",
    "Kırk küp, kırkının da kulpu kırık küp.",
    "Bir berber bir berbere bre berber gel beraber bir berber dükkanı açalım demiş.",
    "Dal sarkar kartal kalkar, kartal kalkar dal sarkar.",
    "Al bu takatukaları takatukacıya takatukalatmaya götür.",
    "İşimizi kışa bıraktık, kışın işimizi dışa bıraktık.",
    "Üç tunç tas has kayısı hoşafı.",
    "Beş keşiş keşişen beş keşiyle kesişti."
  ];

  let gameTeckers = [];
  let currentIdx = 0;
  let startTime = 0;
  let timerInterval = null;
  let isRunning = false;

  const ruletBox = document.getElementById('ruletBox');
  const timerEl = document.getElementById('timer');
  const counterEl = document.getElementById('counter');
  const btnAction = document.getElementById('btnAction');
  const instructionPanel = document.getElementById('instructionPanel');
  const resultScreen = document.getElementById('resultScreen');
  const resultScore = document.getElementById('resultScore');

  function shuffle(array) {
    let currentIndex = array.length, randomIndex;
    while (currentIndex != 0) {
      randomIndex = Math.floor(Math.random() * currentIndex);
      currentIndex--;
      [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
    }
    return array;
  }

  function updateTimer() {
    const now = Date.now();
    const diff = (now - startTime) / 1000;
    timerEl.textContent = diff.toFixed(2);
  }

  function handleAction() {
    if (!isRunning) {
      // Start Game
      isRunning = true;
      instructionPanel.style.display = 'none';
      btnAction.textContent = 'Okudum, Geç! ➔';
      
      // select 5 random
      gameTeckers = shuffle([...TEKERLEMELER]).slice(0, 5);
      currentIdx = 0;
      
      startTime = Date.now();
      timerInterval = setInterval(updateTimer, 50); // fast update
      showNext();
    } else {
      // Next Tecker
      ruletBox.style.transform = 'scale(0.95)';
      setTimeout(() => { ruletBox.style.transform = 'scale(1)'; }, 100);
      
      currentIdx++;
      if (currentIdx >= gameTeckers.length) {
        endGame();
      } else {
        showNext();
      }
    }
  }

  function showNext() {
    ruletBox.textContent = gameTeckers[currentIdx];
    counterEl.textContent = `Tekerleme: ${currentIdx + 1} / 5`;
  }

  function endGame() {
    clearInterval(timerInterval);
    const finalTime = timerEl.textContent;
    resultScore.textContent = `Hız Skorunuz: ${finalTime} saniye`;
    resultScreen.style.display = 'flex';
  }
</script>
