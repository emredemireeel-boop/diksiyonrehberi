<%- include('partials/main-header') %>

<style>
  /* 🎙️ Voice Studio Light Theme 🎙️ */
  body { background: #fafaf9; color: #1c1917; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🎙️ Hero Section 🎙️ */
  .v-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #fdf2f8 0%, #fafaf9 80%);
  }
  .v-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fafaf9,transparent); }

  .hero-circles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .circle-wave { position:absolute; border-radius:50%; border: 1px solid rgba(236, 72, 153, 0.2); left:50%; top:40%; transform:translate(-50%,-50%); animation: ripple 6s infinite linear; }
  .cw-1 { width: 300px; height: 300px; animation-delay: 0s; }
  .cw-2 { width: 500px; height: 500px; animation-delay: -2s; }
  .cw-3 { width: 700px; height: 700px; animation-delay: -4s; }

  @keyframes ripple { 
    0% { width: 0; height: 0; opacity: 1; }
    100% { width: 1000px; height: 1000px; opacity: 0; }
  }

  .v-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; text-shadow: 0 10px 30px rgba(236,72,153,0.3); }
  .v-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #be185d; background: #fce7f3; border:1px solid #fbcfe8; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(236,72,153,0.15); }
  .v-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #1c1917; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .v-title span { background: linear-gradient(135deg, #ec4899, #8b5cf6, #3b82f6); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .v-subtitle { color: #57534e; font-size:1.2rem; max-width:650px; line-height:1.8; z-index:2; position:relative; }

  /* 🎙️ Layout Container 🎙️ */
  .v-wrap { max-width:1050px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 🎙️ Glass Cards (Studio Style) 🎙️ */
  .glass-studio { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(25px); border: 1px solid rgba(236, 72, 153, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03); }
  .glass-studio:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(236, 72, 153, 0.08); border-color: rgba(236, 72, 153, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #ec4899; margin-bottom:24px; display:flex; align-items:center; gap:12px; }
  
  /* 🎙️ Interactive Equalizer 🎙️ */
  .eq-container { display: flex; flex-direction: column; gap: 30px; margin-top: 30px; }
  
  .preset-buttons { display: flex; flex-wrap: wrap; gap: 15px; justify-content: center; margin-bottom: 20px; }
  .preset-btn { padding: 12px 24px; border-radius: 100px; border: none; background: #f1f5f9; color: #475569; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; gap: 8px; }
  .preset-btn:hover { background: #e2e8f0; color: #0f172a; transform: translateY(-2px); }
  .preset-btn.active { background: linear-gradient(135deg, #ec4899, #8b5cf6); color: white; box-shadow: 0 10px 20px rgba(236,72,153,0.3); }

  .visualizer-board { background: #0f172a; border-radius: 24px; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 250px; position: relative; overflow: hidden; box-shadow: inset 0 10px 30px rgba(0,0,0,0.5); }
  
  .bars-container { display: flex; align-items: flex-end; gap: 6px; height: 120px; z-index: 2; }
  .eq-bar { width: 12px; background: #ec4899; border-radius: 6px 6px 0 0; transition: height 0.2s ease, background 0.5s ease; height: 10px; box-shadow: 0 0 15px rgba(236,72,153,0.5); }
  
  .preset-desc { color: #94a3b8; font-size: 1.05rem; text-align: center; margin-top: 30px; max-width: 600px; z-index: 2; line-height: 1.6; }
  
  /* 🎙️ Pitch/Range Slider 🎙️ */
  .slider-box { padding: 30px; border-radius: 20px; background: #f8fafc; border: 1px dashed #cbd5e1; margin-top: 20px; }
  .slider-header { display: flex; justify-content: space-between; margin-bottom: 15px; font-weight: 700; color: #334155; }
  
  input[type=range] { -webkit-appearance: none; width: 100%; background: transparent; }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; height: 24px; width: 24px; border-radius: 50%; background: #ec4899; cursor: pointer; margin-top: -8px; box-shadow: 0 4px 10px rgba(236,72,153,0.4); border: 3px solid white; }
  input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 8px; cursor: pointer; background: linear-gradient(to right, #3b82f6, #ec4899, #f59e0b); border-radius: 4px; }
  
  .pitch-feedback { text-align: center; font-size: 1.5rem; font-weight: 800; color: #ec4899; margin-top: 20px; height: 35px; transition: color 0.3s; }

  /* 🎙️ Voice Profiles Grid 🎙️ */
  .profile-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .profile-card { background: white; border: 1px solid #e2e8f0; padding: 30px; border-radius: 24px; transition: all 0.3s; position: relative; overflow: hidden; }
  .profile-card:hover { transform: translateY(-5px); border-color: #ec4899; box-shadow: 0 15px 30px rgba(236,72,153,0.1); }
  .profile-card h3 { font-size: 1.3rem; font-weight: 800; color: #1e293b; margin-top: 0; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; }
  .profile-card p { color: #64748b; font-size: 0.95rem; line-height: 1.6; margin: 0; }
  
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #e2e8f0; color:#475569; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#f8fafc; color:#0f172a; transform:translateX(-4px); border-color: #cbd5e1; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="v-hero">
  <div class="hero-circles">
    <div class="circle-wave cw-1"></div>
    <div class="circle-wave cw-2"></div>
    <div class="circle-wave cw-3"></div>
  </div>
  <div class="v-icon">🎛️</div>
  <div class="v-badge">Ses Rengi ve Perde Stüdyosu</div>
  <h1 class="v-title">Sesinizin <span>Frekansını</span> Keşfedin</h1>
  <p class="v-subtitle">Otoriter bir CEO sesi, gece FM radyolarının karanlık ve çekici tınısı veya enerjik bir TEDx konuşmacısı olmak... Ses bir enstrümandır, akort etmeyi öğrenin.</p>
</section>

<div class="v-wrap">
  <a href="/diksiyon?cat=perde" class="back-btn">← Tüm Ses ve Perde Egzersizlerini Gör</a>

  <!-- 🎙️ EQ Simulator 🎙️ -->
  <div class="glass-studio reveal">
    <div class="section-label">🎧 Canlı Vokal Ekolayzır (Profil Simülatörü)</div>
    <p style="color:#57534e; font-size:1.05rem; line-height:1.6; margin-bottom:20px;">
      İstediğiniz ses profilini seçin. Bu arayüz, her duygunun ve kimliğin akustik matematiğini (Tiz, Mid, Bass) nasıl ayarlamanız gerektiğini gösterir.
    </p>

    <div class="preset-buttons">
      <button class="preset-btn active" onclick="setEq('neutral', this)">😐 Nötr (Spiker)</button>
      <button class="preset-btn" onclick="setEq('dark', this)">🌙 Gece Sesi (Pes)</button>
      <button class="preset-btn" onclick="setEq('energetic', this)">⚡ Enerjik (Tiz/Maske)</button>
      <button class="preset-btn" onclick="setEq('ceo', this)">👔 CEO / Otorite</button>
      <button class="preset-btn" onclick="setEq('whisper', this)">🤫 Sırdaş (Fısıltı)</button>
    </div>

    <div class="visualizer-board">
      <div class="bars-container" id="eqBars">
        <!-- Bars generated by JS -->
      </div>
      <div class="preset-desc" id="eqDesc">
        <strong>Nötr Spiker Sesi:</strong> Dengeli bas ve tiz frekansları. Gırtlak gevşek, diyafram destekli. Ortalama bir tempoda (120 kelime/dk) okunur.
      </div>
    </div>
  </div>

  <!-- 🎙️ Pitch Slider 🎙️ -->
  <div class="glass-studio reveal">
    <div class="section-label">🎚️ Kafa - Göğüs Sesi (Passaggio) Asansörü</div>
    <p style="color:#57534e; font-size:1.05rem; line-height:1.6;">
      Elinizi göğsünüze koyun. Sürgüyü sola kaydırdıkça sesinizi kalınlaştırıp (Göğüs) göğsünüzdeki titreşimi hissedin. Sağa kaydırdıkça sesi inceltip (Kafa) burun ve alnınızda titreşim arayın.
    </p>

    <div class="slider-box">
      <div class="slider-header">
        <span>🐻 Göğüs Sesi (Kalın)</span>
        <span>🦅 Kafa Sesi (İnce)</span>
      </div>
      <input type="range" id="pitchSlider" min="0" max="100" value="50" oninput="updatePitch()">
      <div class="pitch-feedback" id="pitchFeedback">Orta Perde (Nötr Konuşma)</div>
    </div>
  </div>

  <!-- 🎙️ Acoustic Profiles 🎙️ -->
  <div class="glass-studio reveal">
    <div class="section-label">🎭 Akustik Psikoloji (Duygu Parametreleri)</div>
    
    <div class="profile-grid">
      <div class="profile-card">
        <h3>😠 Öfke ve Otorite</h3>
        <p><strong>Perde:</strong> Kalın (Pes) <br><strong>Atak:</strong> Sert (Glottal) <br><strong>Tempo:</strong> Kesik Kesik (Staccato)</p>
      </div>
      <div class="profile-card">
        <h3>🤗 Sıcaklık ve Güven</h3>
        <p><strong>Perde:</strong> Orta-Tiz <br><strong>Atak:</strong> Yumuşak (Nefesli) <br><strong>Mimik:</strong> Gülümseyen Dudaklar</p>
      </div>
      <div class="profile-card">
        <h3>😨 Korku ve Gizem</h3>
        <p><strong>Perde:</strong> Tiz (Kafa) <br><strong>Atak:</strong> Fısıltılı <br><strong>Vibrato:</strong> Düzensiz ve Titrek</p>
      </div>
      <div class="profile-card">
        <h3>🎉 Çoşku ve Neşe</h3>
        <p><strong>Perde:</strong> Maske Rezonansı <br><strong>Atak:</strong> Dinamik Glissando <br><strong>Tempo:</strong> Çok Hızlı</p>
      </div>
    </div>
  </div>

</div>

<script>
// 🎙️ Scroll Reveal 🎙️
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🎙️ EQ Simulator Logic 🎙️
const numBars = 30;
const eqBarsContainer = document.getElementById('eqBars');
let eqInterval;

// Initialize bars
for(let i=0; i<numBars; i++) {
  const bar = document.createElement('div');
  bar.className = 'eq-bar';
  eqBarsContainer.appendChild(bar);
}
const bars = document.querySelectorAll('.eq-bar');

const presets = {
  neutral: {
    color: '#3b82f6',
    desc: '<strong>Nötr Spiker Sesi:</strong> Dengeli bas ve tiz frekansları. Gırtlak gevşek, diyafram destekli. Güven veren standart haber tonu.',
    pattern: (i) => 30 + Math.random() * 40 // Mid range, balanced
  },
  dark: {
    color: '#8b5cf6',
    desc: '<strong>Gece Sesi (Karanlık Timbre):</strong> Sol taraftaki BAS (Kalın) frekanslar tavan yapar. Tizler (sağ) neredeyse sıfırlanır. Gırtlak tamamen aşağıda (Esneme) ve konuşma hızı %30 yavaştır.',
    pattern: (i) => (i < 10) ? 70 + Math.random()*30 : (i < 20) ? 30 + Math.random()*20 : 10 + Math.random()*10
  },
  energetic: {
    color: '#f59e0b',
    desc: '<strong>Enerjik/TEDx Sesi:</strong> Sesi göğüsten alıp yüz kemiklerine (Maskeye) fırlatma. Sağ taraftaki TİZ frekanslar parlar. Zili andıran keskin (Twang) ve hızlı bir ton.',
    pattern: (i) => (i < 10) ? 10 + Math.random()*15 : (i < 20) ? 40 + Math.random()*20 : 60 + Math.random()*40
  },
  ceo: {
    color: '#10b981',
    desc: '<strong>CEO (Otorite) Sesi:</strong> Kalın ve Mid frekansların kaya gibi sabit duruşu. Tizlere çıkılmaz. Cümle sonları asla soru gibi (Uptalk) yukarı kıvrılmaz, kesin bir düşüşle sonlanır.',
    pattern: (i) => (i < 15) ? 60 + Math.random()*20 : 30 + Math.random()*15
  },
  whisper: {
    color: '#ec4899',
    desc: '<strong>Sırdaş (Destekli Fısıltı):</strong> Ses teli motoru kapanır (Baslar yok). Sadece yoğun diyafram havası ve abartılı ünsüz harflerle (Tiz) sağlanan ASMR etkisi.',
    pattern: (i) => (i < 15) ? 5 + Math.random()*5 : 20 + Math.random()*30
  }
};

function animateEq(presetKey) {
  clearInterval(eqInterval);
  const data = presets[presetKey];
  
  eqInterval = setInterval(() => {
    bars.forEach((bar, index) => {
      const height = data.pattern(index);
      bar.style.height = `${height}px`;
      bar.style.backgroundColor = data.color;
      bar.style.boxShadow = `0 0 15px ${data.color}80`;
    });
  }, 150);
}

function setEq(presetKey, btnElement) {
  document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
  btnElement.classList.add('active');
  
  document.getElementById('eqDesc').innerHTML = presets[presetKey].desc;
  animateEq(presetKey);
}

// Start Default
animateEq('neutral');

// 🎙️ Pitch Slider Logic 🎙️
function updatePitch() {
  const val = document.getElementById('pitchSlider').value;
  const fb = document.getElementById('pitchFeedback');
  
  if(val < 20) {
    fb.innerText = "Vocal Fry (Gıcırdama / En Kalın)";
    fb.style.color = "#8b5cf6";
  } else if(val < 45) {
    fb.innerText = "Göğüs Rezonansı (Otorite / Tok)";
    fb.style.color = "#3b82f6";
  } else if(val < 65) {
    fb.innerText = "Orta Perde (Nötr Konuşma)";
    fb.style.color = "#10b981";
  } else if(val < 85) {
    fb.innerText = "Maske Rezonansı (Parlak / Tiz)";
    fb.style.color = "#f59e0b";
  } else {
    fb.innerText = "Falsetto / Kafa Sesi (En İnce)";
    fb.style.color = "#ec4899";
  }
}
</script>

<%- include('partials/main-footer') %>
