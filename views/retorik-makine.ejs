<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .rm-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; max-width: 1000px; margin: 0 auto; width: 100%; }
  
  .instruction-panel { background: #ffffff; border: 1px solid #e2e8f0; padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #10b981; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1.05rem; color: #475569; margin: 0; max-width: 600px; line-height: 1.6; }

  .sentence-wrapper { width: 100%; display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  
  .box-boring { background: #f1f5f9; border-left: 5px solid #94a3b8; padding: 30px; border-radius: 0 20px 20px 0; font-size: 1.5rem; color: #64748b; font-style: italic; }
  .box-boring::before { content: "Sıradan Cümle:"; display: block; font-size: 0.9rem; font-weight: 800; color: #94a3b8; margin-bottom: 10px; font-style: normal; text-transform: uppercase; }

  .box-epic { background: #1e293b; border-left: 5px solid #10b981; padding: 40px; border-radius: 0 20px 20px 0; font-size: 2rem; font-weight: 800; color: #ffffff; box-shadow: 0 20px 40px rgba(0,0,0,0.2); transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); opacity: 0; transform: translateY(20px); }
  .box-epic::before { content: "Retorik Makinesi Sonucu:"; display: block; font-size: 0.9rem; font-weight: 800; color: #10b981; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 2px; }
  .box-epic.show { opacity: 1; transform: translateY(0); }
  .epic-highlight { color: #10b981; }

  .machine-controls { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; width: 100%; }
  .btn-machine {
    background: #ffffff; border: 2px solid #e2e8f0; color: #0f172a; padding: 20px; border-radius: 16px;
    font-size: 1.1rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
  }
  .btn-machine:hover { border-color: #10b981; background: #f0fdf4; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(16,185,129,0.1); }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: #64748b; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #0f172a; }

</style>

<a href="/retorik" class="btn-back">← Retorik'e Dön</a>

<div class="rm-container">
  
  <div class="instruction-panel">
    <h1 class="instruction-title">Retorik Makinesi</h1>
    <p class="instruction-desc">Sıradan bir cümleyi seçin ve onu Antik Yunan'dan beri kullanılan efsanevi hitabet figürleriyle (Trikolon, Antitez, Anafor) altın değerinde bir repliğe dönüştürün.</p>
  </div>

  <div class="sentence-wrapper">
    <div class="box-boring" id="boringText">"Çok uğraştık, epey yol geldik ve sonunda savaşı kazandık."</div>
    <div class="box-epic" id="epicBox">Geldim, <span class="epic-highlight">Gördüm</span>, Yendim!</div>
  </div>

  <div class="machine-controls">
    <button class="btn-machine" onclick="transformSentence('trikolon')">Trikolon Ekle<br><span style="font-size:0.8rem;color:#64748b;font-weight:400">Üçlü Ritim Kuralı</span></button>
    <button class="btn-machine" onclick="transformSentence('antitez')">Antitez Ekle<br><span style="font-size:0.8rem;color:#64748b;font-weight:400">Zıtlıkların Çarpışması</span></button>
    <button class="btn-machine" onclick="transformSentence('anafor')">Anafor Ekle<br><span style="font-size:0.8rem;color:#64748b;font-weight:400">Baştan Tekrarlama</span></button>
  </div>
  
  <button style="margin-top:40px; background:transparent; border:1px solid #cbd5e1; padding:10px 20px; border-radius:20px; cursor:pointer;" onclick="nextSentence()">Sonraki Cümle ➔</button>

</div>

<script>
  const data = [
    {
      boring: "Ülkemiz için çalışmalıyız, devletten bir şey beklememeliyiz.",
      trikolon: "Ülkemiz için <span class='epic-highlight'>çalışmalı</span>, ülkemiz için <span class='epic-highlight'>üretmeli</span>, ülkemiz için <span class='epic-highlight'>terlemeliyiz!</span>",
      antitez: "Devletinizin <span class='epic-highlight'>sizin için</span> ne yapabileceğini sormayın; <span class='epic-highlight'>sizin devletiniz için</span> ne yapabileceğinizi sorun!",
      anafor: "<span class='epic-highlight'>Biz</span> beklemeyeceğiz. <span class='epic-highlight'>Biz</span> durmayacağız. <span class='epic-highlight'>Biz</span> ülkemiz için çalışacağız."
    },
    {
      boring: "Zor bir durumdayız ama umudumuz var.",
      trikolon: "Bugün <span class='epic-highlight'>karanlıkta</span> olabiliriz, yarın <span class='epic-highlight'>zorlanabiliriz</span>, ama sonunda <span class='epic-highlight'>kazanacağız!</span>",
      antitez: "Dışarıda <span class='epic-highlight'>zifiri bir karanlık</span> olabilir, ama içimizde <span class='epic-highlight'>sönmeyen bir güneş</span> var.",
      anafor: "<span class='epic-highlight'>Umudumuz var</span> çünkü haklıyız. <span class='epic-highlight'>Umudumuz var</span> çünkü cesuruz. <span class='epic-highlight'>Umudumuz var</span> çünkü biz buyuz!"
    }
  ];

  let currentIdx = 0;
  const boringEl = document.getElementById('boringText');
  const epicEl = document.getElementById('epicBox');

  function renderBoring() {
    epicEl.classList.remove('show');
    boringEl.textContent = `"${data[currentIdx].boring}"`;
  }

  function transformSentence(type) {
    const item = data[currentIdx];
    epicEl.classList.remove('show');
    setTimeout(() => {
      epicEl.innerHTML = `"${item[type]}"`;
      epicEl.classList.add('show');
    }, 200);
  }

  function nextSentence() {
    currentIdx = (currentIdx + 1) % data.length;
    renderBoring();
  }

  // Init
  renderBoring();
</script>
