<%- include('partials/main-header') %>

<style>
  /* STORYTELLING - LÜKS LIGHT MODE & FULL SCREEN OVERRIDES */
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.hikaye-page { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }

  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');
  
  :root {
    --hk-primary: #d97706; /* Sıcak Kehribar (Storytelling ruhu) */
    --hk-dark: #78350f;
    --hk-accent: #0f766e; /* Zıtlık için zümrüt/deniz yeşili */
    --text-main: #1c1917;
    --text-muted: #57534e;
    --bg-light: #fafaf9;
    --bg-card: #ffffff;
  }

  /* 1. HERO SECTION */
  .hk-hero {
    position: relative;
    height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(180deg, #fefce8 0%, #fafaf9 100%);
    overflow: hidden;
  }
  .hk-hero::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--hk-primary) 0.5px, transparent 0.5px);
    background-size: 30px 30px;
    opacity: 0.1;
    z-index: 0;
  }
  
  .hk-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 20px;
    animation: fadeUp 1s ease-out;
  }
  .hk-badge {
    display: inline-block;
    padding: 8px 24px;
    border-radius: 30px;
    background: rgba(217, 119, 6, 0.1);
    border: 1px solid rgba(217, 119, 6, 0.3);
    color: var(--hk-dark);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
  }
  .hk-title {
    font-family: 'Playfair Display', serif;
    font-size: 5rem;
    line-height: 1.1;
    margin: 0 0 20px 0;
    color: var(--text-main);
  }
  .hk-title i {
    color: var(--hk-primary);
    font-style: italic;
  }
  .hk-subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 400;
    max-width: 700px;
    margin: 0 auto 50px auto;
    line-height: 1.8;
  }
  .hk-stats {
    display: flex; justify-content: center; gap: 50px; flex-wrap: wrap;
  }
  .hk-stat {
    display: flex; flex-direction: column; align-items: center;
  }
  .hk-stat-n { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--hk-dark); font-weight: 800; }
  .hk-stat-l { font-family: 'Outfit', sans-serif; font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-top: 5px; }

  /* 2. SİMÜLASYON BANNER (LAB) */
  .hk-lab-banner {
    max-width: 1200px;
    margin: -60px auto 80px auto;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(217, 119, 6, 0.2);
    border-radius: 30px;
    padding: 60px 40px;
    position: relative;
    z-index: 10;
    box-shadow: 0 30px 60px rgba(217, 119, 6, 0.05);
    text-align: center;
  }
  .hk-lab-banner::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px;
    background: linear-gradient(90deg, #fef3c7, var(--hk-primary), #fef3c7);
    border-radius: 30px 30px 0 0;
  }
  .lab-subtitle { font-family: 'Outfit'; font-size: 0.85rem; font-weight: 800; color: var(--hk-accent); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; }
  .lab-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--text-main); margin: 0 0 20px 0; }
  .lab-desc { font-family: 'Outfit', sans-serif; color: var(--text-muted); font-size: 1.1rem; max-width: 800px; margin: 0 auto 35px auto; line-height: 1.6; }
  .lab-btns { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
  
  .btn-lab {
    background: #ffffff; border: 2px solid #e5e7eb; color: var(--text-main);
    padding: 16px 36px; border-radius: 30px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.05rem;
    text-decoration: none; transition: all 0.3s; display: inline-flex; align-items: center; gap: 10px;
  }
  .btn-lab.kanca { border-color: var(--hk-accent); color: var(--hk-accent); }
  .btn-lab.kanca:hover { background: var(--hk-accent); color: #fff; box-shadow: 0 10px 20px rgba(15, 118, 110, 0.2); transform: translateY(-3px); }
  
  .btn-lab.kahraman { border-color: var(--hk-primary); color: var(--hk-dark); }
  .btn-lab.kahraman:hover { background: var(--hk-primary); color: #fff; box-shadow: 0 10px 20px rgba(217, 119, 6, 0.2); transform: translateY(-3px); }

  /* 3. KATEGORİLER */
  .hk-nav {
    display: flex; justify-content: center; gap: 15px; margin-bottom: 60px; flex-wrap: wrap;
  }
  .hk-nav-item {
    padding: 12px 28px; border-radius: 30px; text-decoration: none; font-family: 'Outfit', sans-serif;
    font-weight: 600; font-size: 0.95rem; color: var(--text-muted); border: 1px solid transparent; transition: all 0.3s;
  }
  .hk-nav-item.active { background: rgba(217, 119, 6, 0.1); color: var(--hk-dark); border-color: var(--hk-primary); }
  .hk-nav-item:hover:not(.active) { background: rgba(0,0,0,0.03); color: var(--text-main); }

  /* 4. PERDELER (KARTLAR) */
  .hk-section { max-width: 1400px; margin: 0 auto; padding: 60px 5%; }
  .sec-header { display: flex; align-items: center; gap: 20px; margin-bottom: 50px; }
  .sec-icon { background: #fef3c7; border: 1px solid #fde68a; width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; }
  .sec-title h2 { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--text-main); margin: 0 0 5px 0; }
  .sec-title p { font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--text-muted); margin: 0; }

  .hk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; }
  
  .card-perde {
    background: var(--bg-card); border: 1px solid #e5e7eb; border-radius: 24px; padding: 40px;
    text-decoration: none; position: relative; overflow: hidden; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0,0,0,0.02); display: flex; flex-direction: column;
  }
  .card-perde::after {
    content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 4px;
    background: var(--hk-primary); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease;
  }
  .card-perde:hover { transform: translateY(-10px); border-color: #fde68a; box-shadow: 0 20px 40px rgba(217, 119, 6, 0.08); }
  .card-perde:hover::after { transform: scaleX(1); }

  .cp-tag { font-family: 'Outfit'; font-size: 0.75rem; font-weight: 800; color: var(--hk-primary); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 15px; }
  .cp-icon { font-size: 3rem; margin-bottom: 25px; filter: drop-shadow(0 5px 10px rgba(217,119,6,0.2)); }
  .cp-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-main); margin: 0 0 15px 0; }
  .cp-desc { font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--text-muted); line-height: 1.7; margin: 0 0 30px 0; flex-grow: 1; }
  .cp-btn { font-family: 'Outfit', sans-serif; font-size: 0.95rem; font-weight: 700; color: var(--text-main); display: inline-flex; align-items: center; gap: 10px; transition: 0.3s; }
  .card-perde:hover .cp-btn { color: var(--hk-primary); gap: 15px; }

  /* 5. EDITORIAL MAKALE */
  .hk-article { background: linear-gradient(45deg, #ffffff, #fefce8); border-top: 1px solid #fef3c7; border-bottom: 1px solid #fef3c7; padding: 100px 5%; margin-top: 80px; }
  .article-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; align-items: center; }
  .article-text h2 { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--text-main); margin-bottom: 25px; line-height: 1.2; }
  .article-text p { font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 20px; }
  
  .article-quote { background: #fffbeb; border-left: 4px solid var(--hk-primary); padding: 40px; border-radius: 0 24px 24px 0; }
  .quote-text { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--hk-dark); font-style: italic; line-height: 1.6; margin-bottom: 20px; }
  .quote-author { font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 800; color: var(--hk-primary); text-transform: uppercase; letter-spacing: 1px; }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

  @media(max-width: 900px) {
    .hk-title { font-size: 3.5rem; }
    .article-grid { grid-template-columns: 1fr; }
    .lab-btns { flex-direction: column; }
    .btn-lab { width: 100%; justify-content: center; }
  }
</style>

<div class="hikaye-page">

  <!-- 1. HERO -->
  <section class="hk-hero">
    <div class="hk-hero-content">
      <div class="hk-badge">Anlatıcılık Sanatı</div>
      <h1 class="hk-title">Sıradan Kelimeleri <i>Unutulmaz</i> Hikayelere Dönüştür</h1>
      <p class="hk-subtitle">İnsanlar verileri ve raporları değil, hissettiklerini ve hikayeleri hatırlar. Joseph Campbell'ın evrensel kahraman yolculuğundan modern sunum tekniklerine kadar iz bırakan bir anlatıcı olmanın şifresini çözün.</p>
      
      <div class="hk-stats">
        <div class="hk-stat"><span class="hk-stat-n">3</span><span class="hk-stat-l">Perde Yapısı</span></div>
        <div class="hk-stat"><span class="hk-stat-n">10+</span><span class="hk-stat-l">Anlatım Tekniği</span></div>
        <div class="hk-stat"><span class="hk-stat-n">∞</span><span class="hk-stat-l">Etki Alanı</span></div>
      </div>
    </div>
  </section>

  <!-- 2. LAB BANNER -->
  <div class="hk-lab-banner">
    <div class="lab-subtitle">Anlatıcılık Laboratuvarı</div>
    <h2 class="lab-title">4 Efsanevi Simülasyon</h2>
    <p class="lab-desc">Sıradan bir anıyı veya şirket sunumunu nasıl gişe rekorları kıran bir filme çevirirsiniz? Hikaye Mimarı ile sıfırdan bir 3 perde inşa edin, ilk 10 saniyede kusursuz bir kanca atın ve "Göster, Söyleme" kuralının sırrını çözün.</p>
    <div class="lab-btns">
      <a href="/hikaye/mimari" class="btn-lab" style="border-color: #059669; color: #059669;"><i class="fa-solid fa-wand-magic-sparkles"></i> Hikaye Mimarı</a>
      <a href="/hikaye/kanca" class="btn-lab kanca"><i class="fa-solid fa-anchor"></i> Kanca Atıcı</a>
      <a href="/hikaye/kahraman" class="btn-lab kahraman"><i class="fa-solid fa-hat-wizard"></i> Kahramanın Yolculuğu</a>
      <a href="/hikaye/goster" class="btn-lab" style="border-color: #d97706; color: #d97706;"><i class="fa-solid fa-camera-movie"></i> Göster, Söyleme (Show/Tell)</a>
    </div>
  </div>

  <!-- 3. KATEGORİLER -->
  <nav class="hk-nav">
    <a href="/hikaye" class="hk-nav-item active">Tümü</a>
    <a href="/hikaye/sıradan" class="hk-nav-item">Sıradan Dünya</a>
    <a href="/hikaye/kriz" class="hk-nav-item">Çatışma (Kriz)</a>
    <a href="/hikaye/sentez" class="hk-nav-item">Çözüm ve Sentez</a>
  </nav>

  <!-- 4. PERDELER -->
  <section class="hk-section">
    <div class="sec-header">
      <div class="sec-icon">📖</div>
      <div class="sec-title">
        <h2>Hikaye Yapısı: 3 Perde</h2>
        <p>Her büyük hikayenin ve unutulmaz konuşmanın temelindeki evrensel iskelet</p>
      </div>
    </div>

    <div class="hk-grid">
      <!-- Perde 1 -->
      <a href="/hikaye/sıradan" class="card-perde">
        <div class="cp-tag">Perde 01 — Başlangıç</div>
        <div class="cp-icon">🌅</div>
        <h3 class="cp-title">Sıradan Dünya</h3>
        <p class="cp-desc">Kahramanı ve onun normal hayatını tanıtma. Dinleyicinin kendinden bir parça bulup empati kurması için mükemmel zemin oluşturma sanatı.</p>
        <div class="cp-btn">Eğitimi İncele <span>→</span></div>
      </a>

      <!-- Perde 2 -->
      <a href="/hikaye/kriz" class="card-perde">
        <div class="cp-tag">Perde 02 — Çatışma</div>
        <div class="cp-icon">⚡</div>
        <h3 class="cp-title">Kriz ve Dönüm Noktası</h3>
        <p class="cp-desc">Merak uyandıran bir çatışma olmadan hikaye olmaz. Pürüzsüz başarılar sıkıcıdır; gerilim inşa etmeyi ve zorlukların üstesinden gelmeyi öğrenin.</p>
        <div class="cp-btn">Eğitimi İncele <span>→</span></div>
      </a>

      <!-- Perde 3 -->
      <a href="/hikaye/sentez" class="card-perde">
        <div class="cp-tag">Perde 03 — Sonuç</div>
        <div class="cp-icon">🌟</div>
        <h3 class="cp-title">Çözüm ve Sentez</h3>
        <p class="cp-desc">Hikayenin asıl mesajını kalıcı hale getiren ustalık kapanışı. Duygusal rezonans yaratma ve izleyicinin zihninde öğrenilen dersi pekiştirme.</p>
        <div class="cp-btn">Eğitimi İncele <span>→</span></div>
      </a>
    </div>
  </section>

  <!-- 5. EDITORIAL MAKALE -->
  <section class="hk-article">
    <div class="article-grid">
      <div class="article-text">
        <h2>Neden Hikaye Anlatıcılığı?</h2>
        <p>Princeton Üniversitesi'nde yapılan fMRI araştırmaları, iyi bir hikaye dinlendiğinde, konuşmacının ve dinleyicinin beyin dalgalarının kelimenin tam anlamıyla <strong>senkronize</strong> olduğunu kanıtlamıştır.</p>
        <p>Maddeler halindeki kuru veriler beynin sadece dil merkezini çalıştırırken, duyusal detaylarla bezenmiş bir hikaye; beynin görsel, motor ve duyusal kortekslerini aynı anda ateşleyerek yaşanan olayı kişinin kendi anısıymış gibi hissetmesini sağlar.</p>
        <p>İş dünyasındaki çetin sunumlarda, yatırımcı görüşmelerinde veya sadece arkadaş ortamındaki basit bir anı aktarımında dahi, iknanın en kısa yolu karşı tarafın duygularına (Pathos) hitap eden güçlü bir anlatıdır.</p>
      </div>
      <div class="article-quote">
        <div class="quote-text">"Eğer birini etkilemek istiyorsan, ona sarsılmaz bir veri ver. Fakat onu yerinden kaldırıp harekete geçirmek istiyorsan, ona bir hikaye anlat."</div>
        <div class="quote-author">— Brené Brown</div>
      </div>
    </div>
  </section>

</div>

<%- include('partials/main-footer') %>