<%- include('partials/main-header') %>

<style>
  body { background: #0a0a14; color: #f1f5f9; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🌍 Hero 🌍 */
  .a-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 20%, #f59e0b22, transparent 70%);
  }
  .a-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#0a0a14,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: aFloat 9s ease-in-out infinite; background: linear-gradient(135deg, #f59e0b, #fbbf24); }
  @keyframes aFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.1; } 50%{ transform:translateY(-60px) scale(1.5); opacity:.4; } }

  .a-icon { font-size: 6rem; margin-bottom: 20px; animation: aPulse 4s ease-in-out infinite; filter: drop-shadow(0 0 30px #f59e0b66); }
  @keyframes aPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.05) translateY(-5px); } }

  .a-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#fde68a; background:#f59e0b18; border:1px solid #f59e0b44; margin-bottom:24px; box-shadow: 0 0 20px #f59e0b22; }
  .a-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color:#fff; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .a-title span { background: linear-gradient(135deg, #fbbf24, #fcd34d); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .a-subtitle { color:#94a3b8; font-size:1.15rem; max-width:700px; line-height:1.8; }

  /* 🌍 Container 🌍 */
  .a-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 🌍 Glass Cards 🌍 */
  .glass { background:rgba(255,255,255,.02); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,.05); border-radius:24px; padding:40px; margin-bottom:40px; transition:transform .4s,box-shadow .4s; position: relative; overflow: hidden; }
  .glass::before { content:''; position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,.1),transparent); }
  .glass:hover { transform:translateY(-5px); box-shadow:0 30px 60px rgba(0,0,0,.4),0 0 40px #f59e0b11; border-color:rgba(245,158,11,.2); }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#fbbf24; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background:#fbbf24; border-radius:2px; }

  /* 🌍 Code-Switching Switcher 🌍 */
  .switch-container { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #29150022; border-radius: 20px; border: 2px solid #f59e0b33; padding: 40px; margin-bottom: 30px; text-align: center; }
  
  .switch-box { display: flex; background: rgba(0,0,0,0.5); border-radius: 100px; padding: 6px; margin-bottom: 30px; border: 1px solid rgba(245,158,11,0.2); position: relative; }
  .s-btn { flex: 1; padding: 12px 30px; border-radius: 100px; font-weight: 700; color: #94a3b8; cursor: pointer; transition: all 0.3s; position: relative; z-index: 2; border: none; background: transparent; font-size: 1rem; }
  .s-btn.active { color: #000; }
  .switch-glider { position: absolute; top: 6px; left: 6px; height: calc(100% - 12px); width: calc(50% - 6px); background: linear-gradient(135deg, #f59e0b, #fbbf24); border-radius: 100px; transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55); z-index: 1; }
  
  .switch-content { min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .s-text { font-size: 1.8rem; font-weight: 800; color: #fff; margin-bottom: 10px; font-style: italic; transition: opacity 0.3s; }
  .s-desc { color: #fbbf24; font-size: 1rem; transition: opacity 0.3s; }

  /* 🌍 Regional Gym Grid 🌍 */
  .gym-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .gym-container { grid-template-columns: 1fr; } }
  
  .gym-card { background: rgba(0,0,0,.3); border: 1px solid rgba(245,158,11,.15); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all .3s; position: relative; overflow: hidden; }
  .gym-card::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at center, rgba(245,158,11,.1), transparent); opacity:0; transition:opacity .3s; }
  .gym-card:hover { border-color: #f59e0b; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(245,158,11,.15); }
  .gym-card:hover::after { opacity: 1; }
  
  .gym-icon { font-size: 3rem; margin-bottom: 12px; display: inline-block; transition: transform .3s; }
  .gym-card:hover .gym-icon { transform: scale(1.15) rotate(5deg); }
  
  .gym-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .gym-desc { font-size: 0.85rem; color: #94a3b8; line-height: 1.6; }

  /* 🌍 Shadowing / Neutralization Panel 🌍 */
  .workout-panel { background: linear-gradient(145deg, #301700, #0a0a14); border: 1px solid #f59e0b33; border-radius: 24px; padding: 40px; margin-top: 20px; text-align: center; position: relative; overflow: hidden; }
  .workout-panel::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle at center, rgba(245,158,11,.05) 0%, transparent 50%); animation: rotateGlow 15s linear infinite; pointer-events:none; }
  @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .workout-display { font-size: 1.8rem; font-weight: 700; color: #fff; line-height: 1.6; margin: 24px 0; min-height: 60px; display: flex; align-items: center; justify-content: center; }
  .workout-hint { color: #fbbf24; font-size: 1rem; font-weight: 600; margin-bottom: 30px; }
  
  .workout-btn { padding: 16px 40px; border-radius: 100px; background: linear-gradient(135deg, #d97706, #f59e0b); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(245,158,11,.4); transition: all .3s; text-transform: uppercase; letter-spacing: 2px; }
  .workout-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(245,158,11,.6); }
  .workout-btn:active { transform: scale(0.98); }

  /* 🌍 Back Button 🌍 */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); color:#94a3b8; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(255,255,255,.1); color:#fff; transform:translateX(-4px); }

  /* 🌍 Reveal 🌍 */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="a-hero">
  <div class="hero-particles">
    <% for(let i=0; i<30; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 2+Math.random()*5 %>px; height:<%= 2+Math.random()*5 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 4+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="a-icon">🗣️</div>
  <div class="a-badge">🌐 Fonetik ve Aksan Laboratuvarı</div>
  <h1 class="a-title"><span>Nötr Aksan</span> Geliştirme</h1>
  <p class="a-subtitle">Yöresel şivelerimizi silmeden, iş ve resmiyet hayatı için "Standart İstanbul Türkçesi"ne geçiş yapabilme (Code-Switching) yeteneğinizi geliştirin.</p>
</section>

<div class="a-wrap">
  <a href="/diksiyon?cat=aksan" class="back-btn">Tüm Aksan & Lehçe İçeriklerini Gör</a>

  <!-- 🌍 CODE SWITCHING 🌍 -->
  <div class="glass reveal">
    <div class="section-label">🔄 Code-Switching (Dil Geçişi)</div>
    <p style="color:#94a3b8; font-size:1rem; line-height:1.8; margin-bottom:20px;">Diksiyon eğitimi sizin yöresel kültürünüzü yok etmez. Sadece zihninize iki farklı "kanal" kurar. Doğru ortamda, doğru kanalı açmak tamamen sizin kontrolünüzdedir.</p>

    <div class="switch-container">
      <div class="switch-box">
        <div class="switch-glider" id="switchGlider"></div>
        <button class="s-btn active" id="btn1" onclick="switchCode(1)">Kanal 1: Yöresel Şive</button>
        <button class="s-btn" id="btn2" onclick="switchCode(2)">Kanal 2: Standart Türkçe</button>
      </div>
      
      <div class="switch-content">
        <div class="s-text" id="switchText">"Uşağum napanaysun, celiceysun mi?"</div>
        <div class="s-desc" id="switchDesc">📍 Ev/Aile Ortamı (Samimi, doğal, bölgesel melodi serbest)</div>
      </div>
    </div>
  </div>

  <!-- 🌍 REGIONAL GYM 🌍 -->
  <div class="glass reveal">
    <div class="section-label">🗺️ Fonetik Temizleme Odası</div>
    <p style="color:#94a3b8; font-size:1rem; line-height:1.8; margin-bottom:30px;">Kendi yörenizin veya yabancı dilinizin bıraktığı fonetik izleri (daralma, yutma, K-G değişimi) standart Türkçeye adapte edin.</p>
    
    <div class="gym-container">
      <div class="gym-card" onclick="startShadowing('karadeniz')">
        <div class="gym-icon">🌊</div>
        <div class="gym-title">Karadeniz Nötrleme</div>
        <div class="gym-desc">Hızı kesme, C-Ç ve K-G karmaşasını düzeltme, vurguyu kelime sonuna alma.</div>
      </div>
      
      <div class="gym-card" onclick="startShadowing('dogu')">
        <div class="gym-icon">⛰️</div>
        <div class="gym-title">Doğu/G.Doğu Nötrleme</div>
        <div class="gym-desc">Kalın "I" ve gırtlak seslerini yumuşatma, ince ünlüleri (E, İ) öne taşıma.</div>
      </div>
      
      <div class="gym-card" onclick="startShadowing('ege')">
        <div class="gym-icon">☀️</div>
        <div class="gym-title">Ege Nötrleme</div>
        <div class="gym-desc">Yutulan "R" ve "K" seslerini geri getirme, yayvan cümleleri sertleştirme.</div>
      </div>
      
      <div class="gym-card" onclick="startShadowing('yabanci')">
        <div class="gym-icon">🇬🇧</div>
        <div class="gym-title">İngilizce/Yabancı Aksan</div>
        <div class="gym-desc">Amerikan tarzı yuvarlak R'leri ve patlamalı P-T seslerini Türkçe diş seslerine çekme.</div>
      </div>
    </div>
  </div>

  <!-- 🌍 MASTER WORKOUT PANEL 🌍 -->
  <div class="workout-panel reveal" id="workoutPanel" style="display:none;">
    <div class="section-label" style="justify-content:center; color:#fcd34d;" id="workoutTitle">⚙️ Adaptasyon Başlıyor</div>
    <div class="workout-hint" id="workoutHint">Yönergeyi takip edin.</div>
    <div class="workout-display" id="workoutDisplay">"Okuma Metni"</div>
    <button class="workout-btn" id="workoutActionBtn" onclick="nextShadowStep()">Sonraki Adım</button>
  </div>

  <!-- 🌍 PRO TIP 🌍 -->
  <div style="background:linear-gradient(135deg,rgba(245,158,11,.1),rgba(251,191,36,.05)); border:1px solid rgba(245,158,11,.3); border-radius:24px; padding:30px; font-size:1rem; color:#e2e8f0; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">🧠</span>
    <div>
      <strong style="color:#fbbf24; display:block; margin-bottom:8px;">Altın Kural: Kasıtlı Olarak Robotlaşmak</strong>
      Nötr bir İstanbul Türkçesine geçiş yaparken beyniniz kendi alışık olduğu bölgesel "müziği" diretecektir. Bunu kırmak için antrenmanlarda kasıtlı olarak bir "robot" gibi, tamamen düz (monoton) ve yavaş okuma yapın. Eski melodi silinmeden (düzleşmeden), üzerine yeni standart melodi yazılamaz!
    </div>
  </div>

</div>

<script>
// 🌍 Scroll Reveal 🌍
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🌍 Code Switcher Logic 🌍
function switchCode(channel) {
  const glider = document.getElementById('switchGlider');
  const btn1 = document.getElementById('btn1');
  const btn2 = document.getElementById('btn2');
  const text = document.getElementById('switchText');
  const desc = document.getElementById('switchDesc');
  
  text.style.opacity = '0';
  desc.style.opacity = '0';
  
  setTimeout(() => {
    if(channel === 1) {
      glider.style.transform = 'translateX(0)';
      btn1.classList.add('active');
      btn2.classList.remove('active');
      
      text.innerHTML = '"Nörüyon, napıyon, gelicin mi?"';
      desc.innerHTML = '📍 Ev/Aile Ortamı (Samimi, doğal, bölgesel melodi serbest)';
      text.style.color = '#fff';
    } else {
      glider.style.transform = 'translateX(100%)';
      btn2.classList.add('active');
      btn1.classList.remove('active');
      
      text.innerHTML = '"Ne yapıyorsun, gelecek misin?"';
      desc.innerHTML = '🏢 İş/Resmi Ortam (İstanbul Türkçesi, net, kurallı, nötr)';
      text.style.color = '#fcd34d';
    }
    text.style.opacity = '1';
    desc.style.opacity = '1';
  }, 300);
}

// 🌍 Shadowing / Workout Logic 🌍
const shadowData = {
  karadeniz: {
    title: '🌊 Karadeniz Nötrleme (Hız ve Ünsüz)',
    steps: [
      { text: 'Celiceysun -> Geleceksin', hint: 'Dilinizi damağa (C) değil, geriye (G) vurun.' },
      { text: 'Konuşma Hızı: %30 Düşürün.', hint: 'Kelimeleri taramalı tüfek gibi değil, yaya yaya okuyun.' },
      { text: 'GEliceysun -> GeleCEKsin', hint: 'Vurguyu kelimenin başından alıp, EN SON heceye atın.' }
    ]
  },
  dogu: {
    title: '⛰️ Doğu Nötrleme (Gırtlak ve Ünlü)',
    steps: [
      { text: 'Hardeş -> Kardeş', hint: 'K harfini boğazdan (Hı gibi) değil, damaktan (Tık) çıkarın.' },
      { text: 'Bän -> Ben (Kapalı E)', hint: 'E harfini A\'ya yaklaştırmayın. Dudaklarınızı hafif gererek İnce E yapın.' },
      { text: 'Gırtlağı Bırakın, Öne Gelin.', hint: 'Sesi boğazınızın arkasında değil, dudaklarınızda titreştirin.' }
    ]
  },
  ege: {
    title: '☀️ Ege Nötrleme (Yutma ve Melodi)',
    steps: [
      { text: 'Geliom -> GeliyoR-um', hint: 'R harfini asla yutmayın, dil ucunu titretin.' },
      { text: 'Yapıceeeez -> YapıcaZ', hint: 'Cümle sonunu sündürmeyin. Nokta geldiğinde sesi aniden ve sertçe kesin.' },
      { text: 'Dudak Tembelliği', hint: 'Kelimeleri yuvarlamayın, ağzınızı standarttan daha fazla açın.' }
    ]
  },
  yabanci: {
    title: '🇬🇧 İngilizce Aksanı Nötrleme',
    steps: [
      { text: 'RRetroflex -> TTürkçe R (Tap)', hint: 'R derken dili boğaza kıvırmayın, sadece üst diş etine 1 kez vurun.' },
      { text: 'PhatlaT(h)ma -> Patlatma', hint: 'T ve P söylerken ağzınızdan "H" havası (Nefes) çıkmasın.' },
      { text: 'Melodi (Uptalk)', hint: 'İngilizcedeki gibi sesi cümle sonunda yukarı bükmeyin. Düz ve aşağı bitsin.' }
    ]
  }
};

let currentShadow = null;
let currentShadowIndex = 0;

function startShadowing(id) {
  currentShadow = shadowData[id];
  currentShadowIndex = 0;
  
  const panel = document.getElementById('workoutPanel');
  panel.style.display = 'block';
  
  document.getElementById('workoutTitle').innerHTML = currentShadow.title;
  
  const step = currentShadow.steps[0];
  document.getElementById('workoutDisplay').innerHTML = step.text;
  document.getElementById('workoutHint').innerHTML = step.hint;
  document.getElementById('workoutActionBtn').innerHTML = 'Anladım, Uyguluyorum';
  
  currentShadowIndex = 1;
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function nextShadowStep() {
  if(!currentShadow) return;
  
  if(currentShadowIndex < currentShadow.steps.length) {
    const step = currentShadow.steps[currentShadowIndex];
    document.getElementById('workoutDisplay').innerHTML = step.text;
    document.getElementById('workoutHint').innerHTML = step.hint;
    document.getElementById('workoutActionBtn').innerHTML = (currentShadowIndex === currentShadow.steps.length - 1) ? 'Egzersizi Tamamla' : 'Anladım, Sonraki';
    currentShadowIndex++;
  } else {
    document.getElementById('workoutDisplay').innerHTML = '✅ Adaptasyon Başarılı.';
    document.getElementById('workoutHint').innerHTML = 'Bu kuralları her gün bir metin okuyarak kas hafızasına alın.';
    document.getElementById('workoutActionBtn').innerHTML = 'Başa Dön';
    currentShadowIndex = 0;
  }
}
</script>

<%- include('partials/main-footer') %>
