<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🎙️ Hero 🎙️ */
  .v-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 20%, #8b5cf622, transparent 70%);
  }
  .v-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#f8fafc,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: vFloat 8s ease-in-out infinite; background: linear-gradient(135deg, #8b5cf6, #d946ef); }
  @keyframes vFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.1; } 50%{ transform:translateY(-50px) scale(1.5); opacity:.4; } }

  .v-icon { font-size: 6rem; margin-bottom: 20px; animation: vPulse 2.5s ease-in-out infinite; filter: drop-shadow(0 0 30px #8b5cf666); }
  @keyframes vPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.05) translateY(-5px); } }

  .v-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#ddd6fe; background:#8b5cf618; border:1px solid #8b5cf644; margin-bottom:24px; box-shadow: 0 0 20px #8b5cf622; }
  .v-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color:#0f172a; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .v-title span { background: linear-gradient(135deg, #a855f7, #e879f9); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .v-subtitle { color:#0f172a; font-size:1.15rem; max-width:700px; line-height:1.8; }

  /* 🎙️ Container 🎙️ */
  .v-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 🎙️ Glass Cards 🎙️ */
  .glass { background:rgba(15,23,42,.02); backdrop-filter:blur(20px); border:1px solid rgba(15,23,42,.05); border-radius:24px; padding:40px; margin-bottom:40px; transition:transform .4s,box-shadow .4s; position: relative; overflow: hidden; }
  .glass::before { content:''; position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg,transparent,rgba(15,23,42,.1),transparent); }
  .glass:hover { transform:translateY(-5px); box-shadow:0 30px 60px rgba(15,23,42,.4),0 0 40px #8b5cf611; border-color:rgba(139,92,246,.2); }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#c084fc; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background:#c084fc; border-radius:2px; }

  /* 🎙️ Teleprompter Studio 🎙️ */
  .prompter-container { background: #f8fafc; border: 4px solid #cbd5e1; border-radius: 16px; overflow: hidden; position: relative; height: 350px; box-shadow: inset 0 0 20px rgba(0,0,0,0.02); }
  .prompter-screen { position: absolute; inset: 0; padding: 40px 60px; overflow: hidden; display: flex; align-items: flex-start; justify-content: center; }
  
  /* The moving text wrapper */
  .prompter-text-wrapper { position: absolute; top: 100%; width: 80%; text-align: center; transition: transform 0.1s linear; }
  .prompter-text { font-size: 2.5rem; font-weight: 700; color: #0f172a; line-height: 1.5; text-shadow: 0 0 10px rgba(139, 92, 246, 0.1); font-family: 'Inter', sans-serif; }
  
  /* Reading Focus Line */
  .reading-line { position: absolute; top: 50%; left: 0; width: 100%; height: 60px; transform: translateY(-50%); background: linear-gradient(180deg, transparent, rgba(139,92,246,0.1) 50%, transparent); border-top: 1px dashed rgba(139,92,246,0.4); border-bottom: 1px dashed rgba(139,92,246,0.4); pointer-events: none; z-index: 10; }
  .reading-line::before { content: '▶'; position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: #8b5cf6; font-size: 1.5rem; }
  .reading-line::after { content: '◀'; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: #8b5cf6; font-size: 1.5rem; }

  .p-controls { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 20px; background: rgba(15,23,42,.2); padding: 15px; border-radius: 16px; border: 1px solid rgba(139,92,246,.2); }
  .p-btn { padding: 10px 24px; border-radius: 12px; background: rgba(139,92,246,.15); border: 1px solid rgba(139,92,246,.3); color: #ddd6fe; font-size: .95rem; font-weight: 700; cursor: pointer; transition: all .3s; display: flex; align-items: center; gap: 8px; }
  .p-btn:hover { background: rgba(139,92,246,.3); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(139,92,246,.2); }
  .p-btn.active { background: #8b5cf6; color: #fff; box-shadow: 0 0 20px rgba(139,92,246,.4); }

  /* 🎙️ Voice Booth Gym 🎙️ */
  .gym-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .gym-container { grid-template-columns: 1fr; } }
  
  .gym-card { background: rgba(15,23,42,.3); border: 1px solid rgba(139,92,246,.15); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all .3s; position: relative; overflow: hidden; }
  .gym-card::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at center, rgba(139,92,246,.1), transparent); opacity:0; transition:opacity .3s; }
  .gym-card:hover { border-color: #8b5cf6; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(139,92,246,.15); }
  .gym-card:hover::after { opacity: 1; }
  
  .gym-icon { font-size: 3rem; margin-bottom: 12px; display: inline-block; transition: transform .3s; }
  .gym-card:hover .gym-icon { transform: scale(1.15) translateY(-5px); }
  
  .gym-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .gym-desc { font-size: 0.85rem; color: #475569; line-height: 1.6; }

  /* 🎙️ Master Workout Panel 🎙️ */
  .workout-panel { background: linear-gradient(145deg, #1e0a29, #f8fafc); border: 1px solid #8b5cf633; border-radius: 24px; padding: 40px; margin-top: 20px; text-align: center; position: relative; overflow: hidden; }
  .workout-panel::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle at center, rgba(139,92,246,.05) 0%, transparent 50%); animation: rotateGlow 15s linear infinite; pointer-events:none; }
  @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .workout-display { font-size: 1.8rem; font-weight: 700; color: #fff; line-height: 1.6; margin: 24px 0; min-height: 60px; display: flex; align-items: center; justify-content: center; font-style: italic; color: #e9d5ff; }
  .workout-hint { color: #c084fc; font-size: 1rem; font-weight: 600; margin-bottom: 30px; }
  
  .workout-btn { padding: 16px 40px; border-radius: 100px; background: linear-gradient(135deg, #8b5cf6, #d946ef); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(139,92,246,.4); transition: all .3s; text-transform: uppercase; letter-spacing: 2px; }
  .workout-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(139,92,246,.6); }
  .workout-btn:active { transform: scale(0.98); }

  /* 🎙️ Back Button 🎙️ */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(15,23,42,.05); border:1px solid rgba(15,23,42,.1); color:#475569; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(15,23,42,.1); color:#fff; transform:translateX(-4px); }

  /* 🎙️ Reveal 🎙️ */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="v-hero">
  <div class="hero-particles">
    <% for(let i=0; i<30; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 2+Math.random()*5 %>px; height:<%= 2+Math.random()*5 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 4+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="v-icon">🎙️</div>
  <div class="v-badge">🔴 On Air | Seslendirme Stüdyosu</div>
  <h1 class="v-title"><span>Profesyonel</span> Metin Okuma</h1>
  <p class="v-subtitle">Haber bülteni, belgesel, reklam ve podcast sunuculuğu... Sesinizi bir enstrüman gibi kullanarak metinleri duyguyla ve otoriteyle ayağa kaldırın.</p>
</section>

<div class="v-wrap">
  <a href="/diksiyon?cat=okuma" class="back-btn">Tüm Okuma Egzersizlerini Gör</a>

  <!-- 🎙️ TELEPROMPTER 🎙️ -->
  <div class="glass reveal">
    <div class="section-label">📜 Teleprompter Simülatörü</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:20px;">Gözünüzü odak çizgisinden ayırmadan, metin henüz aşağıdan gelirken kelimeleri zihninize alarak "okumuyor, konuşuyor" illüzyonu yaratın.</p>

    <div class="prompter-container">
      <div class="reading-line"></div>
      <div class="prompter-screen">
        <div class="prompter-text-wrapper" id="prompterWrapper">
          <div class="prompter-text" id="prompterText">
            Sayın seyirciler, iyi akşamlar.<br><br>
            Bugün stüdyomuzda, geleceğin teknolojilerini<br>
            ve yapay zekanın hayatımıza etkilerini konuşacağız.<br><br>
            Uzmanların hazırladığı son rapora göre,<br>
            önümüzdeki on yıl içinde iş yapış şekillerimiz<br>
            kökünden değişecek.<br><br>
            Lütfen gözlerinizi kırmızı çizgide tutun<br>
            ve kelimeler çizgiye geldiğinde seslendirin.<br>
            Haberin detayları için, şimdi bağlanıyoruz...
          </div>
        </div>
      </div>
    </div>
    
    <div class="p-controls">
      <button class="p-btn" onclick="startPrompter()" id="btnStart">▶️ Başlat</button>
      <button class="p-btn" onclick="pausePrompter()" id="btnPause" style="display:none;">⏸️ Duraklat</button>
      <button class="p-btn" onclick="resetPrompter()">🔄 Sıfırla</button>
      <div style="width:1px; background:rgba(15,23,42,0.1); margin:0 10px;"></div>
      <button class="p-btn" onclick="changeSpeed(1)">Yavaş</button>
      <button class="p-btn active" onclick="changeSpeed(2)" id="btnSpeed2">Normal</button>
      <button class="p-btn" onclick="changeSpeed(3)">Hızlı (Spiker)</button>
    </div>
  </div>

  <!-- 🎙️ THE GYM 🎙️ -->
  <div class="glass reveal">
    <div class="section-label">🎧 Seslendirme Kabini</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:30px;">Farklı profesyonel formatlarda sesin tınısını, hızını ve duygusunu ayarlama egzersizleri.</p>
    
    <div class="gym-container">
      <div class="gym-card" onclick="startVoiceWorkout('haber')">
        <div class="gym-icon">📺</div>
        <div class="gym-title">Haber Bülteni (Otorite)</div>
        <div class="gym-desc">Nötr, objektif, net vurgular ve cümle sonu düşüşleriyle TRT stili resmi okuma.</div>
      </div>
      
      <div class="gym-card" onclick="startVoiceWorkout('belgesel')">
        <div class="gym-icon">🌍</div>
        <div class="gym-title">Belgesel (Derinlik)</div>
        <div class="gym-desc">Pes ses (göğüs rezonansı) kullanarak yavaş, gizemli ve epik seslendirme.</div>
      </div>
      
      <div class="gym-card" onclick="startVoiceWorkout('reklam')">
        <div class="gym-icon">🎬</div>
        <div class="gym-title">Reklam (Enerji)</div>
        <div class="gym-desc">"Gülümseyen Ses" tekniğiyle yüksek tempolu, dikkat çekici, ikna edici okuma.</div>
      </div>
      
      <div class="gym-card" onclick="startVoiceWorkout('masal')">
        <div class="gym-icon">🧚</div>
        <div class="gym-title">Masal (Mimik & Renk)</div>
        <div class="gym-desc">Tüm ses sınırlarını, abartılı esleri ve karakter taklitlerini barındıran okuma.</div>
      </div>
    </div>
  </div>

  <!-- 🎙️ MASTER WORKOUT PANEL 🎙️ -->
  <div class="workout-panel reveal" id="workoutPanel" style="display:none;">
    <div class="section-label" style="justify-content:center; color:#e879f9;" id="workoutTitle">🔴 Kayıt Başlıyor</div>
    <div class="workout-hint" id="workoutHint">Metni okumadan önce derin bir diyafram nefesi alın.</div>
    <div class="workout-display" id="workoutDisplay">"Ses deneme bir, iki..."</div>
    <button class="workout-btn" id="workoutActionBtn" onclick="nextWorkoutStep()">Sonraki Cümle</button>
  </div>

  <!-- 🎙️ PRO TIP 🎙️ -->
  <div style="background:linear-gradient(135deg,rgba(139,92,246,.1),rgba(217,70,239,.05)); border:1px solid rgba(139,92,246,.3); border-radius:24px; padding:30px; font-size:1rem; color:#e2e8f0; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">💡</span>
    <div>
      <strong style="color:#c084fc; display:block; margin-bottom:8px;">Altın Kural: Phrasing (Cümle Bölümleme)</strong>
      Metin okurken amatörler sadece virgül ve noktalarda durur. Profesyoneller ise cümlenin anlamına göre görünmez virgüller yaratarak kelime öbekleri (phrasing) oluştururlar. Gözünüzle daima ağzınızdan çıkan kelimenin 2-3 kelime ilerisini okuyun (Eye-lead tekniği).
    </div>
  </div>

</div>

<script>
// 🎙️ Scroll Reveal 🎙️
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🎙️ Teleprompter Logic 🎙️
let prompterInterval;
let currentPos = 0;
let isPlaying = false;
let speed = 1.5; // pixels per frame (approx 60fps)

function startPrompter() {
  if(isPlaying) return;
  isPlaying = true;
  document.getElementById('btnStart').style.display = 'none';
  document.getElementById('btnPause').style.display = 'flex';
  
  const wrapper = document.getElementById('prompterWrapper');
  
  prompterInterval = requestAnimationFrame(animatePrompter);
}

function animatePrompter() {
  currentPos -= speed;
  const wrapper = document.getElementById('prompterWrapper');
  wrapper.style.transform = `translateY(${currentPos}px)`;
  
  // Reset condition - arbitrary large number to detect end
  if(currentPos < -800) {
    pausePrompter();
    return;
  }
  
  if(isPlaying) {
    prompterInterval = requestAnimationFrame(animatePrompter);
  }
}

function pausePrompter() {
  isPlaying = false;
  cancelAnimationFrame(prompterInterval);
  document.getElementById('btnStart').style.display = 'flex';
  document.getElementById('btnPause').style.display = 'none';
}

function resetPrompter() {
  pausePrompter();
  currentPos = 0;
  document.getElementById('prompterWrapper').style.transform = `translateY(${currentPos}px)`;
}

function changeSpeed(level) {
  // Reset active classes
  const btns = document.querySelectorAll('.p-controls .p-btn');
  btns.forEach(b => {
    if(b.innerText.includes('Yavaş') || b.innerText.includes('Normal') || b.innerText.includes('Hızlı')) {
      b.classList.remove('active');
    }
  });
  
  event.target.classList.add('active');
  
  if(level === 1) speed = 0.8;
  if(level === 2) speed = 1.5;
  if(level === 3) speed = 2.5;
}

// 🎙️ Voice Workout Logic 🎙️
const voiceWorkouts = {
  haber: {
    title: '📺 Haber Bülteni Okuması',
    steps: [
      { text: '"Sayın seyirciler, iyi akşamlar..."', hint: 'Dik durun, nötr bir ifade takının, net ve otoriter bir tonla girin.' },
      { text: '"Piyasalardaki son dalgalanmaların ardından, Merkez Bankası beklenen açıklamayı yaptı."', hint: 'Virgülde yarım saniye es verin, cümlenin sonunu noktada tamamen kesin.' },
      { text: '"Açıklamada, faiz oranlarının sabit tutulacağı belirtildi."', hint: 'Haberi okumayın, yetkili bir kişi olarak halka BİLDİRİN.' }
    ]
  },
  belgesel: {
    title: '🌍 Belgesel (Voice-Over)',
    steps: [
      { text: '"Derin okyanusların karanlık sularında..."', hint: 'Çok yavaş. Sesi göğsünüzde (pes tonda) hissedin.' },
      { text: '"Yüzyıllardır keşfedilmeyi bekleyen bir sır yatıyordu..."', hint: 'Kelimeleri uzatın, gizem katın. Aralarda uzun sessizlikler bırakın.' },
      { text: '"Zamanın unuttuğu bu diyar, artık uyanmaya hazır."', hint: 'Son cümlede sesi iyice fısıltıya yaklaştırıp etkiyi büyütün.' }
    ]
  },
  reklam: {
    title: '🎬 Reklam Seslendirme',
    steps: [
      { text: '"Bu fırsatı sakın kaçırmayın!"', hint: 'Yüzünüze kocaman bir gülümseme yerleştirin. Yüksek enerji!' },
      { text: '"Sadece bu hafta sonuna özel, tüm ürünlerde yüzde elli indirim sizleri bekliyor!"', hint: 'Yüzde elli kelimelerini patlatın. Tempo hiç düşmesin.' },
      { text: '"Hemen mağazalarımıza gelin, yaza hazır girin!"', hint: 'Sonunda sesi aşağı değil, heyecanla yukarı (ikna edici) bükün.' }
    ]
  },
  masal: {
    title: '🧚 Masal Anlatıcılığı',
    steps: [
      { text: '"Evvel zaman içinde, kalbur saman içinde..."', hint: 'Tekerleme ritminde, müzikal ve neşeli.' },
      { text: '"Ormanın derinliklerinde kocamaaaan bir dev yaşarmış..."', hint: '"Kocamaaaan" derken sesinizi gerçekten dev gibi kalınlaştırın.' },
      { text: '"Dev aniden kapıyı açınca: KİİİM VAAAAR ORADAAAA? diye kükremiş."', hint: 'Duygu geçişi! Aniden sesi değiştirip çocuğu şaşırtın.' }
    ]
  }
};

let currentVoiceWorkout = null;
let currentVoiceStepIndex = 0;

function startVoiceWorkout(id) {
  currentVoiceWorkout = voiceWorkouts[id];
  currentVoiceStepIndex = 0;
  
  const panel = document.getElementById('workoutPanel');
  panel.style.display = 'block';
  
  document.getElementById('workoutTitle').innerHTML = currentVoiceWorkout.title;
  
  const step = currentVoiceWorkout.steps[0];
  document.getElementById('workoutDisplay').innerHTML = step.text;
  document.getElementById('workoutHint').innerHTML = step.hint;
  document.getElementById('workoutActionBtn').innerHTML = 'Sonraki Cümle';
  
  currentVoiceStepIndex = 1;
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function nextWorkoutStep() {
  if(!currentVoiceWorkout) return;
  
  if(currentVoiceStepIndex < currentVoiceWorkout.steps.length) {
    const step = currentVoiceWorkout.steps[currentVoiceStepIndex];
    document.getElementById('workoutDisplay').innerHTML = step.text;
    document.getElementById('workoutHint').innerHTML = step.hint;
    document.getElementById('workoutActionBtn').innerHTML = (currentVoiceStepIndex === currentVoiceWorkout.steps.length - 1) ? 'Kayıt Bitti (Bitir)' : 'Sonraki Cümle';
    currentVoiceStepIndex++;
  } else {
    document.getElementById('workoutDisplay').innerHTML = 'Kestik! Harika Bir Performans. 🎬';
    document.getElementById('workoutHint').innerHTML = 'Farklı bir metin stili seçerek çalışmaya devam edebilirsiniz.';
    document.getElementById('workoutActionBtn').innerHTML = 'Tekrar Kayda Gir';
    currentVoiceStepIndex = 0;
  }
}
</script>

<%- include('partials/main-footer') %>


