<%- include('partials/main-header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');

  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.gorgu-page { 
    max-width: 100% !important; padding: 0 !important; margin: 0 !important; width: 100% !important; background: transparent !important;
  }
  
  :root {
    --gold-primary: #C59D5F; 
    --gold-dark: #9A7B4F;
    --gold-light: #F3EBE1;
    --text-main: #1c1917;
    --text-muted: #57534e;
    --bg-card: #ffffff;
  }

  .s-container {
    max-width: 1200px;
    margin: 60px auto;
    padding: 20px;
    min-height: 85vh;
  }

  .s-header { text-align: center; margin-bottom: 60px; }
  .s-badge {
    display: inline-block; padding: 8px 24px; background: var(--gold-light); color: var(--gold-dark);
    border-radius: 30px; font-family: 'Outfit'; font-weight: 800; font-size: 0.85rem; text-transform: uppercase;
    letter-spacing: 2px; margin-bottom: 20px;
  }
  .s-title { font-family: 'Playfair Display', serif; font-size: 4rem; color: var(--text-main); margin: 0 0 20px 0; line-height: 1.1; }
  .s-desc { font-family: 'Outfit', sans-serif; color: var(--text-muted); font-size: 1.15rem; max-width: 700px; margin: 0 auto; line-height:1.7; }

  /* GAME BOARD */
  .game-board {
    background: var(--bg-card);
    border: 1px solid rgba(197, 157, 95, 0.2);
    border-radius: 32px;
    padding: 60px 40px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    margin-bottom: 80px;
  }

  .question-box { text-align: center; margin-bottom: 60px; }
  .q-level { font-family: 'Outfit'; font-weight: 800; color: var(--gold-primary); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; }
  .q-text { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--text-main); max-width: 800px; line-height: 1.4; margin: 0 auto; }

  /* PLATE & CUTLERY CSS ART */
  .table-setting {
    position: relative;
    width: 350px; height: 350px;
    margin-bottom: 60px;
  }
  .plate {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: #ffffff; border-radius: 50%; border: 3px solid #f3ebe1;
    box-shadow: inset 0 0 30px rgba(197, 157, 95, 0.05), 0 20px 40px rgba(0,0,0,0.08);
  }
  .plate-inner {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 230px; height: 230px; border-radius: 50%; border: 1px solid #f8f4f0;
    box-shadow: inset 0 0 15px rgba(0,0,0,0.02);
  }

  .cutlery {
    position: absolute; top: 50%; left: 50%;
    transform-origin: center center;
    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 5px 5px 15px rgba(0,0,0,0.1);
  }
  
  /* FORK (Çatal) */
  .fork {
    width: 14px; height: 160px;
    background: linear-gradient(135deg, #e5e7eb, #9ca3af);
    border-radius: 7px; margin-top: -80px; margin-left: -7px; z-index: 2;
  }
  .fork::before {
    content: ''; position: absolute; top: -35px; left: -11px;
    width: 36px; height: 45px;
    background: linear-gradient(135deg, #e5e7eb, #9ca3af);
    border-radius: 12px 12px 15px 15px;
    clip-path: polygon(0% 0%, 20% 0%, 20% 60%, 30% 60%, 30% 0%, 50% 0%, 50% 60%, 70% 60%, 70% 0%, 90% 0%, 90% 60%, 100% 60%, 100% 100%, 0% 100%);
  }

  /* KNIFE (Bıçak) */
  .knife {
    width: 18px; height: 170px;
    background: linear-gradient(135deg, #f3f4f6, #9ca3af);
    border-radius: 9px 9px 5px 5px; margin-top: -85px; margin-left: -9px; z-index: 1;
  }
  .knife::before {
    content: ''; position: absolute; top: -45px; left: 0;
    width: 18px; height: 70px;
    background: linear-gradient(135deg, #ffffff, #d1d5db);
    border-radius: 20px 0 0 0;
  }

  /* STATES */
  .state-start .fork { transform: translate(-220px, 0) rotate(0deg); }
  .state-start .knife { transform: translate(220px, 0) rotate(0deg); }
  .state-mola .fork { transform: translate(-40px, -20px) rotate(45deg); }
  .state-mola .knife { transform: translate(40px, -20px) rotate(-45deg); }
  .state-bitti .fork { transform: translate(20px, -20px) rotate(45deg); }
  .state-bitti .knife { transform: translate(45px, -5px) rotate(45deg); }
  .state-mukemmel .fork { transform: translate(0, -20px) rotate(90deg); }
  .state-mukemmel .knife { transform: translate(0, 10px) rotate(90deg); }
  .state-ikinci .fork { transform: translate(0, 0) rotate(90deg); }
  .state-ikinci .knife { transform: translate(0, 0) rotate(0deg); }
  .state-begenmedim .fork { transform: translate(-40px, -20px) rotate(45deg); }
  .state-begenmedim .knife { transform: translate(10px, -20px) rotate(-45deg); }

  /* CONTROLS */
  .controls-grid {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 15px;
    width: 100%; max-width: 900px;
  }
  .btn-action {
    background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px;
    padding: 16px 24px; font-family: 'Outfit'; font-weight: 700; font-size: 1.05rem;
    color: var(--text-main); cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .btn-action:hover {
    border-color: var(--gold-primary); color: var(--gold-dark);
    transform: translateY(-3px); box-shadow: 0 10px 25px rgba(197, 157, 95, 0.15);
  }

  /* FEEDBACK OVERLAY */
  .fb-message {
    margin-top: 40px; padding: 25px; border-radius: 20px; text-align: center;
    font-family: 'Outfit'; display: none; width: 100%; max-width: 700px;
    animation: fadeIn 0.4s;
  }
  .fb-message.success { display: block; background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  .fb-message.error { display: block; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
  .fb-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; font-weight: 800; margin-bottom: 10px; }
  .fb-desc { font-size: 1.1rem; line-height: 1.6; }

  .btn-next {
    background: var(--text-main); color: #fff; border: none; padding: 14px 35px; border-radius: 30px;
    font-size: 1.1rem; font-family: 'Outfit'; font-weight: 700; cursor: pointer; transition: 0.3s; margin-top: 20px;
  }
  .btn-next:hover { background: var(--gold-primary); transform: translateY(-2px); box-shadow: 0 10px 20px rgba(197,157,95,0.3); }

  /* KAPSAMLI BİLGİ BÖLÜMÜ (Yeni Eklenenler) */
  .info-section { margin-top: 80px; }
  .info-section-title { font-family: 'Playfair Display', serif; font-size: 3rem; color: var(--text-main); text-align: center; margin-bottom: 50px; }
  
  .info-grid {
    display: grid; grid-template-columns: 1fr; gap: 40px;
  }
  @media(min-width: 1024px) {
    .info-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .info-card {
    background: #ffffff; border: 1px solid rgba(0,0,0,0.05); border-radius: 24px; padding: 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.02); transition: 0.4s; position: relative; overflow: hidden;
  }
  .info-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(197,157,95,0.1); border-color: rgba(197,157,95,0.3); }
  
  .ic-icon { font-size: 3rem; margin-bottom: 20px; }
  .ic-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--gold-dark); margin-bottom: 15px; }
  .ic-text { font-family: 'Outfit', sans-serif; font-size: 1.05rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 20px; }
  
  .ic-list { list-style: none; padding: 0; margin: 0; }
  .ic-list li { font-family: 'Outfit', sans-serif; font-size: 1rem; color: var(--text-main); margin-bottom: 12px; padding-left: 25px; position: relative; }
  .ic-list li::before { content: '•'; position: absolute; left: 0; color: var(--gold-primary); font-size: 1.5rem; line-height: 1; top: -2px; }

  /* KURAL KARTI */
  .rule-banner {
    background: var(--text-main); color: #fff; border-radius: 24px; padding: 50px; margin-top: 40px;
    text-align: center; background-image: radial-gradient(circle at top right, #3f3f46, transparent);
  }
  .rb-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--gold-primary); margin-bottom: 20px; }
  .rb-text { font-family: 'Outfit', sans-serif; font-size: 1.2rem; line-height: 1.6; max-width: 800px; margin: 0 auto; color: #d4d4d8; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  @media(max-width: 768px) {
    .s-title { font-size: 2.5rem; }
    .q-text { font-size: 1.6rem; }
    .table-setting { width: 250px; height: 250px; }
    .plate-inner { width: 160px; height: 160px; }
    .state-start .fork { transform: translate(-140px, 0) rotate(0deg); }
    .state-start .knife { transform: translate(140px, 0) rotate(0deg); }
    .info-section-title { font-size: 2.2rem; }
  }
</style>

<div class="gorgu-page">
  <div class="s-container">
    <div class="s-header">
      <div class="s-badge">Fine Dining Atölyesi</div>
      <h1 class="s-title">Sofra Mimarı: Çatal Bıçak Dili</h1>
      <p class="s-desc">Prestijli bir akşam yemeğindesiniz. Garsonlarla yüksek sesle konuşmak yerine, sadece çatal ve bıçağınızı doğru konumlandırarak masayı aristokrat bir sessizlikle yönetmeyi öğrenin.</p>
    </div>

    <!-- GAME BOARD -->
    <div class="game-board">
      
      <div class="question-box">
        <div class="q-level" id="qLevel">Senaryo 1 / 5</div>
        <div class="q-text" id="qText">Yemeğe kısa bir süreliğine ara verdiniz (lavaboya gideceksiniz). Tabağınızın alınmaması için çatal bıçağı nasıl bırakırsınız?</div>
      </div>

      <div class="table-setting state-start" id="tableSetting">
        <div class="plate"><div class="plate-inner"></div></div>
        <div class="cutlery fork"></div>
        <div class="cutlery knife"></div>
      </div>

      <div class="controls-grid" id="controlsGrid">
        <button class="btn-action" onclick="makeGuess('mola')">Mola Verdim</button>
        <button class="btn-action" onclick="makeGuess('bitti')">Bitirdim</button>
        <button class="btn-action" onclick="makeGuess('mukemmel')">Çok Beğendim</button>
        <button class="btn-action" onclick="makeGuess('begenmedim')">Beğenmedim</button>
        <button class="btn-action" onclick="makeGuess('ikinci')">Sıradaki Tabağa Geçin</button>
      </div>

      <div class="fb-message" id="fbMessage">
        <div class="fb-title" id="fbTitle">Harika!</div>
        <div class="fb-desc" id="fbDesc">Ters V şekli (veya kolların açık olması), garsona tabağınızı almaması gerektiğini söyler.</div>
        <button class="btn-next" onclick="nextQuestion()" id="btnNext">Sıradaki Senaryo</button>
      </div>
    </div>

    <!-- NEW INFORMATION SECTIONS -->
    <div class="info-section">
      <h2 class="info-section-title">İleri Seviye Sofra Adabı</h2>
      
      <div class="info-grid">
        
        <!-- NAPKIN -->
        <div class="info-card">
          <div class="ic-icon">🧻</div>
          <h3 class="ic-title">I. Kumaş Peçete Adabı</h3>
          <p class="ic-text">Kumaş peçete asla yakanıza asılmaz veya gömlek düğmenize iliklenmez. Sadece dizlerin üzerine örtülür.</p>
          <ul class="ic-list">
            <li><strong>Yemeğe başlarken:</strong> Peçete kibarca ortadan ikiye katlanarak (kat yeri size bakacak şekilde) dize serilir.</li>
            <li><strong>Ağız silme:</strong> Peçetenin sadece iç kısmıyla dudaklar nazikçe kurulanır, böylece dışta leke görünmez.</li>
            <li><strong>Masadan kısa süreli kalkış (Lavabo vb.):</strong> Peçete sandalyenin oturma kısmına (kolçağa değil) bırakılır. Bu "geri döneceğim" demektir.</li>
            <li><strong>Yemek bittiğinde:</strong> Peçete katlanmadan, hafifçe buruşturularak tabağın <strong>soluna</strong> bırakılır. Kirli kısımları içte kalmalıdır.</li>
          </ul>
        </div>

        <!-- GLASS -->
        <div class="info-card">
          <div class="ic-icon">🍷</div>
          <h3 class="ic-title">II. Kadeh Tutuşu ve İçecekler</h3>
          <p class="ic-text">İçecek kadehlerinin yanlış tutulması, fine dining ortamlarında yapılan en göze batan acemi hatalarından biridir.</p>
          <ul class="ic-list">
            <li><strong>Saptan Tutma Kuralı:</strong> Şarap, şampanya ve su kadehleri her zaman sadece ve sadece sapından tutulur. Kadehin çanak kısmından (gövdesinden) tutmak hem parmak izi bırakır hem de vücut ısınızla içeceğin sıcaklığını bozar.</li>
            <li><strong>Leke Bırakmamak:</strong> Kadınların ruj izi bırakmamak için kadehi her yudumda <strong>hep aynı noktadan</strong> içmesi gerekir. Kadehin etrafında ruj lekeleri çemberi oluşturmak kaba kabul edilir.</li>
            <li><strong>Tokuşturma:</strong> Şarap kadehleri tokuşturulurken üst ince kısımdan değil, alt bombeli "çan" kısmından hafifçe tokuşturulur (çatlamayı önler). Resmi yemeklerde tokuşturma yerine kadehi göz hizasına kaldırarak baş ile selam vermek daha elittir.</li>
          </ul>
        </div>

        <!-- POSTURE -->
        <div class="info-card">
          <div class="ic-icon">🪑</div>
          <h3 class="ic-title">III. Oturma ve Duruş Adabı</h3>
          <p class="ic-text">Masa başındaki duruşunuz, statünüzün sessiz bir yansımasıdır. Aristokrat bir duruş için omurga daima dik olmalıdır.</p>
          <ul class="ic-list">
            <li><strong>Dik Duruş:</strong> Yemeğe doğru eğilmeyin; yemeği (çatalı/kaşığı) ağzınıza götürün. Sırtınız sandalyeye yaslanmamalı, dik durmalısınız.</li>
            <li><strong>Dirsekler:</strong> Dirsekler asla masaya konmaz. Sadece ellerinizin bileğe kadar olan kısmı masanın kenarında durabilir.</li>
            <li><strong>Mesafe:</strong> Sandalyenizle masa arasında yaklaşık bir el genişliğinde (yaklaşık 10-15 cm) mesafe bırakmak idealdir.</li>
          </ul>
        </div>

        <!-- BREAD -->
        <div class="info-card">
          <div class="ic-icon">🥖</div>
          <h3 class="ic-title">IV. Ekmek ve Tereyağı Adabı</h3>
          <p class="ic-text">Ekmek tüketimi fine dining ortamlarında en çok hata yapılan konulardan biridir.</p>
          <ul class="ic-list">
            <li><strong>Bütün Isırılmaz:</strong> Ekmek asla bütün olarak ağza götürülüp ısırılmaz ve bıçakla kesilmez.</li>
            <li><strong>Koparma:</strong> Sol üstteki ekmek tabağınızda duran ekmekten, sadece o an yiyeceğiniz kadar (tek lokmalık) bir parça elle koparılır.</li>
            <li><strong>Tereyağı Sürme:</strong> Kopardığınız o tek lokmalık parçaya, kendi tereyağı bıçağınızla biraz tereyağı sürülür ve ağza atılır. Bütün ekmeğe tereyağı sürüp bekletmek kaba bir davranıştır.</li>
          </ul>
        </div>

        <!-- SOUP -->
        <div class="info-card">
          <div class="ic-icon">🥣</div>
          <h3 class="ic-title">V. Çorba İçme Kuralları</h3>
          <p class="ic-text">Çorba, yemeğe zarif bir başlangıç yapmanın ilk testidir.</p>
          <ul class="ic-list">
            <li><strong>Dışa Doğru:</strong> Kaşık, tabağın içinde kendinize doğru değil, <strong>sizden dışa doğru</strong> hareket ettirilerek doldurulur.</li>
            <li><strong>Yan Tarafından İçilir:</strong> Çorba kaşığın ucundan değil, yan (uzun) tarafından sessizce (höpürdetmeden) yudumlanır.</li>
            <li><strong>Tabağı Eğmek:</strong> Çorba azaldığında tabağı kendinize doğru değil, yine dışa doğru hafifçe eğerek alabilirsiniz. Bittiğinde kaşık tabağın veya altlığın içinde bırakılır.</li>
          </ul>
        </div>

        <!-- PAYING -->
        <div class="info-card">
          <div class="ic-icon">💳</div>
          <h3 class="ic-title">VI. Hesap ve Bahşiş Adabı</h3>
          <p class="ic-text">İş yemeklerinde hesabı ödeme anı, liderliği ve misafirperverliği gösterme fırsatıdır.</p>
          <ul class="ic-list">
            <li><strong>Davet Eden Öder:</strong> İş yemeklerinde kural basittir; yemeğe kim davet ettiyse hesabı o öder. Hesap ödeme tartışmasına girmek avam bir harekettir.</li>
            <li><strong>Sessiz Ödeme:</strong> Hesabı masada göz önünde ödemek yerine, lavaboya gitme bahanesiyle kalkıp kasada önceden ödemek veya kredi kartını önceden garsona bırakmak en prestijli yöntemdir.</li>
            <li><strong>Bahşiş:</strong> Fine dining restoranlarda, eğer hesaba servis ücreti eklenmemişse %10-%15 arası bahşiş bırakmak uluslararası bir standarttır.</li>
          </ul>
        </div>

        <!-- PHONE -->
        <div class="info-card">
          <div class="ic-icon">📱</div>
          <h3 class="ic-title">VII. Masada Telefon Kullanımı</h3>
          <p class="ic-text">Fine dining masasında telefonunuzun varlığı bile odak eksikliği ve saygısızlık mesajı verir.</p>
          <ul class="ic-list">
            <li><strong>Masadan Uzak:</strong> Cep telefonu, anahtar veya cüzdan kesinlikle masanın üzerine konulmamalıdır. Çantanızda veya cebinizde sessizde kalmalıdır.</li>
            <li><strong>Acil Durumlar:</strong> Çok acil bir telefon beklemeniz gerekiyorsa, bunu yemeğin başında ev sahibine ve masadakilere kibarca belirtmelisiniz.</li>
            <li><strong>Kalkarak Konuşmak:</strong> Telefon çaldığında masada oturarak konuşulmaz. Özür dileyip masadan kısa süreliğine ayrılmalı ve görüşmeyi masadan uzakta yapmalısınız.</li>
          </ul>
        </div>

        <!-- ACCIDENTS -->
        <div class="info-card">
          <div class="ic-icon">🍴</div>
          <h3 class="ic-title">VIII. Kazalar ve Düşen Eşyalar</h3>
          <p class="ic-text">Lüks bir mekanda yaşanacak ufak kazalarda soğukkanlı kalmak ve durumu profesyonellere bırakmak en doğrusudur.</p>
          <ul class="ic-list">
            <li><strong>Yerden Almayın:</strong> Çatalınız veya peçeteniz yere düştüğünde asla eğilip almaya çalışmayın. Sadece garsona hafifçe işaret ederek yenisini rica edin.</li>
            <li><strong>Dökülen İçecekler:</strong> Bir içeceği veya yemeği dökerseniz, kendi peçetenizle büyük bir telaş içinde temizlemeye çalışmak yerine garsonu çağırıp özür dileyerek temizliği onlara bırakın.</li>
            <li><strong>Gereksiz Özürler:</strong> Yaşanan kaza için masadakilerden bir kez nezaketen özür dilemek yeterlidir; konuyu sürekli gündemde tutmak atmosferi bozar.</li>
          </ul>
        </div>

        <!-- PACE -->
        <div class="info-card">
          <div class="ic-icon">⏱️</div>
          <h3 class="ic-title">IX. Yeme Hızı ve Sohbet Uyumu</h3>
          <p class="ic-text">Yemek masası aslında yemek yemekten çok sosyalleşme ve iş konuşma platformudur.</p>
          <ul class="ic-list">
            <li><strong>Hız Ayarı:</strong> Ne çok hızlı yiyip masada tabağı boş bekleyen ilk kişi olun, ne de çok yavaş yiyip diğerlerini bekletin. Masanın genel yeme hızına ayak uydurun.</li>
            <li><strong>Lokma Büyüklüğü:</strong> Lokmalarınızı sohbetinize engel olmayacak kadar küçük tutun. Ağzınızda yemek varken asla konuşmayın, yutmayı bekleyip ardından cevap verin.</li>
            <li><strong>Bıçakla İşaret:</strong> Konuşurken elinizdeki çatal veya bıçağı karşınızdaki kişiye doğru sallamak veya işaret etmek tehditkar ve kaba bir harekettir.</li>
          </ul>
        </div>

        <!-- TEA & COFFEE -->
        <div class="info-card">
          <div class="ic-icon">☕</div>
          <h3 class="ic-title">X. Çay ve Kahve Seremonisi</h3>
          <p class="ic-text">Yemeğin sonunu getiren çay ve kahve sunumu, nezaketin son sınavıdır.</p>
          <ul class="ic-list">
            <li><strong>Serçe Parmak Miti:</strong> Fincan kulpunu tutarken serçe parmağı havaya kaldırmak aristokratik değil, aksine yapay ve yanlış bir davranıştır. Kulpu başparmak ve işaret parmağı ile sıkıca tutun.</li>
            <li><strong>Kaşık Kullanımı:</strong> Çay veya kahve karıştırılırken kaşıkla fincanın kenarlarına vurulmamalı, girdap yaratmak yerine ileri-geri (saat 6 ve 12 yönünde) sessizce karıştırılmalıdır.</li>
            <li><strong>Kaşığın Yeri:</strong> Karıştırma işlemi bittikten sonra kaşık asla fincanın içinde bırakılmaz, altlığın yan tarafına (veya arasına) konur. Fincandan yudum alırken kaşığın da fincanla birlikte kalkması büyük bir hatadır.</li>
          </ul>
        </div>

      </div>

      <!-- RULE BANNER -->
      <div class="rule-banner">
        <h3 class="rb-title">Altın Kural: "Dıştan İçe"</h3>
        <p class="rb-text">Önünüze gelen çok sayıda çatal bıçak sizi asla korkutmamalıdır. Sofra mimarisinin evrensel kuralı <strong>"Dıştan İçe Doğru"</strong> kullanımdır. İlk gelen yemek (örneğin çorba veya başlangıç) için her zaman en dıştaki çatal/kaşık ve bıçağı alırsınız. Her tabak alındığında, boşalan çatal bıçaklar da alınır ve bir sonrakine geçilir. Tatlı takımları her zaman tabağın üst (kuzey) kısmında yatay olarak bekler.</p>
      </div>

    </div>

  </div>
</div>

<script>
  const questions = [
    {
      text: "Yemeğinize kısa bir ara verdiniz ve masadan kalkacaksınız. Garsonun tabağınızı boş sanıp almasını istemiyorsunuz.",
      targetState: "mola",
      explanation: "Doğru! Çatal ve bıçağı tabağın içinde 'Ters V' (/ \\) şeklinde (sapları size bakacak ve uçları birbirine değmeyecek şekilde) bırakmak 'mola verdim, yemeğe devam edeceğim' anlamına gelir."
    },
    {
      text: "Yemeğinizi tamamen bitirdiniz ve tabağınızın önünüzden alınmasını istiyorsunuz.",
      targetState: "bitti",
      explanation: "Doğru! Çatal ve bıçağı birbirine paralel olarak saat 4 yönünde (sağ alta bakacak şekilde) bırakmak 'yemeğimi bitirdim, alabilirsiniz' mesajıdır."
    },
    {
      text: "Yemek öylesine lezzetliydi ki, şefe iltifat etmek istiyorsunuz. Sessizce 'Mükemmeldi' mesajını nasıl verirsiniz?",
      targetState: "mukemmel",
      explanation: "Harika! Çatal ve bıçağı yatay olarak (saat 9-3 yönünde, bıçağın keskin yüzü çatala bakacak şekilde) paralel bırakmak 'yemek mükemmeldi' anlamına gelen zarif bir iltifattır."
    },
    {
      text: "İlk tabağınızı bitirdiniz ancak menüdeki ikinci tabağa (örneğin ana yemeğe) geçmek için hazır olduğunuzu belirtmek istiyorsunuz.",
      targetState: "ikinci",
      explanation: "Tebrikler! Çatalı dikey, bıçağı yatay şekilde bir artı (+) işareti gibi bırakmak 'sıradaki yemeğe hazırım, getirebilirsiniz' mesajıdır."
    },
    {
      text: "Yemeği hiç beğenmediniz ve bu memnuniyetsizliği nezaket çerçevesinde mekana iletmek istiyorsunuz.",
      targetState: "begenmedim",
      explanation: "Doğru! Bıçağın ucunu çatalın dişleri arasına sokarak Ters V şeklinde bırakmak 'yemeği beğenmedim' anlamına gelen uluslararası, sessiz bir eleştiri kodudur."
    }
  ];

  let currentQ = 0;
  const tableSetting = document.getElementById('tableSetting');
  const fbMessage = document.getElementById('fbMessage');

  function loadQuestion() {
    // Reset state
    tableSetting.className = 'table-setting state-start';
    fbMessage.className = 'fb-message';
    document.getElementById('controlsGrid').style.display = 'flex';
    
    document.getElementById('qLevel').innerText = `Senaryo ${currentQ + 1} / ${questions.length}`;
    document.getElementById('qText').innerText = questions[currentQ].text;
  }

  function makeGuess(state) {
    // Animate cutlery
    tableSetting.className = `table-setting state-${state}`;
    
    // Check answer after a brief delay for animation to start
    setTimeout(() => {
      const q = questions[currentQ];
      if (state === q.targetState) {
        fbMessage.className = 'fb-message success';
        document.getElementById('fbTitle').innerText = '✅ Kusursuz Zarafet!';
        document.getElementById('fbDesc').innerText = q.explanation;
        document.getElementById('controlsGrid').style.display = 'none'; // hide buttons
        
        if(currentQ === questions.length - 1) {
          document.getElementById('btnNext').innerText = "Akademiye Dön";
          document.getElementById('btnNext').onclick = () => window.location.href = '/gorgu';
        } else {
          document.getElementById('btnNext').innerText = "Sıradaki Senaryo";
          document.getElementById('btnNext').onclick = nextQuestion;
        }
      } else {
        fbMessage.className = 'fb-message error';
        document.getElementById('fbTitle').innerText = '❌ Yanlış Mesaj!';
        document.getElementById('fbDesc').innerText = "Bu dizilim garsona bambaşka bir mesaj iletecektir. Lütfen tekrar deneyin.";
        
        // Revert to start after a delay so they can try again
        setTimeout(() => {
          if(fbMessage.className.includes('error')) {
            tableSetting.className = 'table-setting state-start';
            fbMessage.className = 'fb-message';
          }
        }, 2500);
      }
    }, 400);
  }

  function nextQuestion() {
    currentQ++;
    if(currentQ < questions.length) {
      loadQuestion();
    }
  }

  // Init
  window.onload = () => {
    loadQuestion();
  };
</script>

