<%- include('partials/main-header') %>

<style>
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.gorgu-page { 
    max-width: 100% !important; padding: 0 !important; margin: 0 !important; width: 100% !important; background: transparent !important;
  }
  
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
  :root {
    --gold-primary: #C59D5F; 
    --gold-dark: #9A7B4F;
    --text-main: #1c1917;
    --text-muted: #57534e;
    --bg-card: #ffffff;
  }

  .s-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 20px;
    min-height: 85vh;
  }

  .s-header { text-align: center; margin-bottom: 40px; }
  .s-badge {
    display: inline-block; padding: 6px 20px; background: rgba(197, 157, 95, 0.1); color: var(--gold-dark);
    border-radius: 20px; font-family: 'Outfit'; font-weight: 700; font-size: 0.8rem; text-transform: uppercase;
    letter-spacing: 2px; margin-bottom: 20px;
  }
  .s-title { font-family: 'Playfair Display', serif; font-size: 3rem; color: var(--text-main); margin: 0 0 10px 0; }
  .s-desc { font-family: 'Outfit', sans-serif; color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height:1.6; }

  /* GAME BOARD */
  .game-board {
    background: var(--bg-card);
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .question-box {
    text-align: center;
    margin-bottom: 40px;
  }
  .q-level { font-family: 'Outfit'; font-weight: 800; color: var(--gold-dark); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }
  .q-text { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-main); max-width: 600px; line-height: 1.4; }

  /* PLATE & CUTLERY CSS ART */
  .table-setting {
    position: relative;
    width: 300px; height: 300px;
    margin-bottom: 40px;
  }
  .plate {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: #ffffff;
    border-radius: 50%;
    border: 2px solid #e5e7eb;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.03), 0 15px 30px rgba(0,0,0,0.08);
  }
  .plate-inner {
    position: absolute;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 1px solid #f3f4f6;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.02);
  }

  .cutlery {
    position: absolute;
    top: 50%; left: 50%;
    transform-origin: center center;
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); /* Bouncy transition */
    box-shadow: 3px 3px 10px rgba(0,0,0,0.15);
  }
  
  /* FORK (Çatal) */
  .fork {
    width: 12px; height: 140px;
    background: linear-gradient(135deg, #d1d5db, #9ca3af);
    border-radius: 6px;
    margin-top: -70px; margin-left: -6px; /* center perfectly */
    z-index: 2;
  }
  .fork::before {
    content: ''; position: absolute; top: -30px; left: -10px;
    width: 32px; height: 40px;
    background: linear-gradient(135deg, #d1d5db, #9ca3af);
    border-radius: 10px 10px 15px 15px;
    clip-path: polygon(0% 0%, 20% 0%, 20% 60%, 30% 60%, 30% 0%, 50% 0%, 50% 60%, 70% 60%, 70% 0%, 90% 0%, 90% 60%, 100% 60%, 100% 100%, 0% 100%);
  }

  /* KNIFE (Bıçak) */
  .knife {
    width: 16px; height: 150px;
    background: linear-gradient(135deg, #e5e7eb, #9ca3af);
    border-radius: 8px 8px 4px 4px;
    margin-top: -75px; margin-left: -8px;
    z-index: 1;
  }
  .knife::before {
    content: ''; position: absolute; top: -40px; left: 0;
    width: 16px; height: 60px;
    background: linear-gradient(135deg, #f3f4f6, #d1d5db);
    border-radius: 20px 0 0 0;
  }

  /* STATES */
  /* 0: Baslangic (Start) */
  .state-start .fork { transform: translate(-180px, 0) rotate(0deg); }
  .state-start .knife { transform: translate(180px, 0) rotate(0deg); }
  
  /* 1: Mola (Pause) - Ters V */
  .state-mola .fork { transform: translate(-40px, -20px) rotate(45deg); }
  .state-mola .knife { transform: translate(40px, -20px) rotate(-45deg); }

  /* 2: Bitti (Finished) - Paralel Saat 4 */
  .state-bitti .fork { transform: translate(20px, -20px) rotate(45deg); }
  .state-bitti .knife { transform: translate(45px, -5px) rotate(45deg); }

  /* 3: Mükemmel (Excellent) - Yatay Paralel */
  .state-mukemmel .fork { transform: translate(0, -20px) rotate(90deg); }
  .state-mukemmel .knife { transform: translate(0, 10px) rotate(90deg); }

  /* 4: İkinci Tabak (Ready for next plate) - Artı işareti */
  .state-ikinci .fork { transform: translate(0, 0) rotate(90deg); }
  .state-ikinci .knife { transform: translate(0, 0) rotate(0deg); }

  /* 5: Beğenmedim (Did not like) - Bıçak çatalın dişleri arasında */
  .state-begenmedim .fork { transform: translate(-40px, -20px) rotate(45deg); }
  .state-begenmedim .knife { transform: translate(10px, -20px) rotate(-45deg); }

  /* CONTROLS */
  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
    width: 100%;
    max-width: 800px;
  }
  .btn-action {
    background: #fafaf9;
    border: 2px solid #e5e7eb;
    border-radius: 16px;
    padding: 15px;
    font-family: 'Outfit';
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-main);
    cursor: pointer;
    transition: 0.3s;
  }
  .btn-action:hover {
    border-color: var(--gold-primary);
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(197, 157, 95, 0.15);
  }

  /* FEEDBACK OVERLAY */
  .fb-message {
    margin-top: 30px;
    padding: 20px;
    border-radius: 16px;
    text-align: center;
    font-family: 'Outfit';
    display: none;
    width: 100%;
    max-width: 600px;
    animation: fadeIn 0.4s;
  }
  .fb-message.success { display: block; background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
  .fb-message.error { display: block; background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
  .fb-title { font-size: 1.2rem; font-weight: 800; margin-bottom: 5px; }

  .btn-next {
    background: var(--text-main); color: #fff; border: none; padding: 12px 30px; border-radius: 20px;
    font-size: 1rem; font-weight: 700; cursor: pointer; transition: 0.3s; margin-top: 15px;
  }
  .btn-next:hover { background: var(--gold-primary); }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  @media(max-width: 768px) {
    .table-setting { width: 220px; height: 220px; }
    .plate-inner { width: 140px; height: 140px; }
    .s-title { font-size: 2.2rem; }
    .q-text { font-size: 1.4rem; }
    /* Adjust cutlery size for mobile */
    .fork { height: 100px; margin-top: -50px; }
    .knife { height: 110px; margin-top: -55px; }
    .fork::before { top: -20px; width: 24px; height: 30px; left: -6px; }
    .knife::before { top: -30px; height: 45px; }

    /* Adjust transforms for smaller plate */
    .state-start .fork { transform: translate(-120px, 0) rotate(0deg); }
    .state-start .knife { transform: translate(120px, 0) rotate(0deg); }
  }
</style>

<div class="gorgu-page">
  <div class="s-container">
    <div class="s-header">
      <div class="s-badge">Fine Dining Atölyesi</div>
      <h1 class="s-title">Sofra Mimarı: Çatal Bıçak Dili</h1>
      <p class="s-desc">Prestijli bir akşam yemeğindesiniz. Garsonlarla konuşmadan, sadece çatal ve bıçağınızı yerleştirerek onlara mesaj göndermeyi öğrenin.</p>
    </div>

    <div class="game-board">
      
      <div class="question-box">
        <div class="q-level" id="qLevel">Senaryo 1 / 5</div>
        <div class="q-text" id="qText">Yemeğe kısa bir süreliğine ara verdiniz (lavaboya gideceksiniz). Tabağınızın alınmaması için çatal bıçağı nasıl bırakırsınız?</div>
      </div>

      <div class="table-setting state-start" id="tableSetting">
        <div class="plate"><div class="plate-inner"></div></div>
        <div class="cutlery fork"></div>
        <div class="cutlery knife"></div>
      </div>

      <div class="controls-grid" id="controlsGrid">
        <button class="btn-action" onclick="makeGuess('mola')">Mola Verdim</button>
        <button class="btn-action" onclick="makeGuess('bitti')">Bitirdim</button>
        <button class="btn-action" onclick="makeGuess('mukemmel')">Çok Beğendim</button>
        <button class="btn-action" onclick="makeGuess('begenmedim')">Beğenmedim</button>
        <button class="btn-action" onclick="makeGuess('ikinci')">İkinci Tabağı Bekliyorum</button>
      </div>

      <div class="fb-message" id="fbMessage">
        <div class="fb-title" id="fbTitle">Harika!</div>
        <div id="fbDesc">Ters V şekli (veya kolların açık olması), garsona tabağınızı almaması gerektiğini söyler.</div>
        <button class="btn-next" onclick="nextQuestion()" id="btnNext">Sıradaki Senaryo</button>
      </div>

    </div>
  </div>
</div>

<script>
  const questions = [
    {
      text: "Yemeğinize kısa bir ara verdiniz ve masadan kalkacaksınız. Garsonun tabağınızı boş sanıp almasını istemiyorsunuz.",
      targetState: "mola",
      explanation: "Doğru! Çatal ve bıçağı tabağın içinde 'Ters V' (/\) şeklinde bırakmak 'mola verdim, yemeğe devam edeceğim' anlamına gelir."
    },
    {
      text: "Yemeğinizi tamamen bitirdiniz ve tabağınızın önünüzden alınmasını istiyorsunuz.",
      targetState: "bitti",
      explanation: "Doğru! Çatal ve bıçağı birbirine paralel olarak saat 4 yönünde bırakmak 'yemeğimi bitirdim, alabilirsiniz' mesajıdır."
    },
    {
      text: "Yemek öylesine lezzetliydi ki, şefe iltifat etmek istiyorsunuz. Sessizce 'Mükemmeldi' mesajını nasıl verirsiniz?",
      targetState: "mukemmel",
      explanation: "Harika! Çatal ve bıçağı yatay olarak (saat 9-3 yönünde) paralel bırakmak 'yemek mükemmeldi' anlamına gelen zarif bir iltifattır."
    },
    {
      text: "İlk tabağınızı bitirdiniz ancak menüdeki ikinci tabağa (örneğin ana yemeğe) geçmek için hazır olduğunuzu belirtmek istiyorsunuz.",
      targetState: "ikinci",
      explanation: "Tebrikler! Çatalı dikey, bıçağı yatay şekilde bir artı (+) işareti gibi bırakmak 'sıradaki yemeğe hazırım' mesajıdır."
    },
    {
      text: "Yemeği hiç beğenmediniz ve bu memnuniyetsizliği nezaket çerçevesinde garsona iletmek istiyorsunuz.",
      targetState: "begenmedim",
      explanation: "Doğru! Bıçağın ucunu çatalın dişleri arasına sokarak Ters V şeklinde bırakmak 'yemeği beğenmedim' anlamına gelen uluslararası bir koddur."
    }
  ];

  let currentQ = 0;
  const tableSetting = document.getElementById('tableSetting');
  const fbMessage = document.getElementById('fbMessage');

  function loadQuestion() {
    // Reset state
    tableSetting.className = 'table-setting state-start';
    fbMessage.className = 'fb-message';
    document.getElementById('controlsGrid').style.display = 'grid';
    
    document.getElementById('qLevel').innerText = `Senaryo ${currentQ + 1} / ${questions.length}`;
    document.getElementById('qText').innerText = questions[currentQ].text;
  }

  function makeGuess(state) {
    // Animate cutlery
    tableSetting.className = `table-setting state-${state}`;
    
    // Check answer after a brief delay for animation to start
    setTimeout(() => {
      const q = questions[currentQ];
      if (state === q.targetState) {
        fbMessage.className = 'fb-message success';
        document.getElementById('fbTitle').innerText = '✅ Kusursuz Zarafet!';
        document.getElementById('fbDesc').innerText = q.explanation;
        document.getElementById('controlsGrid').style.display = 'none'; // hide buttons
        
        if(currentQ === questions.length - 1) {
          document.getElementById('btnNext').innerText = "Akademiye Dön";
          document.getElementById('btnNext').onclick = () => window.location.href = '/gorgu';
        } else {
          document.getElementById('btnNext').innerText = "Sıradaki Senaryo";
        }
      } else {
        fbMessage.className = 'fb-message error';
        document.getElementById('fbTitle').innerText = '❌ Yanlış Mesaj!';
        document.getElementById('fbDesc').innerText = "Bu pozisyon garsona bambaşka bir mesaj iletecektir. Tekrar deneyin.";
        
        // Revert to start after a delay so they can try again
        setTimeout(() => {
          if(fbMessage.className.includes('error')) {
            tableSetting.className = 'table-setting state-start';
            fbMessage.className = 'fb-message';
          }
        }, 2000);
      }
    }, 400);
  }

  function nextQuestion() {
    currentQ++;
    if(currentQ < questions.length) {
      loadQuestion();
    }
  }

  // Init
  loadQuestion();
</script>

<%- include('partials/main-footer') %>
