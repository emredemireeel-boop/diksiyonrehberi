<%- include('partials/main-header') %>

<style>
  /* 🎭 Character Creation Light Theme 🎭 */
  body { background: #fdf4ff; color: #4a044e; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🎭 Hero Section 🎭 */
  .chr-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #fae8ff 0%, #fdf4ff 80%);
  }
  .chr-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fdf4ff,transparent); }

  /* Workshop Grid Background */
  .chr-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; opacity: 0.15; background-image: radial-gradient(#c026d3 2px, transparent 2px); background-size: 40px 40px; animation: pulseBg 10s ease-in-out infinite alternate; }
  @keyframes pulseBg { 0% { transform: scale(1); } 100% { transform: scale(1.1); } }

  .chr-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: maskFloat 4s ease-in-out infinite; filter: drop-shadow(0 15px 25px rgba(192,38,211,0.3)); }
  @keyframes maskFloat { 0%,100%{ transform:translateY(0) rotate(-5deg); } 50%{ transform:translateY(-15px) rotate(5deg); } }

  .chr-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #c026d3; background: #fae8ff; border:1px solid #f5d0fe; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(192,38,211,0.15); }
  .chr-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #4a044e; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .chr-title span { background: linear-gradient(135deg, #e879f9, #c026d3); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .chr-subtitle { color: #86198f; font-size:1.2rem; max-width:750px; line-height:1.8; z-index:2; position:relative; font-weight: 500; }

  /* 🎭 Container 🎭 */
  .chr-wrap { max-width:1100px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 🎭 Premium Cards 🎭 */
  .chr-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(192, 38, 211, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .chr-card:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(192, 38, 211, 0.1); border-color: rgba(192, 38, 211, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #c026d3; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* 🎭 Want vs Need Simulator 🎭 */
  .wn-box { background: #4a044e; border-radius: 24px; padding: 40px; color: white; display: flex; flex-direction: column; gap: 30px; position: relative; overflow: hidden; }
  .wn-intro { font-size: 1.05rem; color: #f5d0fe; line-height: 1.6; }
  
  .wn-scenario { padding: 25px; background: rgba(255,255,255,0.05); border-left: 4px solid #e879f9; border-radius: 0 16px 16px 0; font-size: 1.15rem; font-style: italic; line-height: 1.6; }
  
  .wn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media(max-width: 768px) { .wn-grid { grid-template-columns: 1fr; } }
  
  .wn-col { display: flex; flex-direction: column; gap: 15px; }
  .wn-col-title { font-weight: 800; color: #e879f9; font-size: 1.1rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; }
  
  .wn-opt { padding: 15px; background: rgba(0,0,0,0.3); border: 2px solid rgba(255,255,255,0.1); border-radius: 12px; cursor: pointer; transition: all 0.2s; font-size: 1rem; color: #fdf4ff; }
  .wn-opt:hover { border-color: #d946ef; background: rgba(217,70,239,0.1); }
  .wn-opt.selected { background: #86198f; border-color: #f0abfc; font-weight: 600; }
  
  .wn-btn { margin-top: 15px; padding: 16px; background: #c026d3; color: white; border: none; border-radius: 12px; font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: all 0.3s; box-shadow: 0 8px 15px rgba(192,38,211,0.3); }
  .wn-btn:hover { background: #a21caf; transform: translateY(-2px); }
  
  .wn-feedback { min-height: 50px; font-weight: 600; font-size: 1.1rem; line-height: 1.5; color: #f0abfc; }

  /* 🎭 Save the Cat Simulator 🎭 */
  .stc-box { background: #fff1f2; border: 1px solid #fecdd3; border-radius: 24px; padding: 40px; }
  .stc-intro { color: #881337; line-height: 1.6; font-size: 1.05rem; margin-bottom: 25px; }
  
  .stc-character { display: flex; align-items: center; gap: 20px; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px dashed #fda4af; }
  .stc-avatar { font-size: 4rem; filter: drop-shadow(0 5px 10px rgba(225,29,72,0.2)); }
  .stc-desc { color: #9f1239; font-size: 1.1rem; font-weight: 500; }
  
  .stc-opts { display: flex; flex-direction: column; gap: 15px; }
  .stc-opt { padding: 20px; background: white; border: 2px solid #ffe4e6; border-radius: 16px; color: #881337; font-size: 1.05rem; cursor: pointer; transition: all 0.2s; display: flex; gap: 15px; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .stc-opt:hover { border-color: #fb7185; transform: translateX(5px); }
  .stc-opt.correct { background: #f0fdf4; border-color: #22c55e; color: #166534; }
  .stc-opt.wrong { background: #fef2f2; border-color: #ef4444; color: #7f1d1d; }
  
  .stc-feedback { margin-top: 20px; font-weight: 600; font-size: 1.1rem; }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #f5d0fe; color:#c026d3; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#fae8ff; color:#86198f; transform:translateX(-4px); border-color: #e879f9; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="chr-hero">
  <div class="chr-bg"></div>
  <div class="chr-icon">🎭</div>
  <div class="chr-badge">Karakter Tasarım Atölyesi</div>
  <h1 class="chr-title">Karakter <span>Oluşturma</span></h1>
  <p class="chr-subtitle">İzleyiciler mükemmellikle empati kuramazlar, sadece zaaflarla kurarlar. "Save the Cat" anları ve "Want vs Need" psikolojisiyle derin, unutulmaz ve empati uyandıran kahramanlar yaratın.</p>
</section>

<div class="chr-wrap">
  <a href="/diksiyon?cat=karakter" class="back-btn">← Tüm Karakter İnşa Prensiplerini Gör (25 Madde)</a>

  <!-- 🎭 WANT VS NEED SIMULATOR 🎭 -->
  <div class="chr-card reveal" style="background:#4a044e; border:none;">
    <div class="section-label" style="color:#f0abfc;">🧠 Want vs Need (İstek vs İhtiyaç)</div>
    
    <div class="wn-box">
      <div class="wn-intro">
        Harika bir hikayede karakterin "İstediği" şey (Dış hedef) ile aslında "İhtiyacı olan" şey (İç/Psikolojik dönüşüm) çatışmalıdır. Hikayenin sonunda kahraman isteğinden vazgeçip ihtiyacını bulduğunda gerçek "Karakter Arkı (Dönüşümü)" tamamlanır.<br><br>
        <strong>Görev:</strong> Aşağıdaki senaryo için doğru <strong>Want (İstek)</strong> ve <strong>Need (İhtiyaç)</strong> ikilisini seçin.
      </div>
      
      <div class="wn-scenario">
        "Kariyer hırsı gözünü kör etmiş genç bir avukat, çok büyük ve kirli bir şirketi savunarak tarihin en genç şirket ortağı olmaya çalışmaktadır. Ancak davanın karşı tarafında kendi ailesini iflas ettiren işçiler vardır."
      </div>
      
      <div class="wn-grid">
        <div class="wn-col" id="col-want">
          <div class="wn-col-title">WANT (Bilinçli Dış Hedefi Nedir?)</div>
          <div class="wn-opt" onclick="selWn(this, 'want', false)">A) Ailesinin intikamını almak</div>
          <div class="wn-opt" onclick="selWn(this, 'want', true)">B) Şirket ortağı olmak (Statü/Para)</div>
        </div>
        
        <div class="wn-col" id="col-need">
          <div class="wn-col-title">NEED (Bilinçaltındaki Gerçek İhtiyacı Nedir?)</div>
          <div class="wn-opt" onclick="selWn(this, 'need', false)">A) Daha iyi bir ofise taşınmak</div>
          <div class="wn-opt" onclick="selWn(this, 'need', true)">B) Kibrini yenip adaleti ve vicdanını seçmek</div>
        </div>
      </div>
      
      <button class="wn-btn" onclick="checkWn()">Karakterin Ruhunu Analiz Et</button>
      <div class="wn-feedback" id="wnBack"></div>
    </div>
  </div>

  <!-- 🎭 SAVE THE CAT SIMULATOR 🎭 -->
  <div class="chr-card reveal">
    <div class="section-label">🐈 Save the Cat (Kediyi Kurtar) Testi</div>
    
    <div class="stc-box">
      <div class="stc-intro">
        Hollywood senaristi Blake Snyder'ın meşhur <strong>"Save the Cat"</strong> kuralı şudur: Kahramanı seyirciye sevdirmek istiyorsanız, hikayenin başında ona "bir kediyi kurtarmak" gibi küçük, iyi niyetli bir aksiyon yaptırın. Böylece karakter ne kadar suçlu veya sert olursa olsun, seyirci ona empati besler.
      </div>
      
      <div class="stc-character">
        <div class="stc-avatar">🕵️‍♂️</div>
        <div class="stc-desc">
          <strong>Karakterimiz:</strong> Acımasız, soğukkanlı ve kimseyle konuşmayan kiralık bir katil (Tetikçi). Hikaye başlarken bir hedefi vurmak için pusuya yatmış bekliyor. Karakter çok "soğuk ve itici". Onu seyirciye nasıl sevdirirsiniz?
        </div>
      </div>
      
      <div class="stc-opts" id="stcOpts">
        <div class="stc-opt" onclick="checkStc(this, false, 'Yanlış. Bu sadece onun ne kadar tehlikeli olduğunu gösterir, empati yaratmaz.')">
          <div style="font-size:1.5rem;">🔫</div>
          Silahını 10 saniyede mükemmel bir şekilde söküp takmasını gösteririz.
        </div>
        <div class="stc-opt" onclick="checkStc(this, true, 'Doğru! (Save the Cat). Sert ve acımasız katilimizin içinde masumiyete karşı bir zaaf (iyilik) olduğunu gördük. Artık seyirci onun ölmesini istemeyecek.')">
          <div style="font-size:1.5rem;">🥛</div>
          Pusuya yattığı çatı katında, sokağa atılmış yavru bir kediye kendi sütünden bir kap ayırdığını gösteririz.
        </div>
        <div class="stc-opt" onclick="checkStc(this, false, 'Yanlış. Bu çok didaktik ve sıkıcıdır. İnsanlar sözlere değil, eylemlere (aksiyona) inanır.')">
          <div style="font-size:1.5rem;">🗣️</div>
          Kamera karşısına geçip "Aslında ben iyi bir insanım ama hayat beni bu yola itti" diye monolog yapmasını sağlarız.
        </div>
      </div>
      
      <div class="stc-feedback" id="stcBack"></div>
    </div>
  </div>

</div>

<script>
// 🎭 Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🎭 Want vs Need
let selWant = null;
let selNeed = null;

function selWn(el, type, isCorrect) {
  const siblings = document.getElementById(`col-${type}`).querySelectorAll('.wn-opt');
  siblings.forEach(s => s.classList.remove('selected'));
  el.classList.add('selected');
  
  if(type === 'want') selWant = isCorrect;
  if(type === 'need') selNeed = isCorrect;
}

function checkWn() {
  const fb = document.getElementById('wnBack');
  if(selWant === null || selNeed === null) {
    fb.innerHTML = "Lütfen hem İstek (Want) hem de İhtiyaç (Need) seçimi yapın.";
    fb.style.color = "#fbcfe8";
    return;
  }
  
  if(selWant === true && selNeed === true) {
    fb.innerHTML = "✅ Harika! Karakterin Want'ı (Şirket Ortağı Olmak) sahte bir hedeftir. Filmin sonunda kahramanımız bu 'İsteğinden' vazgeçecek ve gerçek 'İhtiyacı' olan adaleti seçecektir. Klasik karakter dönüşümü budur!";
    fb.style.color = "#4ade80";
  } else {
    fb.innerHTML = "❌ Eşleşme Hatalı. Unutmayın: Want karakterin peşinden koştuğu dışsal hedef (statü, para), Need ise içsel iyileşmesidir (vicdan).";
    fb.style.color = "#f87171";
  }
}

// 🎭 Save the Cat
function checkStc(btn, isCorrect, exp) {
  const btns = document.getElementById('stcOpts').querySelectorAll('.stc-opt');
  btns.forEach(b => b.style.pointerEvents = 'none');
  
  const fb = document.getElementById('stcBack');
  if(isCorrect) {
    btn.classList.add('correct');
    fb.innerHTML = `✅ ${exp}`;
    fb.style.color = '#166534';
  } else {
    btn.classList.add('wrong');
    btns[1].style.borderColor = '#22c55e'; // Highlight correct option
    fb.innerHTML = `❌ ${exp}`;
    fb.style.color = '#b91c1c';
  }
}
</script>

<%- include('partials/main-footer') %>
