<%- include('partials/main-header') %>

<style>
  /* 🏛️ Rhetoric Academy Light Theme 🏛️ */
  body { background: #f8fafc; color: #334155; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🏛️ Hero Section 🏛️ */
  .r-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #e0e7ff 0%, #f8fafc 80%);
  }
  .r-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#f8fafc,transparent); }

  /* Abstract Pillars/Books background */
  .hero-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; }
  .bg-shape { position:absolute; background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(139, 92, 246, 0.1)); border-radius: 20px; transform: rotate(-15deg); }
  .sh-1 { width: 100px; height: 400px; left: 10%; top: 20%; animation: floatPillar 8s ease-in-out infinite; }
  .sh-2 { width: 80px; height: 500px; right: 15%; top: 10%; animation: floatPillar 10s ease-in-out infinite reverse; }
  .sh-3 { width: 120px; height: 300px; left: 25%; bottom: -10%; animation: floatPillar 9s ease-in-out infinite; }

  @keyframes floatPillar { 0%,100%{ transform:translateY(0) rotate(-15deg); } 50%{ transform:translateY(-30px) rotate(-12deg); } }

  .r-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: bounceBook 4s infinite cubic-bezier(0.4, 0, 0.2, 1); filter: drop-shadow(0 10px 20px rgba(99,102,241,0.3)); }
  @keyframes bounceBook { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-15px); } }

  .r-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #4338ca; background: #e0e7ff; border:1px solid #c7d2fe; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(99,102,241,0.15); }
  .r-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #0f172a; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .r-title span { background: linear-gradient(135deg, #6366f1, #a855f7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .r-subtitle { color: #64748b; font-size:1.2rem; max-width:700px; line-height:1.8; z-index:2; position:relative; }

  /* 🏛️ Container 🏛️ */
  .r-wrap { max-width:1050px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 🏛️ Glass Academy Cards 🏛️ */
  .glass-academy { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(25px); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03); }
  .glass-academy:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(99, 102, 241, 0.08); border-color: rgba(99, 102, 241, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #6366f1; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* 🏛️ Retorik Dedektif 🏛️ */
  .detective-box { background: #f1f5f9; border-radius: 24px; padding: 30px; text-align: center; border: 2px dashed #cbd5e1; }
  .detective-quote { font-size: 1.8rem; font-weight: 800; color: #1e293b; font-style: italic; margin-bottom: 30px; padding: 20px; background: white; border-radius: 16px; box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
  
  .options-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
  .option-btn { padding: 15px; background: white; border: 2px solid #e2e8f0; border-radius: 16px; font-size: 1.1rem; font-weight: 700; color: #475569; cursor: pointer; transition: all 0.3s; }
  .option-btn:hover { border-color: #6366f1; background: #e0e7ff; color: #4338ca; transform: translateY(-3px); }
  .option-btn.correct { background: #10b981; border-color: #059669; color: white; }
  .option-btn.wrong { background: #ef4444; border-color: #b91c1c; color: white; animation: shake 0.5s; }

  @keyframes shake { 0%, 100% {transform: translateX(0);} 25% {transform: translateX(-5px);} 50% {transform: translateX(5px);} 75% {transform: translateX(-5px);} }

  .feedback-msg { margin-top: 20px; font-size: 1.1rem; font-weight: 600; min-height: 25px; transition: opacity 0.3s; }
  
  .next-btn { margin-top: 20px; padding: 10px 30px; background: #1e293b; color: white; border: none; border-radius: 100px; font-weight: 700; cursor: pointer; display: none; }

  /* 🏛️ Retorik Builder (Anadiplozis vs Chiasmus) 🏛️ */
  .builder-area { display: flex; flex-direction: column; gap: 20px; }
  .builder-row { display: flex; align-items: center; gap: 15px; background: white; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; flex-wrap: wrap; }
  .b-slot { padding: 10px 20px; background: #f8fafc; border: 2px dashed #94a3b8; border-radius: 10px; font-weight: 700; color: #64748b; min-width: 120px; text-align: center; cursor: pointer; transition: all 0.2s; }
  .b-slot.filled { background: #e0e7ff; border: 2px solid #6366f1; color: #4338ca; }
  .b-text { font-size: 1.2rem; font-weight: 600; color: #334155; }
  
  .word-bank { display: flex; gap: 15px; margin-top: 20px; padding: 20px; background: #e0e7ff; border-radius: 16px; flex-wrap: wrap; }
  .b-word { padding: 10px 20px; background: #6366f1; color: white; border-radius: 10px; font-weight: 700; cursor: pointer; transition: transform 0.2s; box-shadow: 0 4px 10px rgba(99,102,241,0.3); }
  .b-word:hover { transform: scale(1.05); background: #4f46e5; }
  
  .builder-success { display: none; background: #dcfce7; color: #166534; padding: 15px; border-radius: 12px; font-weight: 700; margin-top: 15px; text-align: center; }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #e2e8f0; color:#475569; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#f8fafc; color:#0f172a; transform:translateX(-4px); border-color: #cbd5e1; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="r-hero">
  <div class="hero-bg">
    <div class="bg-shape sh-1"></div>
    <div class="bg-shape sh-2"></div>
    <div class="bg-shape sh-3"></div>
  </div>
  <div class="r-icon">🏛️</div>
  <div class="r-badge">Retorik Figürler Ansiklopedisi</div>
  <h1 class="r-title">Kelimelerin <span>Mimarisini</span> Öğrenin</h1>
  <p class="r-subtitle">Trikolon, Chiasmus, Anafora... Dünyayı değiştiren konuşmaların arkasında tesadüf değil, matematiksel bir dizilim (Retorik Figürler) vardır. Kelimeleri silah gibi kullanma sanatı.</p>
</section>

<div class="r-wrap">
  <a href="/diksiyon?cat=retorik" class="back-btn">← Tüm Retorik Egzersizlerini Gör (60 Figür)</a>

  <!-- 🏛️ DEDEKTİF OYUNU 🏛️ -->
  <div class="glass-academy reveal">
    <div class="section-label">🕵️‍♂️ Retorik Dedektif: Bu Hangi Figür?</div>
    <p style="color:#64748b; font-size:1.05rem; line-height:1.6; margin-bottom:25px;">
      Hitabetin en güçlü kurallarından biri de karşındakinin hangi kuralı kullandığını deşifre etmektir. Aşağıdaki ünlü cümlenin (veya sözün) hangi retorik figüre ait olduğunu bulun.
    </p>

    <div class="detective-box">
      <div class="detective-quote" id="detQuote">"Sormayın ülkeniz sizin için ne yapabilir, sorun siz ülkeniz için ne yapabilirsiniz."</div>
      
      <div class="options-grid" id="detOptions">
        <!-- Buttons injected by JS -->
      </div>
      
      <div class="feedback-msg" id="detFeedback"></div>
      <button class="next-btn" id="nextDetBtn" onclick="loadNextQuestion()">Sonraki Soru ➔</button>
    </div>
  </div>

  <!-- 🏛️ BUILDER OYUNU 🏛️ -->
  <div class="glass-academy reveal">
    <div class="section-label">🏗️ Retorik Builder (İnşaat)</div>
    <p style="color:#64748b; font-size:1.05rem; line-height:1.6; margin-bottom:25px;">
      Şimdi kendi cümlenizi bir <strong>Anadiplozis</strong> (Bir cümlenin son kelimesiyle, bir sonraki cümleye başlama sanatı) kuralına göre inşa edin. Aşağıdaki kelimeleri doğru boşluklara tıklayarak yerleştirin.
    </p>

    <div class="builder-area">
      <div class="builder-row">
        <span class="b-text">Korku,</span>
        <div class="b-slot" id="slot1" onclick="returnWord(1)">[Kutu 1]</div>
        <span class="b-text">yol açar.</span>
      </div>
      <div class="builder-row">
        <div class="b-slot" id="slot2" onclick="returnWord(2)">[Kutu 2]</div>
        <span class="b-text">, nefrete yol açar.</span>
      </div>
      <div class="builder-row">
        <span class="b-text">Nefret,</span>
        <div class="b-slot" id="slot3" onclick="returnWord(3)">[Kutu 3]</div>
        <span class="b-text">yol açar.</span>
      </div>
      
      <div class="word-bank" id="wordBank">
        <div class="b-word" onclick="placeWord(this, 'Öfkeye')">Öfkeye</div>
        <div class="b-word" onclick="placeWord(this, 'Acıya')">Acıya</div>
        <div class="b-word" onclick="placeWord(this, 'Öfke')">Öfke</div>
      </div>
      
      <div class="builder-success" id="builderSuccess">
        ✅ Mükemmel! Yoda'nın ünlü sözü bir "Anadiplozis" şaheseridir. Zincirleme reaksiyon (A->B, B->C) yarattınız!
      </div>
    </div>
  </div>

</div>

<script>
// 🏛️ Scroll Reveal 🏛️
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🏛️ Detective Game Logic 🏛️
const questions = [
  {
    quote: '"Sormayın ülkeniz sizin için ne yapabilir, sorun siz ülkeniz için ne yapabilirsiniz." (J.F.K)',
    options: ['Chiasmus (Çapraz)', 'Anafora (Tekrar)', 'Hyperbole (Abartı)'],
    correct: 0,
    explanation: 'Doğru! Chiasmus (A-B, B-A) kelimeleri çaprazlayarak ayna yansıması oluşturur.'
  },
  {
    quote: '"Geldim, Gördüm, Yendim." (Jül Sezar)',
    options: ['Oksimor', 'Asyndeton', 'Litotes'],
    correct: 1,
    explanation: 'Doğru! Asyndeton, bağlaç (ve, ile) kullanmadan kelimeleri sıralayarak cümleye çok hızlı bir aksiyon katar.'
  },
  {
    quote: '"Kan, ter ve gözyaşından başka vaat edecek bir şeyim yok." (Churchill)',
    options: ['Trikolon', 'Paradoks', 'Pleonazm'],
    correct: 0,
    explanation: 'Doğru! Trikolon (Üçlü Kural) fikirleri 3 parça halinde sıralayarak ritim ve inandırıcılık yaratır.'
  },
  {
    quote: '"Sessizliğin sesi..."',
    options: ['Anafora', 'Zeugma', 'Oksimor'],
    correct: 2,
    explanation: 'Doğru! Oksimor, çelişen iki kelimenin (Sessizlik ve Ses) bir araya gelmesiyle şiirsel bir anlam yaratır.'
  }
];

let currentQ = 0;

function loadNextQuestion() {
  const q = questions[currentQ];
  document.getElementById('detQuote').innerText = q.quote;
  document.getElementById('detFeedback').innerText = '';
  document.getElementById('nextDetBtn').style.display = 'none';
  
  const optContainer = document.getElementById('detOptions');
  optContainer.innerHTML = '';
  
  q.options.forEach((opt, index) => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    btn.innerText = opt;
    btn.onclick = () => checkAnswer(btn, index, q.correct, q.explanation);
    optContainer.appendChild(btn);
  });
  
  currentQ = (currentQ + 1) % questions.length;
}

function checkAnswer(btn, selected, correct, explanation) {
  const allBtns = document.querySelectorAll('.option-btn');
  allBtns.forEach(b => b.onclick = null); // Disable others
  
  const fb = document.getElementById('detFeedback');
  if(selected === correct) {
    btn.classList.add('correct');
    fb.innerText = '✅ ' + explanation;
    fb.style.color = '#10b981';
  } else {
    btn.classList.add('wrong');
    allBtns[correct].classList.add('correct'); // Show correct
    fb.innerText = '❌ Yanlış! ' + explanation;
    fb.style.color = '#ef4444';
  }
  
  document.getElementById('nextDetBtn').style.display = 'inline-block';
}

// Start game
loadNextQuestion();


// 🏛️ Builder Game Logic 🏛️
// Answer: Korku -> Öfkeye (Slot1), Öfke (Slot2) -> Nefrete, Nefret -> Acıya (Slot3)
const correctOrder = { 1: 'Öfkeye', 2: 'Öfke', 3: 'Acıya' };
let currentSlots = { 1: null, 2: null, 3: null };

function placeWord(wordEl, wordText) {
  // Find first empty slot
  let targetSlot = null;
  for(let i=1; i<=3; i++) {
    if(!currentSlots[i]) {
      targetSlot = i;
      break;
    }
  }
  
  if(targetSlot) {
    currentSlots[targetSlot] = wordText;
    const slotEl = document.getElementById('slot' + targetSlot);
    slotEl.innerText = wordText;
    slotEl.classList.add('filled');
    slotEl.dataset.originalId = wordEl.innerText; // Keep track
    wordEl.style.display = 'none'; // Hide from bank
    
    checkBuilder();
  }
}

function returnWord(slotNum) {
  if(currentSlots[slotNum]) {
    const text = currentSlots[slotNum];
    currentSlots[slotNum] = null;
    
    const slotEl = document.getElementById('slot' + slotNum);
    slotEl.innerText = '[Kutu ' + slotNum + ']';
    slotEl.classList.remove('filled');
    
    // Unhide in bank
    document.querySelectorAll('.b-word').forEach(w => {
      if(w.innerText === text) w.style.display = 'block';
    });
    
    document.getElementById('builderSuccess').style.display = 'none';
  }
}

function checkBuilder() {
  if(currentSlots[1] === correctOrder[1] && currentSlots[2] === correctOrder[2] && currentSlots[3] === correctOrder[3]) {
    document.getElementById('builderSuccess').style.display = 'block';
  }
}
</script>

<%- include('partials/main-footer') %>
