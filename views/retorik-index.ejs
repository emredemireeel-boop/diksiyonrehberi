<%- include('partials/main-header') %>
<link rel="stylesheet" href="/retorik.css?v=7" />

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600&family=JetBrains+Mono:wght@400;700&display=swap');

  /* ═══════════════════════════════════════════════════════════
     RETORIK — Ultra Luxury Light Mode / Competition Grade
     ═══════════════════════════════════════════════════════════ */

  :root {
    --r-bg: #faf9f7;
    --r-bg2: #ffffff;
    --r-surface: #ffffff;
    --r-surface2: #f5f3ef;
    --r-navy: #0f172a;
    --r-navy2: #1e293b;
    --r-gold: #b8860b;
    --r-gold2: #d4a017;
    --r-gold-light: rgba(184, 134, 11, 0.06);
    --r-gold-glow: rgba(212, 160, 23, 0.15);
    --r-text: #1a1a2e;
    --r-text2: #4a4a68;
    --r-text3: #8b8ba3;
    --r-border: rgba(0,0,0,0.06);
    --r-border-h: rgba(184, 134, 11, 0.2);
    --r-shadow: 0 8px 30px rgba(0,0,0,0.04);
    --r-shadow-h: 0 20px 60px rgba(0,0,0,0.08);
  }

  body {
    background: var(--r-bg) !important;
    color: var(--r-text);
    font-family: 'Outfit', sans-serif;
    overflow-x: hidden;
  }

  .retorik-page { display: block !important; }
  .ret-cat-pill { text-decoration: none; }

  /* ── AMBIENT LIGHT BLOBS ── */
  .r-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .r-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    animation: blobFloat 20s ease-in-out infinite alternate;
  }
  .r-blob:nth-child(1) { width: 500px; height: 500px; top: -100px; right: -100px; background: linear-gradient(135deg, #fde68a, #fbbf24); animation-duration: 18s; }
  .r-blob:nth-child(2) { width: 400px; height: 400px; bottom: -80px; left: -80px; background: linear-gradient(135deg, #c7d2fe, #818cf8); animation-duration: 22s; animation-delay: -5s; }
  .r-blob:nth-child(3) { width: 300px; height: 300px; top: 40%; left: 60%; background: linear-gradient(135deg, #fecaca, #f87171); opacity: 0.15; animation-duration: 25s; animation-delay: -10s; }

  @keyframes blobFloat {
    0% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -40px) scale(1.1); }
    66% { transform: translate(-20px, 30px) scale(0.95); }
    100% { transform: translate(10px, -10px) scale(1.05); }
  }

  /* ── GOLD PARTICLE FIELD ── */
  .r-sparkles { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
  .r-spark {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--r-gold2);
    opacity: 0;
    animation: sparkRise linear infinite;
  }
  @keyframes sparkRise {
    0% { opacity: 0; transform: translateY(100vh) scale(0.5); }
    20% { opacity: 0.6; }
    80% { opacity: 0.2; }
    100% { opacity: 0; transform: translateY(-5vh) scale(0.3); }
  }

  /* ── SUBTLE GRID ── */
  .r-grid-overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(0,0,0,0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,0,0,0.015) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* ═══════════════════════════════════════
     MAIN CONTENT WRAPPER
     ═══════════════════════════════════════ */
  .r-world {
    position: relative;
    z-index: 10;
  }

  /* ═══════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════ */
  .r-hero {
    text-align: center;
    padding: 70px 30px 60px;
    position: relative;
    overflow: hidden;
  }
  .r-hero::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--r-border-h), transparent);
  }

  .r-hero-overline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    border-radius: 50px;
    background: var(--r-gold-light);
    border: 1px solid var(--r-border-h);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--r-gold);
    font-weight: 700;
    margin-bottom: 25px;
  }
  .r-hero-overline::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--r-gold2);
    box-shadow: 0 0 8px var(--r-gold2);
    animation: goldPulse 2s ease-in-out infinite;
  }
  @keyframes goldPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.6); }
  }

  .r-hero-title {
    font-family: 'Playfair Display', serif;
    font-size: 4rem;
    font-weight: 900;
    color: var(--r-navy);
    line-height: 1.05;
    margin: 0 0 10px;
    letter-spacing: -1px;
  }
  .r-hero-tagline {
    font-family: 'Outfit', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--r-gold);
    margin-bottom: 18px;
  }
  .r-hero-desc {
    font-size: 1.05rem;
    color: var(--r-text2);
    max-width: 620px;
    margin: 0 auto 35px;
    line-height: 1.8;
  }
  .r-hero-stats {
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .r-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .r-stat-n {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--r-navy);
    line-height: 1;
  }
  .r-stat-l {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--r-text3);
    margin-top: 5px;
    font-weight: 700;
  }

  /* ═══════════════════════════════════════
     INTERACTIVE TOOLS SECTION
     ═══════════════════════════════════════ */
  .r-tools-section {
    padding: 0 30px 60px;
    max-width: 1300px;
    margin: 0 auto;
  }
  .r-section-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .r-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 800;
    color: var(--r-navy);
    margin: 0 0 8px;
  }
  .r-section-sub {
    font-size: 1rem;
    color: var(--r-text3);
  }

  /* ── Masterpiece Cards (Full Width) ── */
  .r-tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }

  .r-master-card {
    grid-column: 1 / -1;
    border-radius: 24px;
    padding: 45px 40px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    border: 1px solid transparent;
  }
  .r-master-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 2px;
    background: linear-gradient(135deg, var(--mc-c1), var(--mc-c2), transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity 0.4s;
  }
  .r-master-card:hover::before { opacity: 1; }
  .r-master-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--mc-bg1), var(--mc-bg2));
    z-index: -1;
    border-radius: 24px;
  }
  .r-master-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 80px var(--mc-shadow);
  }

  .r-mc-badge {
    position: absolute;
    top: 18px;
    right: 22px;
    background: var(--mc-accent);
    color: var(--mc-badge-text, #0f172a);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 900;
    padding: 5px 16px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    animation: badgePulse 3s ease-in-out infinite;
  }
  @keyframes badgePulse {
    0%, 100% { box-shadow: 0 0 0 0 var(--mc-accent-glow); }
    50% { box-shadow: 0 0 0 8px transparent; }
  }

  .r-mc-icon {
    font-size: 4rem;
    margin-bottom: 15px;
    filter: drop-shadow(0 8px 20px var(--mc-shadow));
  }
  .r-mc-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 900;
    margin: 0 0 12px;
    color: var(--mc-title);
    letter-spacing: -0.5px;
  }
  .r-mc-desc {
    font-size: 1rem;
    color: var(--mc-desc);
    line-height: 1.7;
    margin-bottom: 25px;
    max-width: 700px;
  }
  .r-mc-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--mc-accent);
    color: var(--mc-badge-text, #0f172a);
    font-weight: 800;
    padding: 14px 36px;
    border-radius: 50px;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s;
    box-shadow: 0 8px 25px var(--mc-accent-glow);
  }
  .r-master-card:hover .r-mc-cta {
    transform: scale(1.05);
    box-shadow: 0 12px 35px var(--mc-accent-glow);
  }

  /* Master Card Themes */
  .r-mc-munazara { --mc-bg1: #1e1b4b; --mc-bg2: #0f172a; --mc-c1: #eab308; --mc-c2: #f59e0b; --mc-accent: #eab308; --mc-accent-glow: rgba(234,179,8,0.3); --mc-shadow: rgba(234,179,8,0.15); --mc-title: #eab308; --mc-desc: #cbd5e1; --mc-badge-text: #0f172a; }
  .r-mc-karanlik { --mc-bg1: #022c22; --mc-bg2: #0f172a; --mc-c1: #10b981; --mc-c2: #34d399; --mc-accent: #10b981; --mc-accent-glow: rgba(16,185,129,0.3); --mc-shadow: rgba(16,185,129,0.15); --mc-title: #10b981; --mc-desc: #cbd5e1; --mc-badge-text: #0f172a; }
  .r-mc-prompter { --mc-bg1: #4c0519; --mc-bg2: #000000; --mc-c1: #f43f5e; --mc-c2: #fb7185; --mc-accent: #f43f5e; --mc-accent-glow: rgba(244,63,94,0.3); --mc-shadow: rgba(244,63,94,0.15); --mc-title: #f43f5e; --mc-desc: #fecdd3; --mc-badge-text: #fff; }
  .r-mc-asistan { --mc-bg1: #0f172a; --mc-bg2: #0066cc; --mc-c1: #38bdf8; --mc-c2: #7dd3fc; --mc-accent: #38bdf8; --mc-accent-glow: rgba(56,189,248,0.3); --mc-shadow: rgba(56,189,248,0.15); --mc-title: #38bdf8; --mc-desc: #e0f2fe; --mc-badge-text: #0f172a; }

  /* ── Mini Tool Cards ── */
  .r-tool-card {
    background: var(--r-surface);
    border: 1px solid var(--r-border);
    border-radius: 20px;
    padding: 30px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    box-shadow: var(--r-shadow);
  }
  .r-tool-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--tc-color), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .r-tool-card:hover {
    transform: translateY(-8px) scale(1.01);
    box-shadow: var(--r-shadow-h);
    border-color: var(--r-border-h);
  }
  .r-tool-card:hover::before { opacity: 1; }

  .r-tc-icon { font-size: 2.5rem; margin-bottom: 15px; }
  .r-tc-title {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--tc-color);
    margin: 0 0 10px;
  }
  .r-tc-desc {
    font-size: 0.9rem;
    color: var(--r-text2);
    line-height: 1.65;
    margin-bottom: 20px;
    flex-grow: 1;
  }
  .r-tc-cta {
    margin-top: auto;
    background: var(--tc-color);
    color: #fff;
    font-weight: 800;
    padding: 10px 22px;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s;
  }
  .r-tool-card:hover .r-tc-cta { box-shadow: 0 8px 25px var(--tc-glow); }

  /* ═══════════════════════════════════════
     CATEGORY PILLS
     ═══════════════════════════════════════ */
  .r-pills-wrap {
    text-align: center;
    padding: 0 30px;
    margin-bottom: 50px;
  }
  .r-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .r-pill {
    padding: 10px 24px;
    border-radius: 50px;
    border: 1.5px solid var(--r-border);
    background: var(--r-surface);
    color: var(--r-text3);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }
  .r-pill:hover {
    border-color: var(--r-border-h);
    color: var(--r-gold);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(184, 134, 11, 0.08);
  }
  .r-pill.active {
    background: var(--r-navy);
    border-color: var(--r-navy);
    color: #fff;
    box-shadow: 0 8px 25px rgba(15, 23, 42, 0.2);
  }

  /* ═══════════════════════════════════════
     CONTENT SECTIONS (Aristotle, etc)
     ═══════════════════════════════════════ */
  .r-content-section {
    max-width: 1300px;
    margin: 0 auto 40px;
    padding: 0 30px;
  }

  .r-glass-section {
    background: var(--r-surface);
    border: 1px solid var(--r-border);
    border-radius: 24px;
    padding: 40px;
    box-shadow: var(--r-shadow);
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
  }
  .r-glass-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--r-gold), transparent);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .r-glass-section:hover::before { opacity: 1; }
  .r-glass-section:hover {
    box-shadow: var(--r-shadow-h);
    border-color: var(--r-border-h);
  }

  .r-gs-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--r-navy);
    margin: 0 0 6px;
  }
  .r-gs-sub {
    color: var(--r-text3);
    font-size: 0.95rem;
    margin-bottom: 28px;
  }

  /* ── Pillar Cards ── */
  .r-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .r-pillar-card {
    background: var(--r-surface2);
    border: 1px solid var(--r-border);
    border-radius: 18px;
    padding: 30px;
    text-decoration: none;
    display: block;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
  }
  .r-pillar-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--pc-color, var(--r-gold));
    border-radius: 4px 0 0 4px;
    opacity: 0.5;
    transition: opacity 0.3s;
  }
  .r-pillar-card:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 15px 40px rgba(0,0,0,0.06);
    border-color: var(--r-border-h);
  }
  .r-pillar-card:hover::before { opacity: 1; }

  .r-pc-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--r-text3);
    margin-bottom: 14px;
  }
  .r-pc-title {
    font-family: 'Outfit', sans-serif;
    color: var(--r-navy);
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .r-pc-desc {
    color: var(--r-text2);
    font-size: 0.88rem;
    line-height: 1.7;
    margin-bottom: 18px;
  }
  .r-pc-link {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--r-navy);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  /* ═══════════════════════════════════════
     ONBOARDING / ACADEMY SECTION
     ═══════════════════════════════════════ */
  .r-academy {
    background: linear-gradient(135deg, #faf9f7 0%, #f0ede6 100%);
    border: 2px solid var(--r-border-h);
    border-radius: 28px;
    padding: 50px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 15px 50px rgba(184, 134, 11, 0.06);
  }
  .r-academy::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--r-gold), var(--r-gold2), transparent);
    border-radius: 3px;
  }

  .r-academy-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }
  .r-academy-icon {
    font-size: 3rem;
    filter: drop-shadow(0 5px 15px rgba(184, 134, 11, 0.2));
  }
  .r-academy-title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--r-navy);
    margin: 0 0 5px;
    letter-spacing: -0.5px;
  }
  .r-academy-sub {
    color: var(--r-gold);
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .r-academy-text {
    color: var(--r-text2);
    font-size: 1.05rem;
    line-height: 1.85;
    margin-bottom: 18px;
  }

  .r-academy-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin: 30px 0;
  }
  .r-academy-feature {
    background: var(--r-surface);
    padding: 25px;
    border-radius: 16px;
    border-left: 4px solid var(--af-color);
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: all 0.3s;
  }
  .r-academy-feature:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }
  .r-af-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--r-navy);
    margin-bottom: 10px;
  }
  .r-af-text {
    font-size: 0.9rem;
    color: var(--r-text2);
    line-height: 1.7;
    margin: 0;
  }

  /* Quote block */
  .r-quote-block {
    background: var(--r-navy);
    border-radius: 18px;
    padding: 28px 32px;
    color: #fff;
    margin-top: 30px;
  }
  .r-quote-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.7;
    margin-bottom: 15px;
    font-weight: 500;
    opacity: 0.9;
  }
  .r-quote-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .r-quote-cite {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    font-weight: 700;
  }
  .r-quote-cta {
    background: var(--r-gold);
    color: var(--r-navy);
    font-weight: 800;
    padding: 10px 24px;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .r-quote-cta:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(184, 134, 11, 0.3);
  }

  /* ═══════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════ */
  @media (max-width: 768px) {
