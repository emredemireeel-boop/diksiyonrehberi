<script>
  // ═══════════ GOLD SPARKLE PARTICLES ═══════════
  (function() {
    const field = document.getElementById('rSparkles');
    if (!field) return;
    const golds = ['#d4a017', '#b8860b', '#e6c347', '#f0d060', '#c9a832'];
    for (let i = 0; i < 18; i++) {
      const s = document.createElement('div');
      s.className = 'r-spark';
      s.style.left = Math.random() * 100 + '%';
      s.style.animationDuration = (12 + Math.random() * 20) + 's';
      s.style.animationDelay = (Math.random() * 15) + 's';
      const size = (1.5 + Math.random() * 2.5) + 'px';
      s.style.width = size;
      s.style.height = size;
      const c = golds[Math.floor(Math.random() * golds.length)];
      s.style.background = c;
      s.style.boxShadow = `0 0 6px ${c}`;
      field.appendChild(s);
    }
  })();
</script>

