<%- include('partials/main-header') %>

<style>
  body { background: #0a0a14; color: #f1f5f9; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🌿 Hero 🌿 */
  .s-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 20%, #10b98122, transparent 70%);
  }
  .s-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#0a0a14,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: sFloat 7s ease-in-out infinite; background: linear-gradient(135deg, #10b981, #34d399); }
  @keyframes sFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.1; } 50%{ transform:translateY(-40px) scale(1.5); opacity:.5; } }

  .s-icon { font-size: 6rem; margin-bottom: 20px; animation: sPulse 3s ease-in-out infinite; filter: drop-shadow(0 0 30px #10b98166); }
  @keyframes sPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.05) translateY(-5px); } }

  .s-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#a7f3d0; background:#10b98118; border:1px solid #10b98144; margin-bottom:24px; box-shadow: 0 0 20px #10b98122; }
  .s-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color:#fff; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .s-title span { background: linear-gradient(135deg, #34d399, #6ee7b7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .s-subtitle { color:#94a3b8; font-size:1.15rem; max-width:650px; line-height:1.8; }

  /* 🌿 Container 🌿 */
  .s-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 🌿 Glass Cards 🌿 */
  .glass { background:rgba(255,255,255,.02); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,.05); border-radius:24px; padding:40px; margin-bottom:40px; transition:transform .4s,box-shadow .4s; position: relative; overflow: hidden; }
  .glass::before { content:''; position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg,transparent,rgba(255,255,255,.1),transparent); }
  .glass:hover { transform:translateY(-5px); box-shadow:0 30px 60px rgba(0,0,0,.4),0 0 40px #10b98111; border-color:rgba(16,185,129,.2); }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#34d399; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background:#34d399; border-radius:2px; }

  /* 🌿 Hydration & Vocal Spa 🌿 */
  .spa-container { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #064e3b22; border-radius: 20px; border: 2px dashed #10b98144; padding: 40px; position: relative; overflow: hidden; margin-bottom: 30px; text-align: center; }
  
  .water-drop { font-size: 5rem; line-height: 1; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin: 20px 0; color: #fff; text-shadow: 0 0 30px #10b98188; position: relative; }
  .water-fill { position: absolute; bottom: 0; left: 0; width: 100%; height: 0%; background: #34d399; z-index: -1; border-radius: 50%; opacity: 0.5; transition: height 0.5s ease-out; }
  
  .spa-status { font-size: 1.5rem; font-weight: 800; color: #a7f3d0; margin-bottom: 10px; }
  .spa-desc { font-size: 0.95rem; color: #94a3b8; max-width: 500px; margin: 0 auto 20px; }
  
  .spa-controls { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .spa-btn { padding: 12px 24px; border-radius: 12px; background: rgba(16,185,129,.15); border: 1px solid rgba(16,185,129,.3); color: #a7f3d0; font-weight: 700; cursor: pointer; transition: all .3s; }
  .spa-btn:hover { background: rgba(16,185,129,.3); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(16,185,129,.2); }

  /* 🌿 Emergency & Clinic Grid 🌿 */
  .gym-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .gym-container { grid-template-columns: 1fr; } }
  
  .gym-card { background: rgba(0,0,0,.3); border: 1px solid rgba(16,185,129,.15); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all .3s; position: relative; overflow: hidden; }
  .gym-card::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at center, rgba(16,185,129,.1), transparent); opacity:0; transition:opacity .3s; }
  .gym-card:hover { border-color: #10b981; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(16,185,129,.15); }
  .gym-card:hover::after { opacity: 1; }
  
  .gym-icon { font-size: 3rem; margin-bottom: 12px; display: inline-block; transition: transform .3s; }
  .gym-card:hover .gym-icon { transform: scale(1.2); }
  
  .gym-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .gym-desc { font-size: 0.85rem; color: #94a3b8; line-height: 1.6; }

  /* 🌿 Clinic Assessment Panel 🌿 */
  .workout-panel { background: linear-gradient(145deg, #022c22, #0a0a14); border: 1px solid #10b98133; border-radius: 24px; padding: 40px; margin-top: 20px; text-align: center; position: relative; overflow: hidden; }
  .workout-panel::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle at center, rgba(16,185,129,.05) 0%, transparent 50%); animation: rotateGlow 15s linear infinite; pointer-events:none; }
  @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .workout-display { font-size: 2rem; font-weight: 900; color: #fff; letter-spacing: 1px; margin: 24px 0; min-height: 60px; display: flex; align-items: center; justify-content: center; }
  .workout-hint { color: #34d399; font-size: 1rem; font-weight: 600; margin-bottom: 30px; }
  
  .workout-btn { padding: 16px 40px; border-radius: 100px; background: linear-gradient(135deg, #10b981, #059669); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(16,185,129,.4); transition: all .3s; text-transform: uppercase; letter-spacing: 2px; }
  .workout-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(16,185,129,.6); }
  .workout-btn:active { transform: scale(0.98); }

  /* 🌿 Back Button 🌿 */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); color:#94a3b8; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(255,255,255,.1); color:#fff; transform:translateX(-4px); }

  /* 🌿 Reveal 🌿 */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="s-hero">
  <div class="hero-particles">
    <% for(let i=0; i<30; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 2+Math.random()*5 %>px; height:<%= 2+Math.random()*5 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 4+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="s-icon">⚕️</div>
  <div class="s-badge">🩺 Ses Sağlığı Kliniği</div>
  <h1 class="s-title"><span>Sesinizi</span> Koruyun</h1>
  <p class="s-subtitle">Ses telleri yenilenemez bir enstrümandır. Ses kısıklığını önleyen, reflü hasarını durduran ve sesinizin ömrünü uzatan tıbbi destekli bakım ve hijyen rehberi.</p>
</section>

<div class="s-wrap">
  <a href="/diksiyon?cat=saglik" class="back-btn">Tüm Ses Sağlığı İçeriklerini Gör</a>

  <!-- 🌿 VOCAL SPA & HYDRATION 🌿 -->
  <div class="glass reveal">
    <div class="section-label">💧 Ses Spa ve Nemlendirme</div>
    <p style="color:#94a3b8; font-size:1rem; line-height:1.8; margin-bottom:20px;">Ses tellerinin en büyük düşmanı sürtünmedir. Sürtünmeyi sıfırlamak için ses telinin üstündeki kaygan mukozayı her zaman %100 kapasitede tutmalısınız.</p>

    <div class="spa-container">
      <div class="water-drop" id="spaEmoji">
        💧
        <div class="water-fill" id="waterFill"></div>
      </div>
      <div class="spa-status" id="spaStatus">Mukoza Kuruluğu Tespit Edildi</div>
      <div class="spa-desc" id="spaDesc">Havadaki kuruluk ve az su tüketimi ses tellerindeki kayganlığı bitirir. Nodül riski başlar.</div>
      
      <div class="spa-controls">
        <button class="spa-btn" onclick="applySpa('su')">🥤 1 Bardak Su İç (Sistemik)</button>
        <button class="spa-btn" onclick="applySpa('buhar')">♨️ Sıcak Buhar Solu (Yüzeysel)</button>
        <button class="spa-btn" onclick="applySpa('kahve')">☕ Kahve İç (Kurutucu)</button>
      </div>
    </div>
  </div>

  <!-- 🌿 CLINIC GYM 🌿 -->
  <div class="glass reveal">
    <div class="section-label">🚑 Klinik Protokolleri</div>
    <p style="color:#94a3b8; font-size:1rem; line-height:1.8; margin-bottom:30px;">Acil durumlar ve günlük ses bakımı için altın standart tedavi yöntemleri.</p>
    
    <div class="gym-container">
      <div class="gym-card" onclick="startClinic('acil')">
        <div class="gym-icon">🚑</div>
        <div class="gym-title">Ses Kısıklığı Acil Durum</div>
        <div class="gym-desc">Ses kısıldığı an kalıcı hasarı önlemek için yapılacak ilk 24 saatlik protokol.</div>
      </div>
      
      <div class="gym-card" onclick="startClinic('cooldown')">
        <div class="gym-icon">🧊</div>
        <div class="gym-title">Vocal Cooldown (Soğutma)</div>
        <div class="gym-desc">Yoğun bir sunum veya yayın sonrası şişen ses tellerini rahatlatma masajı.</div>
      </div>
      
      <div class="gym-card" onclick="startClinic('hijyen')">
        <div class="gym-icon">🛡️</div>
        <div class="gym-title">10 Altın Kural</div>
        <div class="gym-desc">Asla fısıldama, gıcık temizleme. Günlük hayatta sesi %100 koruyan yasaklar.</div>
      </div>
      
      <div class="gym-card" onclick="startClinic('reflu')">
        <div class="gym-icon">🔥</div>
        <div class="gym-title">Sessiz Reflü Koruması</div>
        <div class="gym-desc">Mide asidinin gece uyurken ses tellerini yakmasını engelleyecek önlemler.</div>
      </div>
    </div>
  </div>

  <!-- 🌿 MASTER WORKOUT PANEL 🌿 -->
  <div class="workout-panel reveal" id="workoutPanel" style="display:none;">
    <div class="section-label" style="justify-content:center; color:#34d399;" id="workoutTitle">🩺 Protokol Başlıyor</div>
    <div class="workout-display" id="workoutDisplay">Hazır mısınız?</div>
    <div class="workout-hint" id="workoutHint">Bu adımları harfiyen uygulayın.</div>
    <button class="workout-btn" id="workoutActionBtn" onclick="nextClinicStep()">Uygulamaya Başla</button>
  </div>

  <!-- 🌿 PRO TIP 🌿 -->
  <div style="background:linear-gradient(135deg,rgba(16,185,129,.1),rgba(52,211,153,.05)); border:1px solid rgba(16,185,129,.3); border-radius:24px; padding:30px; font-size:1rem; color:#e2e8f0; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">⚠️</span>
    <div>
      <strong style="color:#34d399; display:block; margin-bottom:8px;">Altın Kural: Fısıldamak Tehlikelidir!</strong>
      Toplumdaki en büyük yanılgılardan biri "Sesim kısıldı, ses tellerim yorulmasın diye fısıldayarak konuşayım" demektir. Fısıldamak, ses tellerinin asimetrik bir şekilde ve çok yüksek bir gerilimle birbirine sürtünmesine yol açar. Kısık sesli birine yapabileceğiniz en büyük iyilik "Mutlak Ses İstirahati" (hiç konuşmamak) veya çok kısık bir tonda (fısıltısız) konuşmaktır.
    </div>
  </div>

</div>

<script>
// 🌿 Scroll Reveal 🌿
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🌿 Spa Logic 🌿
let hydrationLevel = 20;

function applySpa(action) {
  const fill = document.getElementById('waterFill');
  const emoji = document.getElementById('spaEmoji');
  const status = document.getElementById('spaStatus');
  const desc = document.getElementById('spaDesc');

  if(action === 'su') {
    hydrationLevel = Math.min(100, hydrationLevel + 30);
    emoji.innerHTML = `🧊<div class="water-fill" style="height:${hydrationLevel}%"></div>`;
    status.innerHTML = "Sistemik Nemlendirme Aktif";
    desc.innerHTML = "Suyun böbreklerden kana karışıp ses telinize ulaşması 2 saati bulacaktır. Doğru yoldasınız.";
    status.style.color = "#34d399";
  } else if(action === 'buhar') {
    hydrationLevel = 100;
    emoji.innerHTML = `♨️<div class="water-fill" style="height:${hydrationLevel}%"></div>`;
    status.innerHTML = "Anında Yüzeysel Nemlendirme";
    desc.innerHTML = "Sıcak buhar doğrudan ses tellerine inerek kuruyan ve tahriş olan bölgeleri anında ıslattı ve balgamı çözdü.";
    status.style.color = "#a7f3d0";
  } else if(action === 'kahve') {
    hydrationLevel = Math.max(0, hydrationLevel - 40);
    emoji.innerHTML = `🌵<div class="water-fill" style="height:${hydrationLevel}%"></div>`;
    status.innerHTML = "Diüretik Kuruma Başladı!";
    desc.innerHTML = "Kahve/Çay içindeki kafein vücuttan su atar. Ses telindeki kaygan sıvı kurudu, sürtünme riski (nodül) çok yüksek.";
    status.style.color = "#ef4444";
  }
}

// 🌿 Clinic Protocol Logic 🌿
const clinicData = {
  acil: {
    title: '🚑 Ses Kısıklığı İlk 24 Saat',
    steps: [
      { text: 'Konuşmayı Tamamen KESİN.', hint: '1 Kelime bile etmeyin. Sadece el işareti veya yazıyla anlaşın.' },
      { text: 'Asla Fısıldamayın.', hint: 'Fısıldamak ses teline normal konuşmaktan DAHA FAZLA zarar verir.' },
      { text: 'Kaynar veya Buzlu İçmeyin.', hint: 'Sadece oda sıcaklığında su tüketin.' },
      { text: 'Bol Buhar Soluyun.', hint: 'İçine Vicks/Mentol koymadan sadece sıcak su buharı soluyun.' }
    ]
  },
  cooldown: {
    title: '🧊 Vocal Cooldown (Soğutma)',
    steps: [
      { text: 'Sunum / Yayın Bitti.', hint: 'Hemen sessiz bir odaya geçin.' },
      { text: 'Siren Sesi Yapın (Trill)', hint: 'Dudaklarınızı pır pır titreterek inceden kalına inin (3 Kez).' },
      { text: 'Çok Kısık Sesle Uuuuuu', hint: 'İç çeker gibi en pes tonda U diyerek boğazı rahatlatın.' },
      { text: 'Boyun Masajı', hint: 'Parmak uçlarınızla gırtlağın iki yanındaki kasları yumuşatın.' }
    ]
  },
  hijyen: {
    title: '🛡️ Ses Hijyeni Altın Kuralları',
    steps: [
      { text: 'Boğazınızı Asla "Ahem" Diye Kazımayın.', hint: 'Zımpara kağıdı sürtmek gibidir. Gıcık gelirse su yudumlayın.' },
      { text: 'Bağırmayın, Çığlık Atmayın.', hint: 'Gürültülü ortamlarda (konser, cafe) bağırmak yerine yaklaşın.' },
      { text: 'Uykunuzu Tam Alın.', hint: 'Ses tellerinin hücre yenilenmesi sadece derin uykuda olur.' },
      { text: 'Kilo Başına 30ml Su İçin.', hint: 'Günde ortalama 2.5 Litre su sesinizin sigortasıdır.' }
    ]
  },
  reflu: {
    title: '🔥 Sessiz Reflü Koruması',
    steps: [
      { text: 'Yatmadan 3 Saat Önce Yemeyi Kesin.', hint: 'Mide asidinin uykuda boğaza sızmasını engeller.' },
      { text: 'Yüksek Yastıkta Yatın.', hint: 'Yerçekimini kullanarak asidi midede tutun.' },
      { text: 'Çikolata, Nane, Kahve Kısıtlaması', hint: 'Özellikle akşamları mide kapakçığını gevşeten bu gıdaları tüketmeyin.' },
      { text: 'Sabahları Sesinizi Zorlamayın.', hint: 'Eğer gece asit yanığı olduysa, sabah ses boğuk uyanır. Hemen bağırarak açmaya çalışmayın.' }
    ]
  }
};

let currentClinic = null;
let currentClinicIndex = 0;

function startClinic(id) {
  currentClinic = clinicData[id];
  currentClinicIndex = 0;
  
  const panel = document.getElementById('workoutPanel');
  panel.style.display = 'block';
  
  document.getElementById('workoutTitle').innerHTML = currentClinic.title;
  
  const step = currentClinic.steps[0];
  document.getElementById('workoutDisplay').innerHTML = step.text;
  document.getElementById('workoutHint').innerHTML = step.hint;
  document.getElementById('workoutActionBtn').innerHTML = 'Anladım, Sonraki';
  
  currentClinicIndex = 1;
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function nextClinicStep() {
  if(!currentClinic) return;
  
  if(currentClinicIndex < currentClinic.steps.length) {
    const step = currentClinic.steps[currentClinicIndex];
    document.getElementById('workoutDisplay').innerHTML = step.text;
    document.getElementById('workoutHint').innerHTML = step.hint;
    document.getElementById('workoutActionBtn').innerHTML = (currentClinicIndex === currentClinic.steps.length - 1) ? 'Protokolü Tamamla' : 'Anladım, Sonraki';
    currentClinicIndex++;
  } else {
    document.getElementById('workoutDisplay').innerHTML = '✅ Tedavi/Koruma Protokolü Başarılı.';
    document.getElementById('workoutHint').innerHTML = 'Sağlıklı bir ses için bu kuralları hayat tarzı haline getirin.';
    document.getElementById('workoutActionBtn').innerHTML = 'Başa Dön';
    currentClinicIndex = 0;
  }
}
</script>

<%- include('partials/main-footer') %>
