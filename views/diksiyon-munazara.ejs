<%- include('partials/main-header') %>

<style>
  /* ⚖️ Debate Academy Light Theme ⚖️ */
  body { background: #fdfaf6; color: #1e293b; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ⚖️ Hero Section ⚖️ */
  .m-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #fee2e2 0%, #fdfaf6 80%);
  }
  .m-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fdfaf6,transparent); }

  /* Red vs Blue Background Clash */
  .clash-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; display:flex; justify-content: space-between; opacity: 0.15; }
  .red-side { width: 50%; height: 100%; background: linear-gradient(135deg, #ef4444, transparent); clip-path: polygon(0 0, 100% 0, 70% 100%, 0% 100%); }
  .blue-side { width: 50%; height: 100%; background: linear-gradient(-135deg, #3b82f6, transparent); clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%); margin-left:-20%; }

  .m-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: pulseBalance 3s infinite alternate; filter: drop-shadow(0 10px 20px rgba(239,68,68,0.3)); }
  @keyframes pulseBalance { 0%{ transform: scale(1) rotate(-5deg); } 100%{ transform: scale(1.1) rotate(5deg); } }

  .m-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #b91c1c; background: #fee2e2; border:1px solid #fecaca; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(239,68,68,0.15); }
  .m-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #0f172a; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .m-title span { background: linear-gradient(135deg, #ef4444, #3b82f6); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .m-subtitle { color: #475569; font-size:1.2rem; max-width:700px; line-height:1.8; z-index:2; position:relative; }

  /* ⚖️ Container ⚖️ */
  .m-wrap { max-width:1050px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* ⚖️ Glass Cards ⚖️ */
  .glass-debate { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(25px); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .glass-debate:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #ef4444; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* ⚖️ Rebuttal Builder ⚖️ */
  .rebuttal-box { background: #f8fafc; border-radius: 24px; padding: 30px; border: 2px dashed #cbd5e1; display:flex; flex-direction:column; gap:20px; }
  .opponent-arg { font-size: 1.4rem; font-weight: 800; color: #b91c1c; padding: 20px; background: #fee2e2; border-left: 5px solid #ef4444; border-radius: 12px; }
  
  .fallacy-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
  .fallacy-btn { padding: 15px; background: white; border: 2px solid #e2e8f0; border-radius: 16px; font-size: 1.05rem; font-weight: 700; color: #475569; cursor: pointer; transition: all 0.3s; text-align:left; }
  .fallacy-btn:hover { border-color: #3b82f6; background: #eff6ff; color: #1d4ed8; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(59,130,246,0.1); }
  
  .defense-result { display: none; margin-top: 20px; padding: 20px; border-radius: 16px; font-size: 1.1rem; font-weight: 600; line-height:1.6; }
  .defense-result.success { display: block; background: #eff6ff; color: #1e3a8a; border-left: 5px solid #3b82f6; }
  .defense-result.fail { display: block; background: #fef2f2; color: #991b1b; border-left: 5px solid #ef4444; }

  /* ⚖️ Timer Pressure Simulator ⚖️ */
  .timer-box { display: flex; flex-direction: column; align-items: center; background: #0f172a; border-radius: 32px; padding: 40px; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
  .t-circle { width: 150px; height: 150px; border-radius: 50%; border: 8px solid #334155; display: flex; align-items: center; justify-content: center; font-size: 4rem; font-weight: 900; color: white; margin-bottom: 30px; position: relative; z-index: 2; transition: border-color 0.3s, color 0.3s; }
  .t-circle.danger { border-color: #ef4444; color: #ef4444; animation: heartbeat 1s infinite; }
  @keyframes heartbeat { 0% {transform: scale(1);} 50% {transform: scale(1.1);} 100% {transform: scale(1);} }
  
  .t-text { color: #cbd5e1; font-size: 1.2rem; max-width: 600px; text-align: center; margin-bottom: 30px; line-height: 1.6; z-index: 2; }
  .start-btn { padding: 15px 40px; background: linear-gradient(135deg, #ef4444, #f97316); color: white; border: none; border-radius: 100px; font-size: 1.2rem; font-weight: 800; cursor: pointer; transition: transform 0.2s; z-index: 2; box-shadow: 0 10px 20px rgba(239,68,68,0.3); }
  .start-btn:hover { transform: scale(1.05); }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #e2e8f0; color:#475569; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#f8fafc; color:#0f172a; transform:translateX(-4px); border-color: #cbd5e1; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="m-hero">
  <div class="clash-bg">
    <div class="red-side"></div>
    <div class="blue-side"></div>
  </div>
  <div class="m-icon">⚖️</div>
  <div class="m-badge">Zeka Satrancı Akademisi</div>
  <h1 class="m-title">Mantığın <span>Savaş Alanı</span></h1>
  <p class="m-subtitle">Bağırarak değil, argümanları çökertip kurgulayarak haklı çıkma sanatı. British Parliamentary'den Lincoln-Douglas'a 40 farklı münazara tekniği.</p>
</section>

<div class="m-wrap">
  <a href="/diksiyon?cat=munazara" class="back-btn">← Tüm Münazara Analizlerini Gör (40 Figür)</a>

  <!-- ⚖️ ÇÜRÜTME BUILDER ⚖️ -->
  <div class="glass-debate reveal">
    <div class="section-label">🥊 Çürütme (Rebuttal) Simülatörü</div>
    <p style="color:#475569; font-size:1.05rem; line-height:1.6; margin-bottom:25px;">
      Karşınızdaki rakip "Hükümet" tarafı, son derece duygusal ve mantık hatalarıyla dolu bir argüman sundu. Dinleyiciler etkilenmek üzere. Hangi mantık hatasını (Fallacy) kullanarak bu argümanı çürüteceksiniz?
    </p>

    <div class="rebuttal-box">
      <div class="opponent-arg">
        "Eğer bugün okullarda üniformaları kaldırırsak, yarın çocuklar okula pijamayla gelir, sonraki gün anarşi çıkar ve eğitim sistemi tamamen çöker!"
      </div>
      
      <div class="fallacy-grid">
        <button class="fallacy-btn" onclick="checkRebuttal(0)">
          <strong>A) Ad Hominem:</strong> Karşı tarafın kişiliğine saldır.
        </button>
        <button class="fallacy-btn" onclick="checkRebuttal(1)">
          <strong>B) Slippery Slope (Kaygan Zemin):</strong> Zincirleme abartıyı ifşa et.
        </button>
        <button class="fallacy-btn" onclick="checkRebuttal(2)">
          <strong>C) Straw Man (Korkuluk):</strong> Rakibin argümanını çarpıt.
        </button>
        <button class="fallacy-btn" onclick="checkRebuttal(3)">
          <strong>D) Appeal to Emotion:</strong> Ağlayarak duygu sömürüsü yap.
        </button>
      </div>
      
      <div id="rebuttalResult" class="defense-result"></div>
    </div>
  </div>

  <!-- ⚖️ TIMER PRESSURE ⚖️ -->
  <div class="glass-debate reveal">
    <div class="section-label">⏱️ Zaman Baskısı (Timer Pressure) Testi</div>
    <p style="color:#475569; font-size:1.05rem; line-height:1.6; margin-bottom:25px;">
      Münazaralarda "Süreniz doldu" dendiği an mikrofon kesilir. Aşağıdaki Kapanış Konuşması metnini, süreniz dolmadan takılmadan, net ve otoriter bir şekilde okumaya çalışın.
    </p>

    <div class="timer-box">
      <div class="t-circle" id="timerDisplay">45</div>
      <div class="t-text" id="timerText">
        "Sayın jüri, muhalefet kanadı bize bugün sadece korku sattı. Ancak korku bir politika değildir. Bizler, somut istatistiklerle kanıtladık ki; evrensel temel gelir bir lütuf değil, otomasyon çağının matematiksel bir zorunluluğudur. Bizi geleceğe hazırlayacak olan şey eski alışkanlıklar değil, cesur adımlardır. Kararınızla geleceği onaylayın. Teşekkür ederim."
      </div>
      <button class="start-btn" id="startTimerBtn" onclick="startTimer()">Başla (45 Saniye)</button>
    </div>
  </div>

</div>

<script>
// ⚖️ Scroll Reveal ⚖️
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// ⚖️ Rebuttal Logic ⚖️
function checkRebuttal(choice) {
  const res = document.getElementById('rebuttalResult');
  res.className = 'defense-result'; // reset
  
  if(choice === 1) {
    res.classList.add('success');
    res.innerHTML = "✅ <strong>Muazzam Çürütme! (Slippery Slope)</strong><br> Rakibiniz bir şeyin ufak bir değişiminin zincirleme felaketlere yol açacağını iddia ederek 'Kaygan Zemin' mantık hatası yaptı. Jüriye dönüp: <em>'Sayın jüri, kıyafet özgürlüğünün anarşi getireceği iddiası, Hollywood filmlerinden fırlamış mantıksız bir distopyadır.'</em> demeniz yeterlidir.";
  } else {
    res.classList.add('fail');
    let err = "";
    if(choice===0) err = "Kişiye saldırmak (Ad Hominem) sizi jüri önünde anında haksız ve agresif gösterir.";
    if(choice===2) err = "Straw Man, rakibin söylemediği bir şeyi söylemiş gibi göstermektir, çürütme değil yeni bir yalandır.";
    if(choice===3) err = "Mantıksal bir hatayı duyguyla çözemezsiniz. Logos (Mantık) gerekir.";
    res.innerHTML = `❌ <strong>Yanlış Hamle!</strong><br>${err}`;
  }
}

// ⚖️ Timer Logic ⚖️
let timerInterval;
function startTimer() {
  clearInterval(timerInterval);
  let timeLeft = 45;
  const display = document.getElementById('timerDisplay');
  const btn = document.getElementById('startTimerBtn');
  
  display.innerText = timeLeft;
  display.classList.remove('danger');
  btn.style.display = 'none';
  
  timerInterval = setInterval(() => {
    timeLeft--;
    display.innerText = timeLeft;
    
    if(timeLeft <= 10) {
      display.classList.add('danger');
    }
    
    if(timeLeft <= 0) {
      clearInterval(timerInterval);
      display.innerText = "0";
      alert("SÜRE BİTTİ! Mikrofonunuz kapandı. Cümleyi bitirebildiniz mi?");
      btn.style.display = 'inline-block';
      btn.innerText = "Tekrar Dene";
    }
  }, 1000);
}
</script>

<%- include('partials/main-footer') %>
