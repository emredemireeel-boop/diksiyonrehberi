<%- include('partials/main-header') %>

<style>
  /* 🕴️ Kinetic Leadership Light Theme 🕴️ */
  body { background: #eef2ff; color: #1e1b4b; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🕴️ Hero Section 🕴️ */
  .bl-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #c7d2fe 0%, #eef2ff 80%);
  }
  .bl-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#eef2ff,transparent); }

  /* Kinetic Background */
  .bl-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; opacity: 0.15; }
  .bl-bg::before { content:''; position:absolute; width: 200%; height: 200%; top: -50%; left: -50%; background-image: conic-gradient(from 0deg at 50% 50%, #4f46e5 0deg, transparent 60deg, transparent 300deg, #4f46e5 360deg); animation: rotateRays 30s linear infinite; opacity: 0.5; }
  @keyframes rotateRays { 100% { transform: rotate(360deg); } }

  .bl-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: floatPosture 4s ease-in-out infinite; filter: drop-shadow(0 15px 25px rgba(79,70,229,0.3)); }
  @keyframes floatPosture { 0%,100%{ transform:translateY(0) scale(1); } 50%{ transform:translateY(-15px) scale(1.05); } }

  .bl-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #4f46e5; background: #e0e7ff; border:1px solid #818cf8; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(79,70,229,0.15); }
  .bl-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #1e1b4b; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .bl-title span { background: linear-gradient(135deg, #6366f1, #4338ca); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .bl-subtitle { color: #4f46e5; font-size:1.2rem; max-width:750px; line-height:1.8; z-index:2; position:relative; font-weight: 500; }

  /* 🕴️ Container 🕴️ */
  .bl-wrap { max-width:1100px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 🕴️ Premium Cards 🕴️ */
  .bl-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(79, 70, 229, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .bl-card:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(79, 70, 229, 0.1); border-color: rgba(79, 70, 229, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #4f46e5; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* 🕴️ Micro-Expression Catcher 🕴️ */
  .micro-box { background: #312e81; border-radius: 24px; padding: 40px; text-align: center; color: white; position: relative; overflow: hidden; }
  .face-display { font-size: 6rem; height: 120px; display: flex; align-items: center; justify-content: center; margin: 20px auto; background: white; border-radius: 50%; width: 140px; box-shadow: 0 0 30px rgba(99,102,241,0.5); position: relative; transition: all 0.3s; }
  
  .face-controls { margin-bottom: 30px; }
  .start-face-btn { padding: 14px 28px; background: #4f46e5; color: white; font-weight: 800; font-size: 1.1rem; border: none; border-radius: 12px; cursor: pointer; transition: all 0.3s; box-shadow: 0 8px 15px rgba(79,70,229,0.3); }
  .start-face-btn:hover { background: #4338ca; transform: scale(1.05); }

  .micro-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .micro-options.active { opacity: 1; pointer-events: auto; }
  .m-opt-btn { padding: 15px; background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.2); border-radius: 12px; color: white; font-weight: 600; font-size: 1.05rem; cursor: pointer; transition: all 0.2s; }
  .m-opt-btn:hover { background: rgba(255,255,255,0.2); border-color: #818cf8; }
  .m-opt-btn.correct { background: #22c55e; border-color: #16a34a; }
  .m-opt-btn.wrong { background: #ef4444; border-color: #dc2626; }

  .micro-feedback { min-height: 50px; margin-top: 20px; font-weight: 600; color: #a5b4fc; font-size: 1.1rem; }

  /* 🕴️ Power Pose Simulator 🕴️ */
  .pose-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 24px; padding: 40px; display: flex; flex-direction: column; gap: 30px; }
  .scenario-card { background: white; padding: 25px; border-radius: 16px; border-left: 5px solid #4f46e5; box-shadow: 0 4px 10px rgba(0,0,0,0.03); font-size: 1.15rem; color: #334155; line-height: 1.6; font-weight: 500; }
  
  .pose-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
  .pose-card { background: white; border: 2px solid #e2e8f0; border-radius: 16px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px; }
  .pose-card:hover { border-color: #818cf8; transform: translateY(-5px); box-shadow: 0 10px 20px rgba(79,70,229,0.1); }
  .pose-card.correct { border-color: #22c55e; background: #f0fdf4; }
  .pose-card.wrong { border-color: #ef4444; background: #fef2f2; }
  
  .pose-icon { font-size: 3.5rem; }
  .pose-name { font-weight: 800; color: #1e1b4b; }
  .pose-desc { font-size: 0.9rem; color: #64748b; }

  .pose-feedback { text-align: center; font-size: 1.1rem; font-weight: bold; min-height: 30px; color: #4f46e5; }
  .next-pose-btn { display: inline-block; padding: 12px 24px; background: #4f46e5; color: white; border: none; border-radius: 12px; font-weight: 700; cursor: pointer; margin: 0 auto; display: none; }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #e0e7ff; color:#4f46e5; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#eef2ff; color:#3730a3; transform:translateX(-4px); border-color: #c7d2fe; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="bl-hero">
  <div class="bl-bg"></div>
  <div class="bl-icon">🕴️</div>
  <div class="bl-badge">Kinetik Liderlik Stüdyosu</div>
  <h1 class="bl-title">Beden Dili ve <span>Duruş</span></h1>
  <p class="bl-subtitle">İnsanlar konuştuklarınızdan önce duruşunuzu (Postür) dinler. Güç duruşları (Power Pose), mikro ifadeler ve el jestleriyle otoritenizi bilinçaltına nasıl kodlayacağınızı keşfedin.</p>
</section>

<div class="bl-wrap">
  <a href="/diksiyon?cat=bedendili" class="back-btn">← Tüm Beden Dili Taktiklerini Gör (30 Madde)</a>

  <!-- 🕴️ MICRO-EXPRESSION CATCHER 🕴️ -->
  <div class="bl-card reveal" style="background:#312e81; border:none;">
    <div class="section-label" style="color:#a5b4fc;">👁️ Mikro İfade Yakalayıcı</div>
    <p style="color:#e0e7ff; font-size:1.05rem; line-height:1.6; margin-bottom:30px;">
      İnsanlar yalan söylediğinde veya gerçek duygularını sakladığında, yüzlerinde saliselik (1/15 saniye) "Mikro İfadeler" belirir. Başlat butonuna basın, yüze dikkatlice bakın ve gizlenen duyguyu bulun.
    </p>

    <div class="micro-box">
      <div class="face-display" id="mFace">😐</div>
      
      <div class="face-controls">
        <button class="start-face-btn" id="mStart" onclick="startMicro()">Saliselik Yüzü Göster ▶</button>
      </div>

      <div class="micro-options" id="mOpts">
        <!-- Buttons injected via JS -->
      </div>
      
      <div class="micro-feedback" id="mBack">Önce dikkatlice yüze odaklanın.</div>
    </div>
  </div>

  <!-- 🕴️ POWER POSE SIMULATOR 🕴️ -->
  <div class="bl-card reveal">
    <div class="section-label">⚡ Güç Duruşu (Power Pose) Simülatörü</div>
    <p style="color:#4f46e5; font-size:1.05rem; line-height:1.6; margin-bottom:30px;">
      Ortama, statüye ve amaca göre farklı beden dili araçları (Jestler, Duruşlar) seçilmelidir. Aşağıdaki senaryoyu okuyun ve duruma en uygun (en otoriter veya en empatik) postürü seçin.
    </p>

    <div class="pose-box">
      <div class="scenario-card" id="pScen">
        "Yeni bir ekibin başına geçtiniz. İlk toplantıda onlara hem 'Patron benim' otoritesini vermek hem de vizyoner bir lider olduğunuzu hissettirmek istiyorsunuz. Masada nasıl durmalısınız?"
      </div>
      
      <div class="pose-grid" id="pGrid">
        <!-- Generated via JS -->
      </div>
      
      <div class="pose-feedback" id="pBack"></div>
      <button class="next-pose-btn" id="pNext" onclick="nextPose()">Sıradaki Senaryo →</button>
    </div>
  </div>

</div>

<script>
// 🕴️ Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🕴️ Micro-Expression Logic
const microCases = [
  { em: '😠', dur: 150, correct: 'Öfke (Anger)', exp: 'Kaşların ortadan birleşmesi ve dudakların incelmesi, kişinin bastırmaya çalıştığı gizli bir öfkeye işarettir.' },
  { em: '😏', dur: 100, correct: 'Küçümseme (Contempt)', exp: 'Dudağın tek tarafının yukarı kalkması, kişinin sizi kendinden aşağıda gördüğünü (Kibir/Küçümseme) gösterir.' },
  { em: '😟', dur: 200, correct: 'Korku (Fear)', exp: 'Gözlerin fal taşı gibi açılması ve dudakların yatay olarak gerilmesi gizli bir endişeyi veya korkuyu ele verir.' }
];

let currMicro = 0;

function startMicro() {
  const c = microCases[currMicro];
  document.getElementById('mStart').style.display = 'none';
  document.getElementById('mBack').innerText = "Dikkat!";
  
  // Reset face
  document.getElementById('mFace').innerText = '😐';
  document.getElementById('mOpts').classList.remove('active');
  
  // Flash
  setTimeout(() => {
    document.getElementById('mFace').innerText = c.em;
    setTimeout(() => {
      document.getElementById('mFace').innerText = '😐'; // Back to neutral
      showMicroOptions(c);
    }, c.dur);
  }, 800);
}

function showMicroOptions(c) {
  const cont = document.getElementById('mOpts');
  cont.innerHTML = '';
  document.getElementById('mBack').innerText = "Şimdi, gizlenen duygu neydi?";
  
  const allOpts = ['Öfke (Anger)', 'Küçümseme (Contempt)', 'Korku (Fear)', 'Mutluluk (Joy)'].sort(() => Math.random() - 0.5);
  
  allOpts.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'm-opt-btn';
    btn.innerText = opt;
    btn.onclick = function() { checkMicro(this, opt === c.correct, c.exp); };
    cont.appendChild(btn);
  });
  
  cont.classList.add('active');
}

function checkMicro(btn, isCorrect, exp) {
  const btns = document.getElementById('mOpts').querySelectorAll('.m-opt-btn');
  btns.forEach(b => b.style.pointerEvents = 'none'); // disable
  
  const fb = document.getElementById('mBack');
  if(isCorrect) {
    btn.classList.add('correct');
    fb.innerHTML = `✅ Harika Yakaladınız! ${exp}`;
  } else {
    btn.classList.add('wrong');
    // find correct and highlight
    btns.forEach(b => { if(b.innerText === microCases[currMicro].correct) b.style.borderColor = '#22c55e'; });
    fb.innerHTML = `❌ Kaçırdınız. Oysaki saliselik ifade "${microCases[currMicro].correct}" idi.`;
  }
  
  setTimeout(() => {
    currMicro++;
    if(currMicro < microCases.length) {
      document.getElementById('mStart').style.display = 'inline-block';
      document.getElementById('mStart').innerText = "Sıradaki Yüzü İncele ▶";
      document.getElementById('mOpts').classList.remove('active');
    } else {
      fb.innerHTML += "<br>Tüm yüzleri okudunuz!";
    }
  }, 4000);
}

// 🕴️ Power Pose Logic
const poseCases = [
  {
    s: "Yeni bir ekibin başına geçtiniz. İlk toplantıda onlara hem 'Lider benim' otoritesini vermek hem de vizyoner olduğunuzu hissettirmek istiyorsunuz.",
    opts: [
      { i: '🙏', t: 'Steeple (Çatı Jesti)', d: 'Parmak uçları bitişik, eller göğüs hizasında.', v: true },
      { i: '🙅‍♂️', t: 'Çapraz Kollar', d: 'Kollar göğüste bağlı, geriye yaslanmış.', v: false },
      { i: '🙇‍♂️', t: 'Baş Eğik, Eller Masada', d: 'Göz teması az, eller kenetlenmiş.', v: false }
    ],
    e: 'Doğru Seçim! Steeple (Çatı Jesti), dünya liderlerinin kullandığı, bilgeliği, otoriteyi ve özgüveni simgeleyen en güçlü el hareketidir.'
  },
  {
    s: "Sizi sözlü olarak taciz eden pasif-agresif bir müşterinizle ayakta tartışıyorsunuz. Geri adım atmayacağınızı bedensel olarak nasıl gösterirsiniz?",
    opts: [
      { i: '🦸‍♂️', t: 'Superman Duruşu', d: 'Eller belde, göğüs dışarıda, ayaklar açık.', v: true },
      { i: '🤦‍♂️', t: 'Boyun/Saç Ovma', d: 'Ellerle ense veya saça dokunma (Pacifying).', v: false },
      { i: '🤷‍♂️', t: 'Omuz Silkme', d: 'Avuç içleri açık, omuzlar yukarıda.', v: false }
    ],
    e: 'Mükemmel! Superman duruşu alanı kaplar. Hayvanlar aleminde de olduğu gibi "Büyümek", karşı tarafa bilinçaltı bir tehdit ve "Geri adım atmam" mesajı verir.'
  }
];

let currPose = 0;

function loadPose() {
  const c = poseCases[currPose];
  document.getElementById('pScen').innerText = c.s;
  
  const cont = document.getElementById('pGrid');
  cont.innerHTML = '';
  c.opts.forEach(opt => {
    const card = document.createElement('div');
    card.className = 'pose-card';
    card.innerHTML = `
      <div class="pose-icon">${opt.i}</div>
      <div class="pose-name">${opt.t}</div>
      <div class="pose-desc">${opt.d}</div>
    `;
    card.onclick = function() { checkPose(this, opt.v, c.e); };
    cont.appendChild(card);
  });
  
  document.getElementById('pBack').innerText = '';
  document.getElementById('pNext').style.display = 'none';
}

function checkPose(card, isCorrect, exp) {
  const cards = document.getElementById('pGrid').querySelectorAll('.pose-card');
  cards.forEach(c => c.style.pointerEvents = 'none');
  
  const fb = document.getElementById('pBack');
  if(isCorrect) {
    card.classList.add('correct');
    fb.innerHTML = `✅ ${exp}`;
    fb.style.color = '#16a34a';
  } else {
    card.classList.add('wrong');
    fb.innerHTML = `❌ Hatalı Postür. Bu duruş güçsüzlük veya kapalılık mesajı verir. Doğru olanı seçmeliydiniz.`;
    fb.style.color = '#ef4444';
  }
  
  if(currPose < poseCases.length - 1) {
    document.getElementById('pNext').style.display = 'block';
  } else {
    document.getElementById('pNext').style.display = 'block';
    document.getElementById('pNext').innerText = "Simülasyon Tamamlandı 🕴️";
    document.getElementById('pNext').onclick = null;
  }
}

function nextPose() {
  currPose++;
  loadPose();
}

// init
loadPose();
</script>

<%- include('partials/main-footer') %>
