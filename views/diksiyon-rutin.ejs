<%- include('partials/main-header') %>

<style>
  /* ☀️ Overriding global dark theme specifically for this page ☀️ */
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ☀️ Hero ☀️ */
  .r-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #e0f2fe 0%, #f8fafc 70%);
  }
  .r-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#f8fafc,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: rFloat 8s ease-in-out infinite; background: linear-gradient(135deg, #3b82f6, #0ea5e9); opacity: 0.15; }
  @keyframes rFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.1; } 50%{ transform:translateY(-50px) scale(1.5); opacity:.3; } }

  .r-icon { font-size: 6rem; margin-bottom: 20px; animation: rPulse 3s ease-in-out infinite; filter: drop-shadow(0 10px 20px rgba(14,165,233,0.2)); }
  @keyframes rPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.05) translateY(-5px); } }

  .r-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color: #1d4ed8; background: #dbeafe; border:1px solid #bfdbfe; margin-bottom:24px; box-shadow: 0 4px 15px rgba(59,130,246,0.1); }
  .r-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color: #0f172a; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .r-title span { background: linear-gradient(135deg, #2563eb, #0ea5e9); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .r-subtitle { color: #475569; font-size:1.15rem; max-width:700px; line-height:1.8; }

  /* ☀️ Container ☀️ */
  .r-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* ☀️ Light Glass Cards ☀️ */
  .glass-light { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 1); border-radius: 24px; padding: 40px; margin-bottom: 40px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.03); }
  .glass-light:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08); border-color: #bae6fd; }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color: #2563eb; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background: #2563eb; border-radius:2px; }

  /* ☀️ Morning Routine Simulator ☀️ */
  .routine-player { background: #ffffff; border-radius: 20px; padding: 30px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.02); text-align: center; }
  .timer-ring { width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center; background: conic-gradient(#3b82f6 0%, #e2e8f0 0%); position: relative; transition: background 0.2s linear; }
  .timer-ring::after { content: ''; width: 100px; height: 100px; background: #ffffff; border-radius: 50%; position: absolute; }
  .timer-text { font-size: 2rem; font-weight: 800; color: #1e293b; z-index: 1; font-variant-numeric: tabular-nums; }
  
  .step-display { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 10px; }
  .step-desc { color: #64748b; font-size: 1rem; margin-bottom: 24px; max-width: 400px; margin-inline: auto; }
  
  .play-btn { padding: 14px 40px; border-radius: 100px; background: linear-gradient(135deg, #3b82f6, #0ea5e9); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 20px rgba(59,130,246,0.3); transition: all .3s; }
  .play-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 30px rgba(59,130,246,0.4); }

  /* ☀️ Program Cards (Challenge & Plans) ☀️ */
  .program-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .program-grid { grid-template-columns: 1fr; } }
  
  .p-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 24px; cursor: pointer; transition: all .3s; display: flex; align-items: flex-start; gap: 16px; position: relative; overflow: hidden; }
  .p-card::before { content:''; position:absolute; top:0; left:0; width:4px; height:100%; background:#3b82f6; transform:scaleY(0); transition:transform .3s; transform-origin:bottom; }
  .p-card:hover { transform: translateY(-3px); box-shadow: 0 15px 30px rgba(0,0,0,0.05); border-color: #cbd5e1; }
  .p-card:hover::before { transform:scaleY(1); }
  
  .p-icon { font-size: 2.5rem; background: #f1f5f9; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 12px; flex-shrink: 0; }
  .p-info h3 { font-size: 1.1rem; font-weight: 800; color: #0f172a; margin-bottom: 4px; margin-top: 0; }
  .p-info p { font-size: 0.85rem; color: #64748b; line-height: 1.5; margin: 0; }
  .p-tag { display: inline-block; padding: 4px 8px; background: #e0f2fe; color: #0369a1; border-radius: 6px; font-size: 0.7rem; font-weight: 700; margin-top: 8px; text-transform: uppercase; }

  /* ☀️ Master Checklist Modal / View ☀️ */
  .checklist-panel { background: #ffffff; border: 1px solid #bae6fd; border-radius: 20px; padding: 40px; margin-top: 30px; box-shadow: 0 20px 40px rgba(14,165,233,0.1); }
  .c-title { font-size: 1.5rem; font-weight: 800; color: #0f172a; border-bottom: 2px dashed #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; margin-top: 0; }
  .c-item { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #f1f5f9; }
  .c-item:last-child { border-bottom: none; }
  .c-check { width: 24px; height: 24px; border: 2px solid #cbd5e1; border-radius: 6px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; color: transparent; }
  .c-check.done { background: #10b981; border-color: #10b981; color: white; }
  .c-text { font-size: 0.95rem; color: #334155; font-weight: 500; transition: color 0.2s; }
  .c-text.done { text-decoration: line-through; color: #94a3b8; }

  /* ☀️ Back Button ☀️ */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:1px solid #e2e8f0; color:#475569; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#f8fafc; color:#0f172a; transform:translateX(-4px); box-shadow: 0 6px 12px rgba(0,0,0,0.05); }

  /* ☀️ Reveal ☀️ */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="r-hero">
  <div class="hero-particles">
    <% for(let i=0; i<25; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 5+Math.random()*10 %>px; height:<%= 5+Math.random()*10 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 6+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="r-icon">🌅</div>
  <div class="r-badge">🗓️ Plan ve Disiplin Merkezi</div>
  <h1 class="r-title"><span>Günlük Rutinler</span> ve Programlar</h1>
  <p class="r-subtitle">Diksiyon bir günde değil, her gün yapılan düzenli mikro tekrarlarla gelişir. Sabah ısınmalarından, 90 günlük dönüşüm programlarına kadar ihtiyacınız olan tüm profesyonel antrenman planları burada.</p>
</section>

<div class="r-wrap">
  <a href="/diksiyon?cat=rutin" class="back-btn">Tüm Programları İncele</a>

  <!-- ☀️ MORNING SIMULATOR ☀️ -->
  <div class="glass-light reveal">
    <div class="section-label">⏱️ 5 Dakikalık Sabah Isınması (Canlı)</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:30px;">Uyandığınızda ses telleriniz tıpkı soğuk bir motor gibidir. Yüksek perdeden konuşmadan önce onları bu 5 adımlı hızlı rutinle güne hazırlayın.</p>

    <div class="routine-player">
      <div class="timer-ring" id="timerRing">
        <span class="timer-text" id="timerText">05:00</span>
      </div>
      <h3 class="step-display" id="stepTitle">Hazır mısınız?</h3>
      <p class="step-desc" id="stepDesc">Başlat butonuna tıkladığınızda 5 dakikalık tam ısınma turu başlayacaktır. Dik durun ve rahatlayın.</p>
      
      <button class="play-btn" id="btnPlay" onclick="startRoutine()">▶ Antrenmanı Başlat</button>
    </div>
  </div>

  <!-- ☀️ PROGRAM GRID ☀️ -->
  <div class="glass-light reveal">
    <div class="section-label">📅 Antrenman Planları</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:30px;">Zamanınıza ve hedefinize uygun çalışma planını seçin. Tutarlılık, süreden daha önemlidir.</p>
    
    <div class="program-grid">
      <div class="p-card" onclick="loadChecklist('haftalik')">
        <div class="p-icon">📅</div>
        <div class="p-info">
          <h3>Haftalık Diksiyon Planı</h3>
          <p>Her gün sadece 10 dakika ayırarak diyafram ve temel artikülasyon alışkanlığı kazanın.</p>
          <span class="p-tag">Başlangıç</span>
        </div>
      </div>
      
      <div class="p-card" onclick="loadChecklist('challenge')">
        <div class="p-icon">🏆</div>
        <div class="p-info">
          <h3>30 Günlük Challenge</h3>
          <p>Aksanları temizlemek ve kas hafızasını yeniden yazmak için kesintisiz 1 aylık blok.</p>
          <span class="p-tag" style="background:#fef08a; color:#854d0e;">Orta Seviye</span>
        </div>
      </div>
      
      <div class="p-card" onclick="loadChecklist('sahne')">
        <div class="p-icon">🎤</div>
        <div class="p-info">
          <h3>Sunum Öncesi (Sahne)</h3>
          <p>Mülakat veya konferans öncesi tuvalette yapılabilecek 10 dakikalık acil stres ve ses rutini.</p>
          <span class="p-tag" style="background:#fce7f3; color:#be185d;">Acil Durum</span>
        </div>
      </div>
      
      <div class="p-card" onclick="loadChecklist('mikro')">
        <div class="p-icon">⏱️</div>
        <div class="p-info">
          <h3>Sabah-Öğle-Akşam Mikro</h3>
          <p>Zamanım yok diyenler için gün içine yayılmış, masada yapılabilecek 1'er dakikalık kilit egzersizler.</p>
          <span class="p-tag">Pratik</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ☀️ CHECKLIST PANEL ☀️ -->
  <div class="checklist-panel reveal" id="checklistPanel" style="display:none;">
    <h3 class="c-title" id="cTitle">Seçilen Program</h3>
    <div id="cContainer">
      <!-- Checklist items injected via JS -->
    </div>
    <div style="margin-top: 20px; font-size: 0.85rem; color: #64748b; font-style: italic;">
      * Üzerine tıklayarak tamamladığınız görevlerin üzerini çizebilirsiniz. Sayfa yenilendiğinde sıfırlanır.
    </div>
  </div>

  <!-- ☀️ PRO TIP ☀️ -->
  <div style="background:linear-gradient(135deg,rgba(59,130,246,.1),rgba(14,165,233,.05)); border:1px solid rgba(59,130,246,.2); border-radius:24px; padding:30px; font-size:1rem; color:#1e293b; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">🧠</span>
    <div>
      <strong style="color:#2563eb; display:block; margin-bottom:8px;">Altın Kural: Nöroplastisite ve Devamlılık</strong>
      Diksiyon eğitimi beyindeki konuşma merkezini (nöral ağları) yeniden kablolama işlemidir. Haftada 1 gün 2 saat çalışmak size pek bir şey katmaz, aksine sesinizi yorar. Ancak her gün düzenli olarak GÜNDE SADECE 10 DAKİKA çalışmak, beyninize "bu yeni bir alışkanlık" mesajı verir ve kas hafızasını inanılmaz bir hızla geliştirir.
    </div>
  </div>

</div>

<script>
// ☀️ Scroll Reveal ☀️
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// ☀️ Routine Simulator Logic ☀️
let timerInterval;
let timeLeft = 300; // 5 minutes
let currentStepIndex = 0;
let isPlaying = false;

const routineSteps = [
  { time: 300, name: "Derin Diyafram Nefesi", desc: "Burnunuzdan 3 saniyede nefes alın, karnınızı şişirin, tıslayarak 6 saniyede verin." },
  { time: 240, name: "Yüz ve Çene Masajı", desc: "Parmak uçlarınızla elmacık kemiklerinize ve çene altınıza hafifçe (tapping) vurun." },
  { time: 180, name: "Siren Sesi (Lip Trill)", desc: "Dudaklarınızı pır pır titreterek kalın sesten ince sese doğru inip çıkın." },
  { time: 120, name: "Mırıldanma (Humming)", desc: "Ağzınız kapalı şekilde 'Mmmmm' diyerek sesin dudaklarda titreşmesini sağlayın." },
  { time: 60, name: "Artikülasyon Turu", desc: "Ağzınızı kocaman açarak 3 kez 'A-E-I-İ-O-Ö-U-Ü' deyin." }
];

function updateRing(percent) {
  document.getElementById('timerRing').style.background = `conic-gradient(#3b82f6 ${percent}%, #e2e8f0 ${percent}%)`;
}

function formatTime(seconds) {
  const m = Math.floor(seconds / 60).toString().padStart(2, '0');
  const s = (seconds % 60).toString().padStart(2, '0');
  return `${m}:${s}`;
}

function startRoutine() {
  if(isPlaying) return;
  isPlaying = true;
  document.getElementById('btnPlay').style.display = 'none';
  
  timerInterval = setInterval(() => {
    timeLeft--;
    document.getElementById('timerText').innerText = formatTime(timeLeft);
    
    // Calculate percentage (0 to 100)
    const percent = ((300 - timeLeft) / 300) * 100;
    updateRing(percent);
    
    // Check step change
    for(let i=0; i<routineSteps.length; i++) {
      if(timeLeft === routineSteps[i].time - 1) { // -1 to trigger exactly as we cross the threshold
        document.getElementById('stepTitle').innerText = routineSteps[i].name;
        document.getElementById('stepDesc').innerText = routineSteps[i].desc;
      }
    }
    
    if(timeLeft <= 0) {
      clearInterval(timerInterval);
      document.getElementById('stepTitle').innerText = "✅ Antrenman Tamamlandı!";
      document.getElementById('stepDesc').innerText = "Sesiniz güne hazır. Mükemmel bir iş çıkardınız.";
      document.getElementById('btnPlay').innerText = "Yeniden Başlat";
      document.getElementById('btnPlay').style.display = 'inline-block';
      isPlaying = false;
      timeLeft = 300;
    }
  }, 1000);
  
  // Set initial step
  document.getElementById('stepTitle').innerText = routineSteps[0].name;
  document.getElementById('stepDesc').innerText = routineSteps[0].desc;
}

// ☀️ Checklist Logic ☀️
const programsData = {
  haftalik: {
    title: 'Haftalık Diksiyon Planı (Başlangıç)',
    items: [
      'Pazartesi: Sadece Diyafram Nefesi (10 Dk)',
      'Salı: Ayna Karşısında Yuvarlak Ünlüler (O, Ö, U, Ü)',
      'Çarşamba: Sert Patlamalı Ünsüzler (P, Ç, T, K) Nefes Kontrolü',
      'Perşembe: Yavaş ve Kalemsiz Tekerleme Okuması',
      'Cuma: Haber Metni Sesli Okuma (Vurgulara Dikkat Ederek)',
      'Cumartesi: Gülümseyerek Mimikli Okuma Pratiği',
      'Pazar: Ses Dinlendirme (Mutlak İstirahat)'
    ]
  },
  challenge: {
    title: '30 Günlük Challenge Blokları',
    items: [
      '1. Hafta: Temel İnşa (Diyafram ve Çene Açıklığı)',
      '2. Hafta: Kalemle Artikülasyon (Zorlu Tekerlemeler)',
      '3. Hafta: Melodi ve Vurgu (İniş çıkışlar)',
      '4. Hafta: Code-Switching ve Doğaçlama Akıcılık'
    ]
  },
  sahne: {
    title: 'Sunum Öncesi (Kuliste) 10 Dk',
    items: [
      'Anti-Stres: Kutu Nefesi (4 Sn Al, 4 Sn Tut, 6 Sn Ver)',
      'Motoru Isıtma: 3 Kez Uzun Lip Trill (Dudak Titretme)',
      'Esnetme: Ağzı Kocaman Açıp Aslan Esnemesi Yapma',
      'Tükürük Salgısı: Dil ile Dişlerin Arkasını Yalama (Kuruluğu Önler)',
      'Prova: İlk Cümleyi Power Pose (Dik Duruş) ile Sesli Söyleme'
    ]
  },
  mikro: {
    title: 'Günlük Mikro Egzersizler (1 Dakikalık)',
    items: [
      'Sabah Arabada: Radyodaki Şarkıya Lip Trill ile Eşlik Et',
      'Öğle Molası (Masa Başında): Omuzları Kulaklara Çek-Bırak (Drop) + 3 Derin Nefes',
      'Lavaboya Gittiğinde: Aynaya Bakıp Kocaman Gülümse + 15 Saniye Tıslama (Sssss)'
    ]
  }
};

function loadChecklist(id) {
  const panel = document.getElementById('checklistPanel');
  const container = document.getElementById('cContainer');
  const data = programsData[id];
  
  document.getElementById('cTitle').innerText = data.title;
  
  let html = '';
  data.items.forEach((item, index) => {
    html += `
      <div class="c-item" onclick="toggleCheck(this)">
        <div class="c-check">✓</div>
        <div class="c-text">${item}</div>
      </div>
    `;
  });
  
  container.innerHTML = html;
  panel.style.display = 'block';
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function toggleCheck(element) {
  const check = element.querySelector('.c-check');
  const text = element.querySelector('.c-text');
  
  check.classList.toggle('done');
  text.classList.toggle('done');
}
</script>

<%- include('partials/main-footer') %>
