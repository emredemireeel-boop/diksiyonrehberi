<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🌊 Hero 🌊 */
  .t-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 20%, #06b6d422, transparent 70%);
  }
  .t-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#f8fafc,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: tFloat 6s ease-in-out infinite; background: linear-gradient(135deg, #06b6d4, #3b82f6); }
  @keyframes tFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.1; } 50%{ transform:translateY(-40px) scale(1.4); opacity:.5; } }

  .t-icon { font-size: 6rem; margin-bottom: 20px; animation: tPulse 3s ease-in-out infinite; filter: drop-shadow(0 0 30px #06b6d466); }
  @keyframes tPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.08) translateY(-5px); } }

  .t-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#a5f3fc; background:#06b6d418; border:1px solid #06b6d444; margin-bottom:24px; box-shadow: 0 0 20px #06b6d422; }
  .t-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color:#0f172a; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .t-title span { background: linear-gradient(135deg, #22d3ee, #60a5fa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .t-subtitle { color:#475569; font-size:1.15rem; max-width:650px; line-height:1.8; }

  /* 🌊 Container 🌊 */
  .t-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 🌊 Glass Cards 🌊 */
  .glass { background:rgba(15,23,42,.02); backdrop-filter:blur(20px); border:1px solid rgba(15,23,42,.05); border-radius:24px; padding:40px; margin-bottom:40px; transition:transform .4s,box-shadow .4s; position: relative; overflow: hidden; }
  .glass::before { content:''; position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg,transparent,rgba(15,23,42,.1),transparent); }
  .glass:hover { transform:translateY(-5px); box-shadow:0 30px 60px rgba(15,23,42,.4),0 0 40px #06b6d411; border-color:rgba(6,182,212,.2); }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#22d3ee; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background:#22d3ee; border-radius:2px; }

  /* 🌊 Anatomy 3D Interactive 🌊 */
  .tongue-anatomy { position: relative; width: 100%; height: 350px; display: flex; justify-content: center; align-items: center; margin: 30px 0; background: radial-gradient(circle at center, rgba(6,182,212,0.05), transparent 60%); }
  .tongue-svg { width: 450px; height: 300px; filter: drop-shadow(0 20px 40px rgba(15,23,42,.6)); overflow: visible; }
  .mouth-bg { fill: #0f172a; stroke: #334155; stroke-width: 2; }
  .palate { fill: none; stroke: #475569; stroke-width: 4; }
  .alveolar { fill: #38bdf8; opacity: 0.2; transition: opacity 0.3s; }
  .tongue-body { fill: #ec4899; transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); transform-origin: 250px 220px; }
  
  /* Animations for Tongue */
  .tongue-body.anim-alveolar { transform: rotate(-15deg) translateY(-10px) scaleY(1.1); fill: #f472b6; }
  .tongue-body.anim-kok { transform: translateX(20px) translateY(-15px) scaleY(1.2); transform-origin: 300px 200px; fill: #f43f5e; }
  .tongue-body.anim-stretch { transform: translateX(-30px) scaleX(1.2); fill: #fb7185; }

  .anatomy-btn-group { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 20px; }
  .a-btn { padding: 10px 20px; border-radius: 12px; background: rgba(6,182,212,.1); border: 1px solid rgba(6,182,212,.3); color: #a5f3fc; font-size: .9rem; font-weight: 600; cursor: pointer; transition: all .3s; }
  .a-btn:hover, .a-btn.active { background: rgba(6,182,212,.3); box-shadow: 0 0 20px rgba(6,182,212,.2); transform: translateY(-2px); }

  /* 🌊 Interactive Gym 🌊 */
  .gym-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .gym-container { grid-template-columns: 1fr; } }
  
  .gym-card { background: rgba(15,23,42,.3); border: 1px solid rgba(6,182,212,.15); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all .3s; position: relative; overflow: hidden; }
  .gym-card::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at center, rgba(6,182,212,.1), transparent); opacity:0; transition:opacity .3s; }
  .gym-card:hover { border-color: #06b6d4; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(6,182,212,.15); }
  .gym-card:hover::after { opacity: 1; }
  
  .gym-icon { font-size: 3rem; margin-bottom: 12px; display: inline-block; transition: transform .3s; }
  .gym-card:hover .gym-icon { transform: scale(1.2) rotate(-5deg); }
  
  .gym-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .gym-desc { font-size: 0.85rem; color: #475569; line-height: 1.6; }

  /* 🌊 Master Workout Panel 🌊 */
  .workout-panel { background: linear-gradient(145deg, #081a29, #f8fafc); border: 1px solid #06b6d433; border-radius: 24px; padding: 40px; margin-top: 20px; text-align: center; position: relative; overflow: hidden; }
  .workout-panel::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle at center, rgba(6,182,212,.05) 0%, transparent 50%); animation: rotateGlow 15s linear infinite; pointer-events:none; }
  @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .workout-display { font-size: 2.5rem; font-weight: 900; color: #fff; letter-spacing: 2px; margin: 24px 0; min-height: 60px; display: flex; align-items: center; justify-content: center; }
  .workout-hint { color: #22d3ee; font-size: 1rem; font-weight: 600; margin-bottom: 30px; }
  
  .workout-btn { padding: 16px 40px; border-radius: 100px; background: linear-gradient(135deg, #06b6d4, #3b82f6); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(6,182,212,.4); transition: all .3s; text-transform: uppercase; letter-spacing: 2px; }
  .workout-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(6,182,212,.6); }
  .workout-btn:active { transform: scale(0.98); }

  /* 🌊 Back Button 🌊 */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(15,23,42,.05); border:1px solid rgba(15,23,42,.1); color:#475569; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(15,23,42,.1); color:#fff; transform:translateX(-4px); }

  /* 🌊 Reveal 🌊 */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="t-hero">
  <div class="hero-particles">
    <% for(let i=0; i<30; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 2+Math.random()*5 %>px; height:<%= 2+Math.random()*5 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 4+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="t-icon">👅</div>
  <div class="t-badge">⚡ Artikülasyon Laboratuvarı</div>
  <h1 class="t-title"><span>Dil Tembelliği</span> Çözüm Merkezi</h1>
  <p class="t-subtitle">Peltekliği bitiren, R, S, Z ve L harflerini pürüzsüzleştiren ve konuşma hızınızı 2 katına çıkaran profesyonel dil kası geliştirme egzersizleri.</p>
</section>

<div class="t-wrap">
  <a href="/diksiyon?cat=dil" class="back-btn">Tüm Dil Egzersizlerini Gör</a>

  <!-- 🌊 ANATOMY 🌊 -->
  <div class="glass reveal">
    <div class="section-label">🧠 Dil Artikülasyon Haritası</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:20px;">Farklı harflerin dilinizin hangi bölgesiyle üretildiğini görselleştirin. Doğru diksiyon, dilin ağız içindeki milimetrik temas noktalarının bir sonucudur.</p>

    <div class="tongue-anatomy">
      <svg class="tongue-svg" viewBox="0 0 450 300">
        <!-- Mouth Cavity Background -->
        <ellipse cx="225" cy="150" rx="180" ry="120" class="mouth-bg" />
        
        <!-- Upper Palate & Teeth -->
        <path d="M 80 120 C 130 50 320 50 370 120" class="palate" />
        <rect x="90" y="110" width="15" height="20" rx="4" fill="#334155" />
        <rect x="345" y="110" width="15" height="20" rx="4" fill="#334155" />
        
        <!-- Alveolar Ridge (Target Area) -->
        <circle cx="150" cy="85" r="25" class="alveolar" id="alveolarHighlight" />
        <text x="120" y="55" fill="#38bdf8" font-size="12" font-weight="700">Alveoler Sırt (T, D, N, L)</text>
        
        <!-- Soft Palate (Target Area) -->
        <circle cx="280" cy="80" r="25" fill="#f43f5e" opacity="0" id="velarHighlight" style="transition: opacity 0.3s;" />
        <text x="250" y="45" fill="#f43f5e" font-size="12" font-weight="700" opacity="0" id="velarText" style="transition: opacity 0.3s;">Yumuşak Damak (K, G)</text>

        <!-- The Tongue -->
        <!-- Start at throat (right), go left to tip, loop back -->
        <path id="theTongue" class="tongue-body" d="M 330 220 C 280 180 200 180 140 180 C 100 180 100 210 140 220 C 180 230 250 240 330 240 Z" />
        
        <text x="140" y="205" fill="#fff" font-size="12" font-weight="800">Dil Ucu</text>
        <text x="260" y="205" fill="#fff" font-size="12" font-weight="800">Dil Kökü</text>
      </svg>
    </div>
    
    <div class="anatomy-btn-group">
      <button class="a-btn" onclick="animateTongue('alveolar', this)">T-D-N-L Sesleri (Dil Ucu)</button>
      <button class="a-btn" onclick="animateTongue('kok', this)">K-G Sesleri (Dil Kökü)</button>
      <button class="a-btn" onclick="animateTongue('stretch', this)">Dil Streçi (Esnetme)</button>
      <button class="a-btn" onclick="animateTongue('reset', this)">Nötr Pozisyon</button>
    </div>
  </div>

  <!-- 🌊 THE GYM 🌊 -->
  <div class="glass reveal">
    <div class="section-label">🏋️ Dil Kasları Gym</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:30px;">Peltekliği gideren, seri konuşmayı sağlayan ve kelime sonu yutmalarını kesen 4 temel dil egzersizi.</p>
    
    <div class="gym-container">
      <div class="gym-card" onclick="startWorkout('ucu')">
        <div class="gym-icon">🎯</div>
        <div class="gym-title">Dil Ucu Jimnastiği</div>
        <div class="gym-desc">Dil ucunu alveoler sırta sertçe vurarak T, D, L seslerini keskinleştirin.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('koku')">
        <div class="gym-icon">🏋️</div>
        <div class="gym-title">Dil Kökü Güçlendirme</div>
        <div class="gym-desc">Arka kasları K-G vurşlarıyla çalıştırarak boğuk konuşmayı yok edin.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('damak')">
        <div class="gym-icon">🧲</div>
        <div class="gym-title">Tam Damak Teması</div>
        <div class="gym-desc">Dili damağa tamamen vakumlayıp bırakarak (Mewing) kasları toparlayın.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('darbe')">
        <div class="gym-icon">⚡</div>
        <div class="gym-title">Hızlı Dil Darbesi</div>
        <div class="gym-desc">Saniyede 3 darbe hedefiyle artikülasyon hızınızı sprint seviyesine çekin.</div>
      </div>
    </div>
  </div>

  <!-- 🌊 MASTER WORKOUT PANEL 🌊 -->
  <div class="workout-panel reveal" id="workoutPanel" style="display:none;">
    <div class="section-label" style="justify-content:center; color:#06b6d4;" id="workoutTitle">🏋️ Egzersiz Başlıyor</div>
    <div class="workout-display" id="workoutDisplay">Hazır mısınız?</div>
    <div class="workout-hint" id="workoutHint">Dik oturun, boynunuzu kasmayın.</div>
    <button class="workout-btn" id="workoutActionBtn" onclick="nextWorkoutStep()">Başla</button>
  </div>

  <!-- 🌊 PRO TIP 🌊 -->
  <div style="background:linear-gradient(135deg,rgba(6,182,212,.1),rgba(59,130,246,.05)); border:1px solid rgba(6,182,212,.3); border-radius:24px; padding:30px; font-size:1rem; color:#e2e8f0; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">🧠</span>
    <div>
      <strong style="color:#22d3ee; display:block; margin-bottom:8px;">Altın Kural: Dil Bağlantısı</strong>
      Beynimiz kelimeleri harf harf değil, bloklar halinde düşünür. Kötü diksiyonun sebebi, beynin dil kaslarına "bu kelimeyi üret" demesi, ancak dil kaslarının o kadar hızlı hareket edememesidir. Bu egzersizler, beyin ile dil arasındaki sinirsel iletim hızını (nöromotor bağlantıyı) saniyenin onda birine indirir.
    </div>
  </div>

</div>

<script>
// 🌊 Scroll Reveal 🌊
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🌊 Tongue Simulator 🌊
function animateTongue(type, btn) {
  // Update buttons
  document.querySelectorAll('.a-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  const tongue = document.getElementById('theTongue');
  const alveolarHighlight = document.getElementById('alveolarHighlight');
  const velarHighlight = document.getElementById('velarHighlight');
  const velarText = document.getElementById('velarText');

  // Reset first
  tongue.className.baseVal = "tongue-body";
  alveolarHighlight.style.opacity = "0.1";
  velarHighlight.style.opacity = "0";
  velarText.style.opacity = "0";

  setTimeout(() => {
    if(type === 'alveolar') {
      tongue.classList.add('anim-alveolar');
      alveolarHighlight.style.opacity = "0.6";
    } else if(type === 'kok') {
      tongue.classList.add('anim-kok');
      velarHighlight.style.opacity = "0.6";
      velarText.style.opacity = "1";
    } else if(type === 'stretch') {
      tongue.classList.add('anim-stretch');
    }
  }, 50);
}

// 🌊 Workout Logic 🌊
const workouts = {
  ucu: {
    title: '🎯 Dil Ucu Jimnastiği',
    steps: [
      { text: 'Ağzınızı "A" şeklinde aralayın', hint: 'Çenenizi tamamen sabitleyin.' },
      { text: 'Dil ucunu üst dişin arkasına vurun', hint: 'Tı-Tı-Tı-Tı (Hızlı ve Sert)' },
      { text: 'Şimdi "D" harfine geçin', hint: 'Dı-Dı-Dı-Dı (Çeneyi kıpırdatmadan)' },
      { text: 'Mükemmel.', hint: 'Dil ucu refleksleriniz hızlandı.' }
    ]
  },
  koku: {
    title: '🏋️ Dil Kökü Güçlendirme',
    steps: [
      { text: 'Dil ucunu alt dişlerin arkasına yaslayın', hint: 'Uç kısmı kilitli kalacak.' },
      { text: 'Dil kökünü yukarı damağa vurdurun', hint: 'KA - KA - KA (Patlayıcı güçle)' },
      { text: 'Şimdi "GA" harfi ile', hint: 'GA - GA - GA' },
      { text: 'Harika.', hint: 'Artık kelime sonlarındaki K\'leri yutmayacaksınız.' }
    ]
  },
  damak: {
    title: '🧲 Tam Damak Teması (Vakum)',
    steps: [
      { text: 'Genişçe gülümseyin', hint: 'Dudakları aralayın' },
      { text: 'Dilin tamamını damağa YAPIŞTIRIN', hint: 'Güçlü bir vakum yaratın, 5 saniye bekleyin.' },
      { text: 'Aniden Bırakın!', hint: 'Şlak! diye yüksek bir ses çıkmalı.' },
      { text: 'Süper.', hint: 'Bu, "Mewing" tekniğinin de temelidir.' }
    ]
  },
  darbe: {
    title: '⚡ Hızlı Dil Darbesi',
    steps: [
      { text: 'Metronom hızında vuracağız', hint: 'Teke teke teke teke...' },
      { text: 'Hızlanın!', hint: 'Deke deke deke deke...' },
      { text: 'Daha Hızlı!', hint: 'Neke neke neke neke...' },
      { text: 'Tebrikler!', hint: 'Artikülasyon sprintinizi tamamladınız.' }
    ]
  }
};

let currentWorkout = null;
let currentStepIndex = 0;

function startWorkout(id) {
  currentWorkout = workouts[id];
  currentStepIndex = 0;
  
  const panel = document.getElementById('workoutPanel');
  panel.style.display = 'block';
  
  document.getElementById('workoutTitle').innerHTML = currentWorkout.title;
  document.getElementById('workoutDisplay').innerHTML = 'Hazır mısınız?';
  document.getElementById('workoutHint').innerHTML = 'Dik oturun, boynunuzu kasmayın.';
  document.getElementById('workoutActionBtn').innerHTML = 'Başla';
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function nextWorkoutStep() {
  if(!currentWorkout) return;
  
  if(currentStepIndex < currentWorkout.steps.length) {
    const step = currentWorkout.steps[currentStepIndex];
    document.getElementById('workoutDisplay').innerHTML = step.text;
    document.getElementById('workoutHint').innerHTML = step.hint;
    document.getElementById('workoutActionBtn').innerHTML = (currentStepIndex === currentWorkout.steps.length - 1) ? 'Bitir' : 'Sonraki Adım';
    currentStepIndex++;
  } else {
    document.getElementById('workoutDisplay').innerHTML = 'Egzersiz Tamamlandı! 🎉';
    document.getElementById('workoutHint').innerHTML = 'Günlük tekrar, akıcılığınızı doğrudan artırır.';
    document.getElementById('workoutActionBtn').innerHTML = 'Tekrar Yap';
    currentStepIndex = 0;
  }
}
</script>

<%- include('partials/main-footer') %>


