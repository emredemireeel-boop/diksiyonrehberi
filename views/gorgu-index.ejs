<%- include('partials/main-header') %>

<style>
  /* LIGHT MODE PREMIUM UIX OVERRIDES */
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.gorgu-page { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }
  
  /* FONTS & VARIABLES */
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
  :root {
    --gold-primary: #C59D5F; 
    --gold-dark: #9A7B4F;
    --light-bg: #fafaf9;
    --glass-bg: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(197, 157, 95, 0.2);
    --text-main: #1c1917;
    --text-muted: #57534e;
  }

  /* HERO SECTION */
  .g-hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(circle at center, #ffffff 0%, #f5f5f4 100%);
    overflow: hidden;
  }
  .g-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: url('https://images.unsplash.com/photo-1578308865613-33925a17688c?auto=format&fit=crop&w=1920&q=80') center/cover;
    opacity: 0.08;
    z-index: 0;
    mix-blend-mode: multiply;
  }
  .g-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 20px;
    animation: fadeUp 1s ease-out;
  }
  .g-badge {
    display: inline-block;
    padding: 8px 24px;
    border-radius: 30px;
    background: rgba(197, 157, 95, 0.1);
    border: 1px solid var(--gold-primary);
    color: var(--gold-dark);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
    backdrop-filter: blur(10px);
  }
  .g-title {
    font-family: 'Playfair Display', serif;
    font-size: 5rem;
    line-height: 1.1;
    margin: 0 0 20px 0;
    color: var(--text-main);
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }
  .g-title span {
    color: var(--gold-primary);
  }
  .g-subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 400;
    max-width: 600px;
    margin: 0 auto 40px auto;
    line-height: 1.8;
  }
  
  .g-hero-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
  }
  .btn-primary {
    display: inline-block;
    padding: 16px 36px;
    background: var(--text-main);
    color: #fff;
    text-decoration: none;
    border-radius: 30px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s;
  }
  .btn-primary:hover {
    background: var(--gold-primary);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(197, 157, 95, 0.3);
  }

  .g-scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--gold-primary);
    font-size: 2rem;
    animation: bounce 2s infinite;
    z-index: 2;
  }

  /* CATEGORY NAVIGATION */
  .g-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding: 20px 0;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    box-shadow: 0 5px 15px rgba(0,0,0,0.02);
  }
  .g-nav-item {
    color: var(--text-muted);
    text-decoration: none;
    padding: 10px 25px;
    border-radius: 20px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }
  .g-nav-item.active {
    background: rgba(197, 157, 95, 0.1);
    border-color: var(--gold-primary);
    color: var(--gold-dark);
  }
  .g-nav-item:hover:not(.active) {
    background: rgba(0, 0, 0, 0.03);
    color: var(--text-main);
  }

  /* GRID SECTION */
  .g-section {
    padding: 100px 5%;
    max-width: 1400px;
    margin: 0 auto;
  }
  .g-section-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .g-section-title {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    color: var(--text-main);
    margin: 0;
  }
  .g-section-subtitle {
    font-family: 'Outfit', sans-serif;
    color: var(--gold-dark);
    font-size: 1.1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-top: 10px;
  }

  .g-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
  }
  
  .g-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 40px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
  }
  .g-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--gold-primary), transparent);
    transform: translateX(-100%);
    transition: 0.6s;
  }
  .g-card:hover {
    transform: translateY(-10px);
    border-color: var(--gold-primary);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 0 20px rgba(197, 157, 95, 0.1);
    background: #ffffff;
  }
  .g-card:hover::before {
    transform: translateX(100%);
  }
  
  .g-card-icon {
    font-size: 3rem;
    margin-bottom: 25px;
    filter: drop-shadow(0 5px 10px rgba(0,0,0,0.05));
  }
  .g-card-tag {
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--gold-dark);
    text-transform: uppercase;
    margin-bottom: 15px;
  }
  .g-card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: var(--text-main);
    margin: 0 0 15px 0;
  }
  .g-card-desc {
    font-family: 'Outfit', sans-serif;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 30px 0;
    flex-grow: 1;
  }
  .g-card-btn {
    font-family: 'Outfit', sans-serif;
    display: inline-flex;
    align-items: center;
    color: var(--text-main);
    font-weight: 700;
    font-size: 0.95rem;
    gap: 10px;
    transition: 0.3s;
  }
  .g-card:hover .g-card-btn {
    color: var(--gold-dark);
    gap: 15px;
  }

  /* QUOTE SECTION */
  .g-quote-section {
    background: linear-gradient(45deg, #ffffff, #f5f5f4);
    padding: 100px 20px;
    text-align: center;
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .g-quote {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: var(--text-main);
    max-width: 800px;
    margin: 0 auto 30px auto;
    font-style: italic;
    line-height: 1.4;
  }
  .g-quote-author {
    font-family: 'Outfit', sans-serif;
    color: var(--gold-dark);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0) translateX(-50%); }
    40% { transform: translateY(-20px) translateX(-50%); }
    60% { transform: translateY(-10px) translateX(-50%); }
  }

  /* RESPONSIVE */
  @media(max-width: 768px) {
    .g-title { font-size: 3rem; }
    .g-section { padding: 60px 20px; }
    .g-card { padding: 30px; }
    .g-hero-buttons { flex-direction: column; }
  }

  /* FAQ SECTION */
  .g-faq-container { max-width: 800px; margin: 0 auto; }
  .g-faq-item { border-bottom: 1px solid var(--glass-border); margin-bottom: 15px; }
  .g-faq-btn { width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; padding: 20px 0; font-family: 'Outfit', sans-serif; font-size: 1.2rem; font-weight: 600; color: var(--text-main); cursor: pointer; text-align: left; transition: color 0.3s; }
  .g-faq-btn:hover { color: var(--gold-dark); }
  .g-faq-icon { font-size: 1.5rem; color: var(--gold-primary); transition: transform 0.3s; font-weight: 300; }
  .g-faq-item.active .g-faq-icon { transform: rotate(45deg); }
  .g-faq-content { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; }
  .g-faq-content p { margin: 0; padding-bottom: 20px; font-family: 'Outfit', sans-serif; color: var(--text-muted); line-height: 1.6; font-size: 1.05rem; }
</style>

<div class="gorgu-page">
  <!-- HERO -->
  <section class="g-hero">
    <div class="g-hero-content">
      <div class="g-badge">Aydınlık Masterclass</div>
      <h1 class="g-title">Zarafet <span>Sanatı</span></h1>
      <p class="g-subtitle">Sosyal ortamlarda doğal bir aurayla var olmak, iş hayatında saygı uyandırmak ve her anınızda elit bir izlenim bırakmak için tasarlanmış aydınlık ve kusursuz davranış rehberi.</p>
      <div class="g-hero-buttons" style="flex-wrap: wrap;">
        <a href="#moduller" class="btn-primary">Eğitimlere Başla</a>
        <a href="/gorgu-similator" class="btn-primary" style="background:#C59D5F;">Sosyal Zeka</a>
        <a href="/gorgu-radar" class="btn-primary" style="background:#10b981;">Radarı</a>
        <a href="/gorgu-dedektif" class="btn-primary" style="background:#3b82f6;">Dedektif</a>
        <a href="/gorgu-sofra" class="btn-primary" style="background:#8b5cf6;">Sofra Mimarı</a>
        <a href="/gorgu-diplomasi" class="btn-primary" style="background:#0f172a;">Diplomasi Atölyesi</a>
      </div>
    </div>
    <div class="g-scroll-indicator">↓</div>
  </section>

  <!-- NAV -->
  <nav class="g-nav" id="moduller">
    <a href="/gorgu" class="g-nav-item active">Tüm Modüller</a>
    <a href="/gorgu/yemek-masasi" class="g-nav-item">Sofra Adabı</a>
    <a href="/gorgu/is-hayati" class="g-nav-item">İş Hayatı</a>
    <a href="/gorgu/dijital-etiket" class="g-nav-item">Dijital Kimlik</a>
    <a href="/gorgu/toplum-ici" class="g-nav-item">Sosyal Zeka</a>
  </nav>

  <!-- MODULES GRID -->
  <section class="g-section">
    <div class="g-section-header">
      <div class="g-section-subtitle">Ayrıcalıklı Müfredat</div>
      <h2 class="g-section-title">Eğitim Modülleri</h2>
    </div>

    <div class="g-grid">
      <!-- 1 -->
      <a href="/gorgu/yemek-masasi" class="g-card">
        <div class="g-card-icon">🍽️</div>
        <div class="g-card-tag">Bölüm 01</div>
        <h3 class="g-card-title">Sofra Adabı</h3>
        <p class="g-card-desc">Michelin yıldızlı restoranlardan resmi iş yemeklerine; çatal bıçak dili, kadeh tutuşu ve kusursuz masa duruşu.</p>
        <div class="g-card-btn">Modülü İncele <span>→</span></div>
      </a>
      
      <!-- 2 -->
      <a href="/gorgu/is-hayati" class="g-card">
        <div class="g-card-icon">♟️</div>
        <div class="g-card-tag">Bölüm 02</div>
        <h3 class="g-card-title">Profesyonel Zarafet</h3>
        <p class="g-card-desc">C-Level yöneticilerin toplantı yönetimi, network oluştururken uygulanması gereken güç ve nezaket dengesi.</p>
        <div class="g-card-btn">Modülü İncele <span>→</span></div>
      </a>

      <!-- 3 -->
      <a href="/gorgu/toplum-ici" class="g-card">
        <div class="g-card-icon">🎭</div>
        <div class="g-card-tag">Bölüm 03</div>
        <h3 class="g-card-title">Sosyal Zeka</h3>
        <p class="g-card-desc">Karşılamadan uğurlamaya, elit davetlerdeki ince kurallar ve bulunduğunuz her ortama uyum sağlama sanatı.</p>
        <div class="g-card-btn">Modülü İncele <span>→</span></div>
      </a>

      <!-- 4 -->
      <a href="/gorgu/dijital-etiket" class="g-card">
        <div class="g-card-icon">🌐</div>
        <div class="g-card-tag">Bölüm 04</div>
        <h3 class="g-card-title">Dijital Kimlik</h3>
        <p class="g-card-desc">Online toplantılardaki duruşunuzdan kurumsal e-posta dilinize kadar sanal dünyadaki karizmanızın yönetimi.</p>
        <div class="g-card-btn">Modülü İncele <span>→</span></div>
      </a>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="g-section">
    <div class="g-section-header">
      <div class="g-section-subtitle">Aklınıza Takılanlar</div>
      <h2 class="g-section-title">Sıkça Sorulan Sorular</h2>
    </div>
    <div class="g-faq-container">
      <div class="g-faq-item">
        <button class="g-faq-btn">Görgü kuralları (Adabı Muaşeret) neden bu kadar önemlidir? <span class="g-faq-icon">+</span></button>
        <div class="g-faq-content"><p>Görgü kuralları sadece şekilsel bir zorunluluk değil, karşınızdaki insana duyduğunuz saygının ve kendi öz değerinizin sessiz bir göstergesidir. İş hayatında ve sosyal çevrede güvenilirlik ve karizma inşa etmenin en temel yoludur.</p></div>
      </div>
      <div class="g-faq-item">
        <button class="g-faq-btn">Sofra adabında yapılan en büyük hata nedir? <span class="g-faq-icon">+</span></button>
        <div class="g-faq-content"><p>En yaygın hata, çatal bıçak kullanımındaki yanlış tutuşlar (örn. bıçağı kalem gibi tutmak) ve yemek esnasında masada sergilenen aceleci tavırdır. Zarafet, masada sakinlik ve kontrollü hareketlerle başlar.</p></div>
      </div>
      <div class="g-faq-item">
        <button class="g-faq-btn">İş yemeklerinde hesabı kim ödemelidir? <span class="g-faq-icon">+</span></button>
        <div class="g-faq-content"><p>Profesyonel kurallara göre daveti yapan kişi, cinsiyet veya unvan fark etmeksizin hesabı ödemekle yükümlüdür. Hesap ödeme işleminin masada dikkat çekmeden halledilmesi en zarif yöntemdir.</p></div>
      </div>
      <div class="g-faq-item">
        <button class="g-faq-btn">Dijital etiket nedir ve neden dikkat etmeliyim? <span class="g-faq-icon">+</span></button>
        <div class="g-faq-content"><p>E-posta yazışmalarınız, online toplantılardaki duruşunuz ve mesajlaşma üslubunuz sizin sanal dünyadaki imzanızdır. Gecenin geç saatinde atılan yanlış üsluplu bir mesaj, yıllarca inşa ettiğiniz profesyonel imajı anında zedeleyebilir.</p></div>
      </div>
      <div class="g-faq-item">
        <button class="g-faq-btn">Bu eğitimler sadece iş dünyası için mi geçerli? <span class="g-faq-icon">+</span></button>
        <div class="g-faq-content"><p>Hayır. Zarafet sanatı, sabah fırından ekmek alırken verdiğiniz selamdan, resmi bir holding toplantısına kadar hayatın her alanını kapsar. Modüllerimiz hem özel hem de profesyonel hayatınız için tasarlanmıştır.</p></div>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="g-quote-section">
    <div class="g-quote">"Görgü, kim olduğunuzu sesinizi hiç yükseltmeden tüm dünyaya ilan etme biçimidir."</div>
    <div class="g-quote-author">Özel Koleksiyon Eğitim Serisi</div>
  </section>
</div>

<script>
  document.querySelectorAll('.g-faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      const content = item.querySelector('.g-faq-content');
      
      // Close others
      document.querySelectorAll('.g-faq-item').forEach(otherItem => {
        if (otherItem !== item && otherItem.classList.contains('active')) {
          otherItem.classList.remove('active');
          otherItem.querySelector('.g-faq-content').style.maxHeight = "0";
        }
      });

      // Toggle current
      item.classList.toggle('active');
      if(item.classList.contains('active')) {
        content.style.maxHeight = content.scrollHeight + "px";
      } else {
        content.style.maxHeight = "0";
      }
    });
  });
</script>

