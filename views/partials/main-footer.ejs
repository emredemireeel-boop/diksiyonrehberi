  <script>
    // ── MODAL SYSTEM ──────────────────────────────────────────
    const overlay = document.getElementById('legal-overlay');

    function openModal(name) {
      const m = document.getElementById('modal-' + name);
      if (!m) return;
      overlay.classList.add('active');
      m.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
    function closeModal(name) {
      const m = document.getElementById('modal-' + name);
      if (m) m.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }
    function closeAllModals() {
      document.querySelectorAll('.legal-modal.active').forEach(m => m.classList.remove('active'));
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.footer-modal-link').forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        openModal(link.dataset.modal);
      });
    });
    document.querySelectorAll('.lm-close').forEach(btn => {
      btn.addEventListener('click', () => closeModal(btn.dataset.close));
    });
    overlay.addEventListener('click', closeAllModals);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeAllModals(); });

    // ── CONTACT FORM ──────────────────────────────────────────
    function handleContactForm(e) {
      e.preventDefault();
      const result = document.getElementById('cf-result');
      result.textContent = '✅ Mesajınız alındı! En kısa sürede size dönüş yapacağız.';
      result.style.color = '#16A34A';
      e.target.reset();
      setTimeout(() => { result.textContent = ''; }, 5000);
    }
  </script>
