      <nav class="sf-nav" id="sf-nav">
        <a href="/" class="sf-nav-item">Ana Sayfa</a>

        <div class="sf-nav-group">
          <span class="sf-nav-item">Konuşma</span>
          <div class="sf-dropdown">
            <a href="/retorik" class="sf-dd-item"><span class="sf-dd-emoji">🎤</span><div><div class="sf-dd-label">Retorik</div><div class="sf-dd-sub">İkna ve hitabet sanatı</div></div></a>
            <a href="/diyalektik" class="sf-dd-item"><span class="sf-dd-emoji">⚖️</span><div><div class="sf-dd-label">Diyalektik</div><div class="sf-dd-sub">Mantıksal akıl yürütme</div></div></a>
            <a href="/safsata" class="sf-dd-item"><span class="sf-dd-emoji">🧠</span><div><div class="sf-dd-label">Safsata</div><div class="sf-dd-sub">Mantık hataları ve savunma</div></div></a>
