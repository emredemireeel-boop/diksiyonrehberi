          </div>
        </div>

        <div class="sf-nav-group">
          <span class="sf-nav-item">Zihin</span>
          <div class="sf-dropdown">
            <a href="/manipulasyon" class="sf-dd-item"><span class="sf-dd-emoji">🐍</span><div><div class="sf-dd-label">Manipülasyon</div><div class="sf-dd-sub">Karanlık retorik savunma</div></div></a>
