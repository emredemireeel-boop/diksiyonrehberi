<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; overflow-x: hidden; }
  .box-container { padding: 40px 20px; max-width: 900px; margin: 0 auto; min-height: 85vh; display: flex; flex-direction: column; align-items: center; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #818cf8; text-transform: uppercase; letter-spacing: 2px; text-align: center; text-shadow: 0 0 15px rgba(129, 140, 248, 0.4); }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 30px; text-align: center; max-width: 600px; }

  /* Arena */
  .arena { width: 100%; background: #1e1b4b; border: 3px solid #312e81; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.6); position: relative; display: flex; flex-direction: column; }
  
  /* Status Bars */
  .bars-container { display: flex; width: 100%; background: #0f172a; border-bottom: 2px solid #312e81; }
  .bar-wrapper { flex: 1; padding: 15px 20px; }
  .bar-label { font-size: 0.8rem; font-weight: 900; text-transform: uppercase; margin-bottom: 5px; letter-spacing: 1px; }
  .bar-track { width: 100%; height: 15px; background: #1e293b; border-radius: 10px; overflow: hidden; position: relative; }
  .bar-fill { height: 100%; transition: width 0.5s ease-out; }
  
  #anxLabel { color: #f43f5e; }
  #anxFill { background: #f43f5e; width: 50%; }
  
  #confLabel { color: #10b981; text-align: right; }
  #confFill { background: #10b981; width: 50%; float: right; }
  
  /* Shadow Critic Area */
  .critic-zone { padding: 40px; background: radial-gradient(circle at center, #2e1065 0%, #1e1b4b 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 250px; text-align: center; position: relative; overflow: hidden; }
  
  .critic-avatar { font-size: 5rem; filter: drop-shadow(0 0 20px rgba(244,63,94,0.6)); animation: float 3s ease-in-out infinite; margin-bottom: 20px; position: relative; z-index: 2; }
  
  .critic-bubble { background: rgba(0,0,0,0.6); border: 1px solid #f43f5e; color: #fff; padding: 15px 25px; border-radius: 15px; font-size: 1.2rem; font-weight: 600; font-style: italic; max-width: 80%; position: relative; z-index: 2; box-shadow: 0 10px 30px rgba(244,63,94,0.2); }
  .critic-bubble::after { content: ''; position: absolute; top: -10px; left: 50%; transform: translateX(-50%); border-width: 0 10px 10px 10px; border-style: solid; border-color: transparent transparent #f43f5e transparent; }

  /* Player Options */
  .player-zone { padding: 30px; background: #0f172a; border-top: 2px solid #312e81; }
  .pz-title { font-size: 1rem; font-weight: 800; color: #818cf8; text-transform: uppercase; margin-bottom: 20px; text-align: center; }
  
  .opt-grid { display: flex; flex-direction: column; gap: 15px; }

  .btn-action { background: #1e293b; border: 2px solid #334155; color: #e2e8f0; padding: 20px; border-radius: 15px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.2s; text-align: left; display: flex; gap: 15px; align-items: center; }
  .btn-action:hover { background: #312e81; border-color: #6366f1; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(99,102,241,0.2); }
  .btn-icon { font-size: 1.5rem; }

  /* Outcome Screen */
  .outcome-screen { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.95); z-index: 100; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 30px; text-align: center; }
  .out-icon { font-size: 5rem; margin-bottom: 20px; }
  .out-title { font-size: 2.5rem; font-weight: 900; margin-bottom: 15px; text-transform: uppercase; }
  .out-desc { font-size: 1.1rem; color: #cbd5e1; line-height: 1.6; margin-bottom: 30px; max-width: 500px; }
  .btn-next { background: #818cf8; color: #fff; font-weight: 900; padding: 15px 40px; border-radius: 30px; border: none; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; }

  @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-15px); } 100% { transform: translateY(0px); } }

  .game-over { display: none; text-align: center; padding: 50px; background: #1e1b4b; border: 2px solid #818cf8; border-radius: 20px; margin-top:30px; width:100%; }
</style>

<div class="box-container">
  <h1>Gölge Boksu</h1>
  <p class="desc">Kendi zihninizin içindesiniz. İç sesiniz (Karanlık Gölge) sizi sabote etmeye çalışıyor. Bilişsel Yeniden Çerçeveleme (CBT) taktikleriyle onun saldırılarını nakavt edin.</p>

  <div class="arena" id="arena">
    
    <div class="bars-container">
      <div class="bar-wrapper">
        <div class="bar-label" id="anxLabel">Anksiyete: %50</div>
        <div class="bar-track"><div class="bar-fill" id="anxFill"></div></div>
      </div>
      <div class="bar-wrapper">
        <div class="bar-label" id="confLabel">Özgüven: %50</div>
        <div class="bar-track"><div class="bar-fill" id="confFill"></div></div>
      </div>
    </div>

    <div class="critic-zone">
      <div class="critic-avatar" id="criticAvatar">🌑</div>
      <div class="critic-bubble" id="criticText">"Şu an ellerin titriyor, herkes ne kadar paniklediğini görüyor. Çok acınası duruyorsun."</div>
    </div>

    <div class="player-zone">
      <div class="pz-title">İç Sese Cevabınızı Seçin:</div>
      <div class="opt-grid" id="optGrid">
        <!-- Injected -->
      </div>
    </div>

    <div class="outcome-screen" id="outScreen">
      <div class="out-icon" id="oIcon">✅</div>
      <div class="out-title" id="oTitle">NAKAVT!</div>
      <div class="out-desc" id="oDesc">...</div>
      <button class="btn-next" onclick="nextRound()">Sıradaki Saldırı ➔</button>
    </div>

  </div>

  <div class="game-over" id="gameOver">
    <div style="font-size: 5rem; margin-bottom:20px;">👑</div>
    <h2 style="font-size:2.5rem; color:#818cf8; margin:0 0 15px 0;">Zihin Efendisi</h2>
    <p style="color:#cbd5e1; font-size:1.1rem; margin-bottom:30px;">Kendi iç sesinizi eğitmeyi başardınız. Unutmayın, zihninizi kontrol ederseniz, dünyayı kontrol edersiniz.</p>
    <a href="/ozguven" style="background:#818cf8; color:#fff; padding:15px 30px; border-radius:30px; text-decoration:none; font-weight:900;">Akademiye Dön</a>
  </div>

</div>

<script>
  let anx = 50;
  let conf = 50;

  const scenarios = [
    {
      avatar: "🌑",
      text: "Mükemmel konuşmazsan, tek bir hata bile yaparsan herkes amatör olduğunu anlayacak ve sana gülecek.",
      options: [
        { icon: "😰", text: "Haklısın, o yüzden hiçbir hata yapmamam lazım. Her kelimeyi kelimesi kelimesine ezberleyeyim.", isCorrect: false },
        { icon: "🛡️", text: "Dinleyiciler mükemmel bir robot değil, sahici bir insan görmek istiyor. Hata yapsam da toparlayabilirim, kusursuzluk değil bağ kurmak önemli.", isCorrect: true }
      ],
      successMsg: "Zekice Savunma! Mükemmeliyetçilik bir tuzaktır. Hata yapma hakkınızı baştan kabul etmek omuzlarınızdaki yükü alır ve sizi çok daha doğal yapar.",
      failMsg: "Kurban Tuzağı! Ezberlemek panik yaratır. Tek bir kelimeyi bile unuttuğunuzda tüm sisteminiz çöker ve anksiyeteniz tavan yapar."
    },
    {
      avatar: "🦇",
      text: "Şu an kalbin çok hızlı çarpıyor ve nefesin daralıyor. Panik atak geçiriyorsun, sahneye çıkmamalısın!",
      options: [
        { icon: "🔥", text: "Bu adrenalin! Vücudum bana harika bir performans sergilemem için enerji pompalıyor. Savaş moduna geçiyorum.", isCorrect: true },
        { icon: "🏃", text: "Evet çok kötüyüm, hemen derin nefesler alıp sakinleşmeye çalışayım, heyecanımı bastırmalıyım.", isCorrect: false }
      ],
      successMsg: "Harika! Biyolojinizi yeniden çerçevelediniz (Re-framing). Heyecan ve korkunun fiziksel belirtileri (kalp çarpıntısı) aynıdır. Buna 'Korku' demek yerine 'Enerji' derseniz beyniniz sizi destekler.",
      failMsg: "Yanlış Hamle. Adrenalini bastırmaya çalışmak, beyninize 'Gerçekten büyük bir tehlike var' mesajı gönderir ve paniği körükler."
    },
    {
      avatar: "🕷️",
      text: "Eyvah, söyleyeceğin cümleyi unuttun ve sessiz kaldın... Çok garip bir an oldu, hemen bir şeyler söyleyip boşluğu doldurman lazım!",
      options: [
        { icon: "🗣️", text: "Eee, ııı, yani şey demek istemiştim...", isCorrect: false },
        { icon: "🤫", text: "Sessizlik otoritedir. Bu es vermeyi, cümlenin etkisini artırmak ve dinleyiciyi hazırlamak için kasıtlı bir taktik olarak kullanıyorum.", isCorrect: true }
      ],
      successMsg: "Usta İşi! Özgüvensiz insanlar sessizlikten korkar. Alfa karakterler ise sessizliği bir silah ve vurgu aracı olarak kullanır.",
      failMsg: "Zayıflık Belirtisi. Dolgu kelimeleri ('eee', 'ııı') paniklediğinizi ve kontrolü kaybettiğinizi dinleyiciye anında belli eder."
    },
    {
      avatar: "🐍",
      text: "O gruptaki herkes senden daha zeki ve daha yetenekli. Senin söyleyeceğin fikir onların çoktan aklına gelmiştir. Sus ve rezil olma.",
      options: [
        { icon: "💡", text: "Benim farklı bir perspektifim var. Eğer fikir kötüyse bile, bu beni değersiz yapmaz. Sadece denemiş olurum.", isCorrect: true },
        { icon: "🤐", text: "Doğru, en iyisi onlar konuşsun. Sessiz kalırsam en azından aptal durumuna düşmem.", isCorrect: false }
      ],
      successMsg: "Kalkan Aktif! Kıyaslama (Comparison) zihnin en zehirli safsatasıdır. Kendi değerinizi onlarınkiyle kıyaslamak yerine, masaya 'kendi' değerinizi koymaya odaklandınız.",
      failMsg: "Kendini Sabote Ettin. Kıyaslama sizi eylemsizliğe iter. Hiçbir şey söylememek, sizi görünmez yapar."
    }
  ];

  let currIdx = 0;

  function updateBars(anxDelta, confDelta) {
    anx += anxDelta;
    conf += confDelta;
    
    if(anx > 100) anx = 100; if(anx < 0) anx = 0;
    if(conf > 100) conf = 100; if(conf < 0) conf = 0;

    document.getElementById('anxFill').style.width = anx + "%";
    document.getElementById('anxLabel').textContent = "Anksiyete: %" + anx;
    
    document.getElementById('confFill').style.width = conf + "%";
    document.getElementById('confLabel').textContent = "Özgüven: %" + conf;
  }

  function loadRound() {
    if(currIdx >= scenarios.length) {
      document.getElementById('arena').style.display = 'none';
      document.getElementById('gameOver').style.display = 'block';
      return;
    }

    const s = scenarios[currIdx];
    document.getElementById('criticText').textContent = `"${s.text}"`;
    document.getElementById('criticAvatar').textContent = s.avatar;
    
    const grid = document.getElementById('optGrid');
    grid.innerHTML = '';
    
    const shuffled = [...s.options].sort(() => Math.random() - 0.5);
    shuffled.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'btn-action';
      btn.innerHTML = `<span class="btn-icon">${opt.icon}</span> <span>${opt.text}</span>`;
      btn.onclick = () => selectAction(opt);
      grid.appendChild(btn);
    });
  }

  function selectAction(opt) {
    const s = scenarios[currIdx];
    const outScreen = document.getElementById('outScreen');
    const oIcon = document.getElementById('oIcon');
    const oTitle = document.getElementById('oTitle');
    const oDesc = document.getElementById('oDesc');

    outScreen.style.display = 'flex';

    if(opt.isCorrect) {
      updateBars(-20, +25);
      oIcon.textContent = '🥊';
      oTitle.textContent = 'GÖLGE NAKAVT EDİLDİ!';
      oTitle.style.color = '#10b981';
      oDesc.textContent = s.successMsg;
    } else {
      updateBars(+30, -20);
      oIcon.textContent = '💀';
      oTitle.textContent = 'ZİHİNSEL ÇÖKÜŞ!';
      oTitle.style.color = '#f43f5e';
      oDesc.textContent = s.failMsg;
    }
  }

  function nextRound() {
    document.getElementById('outScreen').style.display = 'none';
    currIdx++;
    loadRound();
  }

  // Init
  loadRound();

</script>

<%- include('partials/main-footer') %>
