<%- include('partials/main-header') %>

<style>
  

  /* ═══════════════════════════════════════════════════════════
     ÖZGÜVEN — Ultra Luxury Light Mode (Retorik altın standardı)
     Accent: Amber/Turuncu — Enerji & Güç
     ═══════════════════════════════════════════════════════════ */
  :root {
    --bl-bg: #faf9f7;          /* Krem zemin */
    --bl-bg2: #f5f3ef;
    --bl-surface: #ffffff;     /* Beyaz kart */
    --bl-surface2: #f5f3ef;
    --bl-navy: #0f172a;        /* Koyu lacivert başlık */
    --bl-primary: #2563eb;     /* Bilgi / Mavi (okunur) */
    --bl-accent: #059669;      /* Başarı / Zümrüt */
    --bl-warning: #d97706;     /* Dikkat / Amber */
    --bl-gold: #b8860b;        /* Lüks vurgu */
    --bl-gold2: #d4a017;
    --bl-text: #1a1a2e;        /* Ana metin */
    --bl-muted: #6b7280;       /* İkincil metin */
    --bl-border: rgba(0,0,0,0.06);
    --bl-border-h: rgba(184,134,11,0.22);
    --bl-shadow: 0 8px 30px rgba(0,0,0,0.05);
    --bl-shadow-h: 0 20px 60px rgba(0,0,0,0.10);
    
    
  }

  body {
    background-color: var(--bl-bg);
    color: var(--bl-text);
    
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  /* ── Ambient light blobs (Retorik standardı) ── */
  .oz-ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .oz-blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.30; animation: blobFloat 20s ease-in-out infinite alternate; }
  .oz-blob:nth-child(1) { width: 500px; height: 500px; top: -100px; right: -100px; background: linear-gradient(135deg, #fde68a, #fbbf24); animation-duration: 18s; }
  .oz-blob:nth-child(2) { width: 400px; height: 400px; bottom: -80px; left: -80px; background: linear-gradient(135deg, #bfdbfe, #60a5fa); animation-duration: 22s; animation-delay: -5s; }
  .oz-blob:nth-child(3) { width: 300px; height: 300px; top: 40%; left: 60%; background: linear-gradient(135deg, #a7f3d0, #34d399); opacity: 0.14; animation-duration: 25s; animation-delay: -10s; }
  @keyframes blobFloat {
    0% { transform: translate(0,0) scale(1); }
    33% { transform: translate(30px,-40px) scale(1.1); }
    66% { transform: translate(-20px,30px) scale(0.95); }
    100% { transform: translate(10px,-10px) scale(1.05); }
  }
  .oz-grid-overlay {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image: linear-gradient(rgba(0,0,0,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.015) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* 1. Hero Section */
  .oz-hero {
    position: relative;
    z-index: 10;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 90px 20px 60px;
  }

  .oz-hero-content { position: relative; z-index: 2; max-width: 920px; }

  .oz-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 22px;
    border-radius: 50px;
    background: var(--bl-surface);
    border: 1px solid var(--bl-border-h);
    color: var(--bl-gold);
    
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 28px;
    box-shadow: var(--bl-shadow);
  }
  .oz-badge::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--bl-gold2); box-shadow: 0 0 8px var(--bl-gold2);
    animation: goldPulse 2s ease-in-out infinite;
  }
  @keyframes goldPulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.6); } }

  .oz-hero h1 {
    
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -1.5px;
    margin-bottom: 18px;
    color: var(--bl-navy);
    line-height: 1.08;
  }
  .oz-hero h1 .oz-hl {
    background: linear-gradient(120deg, var(--bl-gold), var(--bl-gold2));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .oz-hero h2 {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--bl-muted);
    margin: 0 auto 40px;
    max-width: 640px;
    line-height: 1.7;
  }

  .oz-science-stats {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .science-box {
    background: var(--bl-surface);
    border: 1px solid var(--bl-border);
    padding: 22px 30px;
    border-radius: 18px;
    text-align: left;
    min-width: 210px;
    transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
    box-shadow: var(--bl-shadow);
  }
  .science-box:hover {
    transform: translateY(-5px);
    box-shadow: var(--bl-shadow-h);
    border-color: var(--bl-border-h);
  }
  .s-title { font-size: 0.72rem; color: var(--bl-muted); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }
  .s-value { font-size: 2rem; font-weight: 800; margin: 8px 0;  }
  .s-value.down { color: var(--bl-accent); }
  .s-value.up { color: var(--bl-primary); }
  .s-desc { font-size: 0.85rem; color: var(--bl-muted); }

  /* 2. Özgüvenin 4 Sütunu */
  .pillars-section {
    position: relative;
    z-index: 10;
    padding: 80px 20px;
    background: var(--bl-surface);
    border-top: 1px solid var(--bl-border);
    border-bottom: 1px solid var(--bl-border);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 55px;
  }
  .section-header h3 {
    
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 800;
    color: var(--bl-navy);
    margin-bottom: 14px;
  }
  .section-header p {
    font-size: 1.1rem;
    color: var(--bl-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .pillars-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 26px;
  }

  .pillar-card {
    background: var(--bl-surface2);
    border: 1px solid var(--bl-border);
    border-radius: 20px;
    padding: 38px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.34,1.56,0.64,1);
  }
  .pillar-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 4px;
    background: var(--bl-muted);
    transition: all 0.4s ease;
  }
  
  .pillar-card.p-bilgi::before { background: #2563eb; }
  .pillar-card.p-sosyal::before { background: #7c3aed; }
  .pillar-card.p-deger::before { background: #059669; }
  .pillar-card.p-performans::before { background: #d97706; }

  .pillar-card:hover {
    transform: translateY(-8px);
    border-color: var(--bl-border-h);
    box-shadow: var(--bl-shadow-h);
    background: var(--bl-surface);
  }

  .p-score {
    position: absolute;
    top: 22px; right: 22px;
    font-size: 1.4rem;
    font-weight: 800;
    
    color: var(--bl-navy);
    opacity: 0.35;
  }

  .p-icon { font-size: 2.6rem; margin-bottom: 18px; display: block; line-height: 1; }

  .p-title {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: var(--bl-navy);
  }

  .p-list { list-style: none; padding: 0; margin: 0 0 20px 0; }
  .p-list li {
    padding: 9px 0;
    border-bottom: 1px solid var(--bl-border);
    color: var(--bl-text);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
  }
  .p-list li .chk { color: var(--bl-accent); font-weight: 800; }

  .p-ethos {
    display: inline-block;
    padding: 6px 14px;
    background: var(--bl-gold-light, rgba(184,134,11,0.08));
    border: 1px solid var(--bl-border-h);
    border-radius: 8px;
    font-size: 0.8rem;
    color: var(--bl-gold);
    font-weight: 700;
  }

  /* 3. Özgüven Testi */
  .test-section {
    position: relative;
    z-index: 10;
    padding: 80px 20px;
    background: transparent;
  }
  .test-container {
    max-width: 800px;
    margin: 0 auto;
    background: var(--bl-surface);
    border: 1px solid var(--bl-border);
    border-radius: 24px;
    padding: 48px;
    box-shadow: var(--bl-shadow);
  }
  .question-box { display: none; animation: fadeIn 0.5s ease; }
  .question-box.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .q-title {
    font-size: 1.35rem;
    color: var(--bl-navy);
    margin-bottom: 28px;
    line-height: 1.5;
    font-weight: 700;
  }
  .q-badge {
    display: inline-block;
    background: var(--bl-surface2);
    border: 1px solid var(--bl-border);
    color: var(--bl-gold);
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 0.72rem;
    margin-bottom: 16px;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 1px;
  }
  .option-btn {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--bl-surface2);
    border: 1px solid var(--bl-border);
    color: var(--bl-text);
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 14px;
    cursor: pointer;
    font-size: 1.05rem;
    
    transition: all 0.25s;
  }
  .option-btn:hover {
    background: #fff;
    border-color: var(--bl-gold);
    transform: translateX(4px);
    box-shadow: 0 6px 18px rgba(184,134,11,0.08);
  }
  .progress-bar {
    width: 100%;
    height: 10px;
    background: var(--bl-surface2);
    border-radius: 5px;
    margin-bottom: 38px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--bl-gold), var(--bl-gold2));
    width: 0%;
    transition: width 0.3s ease;
  }
  .test-result { display: none; text-align: center; }
  .total-score-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 5px solid var(--bl-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 900;
    
    margin: 0 auto 30px;
    color: var(--bl-navy);
    background: var(--bl-surface2);
  }
  .sub-scores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 30px;
  }
  .sub-score-box {
    background: var(--bl-surface2);
    padding: 20px;
    border-radius: 12px;
    border: 1px solid var(--bl-border);
    color: var(--bl-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .sub-score-box span { font-size: 2rem; font-weight: bold; display: block; margin-top: 10px;  }

  /* 4-7. Geliştirme Modülleri */
  .module-section {
    position: relative;
    z-index: 10;
    padding: 70px 20px;
    background: var(--bl-surface);
    border-top: 1px solid var(--bl-border);
  }
  .module-section:nth-child(even) { background: transparent; }
  .m-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 26px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .m-card {
    background: var(--bl-surface);
    border: 1px solid var(--bl-border);
    border-radius: 18px;
    padding: 32px;
    box-shadow: var(--bl-shadow);
    transition: all 0.3s;
  }
  .m-card:hover { box-shadow: var(--bl-shadow-h); border-color: var(--bl-border-h); }
  .m-card h4 {
    font-size: 1.25rem;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--bl-navy);
    font-weight: 800;
  }
  
  /* Checklist */
  .chk-item {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    cursor: pointer;
    color: var(--bl-muted);
    transition: 0.3s;
    user-select: none;
  }
  .chk-item:hover { color: var(--bl-navy); }
  .chk-box {
    width: 24px; height: 24px;
    border: 2px solid var(--bl-gold);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: 0.2s;
  }
  .chk-item.checked .chk-box { background: var(--bl-gold); }
  .chk-item.checked .chk-box::after { content: '✔'; color: white; font-size: 0.8rem; }
  .chk-item.checked { color: var(--bl-navy); text-decoration: line-through; opacity: 0.6; }

  /* Senaryo */
  .scenario-box { margin-bottom: 20px; }
  .scenario-title { font-weight: 700; color: var(--bl-navy); margin-bottom: 14px; line-height: 1.5; }
  .sc-btn {
    display: block; width: 100%; text-align: left;
    background: var(--bl-surface2); border: 1px solid var(--bl-border);
    color: var(--bl-text); padding: 14px; border-radius: 10px; margin-bottom: 12px; cursor: pointer;
     font-size: 0.98rem; transition: 0.25s;
  }
  .sc-btn:hover { background: #fff; border-color: var(--bl-gold); }
  .sc-btn.correct { border-color: var(--bl-accent); background: rgba(5, 150, 105, 0.08); }
  .sc-btn.wrong { border-color: var(--bl-warning); background: rgba(217, 119, 6, 0.08); }
  .sc-feedback { display: none; font-size: 0.92rem; padding: 14px; border-radius: 8px; margin-bottom: 15px; line-height: 1.6; }

  /* Nefes Egzersizi */
  .breath-circle {
    width: 200px; height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--bl-gold2) 0%, rgba(212,160,23,0.1) 70%);
    margin: 0 auto 30px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; font-weight: 800; color: var(--bl-navy);
    animation: breathPulse 19s infinite;
  }
  @keyframes breathPulse {
    0% { transform: scale(1); opacity: 0.55; }
    21% { transform: scale(1.5); opacity: 1; }
    58% { transform: scale(1.5); opacity: 1; }
    100% { transform: scale(1); opacity: 0.55; }
  }

  /* ── SEO İçerik Bölümü ── */
  .oz-seo {
    position: relative; z-index: 10;
    max-width: 900px; margin: 0 auto; padding: 70px 20px;
  }
  .oz-seo h2 {  font-size: 2rem; color: var(--bl-navy); margin: 40px 0 16px; font-weight: 800; }
  .oz-seo h3 { font-size: 1.3rem; color: var(--bl-navy); margin: 28px 0 12px; font-weight: 700; }
  .oz-seo p { color: var(--bl-text); line-height: 1.85; margin-bottom: 16px; font-size: 1.05rem; }
  .oz-seo ul { color: var(--bl-text); line-height: 1.8; margin: 0 0 16px; padding-left: 22px; }
  .oz-seo li { margin-bottom: 8px; }

  /* ── FAQ ── */
  .oz-faq { max-width: 900px; margin: 0 auto 40px; }
  .oz-faq-item { background: var(--bl-surface); border: 1px solid var(--bl-border); border-radius: 14px; margin-bottom: 12px; overflow: hidden; box-shadow: var(--bl-shadow); }
  .oz-faq-q { padding: 20px 24px; font-weight: 700; color: var(--bl-navy); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 1.05rem; }
  .oz-faq-q::after { content: '+'; font-size: 1.5rem; color: var(--bl-gold); transition: 0.3s; }
  .oz-faq-item.open .oz-faq-q::after { transform: rotate(45deg); }
  .oz-faq-a { max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.35s ease; padding: 0 24px; color: var(--bl-muted); line-height: 1.75; }
  .oz-faq-item.open .oz-faq-a { max-height: 400px; padding: 0 24px 20px; }

  /* ── İlgili Modüller ── */
  .oz-related { max-width: 1200px; margin: 0 auto; padding: 40px 20px 90px; position: relative; z-index: 10; }
  .oz-related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .oz-related-card { display: block; text-decoration: none; background: var(--bl-surface); border: 1px solid var(--bl-border); border-radius: 16px; padding: 26px; transition: all 0.35s cubic-bezier(0.34,1.56,0.64,1); box-shadow: var(--bl-shadow); }
  .oz-related-card:hover { transform: translateY(-6px); box-shadow: var(--bl-shadow-h); border-color: var(--bl-border-h); }
  .oz-related-card .ic { font-size: 2rem; display: block; margin-bottom: 12px; }
  .oz-related-card h4 { color: var(--bl-navy); font-size: 1.1rem; margin: 0 0 6px; font-weight: 800; }
  .oz-related-card p { color: var(--bl-muted); font-size: 0.88rem; margin: 0; line-height: 1.6; }

  @media (max-width: 768px) {
    .oz-hero { min-height: auto; padding: 70px 16px 40px; }
    .test-container { padding: 30px 22px; }
    .sub-scores { grid-template-columns: 1fr; }
    .section-header { margin-bottom: 36px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .oz-blob, .breath-circle, .oz-badge::before { animation: none !important; }
    .pillar-card, .science-box, .oz-related-card, .option-btn { transition: none !important; }
  }
</style>

<!-- AMBIENT -->
<div class="oz-ambient"><div class="oz-blob"></div><div class="oz-blob"></div><div class="oz-blob"></div></div>
<div class="oz-grid-overlay"></div>

<!-- ADIM 1: HERO SECTION -->
<section class="oz-hero">
  <div class="oz-hero-content">
    <div class="oz-badge">Bilim + Pratik = Başarı</div>
    <h1>Özgüven:<br><span class="oz-hl">Sarsılmaz Bir Duruşun Bilimi</span></h1>
    <h2>Özgüven doğuştan gelmez; nörolojik olarak öğrenilir ve psikolojik olarak geliştirilir. İşte kanıta dayalı yol haritanız.</h2>
    
    <div class="oz-science-stats">
      <div class="science-box">
        <div class="s-title">Kortizol (Stres)</div>
        <div class="s-value down">↓ %25</div>
        <div class="s-desc">Amigdala deaktivasyonu</div>
      </div>
      <div class="science-box">
        <div class="s-title">Dopamin (Motivasyon)</div>
        <div class="s-value up">↑ %30</div>
        <div class="s-desc">Hedef odaklı cesaret</div>
      </div>
    </div>
  </div>
</section>

<!-- ADIM 2: ÖZGÜVENİN 4 TEMEL SÜTUNU -->
<section class="pillars-section">
  <div class="section-header">
    <h3>Özgüvenin 4 Sütunu</h3>
    <p>Gerçek özgüvenin arkasında 4 ana sütun bulunur. Bir hatip, sahnede yıkılmaz görünmek istiyorsa bu 4 sütunu da inşa etmelidir.</p>
  </div>

  <div class="pillars-container">
    
    <!-- 1. Bilgi -->
    <div class="pillar-card p-bilgi">
      <div class="p-score">%30</div>
      <span class="p-icon">📚</span>
      <h4 class="p-title">1. Bilgi Özgüveni</h4>
      <ul class="p-list">
        <li><span class="chk">✓</span> Konuya tam hakimiyet</li>
        <li><span class="chk">✓</span> Derin araştırma yapma</li>
        <li><span class="chk">✓</span> Soru-Cevap hazırlığı</li>
      </ul>
      <div class="p-ethos">Bağlantı: Phronesis (Uzmanlık)</div>
    </div>

    <!-- 2. Sosyal -->
    <div class="pillar-card p-sosyal">
      <div class="p-score">%25</div>
      <span class="p-icon">🤝</span>
      <h4 class="p-title">2. Sosyal Özgüven</h4>
      <ul class="p-list">
        <li><span class="chk">✓</span> Rahat iletişim kurma</li>
        <li><span class="chk">✓</span> Güçlü göz teması</li>
        <li><span class="chk">✓</span> Konuşma başlatabilme</li>
      </ul>
      <div class="p-ethos">Bağlantı: Eunoia (İyi Niyet)</div>
    </div>

    <!-- 3. Değer -->
    <div class="pillar-card p-deger">
      <div class="p-score">%25</div>
      <span class="p-icon">💎</span>
      <h4 class="p-title">3. Değer Özgüveni</h4>
      <ul class="p-list">
        <li><span class="chk">✓</span> Kendi değerini bilme</li>
        <li><span class="chk">✓</span> Sınırları net koyma</li>
        <li><span class="chk">✓</span> Hak talebinde bulunma</li>
      </ul>
      <div class="p-ethos">Bağlantı: Arete (Karakter)</div>
    </div>

    <!-- 4. Performans -->
    <div class="pillar-card p-performans">
      <div class="p-score">%20</div>
      <span class="p-icon">⚡</span>
      <h4 class="p-title">4. Performans</h4>
      <ul class="p-list">
        <li><span class="chk">✓</span> Stres altında sakin kalma</li>
        <li><span class="chk">✓</span> Hata korkusunu yenme</li>
