<%- include('partials/main-header') %>

<style>
  /* ÖZGÜVEN MODÜLÜ - BİLİMSEL & LÜKS TEMA (ETHOS) */
  :root {
    --bl-bg: #0A0A0A;
    --bl-surface: #171717;
    --bl-primary: #3B82F6; /* Sakinlik, Bilgi ve Dopamin (Mavi) */
    --bl-accent: #10B981;  /* Büyüme ve Başarı (Zümrüt) */
    --bl-warning: #F59E0B; /* Dikkat ve Cortisol (Sarı/Turuncu) */
    --bl-text: #F8FAFC;
    --bl-muted: #94A3B8;
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  body {
    background-color: var(--bl-bg);
    color: var(--bl-text);
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
  }

  /* 1. Hero Section */
  .oz-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #000000 100%);
    padding: 20px;
  }

  .oz-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at center, rgba(59, 130, 246, 0.15) 0%, transparent 60%);
    z-index: 1;
  }

  .oz-hero-particles {
    position: absolute;
    width: 100%; height: 100%;
    background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.3;
    animation: drift 20s linear infinite;
  }
  @keyframes drift {
    0% { background-position: 0 0; }
    100% { background-position: 100px 100px; }
  }

  .oz-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  .oz-badge {
    display: inline-block;
    padding: 8px 24px;
    border-radius: 30px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid var(--bl-primary);
    color: var(--bl-primary);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
  }

  .oz-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -2px;
    margin-bottom: 20px;
    background: linear-gradient(to right, #ffffff, var(--bl-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .oz-hero h2 {
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--bl-muted);
    margin-bottom: 40px;
    letter-spacing: 1px;
  }

  .oz-science-stats {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 40px;
    flex-wrap: wrap;
  }
  .science-box {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 20px 30px;
    border-radius: 15px;
    text-align: left;
    min-width: 200px;
    transition: all 0.3s;
  }
  .science-box:hover {
    transform: translateY(-5px);
    background: rgba(255,255,255,0.1);
  }
  .s-title { font-size: 0.9rem; color: var(--bl-muted); text-transform: uppercase; letter-spacing: 1px; }
  .s-value { font-size: 2rem; font-weight: 800; margin: 10px 0; }
  .s-value.down { color: var(--bl-accent); } /* Cortisol down is good */
  .s-value.up { color: var(--bl-primary); } /* Dopamin up is good */
  .s-desc { font-size: 0.9rem; color: #cbd5e1; }

  /* 2. Özgüvenin 4 Sütunu */
  .pillars-section {
    padding: 100px 20px;
    background: var(--bl-surface);
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .section-header h3 {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 15px;
  }
  .section-header p {
    font-size: 1.2rem;
    color: var(--bl-muted);
    max-width: 700px;
    margin: 0 auto;
  }

  .pillars-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .pillar-card {
    background: var(--bl-bg);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 40px 30px;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }
  .pillar-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 4px;
    background: var(--bl-muted);
    transition: all 0.4s ease;
  }
  
  /* Pillar Colors */
  .pillar-card.p-bilgi::before { background: #3B82F6; }
  .pillar-card.p-sosyal::before { background: #8B5CF6; }
  .pillar-card.p-deger::before { background: #10B981; }
  .pillar-card.p-performans::before { background: #F59E0B; }

  .pillar-card:hover {
    transform: translateY(-10px);
    border-color: rgba(255,255,255,0.2);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .p-score {
    position: absolute;
    top: 20px; right: 20px;
    font-size: 1.5rem;
    font-weight: 800;
    opacity: 0.5;
  }

  .p-icon {
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: var(--bl-text);
  }

  .p-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 15px;
  }

  .p-list {
    list-style: none;
    padding: 0;
    margin: 0 0 20px 0;
  }
  .p-list li {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: var(--bl-muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .p-list li i { color: var(--bl-primary); font-size: 0.8rem; }

  .p-ethos {
    display: inline-block;
    padding: 5px 12px;
    background: rgba(255,255,255,0.05);
    border-radius: 5px;
    font-size: 0.85rem;
    color: #e2e8f0;
    font-weight: 600;
  }

  /* 3. Özgüven Testi */
  .test-section {
    padding: 100px 20px;
    background: var(--bl-bg);
  }
  .test-container {
    max-width: 800px;
    margin: 0 auto;
    background: var(--bl-surface);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: 50px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }
  .question-box {
    display: none;
    animation: fadeIn 0.5s ease;
  }
  .question-box.active {
    display: block;
  }
  .q-title {
    font-size: 1.5rem;
    color: white;
    margin-bottom: 30px;
    line-height: 1.5;
  }
  .q-badge {
    display: inline-block;
    background: rgba(59, 130, 246, 0.2);
    color: var(--bl-primary);
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 0.8rem;
    margin-bottom: 15px;
    text-transform: uppercase;
    font-weight: bold;
  }
  .option-btn {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--bl-bg);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--bl-text);
    padding: 15px 20px;
    border-radius: 10px;
    margin-bottom: 15px;
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 0.2s;
  }
  .option-btn:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: var(--bl-primary);
  }
  .progress-bar {
    width: 100%;
    height: 10px;
    background: rgba(255,255,255,0.1);
    border-radius: 5px;
    margin-bottom: 40px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--bl-primary);
    width: 0%;
    transition: width 0.3s ease;
  }
  .test-result {
    display: none;
    text-align: center;
  }
  .total-score-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 5px solid var(--bl-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 900;
    margin: 0 auto 30px;
    color: white;
  }
  .sub-scores {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
  }
  .sub-score-box {
    background: var(--bl-bg);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .sub-score-box span { font-size: 2rem; font-weight: bold; display: block; margin-top: 10px; }

  /* 4-7. Geliştirme Modülleri Genel Stiller */
  .module-section {
    padding: 80px 20px;
    background: var(--bl-surface);
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .module-section:nth-child(even) {
    background: var(--bl-bg);
  }
  .m-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .m-card {
    background: var(--bl-bg);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 15px;
    padding: 30px;
  }
  .m-card h4 {
    font-size: 1.3rem;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  /* Checklist Stilleri */
  .chk-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    cursor: pointer;
    color: var(--bl-muted);
    transition: 0.3s;
  }
  .chk-item:hover { color: white; }
  .chk-box {
    width: 24px; height: 24px;
    border: 2px solid var(--bl-primary);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .chk-item.checked .chk-box { background: var(--bl-primary); }
  .chk-item.checked .chk-box::after { content: '✔'; color: white; font-size: 0.8rem; }
  .chk-item.checked { color: white; text-decoration: line-through; opacity: 0.7; }

  /* Senaryo Butonları */
  .scenario-box { margin-bottom: 20px; }
  .scenario-title { font-weight: bold; color: var(--bl-primary); margin-bottom: 10px; }
  .sc-btn {
    display: block; width: 100%; text-align: left;
    background: transparent; border: 1px solid rgba(255,255,255,0.1);
    color: var(--bl-text); padding: 12px; border-radius: 8px; margin-bottom: 10px; cursor: pointer;
  }
  .sc-btn:hover { background: rgba(255,255,255,0.05); }
  .sc-btn.correct { border-color: var(--bl-accent); background: rgba(16, 185, 129, 0.1); }
  .sc-btn.wrong { border-color: var(--bl-warning); background: rgba(245, 158, 11, 0.1); }
  .sc-feedback { display: none; font-size: 0.9rem; padding: 10px; border-radius: 5px; margin-bottom: 15px; }

  /* Nefes Egzersizi */
  .breath-circle {
    width: 200px; height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--bl-primary) 0%, transparent 70%);
    margin: 0 auto 30px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; font-weight: bold;
    animation: breathPulse 19s infinite; /* 4 in + 7 hold + 8 out = 19s */
  }
  @keyframes breathPulse {
    0% { transform: scale(1); opacity: 0.5; }
    21% { transform: scale(1.5); opacity: 1; } /* 4s in */
    58% { transform: scale(1.5); opacity: 1; } /* 7s hold */
    100% { transform: scale(1); opacity: 0.5; } /* 8s out */
  }

</style>

<!-- ADIM 1: HERO SECTION -->
<section class="oz-hero">
  <div class="oz-hero-bg"></div>
  <div class="oz-hero-particles"></div>
  
  <div class="oz-hero-content">
    <div class="oz-badge">Bilim + Pratik = Başarı</div>
    <h1>Özgüven:<br>Ethos'un Görünür Halidir</h1>
    <h2>Özgüven doğuştan gelmez; nörolojik olarak öğrenilir ve psikolojik olarak geliştirilir.</h2>
    
    <div class="oz-science-stats">
      <div class="science-box">
        <div class="s-title">Kortizol (Stres)</div>
        <div class="s-value down"><i class="fa-solid fa-arrow-trend-down"></i> %25</div>
        <div class="s-desc">Amigdala deaktivasyonu</div>
      </div>
      <div class="science-box">
        <div class="s-title">Dopamin (Motivasyon)</div>
        <div class="s-value up"><i class="fa-solid fa-arrow-trend-up"></i> %30</div>
        <div class="s-desc">Hedef odaklı cesaret</div>
      </div>
    </div>
  </div>
</section>

<!-- ADIM 2: ÖZGÜVENİN 4 TEMEL SÜTUNU -->
<section class="pillars-section">
  <div class="section-header">
    <h3>Özgüvenin 4 Sütunu</h3>
    <p>Gerçek özgüvenin arkasında 4 ana sütun bulunur. Bir hatip, sahnede yıkılmaz görünmek istiyorsa bu 4 sütunu da inşa etmelidir.</p>
  </div>

  <div class="pillars-container">
    
    <!-- 1. Bilgi -->
    <div class="pillar-card p-bilgi">
      <div class="p-score">%30</div>
      <i class="fa-solid fa-book-open-reader p-icon" style="color: #3B82F6;"></i>
      <h4 class="p-title">1. Bilgi Özgüveni</h4>
      <ul class="p-list">
        <li><i class="fa-solid fa-check"></i> Konuya tam hakimiyet</li>
        <li><i class="fa-solid fa-check"></i> Derin araştırma yapma</li>
        <li><i class="fa-solid fa-check"></i> Soru-Cevap hazırlığı</li>
      </ul>
      <div class="p-ethos">Bağlantı: Phronesis (Uzmanlık)</div>
    </div>

    <!-- 2. Sosyal -->
    <div class="pillar-card p-sosyal">
      <div class="p-score">%25</div>
      <i class="fa-solid fa-users p-icon" style="color: #8B5CF6;"></i>
      <h4 class="p-title">2. Sosyal Özgüven</h4>
      <ul class="p-list">
        <li><i class="fa-solid fa-check"></i> Rahat iletişim kurma</li>
        <li><i class="fa-solid fa-check"></i> Güçlü göz teması</li>
        <li><i class="fa-solid fa-check"></i> Konuşma başlatabilme</li>
      </ul>
      <div class="p-ethos">Bağlantı: Eunoia (İyi Niyet)</div>
    </div>

    <!-- 3. Değer -->
    <div class="pillar-card p-deger">
      <div class="p-score">%25</div>
      <i class="fa-solid fa-gem p-icon" style="color: #10B981;"></i>
      <h4 class="p-title">3. Değer Özgüveni</h4>
      <ul class="p-list">
        <li><i class="fa-solid fa-check"></i> Kendi değerini bilme</li>
        <li><i class="fa-solid fa-check"></i> Sınırları net koyma</li>
        <li><i class="fa-solid fa-check"></i> Hak talebinde bulunma</li>
      </ul>
      <div class="p-ethos">Bağlantı: Arete (Karakter)</div>
    </div>

    <!-- 4. Performans -->
    <div class="pillar-card p-performans">
      <div class="p-score">%20</div>
      <i class="fa-solid fa-bolt p-icon" style="color: #F59E0B;"></i>
      <h4 class="p-title">4. Performans</h4>
      <ul class="p-list">
        <li><i class="fa-solid fa-check"></i> Stres altında sakin kalma</li>
        <li><i class="fa-solid fa-check"></i> Hata korkusunu yenme</li>
        <li><i class="fa-solid fa-check"></i> Sahne heyecanını yönetme</li>
      </ul>
      <div class="p-ethos">Bağlantı: Tüm Bileşenler</div>
    </div>

  </div>
</section>

<!-- ADIM 3: ÖZGÜVEN SEVİYESİ DEĞERLENDİRME TESTİ -->
<section class="test-section" id="ozguvenTesti">
  <div class="section-header">
    <h3>Özgüven Seviyesi Testi</h3>
    <p>Hangi sütununuz sağlam, hangisi güçlendirilmeli? Bu mini test ile anında öğrenin.</p>
  </div>

  <div class="test-container">
    <div id="quizApp">
      <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
      
      <div id="questionsContainer">
        <!-- JS ile Doldurulacak -->
      </div>

      <div class="test-result" id="testResult">
        <h3>Test Tamamlandı!</h3>
        <p style="color: var(--bl-muted); margin-bottom: 30px;">İşte güncel özgüven profiliniz:</p>
        
        <div class="total-score-circle" id="totalScoreText">0</div>
        <p style="font-size: 1.2rem; font-weight: bold; color: var(--bl-primary); margin-bottom: 30px;" id="generalStatusText"></p>
        
        <div class="sub-scores">
          <div class="sub-score-box">Bilgi Özgüveni <span id="s1" style="color:#3B82F6">0</span></div>
          <div class="sub-score-box">Sosyal Özgüven <span id="s2" style="color:#8B5CF6">0</span></div>
          <div class="sub-score-box">Değer Özgüveni <span id="s3" style="color:#10B981">0</span></div>
          <div class="sub-score-box">Performans <span id="s4" style="color:#F59E0B">0</span></div>
        </div>

        <button onclick="location.reload()" class="oz-badge" style="cursor: pointer; background: transparent; border-color: white; color: white;">Testi Tekrarla</button>
      </div>
    </div>
  </div>
</section>

<!-- ADIM 4: BİLGİ ÖZGÜVENİ GELİŞTİRME -->
<section class="module-section">
  <div class="section-header">
    <h3>Bilgi Özgüveni (Phronesis)</h3>
    <p>Hazırlık, korkunun panzehiridir. Bir konuya ne kadar hakimseniz, sahnede o kadar özgüvenli olursunuz.</p>
  </div>
  <div class="m-grid">
    <div class="m-card">
      <h4 style="color:#3B82F6"><i class="fa-solid fa-list-check"></i> Derinlemesine Öğrenme</h4>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Tüm özellikleri biliyorum</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Avantaj ve dezavantajlara hakimim</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Rakip analizi yaptım</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Sık sorulan soruları biliyorum</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> İstatistik ve verilerle destekledim</div>
    </div>
    <div class="m-card">
      <h4 style="color:#3B82F6"><i class="fa-solid fa-magnifying-glass"></i> Araştırma Kaynakları</h4>
      <ul class="p-list">
        <li><i class="fa-solid fa-book"></i> Resmi Belgeler & Manual'ler</li>
        <li><i class="fa-solid fa-star"></i> Müşteri/Kullanıcı Yorumları</li>
        <li><i class="fa-solid fa-chart-line"></i> Endüstri Trend Raporları</li>
        <li><i class="fa-solid fa-graduation-cap"></i> Akademik Makaleler</li>
      </ul>
      <p style="color:var(--bl-muted); font-size:0.9rem; margin-top:15px;">Araştırma Derinliği: Derin (6-10 saat) = %85 Özgüven Garantisi</p>
    </div>
  </div>
</section>

<!-- ADIM 5: SOSYAL ÖZGÜVEN GELİŞTİRME -->
<section class="module-section">
  <div class="section-header">
    <h3>Sosyal Özgüven (Eunoia)</h3>
    <p>İnsanlarla bağ kurma sanatı. Göz teması ve aktif dinleme pratikleriyle aurayı yönetin.</p>
  </div>
  <div class="m-grid">
    <div class="m-card">
      <h4 style="color:#8B5CF6"><i class="fa-solid fa-eye"></i> Göz Teması Egzersizi</h4>
      <p style="color:var(--bl-muted); margin-bottom:20px;">Adım adım göz teması sürenizi artırın:</p>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Seviye 1: Aynada kendine bak (30s)</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Seviye 2: Arkadaşla kesintisiz (1dk)</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Seviye 3: Grup içinde dolaşarak (5dk)</div>
      <div class="chk-item" onclick="this.classList.toggle('checked')"><div class="chk-box"></div> Seviye 4: Kalabalık önünde (10dk)</div>
    </div>
    <div class="m-card">
      <h4 style="color:#8B5CF6"><i class="fa-solid fa-ear-listen"></i> Aktif Dinleme Formülü</h4>
      <div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:10px; margin-bottom:10px;">
        <strong>1. Tam Dikkat:</strong> Telefonu ters çevir
      </div>
      <div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:10px; margin-bottom:10px;">
        <strong>2. Geri Bildirim:</strong> "Evet, anlıyorum" onayı ver
      </div>
      <div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:10px;">
        <strong>3. Özetleme:</strong> "Anladığım kadarıyla şunu demek istedin..."
      </div>
    </div>
  </div>
</section>

<!-- ADIM 6: DEĞER ÖZGÜVENİ GELİŞTİRME -->
<section class="module-section">
  <div class="section-header">
    <h3>Değer Özgüveni (Arete)</h3>
    <p>Kendi sınırlarınızı çizme ve hak ettiğinizi talep etme simülasyonları.</p>
  </div>
  <div class="m-grid" style="max-width: 800px;">
    <div class="m-card">
      <h4 style="color:#10B981"><i class="fa-solid fa-hand"></i> Sınır Koyma Simülatörü</h4>
      <div class="scenario-box">
        <div class="scenario-title">Senaryo: Patron size 3 günde 5 zor proje verdi. Ne dersiniz?</div>
        
        <button class="sc-btn" onclick="checkScenario(this, 'wrong', 'Değer Özgüveni: %20. Sınırlarınızı koruyamadınız ve tükenmişliğe sürükleneceksiniz.')">
          "Tamam, bir şekilde hallederim."
        </button>
        <button class="sc-btn" onclick="checkScenario(this, 'correct', 'Değer Özgüveni: %90. Mükemmel! Sınırınızı çizdiniz ve çözüm odaklı yaklaştınız.')">
          "Bu 5 projeyi 3 günde bitirmek kaliteyi düşürür. Öncelikleri belirleyip gerçekçi bir plan yapalım."
        </button>
        <div class="sc-feedback"></div>
      </div>
    </div>
    <div class="m-card">
      <h4 style="color:#10B981"><i class="fa-solid fa-arrow-up-right-dots"></i> Hak Talebi Simülatörü</h4>
      <div class="scenario-box">
        <div class="scenario-title">Senaryo: Çok başarılı bir yılın ardından zam isteyeceksiniz.</div>
        
        <button class="sc-btn" onclick="checkScenario(this, 'wrong', 'Değer Özgüveni: %30. Zayıf talep. Karşı tarafa inisiyatif bıraktınız.')">
          "Eğer mümkünse bu ay maaşımda biraz artış olabilir mi?"
        </button>
        <button class="sc-btn" onclick="checkScenario(this, 'correct', 'Değer Özgüveni: %95. Verilerle konuştunuz ve özgüvenle hakkınızı talep ettiniz.')">
          "Son 2 yılda hedefleri %150 aştım. Bu değere istinaden %15 zam talep ediyorum."
        </button>
        <div class="sc-feedback"></div>
      </div>
    </div>
  </div>
</section>

<!-- ADIM 7: PERFORMANS ÖZGÜVENİ GELİŞTİRME -->
<section class="module-section">
  <div class="section-header">
    <h3>Performans Özgüveni</h3>
    <p>Sahne korkusunu yenmek ve stres altında soğukkanlı kalmak.</p>
  </div>
  <div class="m-grid">
    <div class="m-card" style="text-align: center;">
      <h4 style="color:#F59E0B; justify-content:center;"><i class="fa-solid fa-wind"></i> 4-7-8 Nefes Egzersizi</h4>
      <p style="color:var(--bl-muted); margin-bottom:30px;">Kortizolü (stres hormonunu) anında %30 düşürür.</p>
      
      <div class="breath-circle" id="breathCircle">Nefes Al (4s)</div>
      
      <p style="font-size:0.9rem; color:#cbd5e1;">Sahneye çıkmadan önce bu döngüyü 4 kez tekrarlayın.</p>
    </div>
    
    <div class="m-card">
      <h4 style="color:#F59E0B"><i class="fa-solid fa-brain"></i> Hata Korkusu Seviyeleri</h4>
      <ul class="p-list">
        <li>
          <div>
            <strong style="color:white;">Seviye 1: Kelime Unutma</strong><br>
            <span style="font-size:0.9rem;">Dinleyici fark etmez bile. Gülümse ve devam et. (Özgüven: %70)</span>
          </div>
        </li>
        <li>
          <div>
            <strong style="color:white;">Seviye 2: Yanlış Bilgi Verme</strong><br>
            <span style="font-size:0.9rem;">Fark ettiğin an zarifçe düzelt. Dürüstlük güveni artırır. (Özgüven: %85)</span>
          </div>
        </li>
        <li>
          <div>
            <strong style="color:white;">Seviye 3: Sahnede Tamamen Kilitlenme</strong><br>
            <span style="font-size:0.9rem;">Seyirciye itiraf et: "Şu an heyecanlandım, 1 saniye müsaade." İnsanlık bağı kurar. (Özgüven: %95)</span>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  // Adım 3: Test Logic
  const questions = [
    { cat: 'bilgi', badge: 'Bilgi Özgüveni', text: 'Konuşmak istediğim veya savunduğum bir konuda ne kadar bilgili ve hazırlıklı hissediyorum?', opts: [{t: 'Hiç bilgili değilim', v: 0}, {t: 'Biraz bilgili', v: 25}, {t: 'Oldukça bilgili', v: 75}, {t: 'Uzman seviyesinde', v: 100}] },
    { cat: 'sosyal', badge: 'Sosyal Özgüven', text: 'Yabancı insanlarla veya kalabalık önünde konuşma başlatmaktan ne kadar rahat hissediyorum?', opts: [{t: 'Çok rahatsız', v: 0}, {t: 'Biraz rahatsız', v: 25}, {t: 'Oldukça rahat', v: 75}, {t: 'Çok rahat (Doğal)', v: 100}] },
    { cat: 'deger', badge: 'Değer Özgüveni', text: 'Kendi değerimi biliyor, haksızlığa uğradığımda sınırlarımı net bir şekilde çizebiliyor muyum?', opts: [{t: 'Asla savunamam', v: 0}, {t: 'Zorlanırım', v: 25}, {t: 'Çoğu zaman çizerim', v: 75}, {t: 'Her zaman korurum', v: 100}] },
    { cat: 'performans', badge: 'Performans Özgüveni', text: 'Beklenmedik bir hata yaptığımda veya stres altında kaldığımda sahnede/ortamda nasıl tepki veririm?', opts: [{t: 'Paniklerim/Donarım', v: 0}, {t: 'Toparlamam zaman alır', v: 25}, {t: 'Kısa sürede toparlarım', v: 75}, {t: 'Hatamı bile lehime çeviririm', v: 100}] }
  ];

  let currentQ = 0;
  let scores = { bilgi: 0, sosyal: 0, deger: 0, performans: 0 };

  const container = document.getElementById('questionsContainer');
  const progressFill = document.getElementById('progressFill');

  function renderQuestion() {
    container.innerHTML = '';
    const q = questions[currentQ];
    
    const box = document.createElement('div');
    box.className = 'question-box active';
    box.innerHTML = `
      <div class="q-badge">${q.badge}</div>
      <h4 class="q-title">${currentQ + 1}. ${q.text}</h4>
    `;

    q.opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'option-btn';
      btn.innerHTML = opt.t;
      btn.onclick = () => handleAnswer(q.cat, opt.v);
      box.appendChild(btn);
    });

    container.appendChild(box);
    progressFill.style.width = ((currentQ) / questions.length * 100) + '%';
  }

  function handleAnswer(cat, val) {
    scores[cat] += val;
    currentQ++;
    if (currentQ < questions.length) {
      renderQuestion();
    } else {
      showResults();
    }
  }

  function showResults() {
    container.style.display = 'none';
    progressFill.style.width = '100%';
    document.getElementById('testResult').style.display = 'block';

    const total = Math.round((scores.bilgi + scores.sosyal + scores.deger + scores.performans) / 4);
    document.getElementById('totalScoreText').innerText = total;
    
    document.getElementById('s1').innerText = scores.bilgi;
    document.getElementById('s2').innerText = scores.sosyal;
    document.getElementById('s3').innerText = scores.deger;
    document.getElementById('s4').innerText = scores.performans;

    let status = 'Düşük Seviye';
    if(total > 40) status = 'Orta Seviye - Geliştirilmeli';
    if(total > 70) status = 'Yüksek Seviye Özgüven!';
    if(total > 90) status = 'Master Seviye (Sarsılmaz)!';
    document.getElementById('generalStatusText').innerText = status;
  }

  // Adım 6: Senaryo Kontrolü
  function checkScenario(btn, type, msg) {
    const box = btn.closest('.scenario-box');
    const feedback = box.querySelector('.sc-feedback');
    const btns = box.querySelectorAll('.sc-btn');
    
    btns.forEach(b => { b.classList.remove('correct', 'wrong'); b.style.opacity = '0.5'; });
    btn.style.opacity = '1';
    btn.classList.add(type);
    
    feedback.style.display = 'block';
    feedback.innerText = msg;
    feedback.style.color = type === 'correct' ? 'var(--bl-accent)' : 'var(--bl-warning)';
    feedback.style.backgroundColor = type === 'correct' ? 'rgba(16, 185, 129, 0.1)' : 'rgba(245, 158, 11, 0.1)';
  }

  // Adım 7: Nefes Döngüsü Text Güncelleme
  document.addEventListener('DOMContentLoaded', () => {
    renderQuestion();

    const breathCircle = document.getElementById('breathCircle');
    if(breathCircle) {
      setInterval(() => {
        setTimeout(() => { breathCircle.innerText = 'Tut (7s)'; }, 4000);
        setTimeout(() => { breathCircle.innerText = 'Ver (8s)'; }, 11000);
        setTimeout(() => { breathCircle.innerText = 'Al (4s)'; }, 19000);
      }, 19000);
      // İlk döngüyü hemen başlat
      setTimeout(() => { breathCircle.innerText = 'Tut (7s)'; }, 4000);
      setTimeout(() => { breathCircle.innerText = 'Ver (8s)'; }, 11000);
      setTimeout(() => { breathCircle.innerText = 'Al (4s)'; }, 19000);
    }
  });
</script>

<%- include('partials/main-footer') %>