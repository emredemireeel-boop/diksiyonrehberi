<script>
  // Adım 3: Test Logic
  const questions = [
    { cat: 'bilgi', badge: 'Bilgi Özgüveni', text: 'Konuşmak istediğim veya savunduğum bir konuda ne kadar bilgili ve hazırlıklı hissediyorum?', opts: [{t: 'Hiç bilgili değilim', v: 0}, {t: 'Biraz bilgili', v: 25}, {t: 'Oldukça bilgili', v: 75}, {t: 'Uzman seviyesinde', v: 100}] },
    { cat: 'sosyal', badge: 'Sosyal Özgüven', text: 'Yabancı insanlarla veya kalabalık önünde konuşma başlatmaktan ne kadar rahat hissediyorum?', opts: [{t: 'Çok rahatsız', v: 0}, {t: 'Biraz rahatsız', v: 25}, {t: 'Oldukça rahat', v: 75}, {t: 'Çok rahat (Doğal)', v: 100}] },
    { cat: 'deger', badge: 'Değer Özgüveni', text: 'Kendi değerimi biliyor, haksızlığa uğradığımda sınırlarımı net bir şekilde çizebiliyor muyum?', opts: [{t: 'Asla savunamam', v: 0}, {t: 'Zorlanırım', v: 25}, {t: 'Çoğu zaman çizerim', v: 75}, {t: 'Her zaman korurum', v: 100}] },
    { cat: 'performans', badge: 'Performans Özgüveni', text: 'Beklenmedik bir hata yaptığımda veya stres altında kaldığımda sahnede/ortamda nasıl tepki veririm?', opts: [{t: 'Paniklerim/Donarım', v: 0}, {t: 'Toparlamam zaman alır', v: 25}, {t: 'Kısa sürede toparlarım', v: 75}, {t: 'Hatamı bile lehime çeviririm', v: 100}] }
  ];

  let currentQ = 0;
  let scores = { bilgi: 0, sosyal: 0, deger: 0, performans: 0 };

  const container = document.getElementById('questionsContainer');
  const progressFill = document.getElementById('progressFill');

  function renderQuestion() {
    container.innerHTML = '';
    const q = questions[currentQ];
    
    const box = document.createElement('div');
    box.className = 'question-box active';
    box.innerHTML = `
      <div class="q-badge">${q.badge}</div>
      <h4 class="q-title">${currentQ + 1}. ${q.text}</h4>
    `;

    q.opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'option-btn';
      btn.innerHTML = opt.t;
      btn.onclick = () => handleAnswer(q.cat, opt.v);
      box.appendChild(btn);
    });

    container.appendChild(box);
    progressFill.style.width = ((currentQ) / questions.length * 100) + '%';
  }

  function handleAnswer(cat, val) {
    scores[cat] += val;
    currentQ++;
    if (currentQ < questions.length) {
      renderQuestion();
    } else {
      showResults();
    }
  }

  function showResults() {
    container.style.display = 'none';
    progressFill.style.width = '100%';
    document.getElementById('testResult').style.display = 'block';

    const total = Math.round((scores.bilgi + scores.sosyal + scores.deger + scores.performans) / 4);
    document.getElementById('totalScoreText').innerText = total;
    
    document.getElementById('s1').innerText = scores.bilgi;
    document.getElementById('s2').innerText = scores.sosyal;
    document.getElementById('s3').innerText = scores.deger;
    document.getElementById('s4').innerText = scores.performans;

    let status = 'Düşük Seviye';
    if(total > 40) status = 'Orta Seviye - Geliştirilmeli';
    if(total > 70) status = 'Yüksek Seviye Özgüven!';
    if(total > 90) status = 'Master Seviye (Sarsılmaz)!';
    document.getElementById('generalStatusText').innerText = status;
  }

  // Adım 6: Senaryo Kontrolü
  function checkScenario(btn, type, msg) {
    const box = btn.closest('.scenario-box');
    const feedback = box.querySelector('.sc-feedback');
    const btns = box.querySelectorAll('.sc-btn');
    
    btns.forEach(b => { b.classList.remove('correct', 'wrong'); b.style.opacity = '0.5'; });
    btn.style.opacity = '1';
    btn.classList.add(type);
    
    feedback.style.display = 'block';
    feedback.innerText = msg;
    feedback.style.color = type === 'correct' ? 'var(--bl-accent)' : 'var(--bl-warning)';
    feedback.style.backgroundColor = type === 'correct' ? 'rgba(5, 150, 105, 0.08)' : 'rgba(217, 119, 6, 0.08)';
  }

  // SSS aç/kapa
  document.querySelectorAll('.oz-faq-q').forEach(q => {
    q.addEventListener('click', () => q.closest('.oz-faq-item').classList.toggle('open'));
  });

  // Adım 7: Nefes Döngüsü Text Güncelleme
  document.addEventListener('DOMContentLoaded', () => {
    renderQuestion();

    const breathCircle = document.getElementById('breathCircle');
    if(breathCircle) {
      setInterval(() => {
        setTimeout(() => { breathCircle.innerText = 'Tut (7s)'; }, 4000);
