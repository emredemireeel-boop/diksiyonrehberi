<%- include('partials/main-header') %>

<style>
  /* LIGHT MODE PREMIUM UIX OVERRIDES - FULL SCREEN */
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.ozguven-page { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }
  
  /* FONTS & VARIABLES */
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
  :root {
    --oz-primary: #8b5cf6; /* Elegant violet */
    --oz-dark: #5b21b6;
    --oz-light: #ddd6fe;
    --gold-primary: #C59D5F; 
    --light-bg: #fafaf9;
    --glass-bg: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(139, 92, 246, 0.2);
    --text-main: #1c1917;
    --text-muted: #57534e;
  }

  /* HERO SECTION */
  .oz-hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(circle at center, #ffffff 0%, #f5f3ff 100%);
    overflow: hidden;
  }
  .oz-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: url('https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=1920&q=80') center/cover;
    opacity: 0.05;
    z-index: 0;
    mix-blend-mode: multiply;
  }
  .oz-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 20px;
    animation: fadeUp 1s ease-out;
  }
  .oz-badge {
    display: inline-block;
    padding: 8px 24px;
    border-radius: 30px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid var(--oz-primary);
    color: var(--oz-dark);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
    backdrop-filter: blur(10px);
  }
  .oz-title {
    font-family: 'Playfair Display', serif;
    font-size: 5rem;
    line-height: 1.1;
    margin: 0 0 20px 0;
    color: var(--text-main);
    text-shadow: 0 10px 30px rgba(139, 92, 246, 0.1);
  }
  .oz-title span {
    color: var(--oz-primary);
    font-style: italic;
  }
  .oz-subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    color: var(--text-muted);
    font-weight: 400;
    max-width: 650px;
    margin: 0 auto 50px auto;
    line-height: 1.8;
  }

  .oz-stats-container {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 20px;
  }
  .oz-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .oz-stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: var(--oz-dark);
    font-weight: 700;
    line-height: 1;
  }
  .oz-stat-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 5px;
    font-weight: 600;
  }

  /* APP BANNER (LABORATUVAR) */
  .oz-lab-banner {
    max-width: 1400px;
    margin: -50px auto 60px auto;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 30px;
    padding: 50px 30px;
    position: relative;
    z-index: 10;
    box-shadow: 0 30px 60px rgba(139, 92, 246, 0.08);
    text-align: center;
  }
  .oz-lab-banner::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--oz-light), var(--oz-primary), var(--oz-light));
    border-radius: 30px 30px 0 0;
  }
  .lab-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--text-main); margin: 0 0 15px 0; }
  .lab-desc { font-family: 'Outfit', sans-serif; color: var(--text-muted); font-size: 1.1rem; max-width: 800px; margin: 0 auto 30px auto; line-height: 1.6; }
  .lab-buttons { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
  
  .btn-lab {
    background: #ffffff;
    border: 2px solid #e5e7eb;
    color: var(--text-main);
    padding: 15px 35px;
    border-radius: 30px;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: all 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .btn-lab.golge { border-color: #818cf8; color: #4338ca; }
  .btn-lab.golge:hover { background: #4f46e5; color: #fff; box-shadow: 0 10px 20px rgba(79, 70, 229, 0.2); transform: translateY(-3px); }
  
  .btn-lab.red { border-color: #fb7185; color: #be123c; }
  .btn-lab.red:hover { background: #e11d48; color: #fff; box-shadow: 0 10px 20px rgba(225, 29, 72, 0.2); transform: translateY(-3px); }
  
  .btn-lab.statu { border-color: #fde047; color: #854d0e; }
  .btn-lab.statu:hover { background: #eab308; color: #fff; box-shadow: 0 10px 20px rgba(234, 179, 8, 0.2); transform: translateY(-3px); }
  
  .btn-lab.aura { border-color: #c4b5fd; color: #5b21b6; background: linear-gradient(135deg, #ffffff, #f5f3ff); }
  .btn-lab.aura:hover { background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #fff; box-shadow: 0 10px 20px rgba(139, 92, 246, 0.3); transform: translateY(-3px); border-color: transparent; }

  /* NAVIGATION */
  .oz-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding: 20px 0;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    box-shadow: 0 5px 15px rgba(0,0,0,0.02);
  }
  .oz-nav-item {
    color: var(--text-muted);
    text-decoration: none;
    padding: 10px 25px;
    border-radius: 20px;
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }
  .oz-nav-item.active {
    background: rgba(139, 92, 246, 0.1);
    border-color: var(--oz-primary);
    color: var(--oz-dark);
  }
  .oz-nav-item:hover:not(.active) {
    background: rgba(0, 0, 0, 0.03);
    color: var(--text-main);
  }

  /* MAIN CONTENT SECTION */
  .oz-section {
    padding: 100px 5%;
    max-width: 1400px;
    margin: 0 auto;
  }
  .oz-section-header { text-align: center; margin-bottom: 60px; }
  .oz-section-title { font-family: 'Playfair Display', serif; font-size: 3rem; color: var(--text-main); margin: 0; }
  .oz-section-subtitle { font-family: 'Outfit', sans-serif; color: var(--oz-primary); font-size: 1.1rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 15px; }

  /* CARDS */
  .oz-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
  }
  .oz-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 40px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(139, 92, 246, 0.03);
  }
  .oz-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--oz-primary), transparent);
    transform: translateX(-100%); transition: 0.6s;
  }
  .oz-card:hover {
    transform: translateY(-10px);
    border-color: var(--oz-primary);
    box-shadow: 0 20px 40px rgba(139, 92, 246, 0.1);
    background: #ffffff;
  }
  .oz-card:hover::before { transform: translateX(100%); }
  
  .oz-card-tag { font-family: 'Outfit'; font-size: 0.75rem; font-weight: 800; letter-spacing: 2px; color: var(--oz-dark); text-transform: uppercase; margin-bottom: 15px; }
  .oz-card-icon { font-size: 3rem; margin-bottom: 25px; filter: drop-shadow(0 5px 10px rgba(139, 92, 246, 0.2)); }
  .oz-card-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-main); margin: 0 0 15px 0; }
  .oz-card-desc { font-family: 'Outfit', sans-serif; color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin: 0 0 30px 0; flex-grow: 1; }
  
  .oz-card-btn {
    font-family: 'Outfit', sans-serif; display: inline-flex; align-items: center;
    color: var(--text-main); font-weight: 700; font-size: 0.95rem; gap: 10px; transition: 0.3s;
  }
  .oz-card:hover .oz-card-btn { color: var(--oz-dark); gap: 15px; }

  /* ARTICLE SECTION */
  .oz-article {
    background: linear-gradient(45deg, #ffffff, #f8fafc);
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding: 100px 5%;
  }
  .oz-article-content { max-width: 800px; margin: 0 auto; text-align: center; }
  .oz-article-title { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--text-main); margin-bottom: 20px; }
  .oz-article-text { font-family: 'Outfit', sans-serif; color: var(--text-muted); font-size: 1.15rem; line-height: 1.8; margin-bottom: 30px; }
  
  .oz-quote-box {
    background: #f5f3ff;
    border-left: 4px solid var(--oz-primary);
    padding: 30px;
    border-radius: 0 20px 20px 0;
    text-align: left;
    margin-top: 40px;
  }
  .oz-quote { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--oz-dark); font-style: italic; margin-bottom: 15px; line-height: 1.5; }
  .oz-quote-author { font-family: 'Outfit', sans-serif; font-size: 0.9rem; font-weight: 700; color: var(--oz-primary); text-transform: uppercase; letter-spacing: 1px; }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

  @media(max-width: 768px) {
    .oz-title { font-size: 3rem; }
    .lab-buttons { flex-direction: column; }
    .btn-lab { width: 100%; justify-content: center; }
    .oz-section { padding: 60px 20px; }
  }
</style>

<div class="ozguven-page">
  
  <!-- HERO -->
  <section class="oz-hero">
    <div class="oz-hero-content">
      <div class="oz-badge">İçsel Güç Masterclass</div>
      <h1 class="oz-title">Sarsılmaz Bir <span>Özgüven</span></h1>
      <p class="oz-subtitle">Özgüven bir kişilik özelliği değil, psikolojik bir mühendisliktir. Mükemmeliyetçilik tuzaklarından kurtulun, sessizliğin gücünü yönetin ve her ortama otoritenizle hakim olun.</p>
      
      <div class="oz-stats-container">
        <div class="oz-stat"><span class="oz-stat-num">3</span><span class="oz-stat-label">Ana Disiplin</span></div>
        <div class="oz-stat"><span class="oz-stat-num">10+</span><span class="oz-stat-label">Mental Teknik</span></div>
        <div class="oz-stat"><span class="oz-stat-num">∞</span><span class="oz-stat-label">Potansiyel</span></div>
      </div>
    </div>
  </section>

  <!-- APP BANNER -->
  <div class="oz-lab-banner">
    <div style="font-family: 'Outfit'; font-size: 0.85rem; font-weight: 800; color: var(--oz-primary); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px;">Özgüven Laboratuvarı</div>
    <h2 class="lab-title">4 Efsanevi Simülasyon</h2>
    <p class="lab-desc">Özgüven sadece okuyarak değil, korkularınızın üstüne giderek gelişir. Özel olarak hazırladığımız simülasyonlarla iç sesinizi susturmayı, reddedilme korkunuzu yenmeyi, sosyal statünüzü korumayı ve auranızı yönetmeyi interaktif olarak deneyimleyin.</p>
    <div class="lab-buttons">
      <a href="/ozguven/golge-boksu" class="btn-lab golge">🥊 Gölge Boksu (İç Ses)</a>
      <a href="/ozguven/reddedilme" class="btn-lab red">💔 Reddedilme Terapisi</a>
      <a href="/ozguven/statu" class="btn-lab statu">👑 Statü Arenası</a>
      <a href="/ozguven/aura" class="btn-lab aura">✨ Aura Mimarı (İlk İzlenim)</a>
    </div>
  </div>

  <!-- NAV -->
  <nav class="oz-nav">
    <a href="/ozguven" class="oz-nav-item active">Tüm Modüller</a>
    <a href="/ozguven/mükemmel" class="oz-nav-item">Mükemmeliyetçilik</a>
    <a href="/ozguven/sessizlik" class="oz-nav-item">Sessizliğin Gücü</a>
    <a href="/ozguven/kıyas" class="oz-nav-item">Kıyas Zehri</a>
  </nav>

  <!-- MODULES GRID -->
  <section class="oz-section" id="moduller">
    <div class="oz-section-header">
      <div class="oz-section-subtitle">Zihin Mühendisliği</div>
      <h2 class="oz-section-title">İçsel Sınırları Kırmak</h2>
    </div>

    <div class="oz-grid">
      <!-- 1 -->
      <a href="/ozguven/mükemmel" class="oz-card">
        <div class="oz-card-tag">Bölüm 01</div>
        <div class="oz-card-icon">🎯</div>
        <h3 class="oz-card-title">Mükemmeliyetçilik Tuzağı</h3>
        <p class="oz-card-desc">Mükemmel olmak zorunda hissi sizi felç mi ediyor? Hatalarla barışıp "yeterince iyi" kavramını içselleştirmenin ve harekete geçmenin pratik yolları.</p>
        <div class="oz-card-btn">Eğitimi İncele <span>→</span></div>
      </a>
      
      <!-- 2 -->
      <a href="/ozguven/sessizlik" class="oz-card">
        <div class="oz-card-tag">Bölüm 02</div>
        <div class="oz-card-icon">🤫</div>
        <h3 class="oz-card-title">Sessizliğin Gücü</h3>
        <p class="oz-card-desc">Sosyal ortamlarda konuşma baskısı hissetmeden rahat sessizliği kullanmak. Sessizliği bir zayıflık olarak değil, bir karizma silahı olarak konumlandırın.</p>
        <div class="oz-card-btn">Eğitimi İncele <span>→</span></div>
      </a>

      <!-- 3 -->
      <a href="/ozguven/kıyas" class="oz-card">
        <div class="oz-card-tag">Bölüm 03</div>
        <div class="oz-card-icon">⚖️</div>
        <h3 class="oz-card-title">Başkalarıyla Kıyas</h3>
        <p class="oz-card-desc">Sosyal medya çağında sürekli kıyaslanma psikolojisinden çıkış formülü. Dış gürültüyü kapatarak tamamen kendi eşsiz potansiyelinize odaklanma teknikleri.</p>
        <div class="oz-card-btn">Eğitimi İncele <span>→</span></div>
      </a>
    </div>
  </section>

  <!-- ARTICLE -->
  <section class="oz-article">
    <div class="oz-article-content">
      <h2 class="oz-article-title">Özgüven Neden Geliştirilebilir Bir Kas Gibidir?</h2>
      <p class="oz-article-text">Araştırmalar, özgüvenin doğuştan gelen değiştirilemez bir kader değil; büyük ölçüde <strong>deneyim, pratik ve mental yeniden yapılandırma (re-framing)</strong> ile geliştirilebilen dinamik bir yapı olduğunu göstermektedir.</p>
      <p class="oz-article-text">Beynin nöroplastisite özelliği sayesinde, yeni ve güçlü davranış kalıplarını tutarlı bir şekilde tekrarlayarak sinir yollarımızı yeniden inşa edebiliriz. Örneğin, Harvard Profesörü Amy Cuddy'nin klinik çalışmalarına göre; sadece iki dakika boyunca "güç pozisyonunda" (power pose) durmak, vücuttaki testosteron (özgüven hormonu) seviyesini %20 artırırken, kortizol (stres hormonu) seviyesini %25 oranında düşürmektedir.</p>
      
      <div class="oz-quote-box">
        <div class="oz-quote">"Gerçek özgüven, her şeyi kusursuz yapacağınızı garanti etmek değil; her şey yanlış gitse bile o krizle zarafetle başa çıkabileceğinize olan o derin ve sarsılmaz inançtır."</div>
        <div class="oz-quote-author">Eleanor Roosevelt</div>
      </div>
    </div>
  </section>

</div>

<%- include('partials/main-footer') %>