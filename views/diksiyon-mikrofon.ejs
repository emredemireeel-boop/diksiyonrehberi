<%- include('partials/main-header') %>

<style>
  /* 🎙️ Microphone & Recording Light Theme 🎙️ */
  body { background: #fef2f2; color: #450a0a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🎙️ Hero Section 🎙️ */
  .mk-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #fee2e2 0%, #fef2f2 80%);
  }
  .mk-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fef2f2,transparent); }

  /* Studio Background */
  .mk-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; }
  .sound-wave { position: absolute; bottom: 0; left: 0; width: 100vw; height: 100px; display: flex; align-items: flex-end; justify-content: center; gap: 4px; opacity: 0.15; }
  .bar { width: 15px; background: #ef4444; border-radius: 10px 10px 0 0; animation: eqBounce 1s ease-in-out infinite alternate; }
  .bar:nth-child(even) { animation-delay: 0.2s; animation-duration: 0.8s; }
  .bar:nth-child(3n) { animation-delay: 0.4s; animation-duration: 1.2s; }
  @keyframes eqBounce { 0% { height: 10px; } 100% { height: 90px; } }

  .rec-dot { position: absolute; top: 40px; right: 40px; display: flex; align-items: center; gap: 10px; font-weight: 800; color: #ef4444; letter-spacing: 2px; }
  .dot { width: 16px; height: 16px; background: #ef4444; border-radius: 50%; animation: recBlink 1s infinite alternate; box-shadow: 0 0 10px rgba(239,68,68,0.6); }
  @keyframes recBlink { 0% { opacity: 0.3; } 100% { opacity: 1; } }

  .mk-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; filter: drop-shadow(0 15px 25px rgba(239,68,68,0.4)); }
  
  .mk-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #dc2626; background: #fca5a5; border:1px solid #f87171; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(239,68,68,0.15); }
  .mk-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #450a0a; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .mk-title span { background: linear-gradient(135deg, #ef4444, #b91c1c); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .mk-subtitle { color: #7f1d1d; font-size:1.2rem; max-width:750px; line-height:1.8; z-index:2; position:relative; font-weight: 500; }

  /* 🎙️ Container 🎙️ */
  .mk-wrap { max-width:1100px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 🎙️ Premium Cards 🎙️ */
  .mk-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .mk-card:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #dc2626; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* 🎙️ Proximity Effect Simulator 🎙️ */
  .prox-box { background: #111; border-radius: 24px; padding: 40px; color: white; display: grid; grid-template-columns: 1fr; gap: 30px; position: relative; border: 2px solid #333; }
  .prox-intro { font-size: 1.05rem; color: #a3a3a3; line-height: 1.6; }
  
  .prox-stage { position: relative; height: 120px; background: #222; border-radius: 16px; margin: 20px 0; display: flex; align-items: center; justify-content: space-between; padding: 0 40px; }
  .mouth { font-size: 3rem; transform: scaleX(-1); }
  .mic { font-size: 3rem; transition: transform 0.2s; position: absolute; right: 40px; }
  
  .slider-container { margin-bottom: 20px; }
  .dist-slider { width: 100%; appearance: none; height: 12px; background: #444; border-radius: 10px; outline: none; }
  .dist-slider::-webkit-slider-thumb { appearance: none; width: 24px; height: 24px; background: #ef4444; border-radius: 50%; cursor: pointer; border: 3px solid #fff; }
  
  .eq-display { display: flex; justify-content: space-between; align-items: flex-end; height: 60px; gap: 5px; margin-top: 20px; padding: 15px; background: #000; border-radius: 12px; }
  .eq-bar { width: 15%; background: #4ade80; border-radius: 4px 4px 0 0; transition: height 0.2s, background 0.2s; }
  .eq-label { display: flex; justify-content: space-between; color: #666; font-size: 0.8rem; font-weight: bold; margin-top: 5px; }

  .prox-result { padding: 20px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 12px; font-weight: bold; color: #fca5a5; font-size: 1.1rem; text-align: center; }

  /* 🎙️ Acoustic Room Editor 🎙️ */
  .room-box { background: #fff; border: 1px solid #fca5a5; border-radius: 24px; padding: 40px; display: grid; grid-template-columns: 1fr; gap: 30px; }
  .r-intro { color: #7f1d1d; font-size: 1.05rem; line-height: 1.6; }
  
  .room { background: #f8fafc; border: 4px solid #cbd5e1; height: 250px; border-radius: 12px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; box-shadow: inset 0 0 50px rgba(0,0,0,0.05); }
  .r-mic { font-size: 3rem; position: absolute; z-index: 10; }
  .sound-ring { position: absolute; border: 2px solid #ef4444; border-radius: 50%; animation: ringExpand 2s infinite; opacity: 0; }
  @keyframes ringExpand { 0% { width: 0; height: 0; opacity: 0.8; } 100% { width: 400px; height: 400px; opacity: 0; } }
  
  .panel { position: absolute; background: #334155; opacity: 0; transition: opacity 0.3s; }
  .p-left { top: 20%; left: 0; width: 20px; height: 60%; border-radius: 0 8px 8px 0; }
  .p-right { top: 20%; right: 0; width: 20px; height: 60%; border-radius: 8px 0 0 8px; }
  .p-back { top: 0; left: 20%; width: 60%; height: 20px; border-radius: 0 0 8px 8px; }
  .p-floor { bottom: 0; left: 10%; width: 80%; height: 15px; background: #8b5cf6; border-radius: 8px 8px 0 0; } /* Halı */

  .tools { display: flex; gap: 15px; flex-wrap: wrap; }
  .t-btn { flex: 1; padding: 15px; background: #fff; border: 2px solid #fecaca; border-radius: 12px; cursor: pointer; transition: all 0.2s; font-size: 1rem; font-weight: bold; color: #991b1b; text-align: center; }
  .t-btn:hover { background: #fee2e2; border-color: #ef4444; }
  .t-btn.active { background: #ef4444; color: white; border-color: #b91c1c; }

  .echo-meter { margin-top: 20px; }
  .meter-bar { height: 20px; background: #e2e8f0; border-radius: 10px; overflow: hidden; position: relative; }
  .meter-fill { height: 100%; background: #ef4444; width: 100%; transition: width 0.5s, background 0.5s; }
  .meter-label { margin-top: 8px; font-weight: 800; color: #ef4444; display: flex; justify-content: space-between; }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #fca5a5; color:#ef4444; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#fee2e2; color:#b91c1c; transform:translateX(-4px); border-color: #f87171; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<div class="rec-dot"><div class="dot"></div> REC</div>

<section class="mk-hero">
  <div class="mk-bg">
    <div class="sound-wave">
      <% for(let i=0; i<30; i++) { %><div class="bar"></div><% } %>
    </div>
  </div>
  <div class="mk-icon">🎙️</div>
  <div class="mk-badge">Ses Kayıt & Podcast Stüdyosu</div>
  <h1 class="mk-title">Mikrofon <span>Teknikleri</span></h1>
  <p class="mk-subtitle">En pahalı mikrofon bile yanlış açıyla kullanılırsa kötü ses verir. Dinamik mikrofonların sırrını (Proximity Effect) keşfedin ve ev odanızı akustik bir stüdyoya dönüştürün.</p>
</section>

<div class="mk-wrap">
  <a href="/diksiyon?cat=mikrofon" class="back-btn">← Tüm Kayıt Tekniklerini Gör (15 Madde)</a>

  <!-- 🎙️ PROXIMITY EFFECT SIMULATOR 🎙️ -->
  <div class="mk-card reveal" style="background:#111; border:none;">
    <div class="section-label" style="color:#f87171;">🎚️ Proximity Effect (Yakınlık Etkisi) Simülatörü</div>
    
    <div class="prox-box">
      <div class="prox-intro">
        Dinamik mikrofonların (radyo mikrofonları) en büyük sırrı <strong>"Yakınlık Etkisi"dir (Proximity Effect)</strong>. Mikrofona yaklaştıkça sesinizin bas (kalın) frekansları muazzam şekilde artar. Ancak çok yaklaşırsanız "P" ve "B" sesleri (Pop) patlamaya başlar.<br><br>
        <strong>Görevi:</strong> Kaydırıcıyı kullanarak mikrofon mesafesini ayarlayın. İdeal radyo (FM) sesini bulmaya çalışın.
      </div>
      
      <div class="prox-stage">
        <div class="mouth">👄</div>
        <div class="mic" id="pMic">🎤</div>
      </div>
      
      <div class="slider-container">
        <input type="range" min="0" max="100" value="100" class="dist-slider" id="pSlider" oninput="updateProx()">
        <div style="display:flex; justify-content:space-between; font-size:0.8rem; color:#888; margin-top:8px;">
          <span>Çok Yakın (0 cm)</span>
          <span>Orta (10 cm)</span>
          <span>Uzak (30 cm)</span>
        </div>
      </div>
      
      <div class="eq-display">
        <div class="eq-bar" id="eqBass" style="height:20%; background:#3b82f6;"></div>
        <div class="eq-bar" id="eqLowMid" style="height:40%; background:#22c55e;"></div>
        <div class="eq-bar" id="eqMid" style="height:60%; background:#22c55e;"></div>
        <div class="eq-bar" id="eqHighMid" style="height:50%; background:#22c55e;"></div>
        <div class="eq-bar" id="eqTreble" style="height:30%; background:#eab308;"></div>
        <div class="eq-bar" id="eqPop" style="height:10%; background:#ef4444;"></div>
      </div>
      <div class="eq-label">
        <span>BAS (Derinlik)</span>
        <span>ORTA (Netlik)</span>
        <span>TİZ</span>
        <span style="color:#ef4444;">PATLAMA (Pop)</span>
      </div>
      
      <div class="prox-result" id="pResult">Uzak Mesafe: Sesiniz zayıf, ince ve ortam yankısı alıyor.</div>
    </div>
  </div>

  <!-- 🎙️ ACOUSTIC ROOM EDITOR 🎙️ -->
  <div class="mk-card reveal">
    <div class="section-label">🧱 Podcast Odası Akustik Düzenleyici</div>
    
    <div class="room-box">
      <div class="r-intro">
        Odanızdaki çıplak duvarlar ses dalgalarını çarptırarak iğrenç bir "yankı" (Reverb/Echo) oluşturur. Hangi akustik düzenlemeleri yaparak bu yankıyı "Sıfır" noktasına getireceğinizi keşfedin.
      </div>
      
      <div class="room">
        <div class="p-left panel" id="pl"></div>
        <div class="p-right panel" id="pr"></div>
        <div class="p-back panel" id="pb"></div>
        <div class="p-floor panel" id="pf"></div>
        
        <div class="sound-ring" id="sr1"></div>
        <div class="sound-ring" id="sr2" style="animation-delay:0.5s"></div>
        <div class="sound-ring" id="sr3" style="animation-delay:1s"></div>
        
        <div class="r-mic">🗣️🎤</div>
      </div>
      
      <div class="tools">
        <div class="t-btn" onclick="toggleAcoustic('pl', this)">Sol Duvara Panel</div>
        <div class="t-btn" onclick="toggleAcoustic('pr', this)">Sağ Duvara Panel</div>
        <div class="t-btn" onclick="toggleAcoustic('pb', this)">Arka Duvara Sünger</div>
        <div class="t-btn" onclick="toggleAcoustic('pf', this)">Yere Kalın Halı</div>
      </div>
      
      <div class="echo-meter">
        <div class="meter-bar"><div class="meter-fill" id="echoFill"></div></div>
        <div class="meter-label">
          <span>Yankı (Reverb) Seviyesi</span>
          <span id="echoVal">100% (Çıplak Oda Yankısı)</span>
        </div>
      </div>
      
    </div>
  </div>

</div>

<script>
// 🎙️ Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🎙️ Proximity Logic
function updateProx() {
  const val = parseInt(document.getElementById('pSlider').value); // 0 (yakın) to 100 (uzak)
  const mic = document.getElementById('pMic');
  
  // Move mic visually (40px to 80%)
  const pos = 40 + (val * 0.6); // roughly %
  mic.style.right = pos + '%';
  
  // EQ Logic
  const eqBass = document.getElementById('eqBass');
  const eqMid = document.getElementById('eqMid');
  const eqPop = document.getElementById('eqPop');
  const res = document.getElementById('pResult');
  
  if (val > 70) {
    // Far
    eqBass.style.height = '20%'; eqBass.style.background = '#3b82f6';
    eqPop.style.height = '5%';
    res.innerHTML = "Uzak Mesafe: Sesiniz zayıf, ince ve ortam yankısı alıyor.";
    res.style.color = "#fca5a5"; res.style.borderColor = "rgba(239,68,68,0.3)";
  } else if (val >= 25 && val <= 70) {
    // Ideal (Sweet Spot)
    const bassLvl = 100 - val; // 30 to 75
    eqBass.style.height = bassLvl + '%'; eqBass.style.background = '#4ade80';
    eqPop.style.height = '15%';
    res.innerHTML = "🎧 İdeal 'Sweet Spot'! Sesin bas frekansları dolgun (FM Radyo tınısı) ve patlama yok.";
    res.style.color = "#4ade80"; res.style.borderColor = "#22c55e";
  } else {
    // Too close
    eqBass.style.height = '100%'; eqBass.style.background = '#eab308';
    eqPop.style.height = '100%';
    res.innerHTML = "⚠️ Çok Yakın! Yakınlık etkisi maksimumda ama 'P' ve 'B' sesleri patlıyor (Clipping).";
    res.style.color = "#eab308"; res.style.borderColor = "#ca8a04";
  }
}

// 🎙️ Acoustic Logic
let activePanels = 0;
function toggleAcoustic(id, btn) {
  const panel = document.getElementById(id);
  
  if(btn.classList.contains('active')) {
    btn.classList.remove('active');
    panel.style.opacity = '0';
    activePanels--;
  } else {
    btn.classList.add('active');
    panel.style.opacity = '1';
    activePanels++;
  }
  
  const fill = document.getElementById('echoFill');
  const val = document.getElementById('echoVal');
  const rings = document.querySelectorAll('.sound-ring');
  
  const echoLvl = 100 - (activePanels * 25);
  fill.style.width = echoLvl + '%';
  
  if(echoLvl === 100) {
    fill.style.background = '#ef4444'; val.style.color = '#ef4444';
    val.innerHTML = "100% (Banyo Yankısı - Kötü)";
    rings.forEach(r => r.style.animationDuration = '2s');
  } else if(echoLvl === 75 || echoLvl === 50) {
    fill.style.background = '#f59e0b'; val.style.color = '#f59e0b';
    val.innerHTML = `${echoLvl}% (Yankı Azalıyor)`;
    rings.forEach(r => r.style.animationDuration = '4s');
  } else if(echoLvl === 25) {
    fill.style.background = '#10b981'; val.style.color = '#10b981';
    val.innerHTML = "25% (Yeterli Stüdyo Akustiği)";
    rings.forEach(r => r.style.animationDuration = '8s');
  } else {
    fill.style.background = '#3b82f6'; val.style.color = '#3b82f6';
    val.innerHTML = "0% (Dead Room - Kusursuz Yalıtım!)";
    rings.forEach(r => { r.style.animationDuration = '0s'; r.style.opacity = '0'; });
  }
}
</script>

<%- include('partials/main-footer') %>
