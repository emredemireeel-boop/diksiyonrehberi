<%- include('partials/main-header') %>

<style>
  .error-page-wrapper {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 2rem;
    background-color: #0f172a;
    background-image: radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.15) 0%, transparent 60%);
  }
  
  .error-content {
    text-align: center;
    position: relative;
    z-index: 2;
    max-width: 600px;
    animation: fadeIn 0.8s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .error-glitch {
    font-size: 8rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #a78bfa, #c4b5fd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    display: inline-block;
    filter: drop-shadow(0 0 30px rgba(167, 139, 250, 0.4));
  }

  .error-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    display: inline-block;
    animation: float 3s ease-in-out infinite;
    filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));
  }
  
  @keyframes float {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-15px) rotate(-5deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }

  .error-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }
  
  .error-desc {
    font-size: 1.15rem;
    color: #cbd5e1;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-btn-primary {
    padding: 14px 32px;
    background: linear-gradient(135deg, var(--primary) 0%, #a78bfa 100%);
    color: #1e1b4b;
    font-weight: 700;
    border-radius: 50px;
    text-decoration: none;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.4);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .error-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px -5px rgba(139, 92, 246, 0.6);
  }

  .error-btn-secondary {
    padding: 14px 32px;
    background: rgba(255, 255, 255, 0.03);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(10px);
  }

  .error-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .quick-links {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .quick-links-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1.2rem;
    display: block;
    font-weight: 600;
  }

  .quick-links-row {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
  }

  .quick-link-item {
    color: #c4b5fd;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: rgba(139, 92, 246, 0.05);
    border-radius: 20px;
    border: 1px solid rgba(139, 92, 246, 0.1);
  }

  .quick-link-item:hover {
    color: #fff;
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-2px);
  }

  /* Decorative background circles */
  .bg-circle {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 1;
    opacity: 0.5;
  }
  .bg-circle-1 {
    width: 300px;
    height: 300px;
    background: rgba(139, 92, 246, 0.15);
    top: -100px;
    left: -100px;
  }
  .bg-circle-2 {
    width: 400px;
    height: 400px;
    background: rgba(79, 70, 229, 0.1);
    bottom: -150px;
    right: -100px;
  }
</style>

<div class="error-page-wrapper">
  <div class="bg-circle bg-circle-1"></div>
  <div class="bg-circle bg-circle-2"></div>
  
  <div class="error-content">
    <div class="error-icon">🔇</div>
    <div class="error-glitch">404</div>
    <h1 class="error-title">Ses Deneme Bir, İki, Üç...</h1>
    <p class="error-desc">
      Sanırım bu frekansta yayın yapmıyoruz. Aradığınız sayfa yayından kaldırılmış, adresi değişmiş veya hiç var olmamış olabilir.
    </p>
    
    <div class="error-actions">
      <a href="/" class="error-btn-primary">
        🏠 Ana Sayfaya Dön
      </a>
      <a href="javascript:history.back()" class="error-btn-secondary">
        ← Geri Git
      </a>
    </div>

    <div class="quick-links">
      <span class="quick-links-title">Popüler Frekanslar</span>
      <div class="quick-links-row">
        <a href="/diksiyon" class="quick-link-item">🎙️ Diksiyon Egzersizleri</a>
        <a href="/retorik" class="quick-link-item">🏛️ Retorik Eğitimi</a>
        <a href="/tekerlemeler/a" class="quick-link-item">🗣️ Tekerlemeler</a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/main-footer') %>
