<%- include('partials/main-header') %>

<style>
  body { background: #0a0a14; color: #f1f5f9; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ⚡Hero ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .r-hero {
    min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 110px 24px 60px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 80% 60% at 50% 30%, #ef444422, transparent 70%);
  }
  .r-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:120px; background:linear-gradient(to top,#0a0a14,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: rFloat 6s ease-in-out infinite; }
  @keyframes rFloat { 0%,100%{ transform:translateY(0) rotate(0deg); opacity:.3; } 50%{ transform:translateY(-40px) rotate(180deg); opacity:.8; } }

  .r-icon { font-size: 6rem; margin-bottom: 10px; animation: rPulse 2s ease-in-out infinite; filter: drop-shadow(0 0 40px #ef444466); }
  @keyframes rPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.08); } }

  .r-badge { display:inline-flex; align-items:center; gap:8px; padding:6px 20px; border-radius:30px; font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:3px; color:#ef4444; background:#ef444418; border:1px solid #ef444444; margin-bottom:16px; }
  .r-title { font-size:clamp(2.2rem,5vw,3.5rem); font-weight:900; color:#fff; margin-bottom:8px; line-height:1.1; }
  .r-title span { background: linear-gradient(135deg, #ef4444, #f97316); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .r-subtitle { color:#94a3b8; font-size:1.05rem; max-width:600px; line-height:1.7; }

  /* ⚡Container ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .r-wrap { max-width:960px; margin:0 auto; padding:0 20px 80px; }

  /* ⚡Glass Cards ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .glass { background:rgba(255,255,255,.03); backdrop-filter:blur(16px); border:1px solid rgba(255,255,255,.06); border-radius:20px; padding:32px; margin-bottom:32px; transition:transform .35s,box-shadow .35s; }
  .glass:hover { transform:translateY(-4px); box-shadow:0 20px 60px rgba(0,0,0,.3),0 0 30px #ef444411; }
  .section-label { font-size:.75rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color:#ef4444; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
  .section-label::before { content:''; width:16px; height:2px; background:#ef4444; border-radius:2px; }

  /* ⚡Mouth Anatomy SVG ⚡⚡⚡⚡⚡⚡⚡*/
  .anatomy-wrap { display:flex; justify-content:center; margin:20px 0 30px; }
  .anatomy-svg { width:320px; height:240px; }
  .anatomy-label { fill:#94a3b8; font-size:11px; font-weight:600; }
  .tongue-r { fill:#ef4444; transition: all .6s ease; }
  .tongue-r.active { fill:#f97316; filter: drop-shadow(0 0 8px #f97316); }
  .palate { fill:#1e293b; stroke:#334155; stroke-width:1.5; }
  .teeth { fill:#e2e8f0; }
  .lip { fill:#94a3b8; }
  .air-arrow { stroke:#ef4444; stroke-width:2; fill:none; stroke-dasharray:6,4; animation:airFlow 1.5s linear infinite; }
  @keyframes airFlow { to { stroke-dashoffset: -20; } }

  /* ⚡4 Stage Practice ⚡⚡⚡⚡⚡⚡⚡*/
  .stages { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:12px; margin:20px 0; }
  /* Responsive grid handles its own wrapping, no need for media queries here */
  .stage-card { padding:20px; border-radius:16px; text-align:center; cursor:pointer; border:2px solid rgba(255,255,255,.06); background:rgba(255,255,255,.03); transition:all .3s; position:relative; overflow:hidden; }
  .stage-card::before { content:''; position:absolute; inset:0; background:linear-gradient(135deg,#ef444411,transparent); opacity:0; transition:opacity .3s; }
  .stage-card:hover::before, .stage-card.active::before { opacity:1; }
  .stage-card.active { border-color:#ef4444; box-shadow:0 0 20px #ef444422; }
  .stage-card.completed { border-color:#10b981; }
  .stage-card.completed::after { content:'✅'; position:absolute; top:8px; right:10px; color:#10b981; font-weight:900; font-size:1.2rem; }
  .stage-num { font-size:1.8rem; font-weight:900; color:#ef4444; margin-bottom:6px; }
  .stage-sound { font-size:1.4rem; font-weight:700; color:#fff; margin-bottom:4px; letter-spacing:3px; }
  .stage-desc { font-size:.78rem; color:#64748b; }

  /* ⚡Practice Arena ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .practice-arena { background:linear-gradient(135deg,#1a0a0a,#0f172a); border:2px solid #ef444433; border-radius:24px; padding:40px; text-align:center; margin:20px 0; position:relative; overflow:hidden; }
  .practice-arena::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at 50% 50%,#ef444408,transparent 60%); pointer-events: none; }
  .practice-word { font-size:3.5rem; font-weight:900; color:#fff; margin:20px 0; letter-spacing:6px; position:relative; z-index:1; }
  .practice-word .r-highlight { color:#ef4444; text-shadow:0 0 20px #ef444466; font-size:4rem; }
  .practice-hint { color:#64748b; font-size:.9rem; margin-bottom:20px; }
  .practice-btn { display:inline-flex; align-items:center; gap:10px; padding:14px 36px; border-radius:14px; background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; font-size:1rem; font-weight:700; border:none; cursor:pointer; transition:all .3s; box-shadow:0 4px 20px #ef444444; }
  .practice-btn:hover { transform:translateY(-2px); box-shadow:0 8px 30px #ef444466; }
  .practice-btn:active { transform:scale(.97); }

  /* ⚡Speed Chrono ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .chrono-display { font-size:4rem; font-weight:900; font-variant-numeric:tabular-nums; color:#fff; margin:16px 0; }
  .chrono-display .ms { font-size:2rem; color:#64748b; }
  .chrono-controls { display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
  .chrono-btn { padding:12px 28px; border-radius:12px; font-size:.9rem; font-weight:700; border:none; cursor:pointer; transition:all .3s; }
  .chrono-start { background:linear-gradient(135deg,#10b981,#059669); color:#fff; box-shadow:0 4px 16px #10b98144; }
  .chrono-stop { background:linear-gradient(135deg,#ef4444,#dc2626); color:#fff; box-shadow:0 4px 16px #ef444444; }
  .chrono-reset { background:rgba(255,255,255,.06); color:#94a3b8; border:1px solid rgba(255,255,255,.1); }
  .chrono-btn:hover { transform:translateY(-2px); }

  /* ⚡Word Marathon ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .word-grid { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; }
  .r-word { padding:10px 18px; border-radius:12px; background:rgba(239,68,68,.08); border:1px solid #ef444433; color:#fca5a5; font-size:.95rem; font-weight:600; cursor:pointer; transition:all .3s; position:relative; }
  .r-word:hover { background:#ef444422; transform:scale(1.05); box-shadow:0 0 16px #ef444422; }
  .r-word.spoken { background:#10b98118; border-color:#10b98144; color:#6ee7b7; }
  .r-word .r-char { color:#ef4444; font-weight:900; font-size:1.1em; }

  /* ⚡Tekerleme Arena ⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .teker-text { font-size:1.3rem; font-weight:600; color:#e2e8f0; line-height:2; text-align:center; padding:20px; border-radius:16px; background:rgba(255,255,255,.03); margin:16px 0; }
  .teker-text .r-mark { color:#ef4444; font-weight:900; text-decoration:underline; text-underline-offset:4px; }

  /* ⚡Progress Bar ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .progress-track { width:100%; height:12px; border-radius:20px; background:rgba(255,255,255,.06); overflow:hidden; margin:20px 0; }
  .progress-fill { height:100%; border-radius:20px; background:linear-gradient(90deg,#ef4444,#f97316); transition:width .6s ease; position:relative; }
  .progress-fill::after { content:''; position:absolute; right:0; top:0; bottom:0; width:30px; background:rgba(255,255,255,.4); filter:blur(4px); animation:shimmer 1.5s ease-in-out infinite; }
  @keyframes shimmer { 0%,100%{ opacity:.3; } 50%{ opacity:.8; } }
  .progress-label { display:flex; justify-content:space-between; color:#64748b; font-size:.8rem; font-weight:600; }

  /* ⚡Back Button ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); color:#94a3b8; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(255,255,255,.1); color:#fff; transform:translateX(-4px); }

  /* ⚡Scroll Reveal ⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡⚡*/
  .reveal { opacity:0; transform:translateY(30px); transition:all .6s cubic-bezier(.16,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<!-- "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"HERO "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"-->
<section class="r-hero">
  <div class="hero-particles">
    <% for(let i=0; i<24; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 3+Math.random()*6 %>px; height:<%= 3+Math.random()*6 %>px; background:#ef4444; animation-delay:<%= Math.random()*6 %>s; animation-duration:<%= 4+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="r-icon">🏎️</div>
  <div class="r-badge">🔬 Telaffuz Laboratuvarı</div>
  <h1 class="r-title"><span>R</span> Harfi Söyleyememe (Rotasizm) Çözüm Merkezi</h1>
  <p class="r-subtitle">Türkçe'nin en zorlu seslerinden biri olan R harfinin titreşimli telaffuzunu kusursuz hale getirin. Kademeli pratik sistemi ile dil ucunuzu eğitin.</p>
</section>

<div class="r-wrap">

  <a href="/" class="back-btn">Ana Sayfaya Dön</a>

  <!-- "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"DİL POZİSYONU ANATOMİSİ "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"-->
  <div class="glass reveal">
    <div class="section-label">👅 Dil Pozisyonu Anatomisi</div>
    <p style="color:#94a3b8; font-size:.95rem; line-height:1.7; margin-bottom:16px;">R sesi, dil ucunun üst ön dişlerin hemen arkasındaki <strong style="color:#ef4444">alveoler sırta</strong> hafifçe dokunup titreşmesiyle oluşur. Hava akımı dil ile damak arasından geçerken dili titreştirir.</p>

    <div class="anatomy-wrap">
      <svg class="anatomy-svg" viewBox="0 0 320 240">
        <!-- Mouth outline -->
        <ellipse cx="160" cy="130" rx="130" ry="100" fill="#1e293b" stroke="#334155" stroke-width="2"/>
        <!-- Palate -->
        <path class="palate" d="M60 90 Q160 30 260 90" fill="none" stroke="#475569" stroke-width="3"/>
        <!-- Alveolar ridge marker -->
        <circle cx="110" cy="78" r="8" fill="#ef4444" opacity="0.6">
          <animate attributeName="opacity" values="0.4;1;0.4" dur="2s" repeatCount="indefinite"/>
        </circle>
        <text🔍="60" y="68" class="anatomy-label" fill="#ef4444" font-weight="700">Alveoler Sırt</text>
        <!-- Tongue -->
        <path id="tongueR" class="tongue-r" d="M80 180 Q100 130 115 85 Q130 100 160 140 Q190 170 240 185 Q180 200 120 195 Z"/>
        <!-- Teeth top -->
        <rect class="teeth"🔍="68" y="82" width="14" height="12" rx="3"/>
        <rect class="teeth"🔍="238" y="82" width="14" height="12" rx="3"/>
        <!-- Air flow arrows -->
        <path class="air-arrow" d="M120 90 Q140 60 170 70 Q200 80 190 100"/>
        <path class="air-arrow" d="M115 95 Q130 50 165 55" style="animation-delay:.5s"/>
        <!-- Labels -->
        <text🔍="170" y="160" class="anatomy-label">Dil</text>
        <text🔍="145" y="50" class="anatomy-label" fill="#ef4444">Hava Akışı </text>
        <text🔍="210" y="100" class="anatomy-label">Damak</text>
        <!-- Vibration waves -->
        <circle cx="112" cy="82" r="14" fill="none" stroke="#ef4444" stroke-width="1" opacity="0.4">
          <animate attributeName="r" values="12;22;12" dur="1s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="1s" repeatCount="indefinite"/>
        </circle>
      </svg>
    </div>
    <p style="color:#64748b; font-size:.85rem; text-align:center;">️ Dil ucunun kırmızı noktaya (alveoler sırt) temas ettiğini gözlemleyin</p>
  </div>

  <!-- "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"4 AŞAMALI KADEMELİ PRATİK "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"-->
  <div class="glass reveal">
    <div class="section-label">📈 4 Aşamalı Kademeli Pratik</div>
    <p style="color:#94a3b8; font-size:.95rem; line-height:1.7; margin-bottom:20px;">Her aşamayı 5 kez tekrarlayarak ilerleyin. Bir aşamayı rahatça yapabildiğinizde bir sonrakine geçin.</p>

    <div class="stages">
      <div class="stage-card active" onclick="setStage(0)">
        <div class="stage-num">1</div>
        <div class="stage-sound">Drrr</div>
        <div class="stage-desc">Titreşim Başlatma</div>
      </div>
      <div class="stage-card" onclick="setStage(1)">
        <div class="stage-num">2</div>
        <div class="stage-sound">Trr</div>
        <div class="stage-desc">Kısaltma</div>
      </div>
      <div class="stage-card" onclick="setStage(2)">
        <div class="stage-num">3</div>
        <div class="stage-sound">Rr</div>
        <div class="stage-desc">Pürüzsüzleştirme</div>
      </div>
      <div class="stage-card" onclick="setStage(3)">
        <div class="stage-num">4</div>
        <div class="stage-sound">R</div>
        <div class="stage-desc">Kelime İçinde</div>
      </div>
    </div>

    <div class="practice-arena" id="practiceArena">
      <div class="practice-hint" id="practiceHint">Dil ucunuzu alveoler sırta koyun ve güçlü bir nefesle titretin</div>
      <div class="practice-word" id="practiceWord">D<span class="r-highlight">rrr</span></div>
      <div style="display:flex;gap:12px;justify-content:center;align-items:center;margin-top:16px;">
        <button class="practice-btn" id="repeatBtn" onclick="nextRepeat()">
          <span style="font-size:1.2rem;">🔁</span> Tekrarla (<span id="repeatCount">0</span>/5)
        </button>
        <button class="practice-btn" style="background:linear-gradient(135deg,#10b981,#059669); display:none;" id="nextStageBtn" onclick="completeStage()">
          <span style="font-size:1.2rem;"></span> Sonraki Aşama
        </button>
      </div>
    </div>

    <div class="progress-track">
      <div class="progress-fill" id="progressFill" style="width:0%"></div>
    </div>
    <div class="progress-label">
      <span>Başlangıç</span>
      <span id="progressText">%0 Tamamlandı</span>
      <span>Usta</span>
    </div>
  </div>

  <!-- "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"HIZ KRONOMETRESİ "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"-->
  <div class="glass reveal">
    <div class="section-label">⏱️ R Tekerleme Kronometresi</div>
    <p style="color:#94a3b8; font-size:.95rem; line-height:1.7; margin-bottom:16px;">Aşağıdaki R ağırlıklı tekerlemeyi mümkün olduğunca hızlı ve <strong style="color:#ef4444">hatasız</strong> okuyun:</p>

    <div class="teker-text" id="rTekerlemeText" style="min-height:100px;">
      Yükleniyor...
    </div>
    
    <div style="display:flex; justify-content:center; gap:12px; margin-bottom:16px;">
      <button class="back-btn" style="margin-bottom:0; padding:8px 16px; background:rgba(255,255,255,.08);" onclick="prevRTekerleme()">« nceki</button>
      <span style="color:#94a3b8; font-weight:600; align-self:center;" id="rTekerlemeCount">1 / 0</span>
      <button class="back-btn" style="margin-bottom:0; padding:8px 16px; background:rgba(255,255,255,.08);" onclick="nextRTekerleme()">Sonraki »</button>
    </div>

    <div style="text-align:center;">
      <div class="chrono-display"><span id="chronoMin">00</span>:<span id="chronoSec">00</span><span class="ms">.<span id="chronoMs">00</span></span></div>
      <div class="chrono-controls">
        <button class="chrono-btn chrono-start" id="chronoStartBtn" onclick="chronoStart()">Başlat</button>
        <button class="chrono-btn chrono-stop" id="chronoStopBtn" onclick="chronoStop()" style="display:none;">⏸ Durdur</button>
        <button class="chrono-btn chrono-reset" onclick="chronoReset()">Sıfırla</button>
      </div>
      <div id="chronoBest" style="margin-top:16px;color:#64748b;font-size:.85rem;"></div>
    </div>
  </div>

  <!-- "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"R KELİME MARATONU "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"-->
  <div class="glass reveal">
    <div class="section-label">🏃 R Kelime Maratonu</div>
    <p style="color:#94a3b8; font-size:.95rem; line-height:1.7; margin-bottom:20px;">Her kelimeye tıklayın, yüksek sesle söyleyin ve R harfini vurgulayın. Tamamladığınız kelimeler yeşile döner.</p>

    <div class="word-grid" id="wordGrid"></div>

    <div style="text-align:center; margin-top:20px;">
      <span id="wordProgress" style="color:#64748b; font-size:.9rem; font-weight:600;">0 / 0 kelime tamamlandı</span>
    </div>
  </div>

  <!-- "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"İPUCU "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"-->
  <div style="background:linear-gradient(135deg,rgba(251,191,36,.08),rgba(251,191,36,.02)); border:1px solid rgba(251,191,36,.25); border-radius:18px; padding:24px 28px; font-size:.95rem; color:#fbbf24; line-height:1.7; display:flex; align-items:flex-start; gap:14px; margin-bottom:32px;" class="reveal">
    <span style="font-size:1.5rem; flex-shrink:0;">💡</span>
    <span>R sesi çıkaramıyorsanız endişelenmeyin  bu Türkçe konuşanların en yaygın problemidir. Günde sadece 5 dakika pratikle 2-3 hafta içinde belirgin gelişim göreceksiniz. Asla zorlamayın, dilinizi dinleyin.</span>
  </div>

</div>

<script src="/tekerlemeler.js"></script>
<script>
// "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"4 Stage Practice "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"
const stageData = [
  { word: 'D<span class="r-highlight">rrr</span>', hint: 'Dil ucunuzu alveoler sırta koyun ve güçlü bir nefesle titretin' },
  { word: 'T<span class="r-highlight">rr</span>', hint: 'Titreşimi kısaltın  sadece 2-3 vuruş yeterli' },
  { word: '<span class="r-highlight">Rr</span>', hint: 'Başlangıç ünsüzünü kaldırın, doğrudan R ile başlayın' },
  { word: '<span class="r-highlight">R</span>üzgâ<span class="r-highlight">r</span>', hint: 'Artık R\'yi bir kelime içinde doğal şekilde söyleyin' }
];
let currentStage = 0, repeatCount = 0, completedStages = [];

function setStage(idx) {
  currentStage = idx;
  repeatCount = 0;
  document.getElementById('practiceWord').innerHTML = stageData[idx].word;
  document.getElementById('practiceHint').textContent = stageData[idx].hint;
  document.getElementById('repeatCount').textContent = '0';
  document.querySelectorAll('.stage-card').forEach((c,i) => {
    c.classList.remove('active');
    if(i === idx) c.classList.add('active');
  });
  updateProgress();
}

function nextRepeat() {
  repeatCount++;
  if(repeatCount > 5) repeatCount = 5;
  document.getElementById('repeatCount').textContent = repeatCount;
  if(repeatCount >= 5) document.getElementById('nextStageBtn').style.display = 'inline-flex';
  const btn = document.getElementById('repeatBtn');
  btn.style.transform = 'scale(0.95)';
  setTimeout(() => btn.style.transform = '', 150);
  updateProgress();
}

function completeStage() {
  if(!completedStages.includes(currentStage)) completedStages.push(currentStage);
  document.querySelectorAll('.stage-card')[currentStage].classList.add('completed');
  document.getElementById('nextStageBtn').style.display = 'none';
  if(currentStage < 3) setStage(currentStage + 1);
  updateProgress();
}

function updateProgress() {
  const base = completedStages.length * 25;
  const partial = (repeatCount / 5) * 25;
  const pct = Math.min(base + (completedStages.includes(currentStage) ? 0 : partial), 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressText').textContent = '%' + Math.round(pct) + ' Tamamlandı';
}

// "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"Chronometer "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"
let chronoInterval = null, chronoTime = 0, bestTime = Infinity;

function chronoStart() {
  if(chronoInterval) return;
  document.getElementById('chronoStartBtn').style.display = 'none';
  document.getElementById('chronoStopBtn').style.display = '';
  chronoInterval = setInterval(() => {
    chronoTime += 10;
    const mins = Math.floor(chronoTime / 60000);
    const secs = Math.floor((chronoTime % 60000) / 1000);
    const ms = Math.floor((chronoTime % 1000) / 10);
    document.getElementById('chronoMin').textContent = String(mins).padStart(2,'0');
    document.getElementById('chronoSec').textContent = String(secs).padStart(2,'0');
    document.getElementById('chronoMs').textContent = String(ms).padStart(2,'0');
  }, 10);
}

function chronoStop() {
  clearInterval(chronoInterval);
  chronoInterval = null;
  document.getElementById('chronoStartBtn').style.display = '';
  document.getElementById('chronoStopBtn').style.display = 'none';
  if(chronoTime > 0 && chronoTime < bestTime) {
    bestTime = chronoTime;
    const mins = Math.floor(bestTime / 60000);
    const secs = Math.floor((bestTime % 60000) / 1000);
    const ms = Math.floor((bestTime % 1000) / 10);
    document.getElementById('chronoBest').innerHTML = '🏆 En İyi Süre: <strong style="color:#f97316;">' + String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0') + '.' + String(ms).padStart(2,'0') + '</strong>';
  }
}

function chronoReset() {
  clearInterval(chronoInterval);
  chronoInterval = null;
  chronoTime = 0;
  document.getElementById('chronoMin').textContent = '00';
  document.getElementById('chronoSec').textContent = '00';
  document.getElementById('chronoMs').textContent = '00';
  document.getElementById('chronoStartBtn').style.display = '';
  document.getElementById('chronoStopBtn').style.display = 'none';
}

// "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"Word Marathon "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"
const rWords = [
  'Rüzgâr','Radar','Resim','Robot','Rahat','Rampa','Refah','Ritim','Rüya','Radyo',
  'Renk','Reçel','Rota','Rapor','Rehber','Rumuz','Rahmet','Resmi','Reform','Rotasyon',
  'Armut','Berber','Kartal','Dört','Kırmızı','Orman','Gurur','Zafer','Huzur','Şeker'
];

function renderWords() {
  const grid = document.getElementById('wordGrid');
  grid.innerHTML = '';
  rWords.forEach((w, i) => {
    const highlighted = w.replace(/[Rr]/g, m => '<span class="r-char">' + m + '</span>');
    const el = document.createElement('div');
    el.className = 'r-word';
    el.innerHTML = highlighted;
    el.onclick = () => {
      el.classList.toggle('spoken');
      updateWordProgress();
    };
    grid.appendChild(el);
  });
  updateWordProgress();
}

function updateWordProgress() {
  const total = rWords.length;
  const done = document.querySelectorAll('.r-word.spoken').length;
  document.getElementById('wordProgress').textContent = done + ' / ' + total + ' kelime tamamlandı';
}

renderWords();

// "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"Tekerleme Modül Entegrasyonu "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"
let rTekerlemeler = typeof TEKERLEMELER !== 'undefined' && TEKERLEMELER['R'] ? TEKERLEMELER['R'] : [
  "Ramazanda rızkını romatizmalı Ramiz'e rastgele rehin bırakan radyocu Rıdvan, ruhsarını rüyasında rubleyle renklendirdi.",
  "Bir berber bir berbere bre berber, gel beraber bir berber dükkânı açalım, demiş.",
  "Kar yağar kara karar dar karara kar yağar, kara karar kararda kar yağar."
];
let currentRTekerlemeIdx = 0;

function renderRTekerleme() {
  if (rTekerlemeler.length === 0) {
    document.getElementById('rTekerlemeText').textContent = "Tekerleme bulunamadı.";
    return;
  }
  let t = rTekerlemeler[currentRTekerlemeIdx];
  t = t.replace(/r/gi, match => `<span class="r-mark">${match}</span>`);
  document.getElementById('rTekerlemeText').innerHTML = t;
  document.getElementById('rTekerlemeCount').textContent = (currentRTekerlemeIdx + 1) + " / " + rTekerlemeler.length;
}

function prevRTekerleme() {
  currentRTekerlemeIdx--;
  if (currentRTekerlemeIdx < 0) currentRTekerlemeIdx = rTekerlemeler.length - 1;
  renderRTekerleme();
}

function nextRTekerleme() {
  currentRTekerlemeIdx++;
  if (currentRTekerlemeIdx >= rTekerlemeler.length) currentRTekerlemeIdx = 0;
  renderRTekerleme();
}

renderRTekerleme();

// "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"Scroll Reveal "⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"⚡"
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
</script>

