<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; }
  .aura-container { display: flex; flex-direction: column; md:flex-row; gap: 40px; padding: 40px 20px; max-width: 1200px; margin: 0 auto; min-height: 80vh; }
  
  .panel { flex: 1; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 30px; }

  /* Left Panel: Emotion Selector */
  .emotion-grid { display: grid; grid-template-columns: 1fr; gap: 15px; }
  .emotion-card { background: #1e293b; border: 2px solid #334155; padding: 20px; border-radius: 15px; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; gap: 15px; position: relative; overflow: hidden; }
  .emotion-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: transparent; transition: all 0.3s; }
  
  .emotion-card:hover { transform: translateX(10px); background: #334155; }
  
  .emotion-card.active { background: #0f172a; border-color: #38bdf8; box-shadow: 0 10px 30px rgba(56, 189, 248, 0.2); }
  .emotion-card.active::before { background: #38bdf8; }

  .emo-icon { font-size: 2.5rem; }
  .emo-text h3 { font-size: 1.2rem; font-weight: 800; margin: 0 0 5px 0; color: #e2e8f0; }
  .emo-text p { font-size: 0.85rem; color: #94a3b8; margin: 0; }

  /* Right Panel: Visualization */
  .visual-box { background: #1e293b; border-radius: 20px; padding: 40px; display: flex; flex-direction: column; align-items: center; border: 1px solid #334155; position: relative; }
  
  /* Aura Glow */
  .aura-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 300px; height: 300px; border-radius: 50%; filter: blur(60px); z-index: 0; opacity: 0.5; transition: background 1s ease-in-out; }

  .suit-container { width: 220px; height: 280px; position: relative; z-index: 10; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5)); transition: all 0.5s; }
  
  /* SVG Suit Elements */
  .v-suit { fill: #1e3a8a; transition: fill 0.8s ease-in-out; } /* Jacket */
  .v-shirt { fill: #ffffff; transition: fill 0.8s ease-in-out; }
  .v-tie { fill: #991b1b; transition: fill 0.8s ease-in-out; }

  /* Breakdown Text */
  .breakdown { margin-top: 40px; width: 100%; z-index: 10; }
  .bd-title { font-size: 1.2rem; font-weight: 800; color: #38bdf8; border-bottom: 2px solid #334155; padding-bottom: 10px; margin-bottom: 20px; }
  
  .bd-item { display: flex; align-items: flex-start; gap: 15px; margin-bottom: 20px; background: rgba(0,0,0,0.2); padding: 15px; border-radius: 12px; }
  .bd-color-box { width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.2); }
  .bd-text h4 { margin: 0 0 5px 0; font-size: 1rem; color: #e2e8f0; }
  .bd-text p { margin: 0; font-size: 0.85rem; color: #cbd5e1; line-height: 1.6; }

  @media (min-width: 1024px) {
    .aura-container { flex-direction: row; }
  }
</style>

<div class="aura-container">
  
  <!-- Left: Controls -->
  <div class="panel">
    <h1>Aura Tarayıcı</h1>
    <p class="desc">Renkler sadece görsel değildir, bilinçaltı frekanslarıdır. Bırakmak istediğiniz ilk izlenimi seçin, sistem psikolojik olarak kusursuz renk paletini çıkartsın.</p>

    <div class="emotion-grid">
      
      <div class="emotion-card active" onclick="selectAura('power')" id="card-power">
        <div class="emo-icon">♟️</div>
        <div class="emo-text">
          <h3>Otorite ve Güç</h3>
          <p>Liderlik, mesafe ve tartışmasız hakimiyet.</p>
        </div>
      </div>

      <div class="emotion-card" onclick="selectAura('trust')" id="card-trust">
        <div class="emo-icon">🤝</div>
        <div class="emo-text">
          <h3>Güven ve Samimiyet</h3>
          <p>İkna, ortaklık ve sağlamlık hissi.</p>
        </div>
      </div>

      <div class="emotion-card" onclick="selectAura('creative')" id="card-creative">
        <div class="emo-icon">💡</div>
        <div class="emo-text">
          <h3>Yaratıcılık ve Vizyon</h3>
          <p>Farklılık, dinamizm ve yenilikçilik.</p>
        </div>
      </div>

      <div class="emotion-card" onclick="selectAura('approachable')" id="card-approachable">
        <div class="emo-icon">☕</div>
        <div class="emo-text">
          <h3>Erişilebilirlik ve Sıcaklık</h3>
          <p>Dostane, açık ve tehditkar olmayan yaklaşım.</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Right: Visualizer -->
  <div class="panel">
    <div class="visual-box">
      
      <div class="aura-glow" id="auraGlow" style="background: #1e3a8a;"></div>

      <!-- Minimalist Suit SVG -->
      <div class="suit-container">
        <svg viewBox="0 0 200 250" xmlns="http://www.w3.org/2000/svg">
          <!-- Shirt -->
          <path class="v-shirt" id="svg-shirt" d="M 60,0 L 140,0 L 160,250 L 40,250 Z" />
          <!-- Jacket Left -->
          <path class="v-suit" id="svg-jacket" d="M 40,0 L 95,120 L 70,250 L 0,250 L 0,40 Z" />
          <!-- Jacket Right -->
          <path class="v-suit" id="svg-jacket2" d="M 160,0 L 105,120 L 130,250 L 200,250 L 200,40 Z" />
          <!-- Collar / Lapels -->
          <path class="v-suit" id="svg-lapel" d="M 40,0 L 90,80 L 100,20 L 110,80 L 160,0 Z" />
          <!-- Tie -->
          <path class="v-tie" id="svg-tie" d="M 90,20 L 110,20 L 105,180 L 100,195 L 95,180 Z" />
        </svg>
      </div>

      <div class="breakdown">
        <div class="bd-title" id="bdTitle">Otorite ve Güç Profili</div>
        <div id="bdItems">
          <!-- Populated by JS -->
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  const auraData = {
    power: {
      title: "Otorite ve Güç Profili (CEO / Mahkeme)",
      glow: "#1e3a8a",
      suit: "#0f172a", // Charcoal / Near Black
      shirt: "#ffffff", // Pure White
      tie: "#991b1b", // Deep Red (Power Tie)
      breakdown: [
        { name: "Takım: Antrasit / Siyah", hex: "#0f172a", desc: "Siyah ve koyu füme tonları bilinçaltında ciddiyet, mesafe ve 'ben buranın yöneticisiyim' mesajı verir." },
        { name: "Gömlek: Saf Beyaz", hex: "#ffffff", desc: "Beyaz gömlek, koyu takım ile yüksek kontrast (High Contrast) yaratarak keskinliği ve otoriteyi maksimize eder." },
        { name: "Kravat: Güç Kırmızısı", hex: "#991b1b", desc: "Kırmızı kravat (Power Tie), tehlike, uyanıklık ve hakimiyet rengidir. Karşı tarafa boyun eğdirme psikolojisi taşır." }
      ]
    },
    trust: {
      title: "Güven ve İkna Profili (Müşteri Toplantısı)",
      glow: "#1d4ed8",
      suit: "#1e3a8a", // Navy Blue
      shirt: "#eff6ff", // Light Blue
      tie: "#0369a1", // Mid Blue / Navy Pattern
      breakdown: [
        { name: "Takım: Lacivert", hex: "#1e3a8a", desc: "Lacivert (Navy), dünyada güven, sadakat ve dürüstlük hissi veren en güçlü renktir (Bu yüzden üniformalar laciverttir)." },
        { name: "Gömlek: Açık Mavi", hex: "#eff6ff", desc: "Beyazın agresif kontrastı yerine, mavi gömlek sakinlik ve dinginlik vererek karşı tarafın savunmasını indirir." },
        { name: "Kravat: Mavi Tonları", hex: "#0369a1", desc: "Monokrom (tek renk ailesi) giyinmek zihni yormaz ve istikrarlı, sağlam bir karakter imajı çizer." }
      ]
    },
    creative: {
      title: "Yaratıcılık Profili (Ajans / Sunum)",
      glow: "#8b5cf6",
      suit: "#475569", // Slate Gray
      shirt: "#000000", // Black Turtleneck or Shirt
      tie: "transparent", // No Tie
      breakdown: [
        { name: "Ceket: Slate Gri", hex: "#475569", desc: "Klasik kurumsal kodlardan sıyrılmış, daha modern ve esnek bir zihin yapısını temsil eder." },
        { name: "Gömlek/Kazak: Siyah", hex: "#000000", desc: "Steve Jobs etkisi. Siyah boğazlı kazak veya gömlek, dikkati kıyafetten ziyade kişinin yüzüne (fikirlerine) çeker." },
        { name: "Kravat: Yok", hex: "transparent", desc: "Yaratıcı sektörlerde kravat, zihnin 'kurallarla bağlandığı' algısı yaratır. Açık yaka özgürlüğü temsil eder." }
      ]
    },
    approachable: {
      title: "Erişilebilirlik Profili (Takım İçi / Mentor)",
      glow: "#d97706",
      suit: "#78350f", // Brown / Earthy
      shirt: "#fffbeb", // Off-white / Cream
      tie: "#4d7c0f", // Olive / Earth tone
      breakdown: [
        { name: "Ceket: Toprak Tonları / Kahve", hex: "#78350f", desc: "Toprak tonları (kahve, bej), doğayı hatırlatır ve insan beyninde sıcaklık, güven ve tehditsizlik algısı yaratır." },
        { name: "Gömlek: Kırık Beyaz", hex: "#fffbeb", desc: "Saf beyazın keskin otoritesini kırar, daha yumuşak ve göz yormayan bir iletişim zemini hazırlar." },
        { name: "Kravat: Zeytin Yeşili / Triko", hex: "#4d7c0f", desc: "Doğal renkler ve mat (örgü) dokular, kişinin statü peşinde koşmadığını, empatiye açık olduğunu fısıldar." }
      ]
    }
  };

  function selectAura(key) {
    // UI Classes
    document.querySelectorAll('.emotion-card').forEach(c => c.classList.remove('active'));
    document.getElementById('card-' + key).classList.add('active');

    const data = auraData[key];

    // SVG Colors
    const elsJacket = document.querySelectorAll('.v-suit');
    elsJacket.forEach(e => e.style.fill = data.suit);
    document.getElementById('svg-shirt').style.fill = data.shirt;
    document.getElementById('svg-tie').style.fill = data.tie;
    
    // Glow
    document.getElementById('auraGlow').style.background = data.glow;
    document.getElementById('bdTitle').style.color = data.glow;
    document.getElementById('bdTitle').textContent = data.title;

    // Breakdown Text
    const bdCont = document.getElementById('bdItems');
    bdCont.innerHTML = '';
    data.breakdown.forEach(b => {
      bdCont.innerHTML += `
        <div class="bd-item">
          <div class="bd-color-box" style="background: ${b.hex}; border-color: ${b.hex === 'transparent' ? '#334155' : 'transparent'}"></div>
          <div class="bd-text">
            <h4>${b.name}</h4>
            <p>${b.desc}</p>
          </div>
        </div>
      `;
    });
  }

  // Initialize Default
  selectAura('power');

</script>

<%- include('partials/main-footer') %>
