<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; overflow-x: hidden; }
  .radar-container { padding: 40px 20px; max-width: 600px; margin: 0 auto; min-height: 85vh; display: flex; flex-direction: column; align-items: center; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #f43f5e; text-transform: uppercase; letter-spacing: 2px; text-align: center; text-shadow: 0 0 10px rgba(244, 63, 94, 0.4); }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 30px; text-align: center; }

  /* App Phone Frame */
  .phone-frame { width: 100%; max-width: 400px; background: #1e293b; border: 10px solid #000; border-radius: 40px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.6); display: flex; flex-direction: column; position: relative; height: 650px; }
  
  .notch { width: 150px; height: 25px; background: #000; border-bottom-left-radius: 15px; border-bottom-right-radius: 15px; position: absolute; top: 0; left: 50%; transform: translateX(-50%); z-index: 10; }

  /* Top Bar */
  .top-bar { padding: 35px 20px 15px; display: flex; justify-content: space-between; align-items: center; color: #f43f5e; font-weight: 900; font-size: 1.2rem; border-bottom: 1px solid #334155; }
  
  /* Card Area */
  .card-area { flex: 1; padding: 20px; display: flex; flex-direction: column; align-items: center; position: relative; }
  
  .dating-card { background: linear-gradient(to bottom, #334155, #0f172a); width: 100%; height: 100%; border-radius: 20px; position: absolute; top: 20px; left: 0; right: 0; margin: auto; max-width: calc(100% - 40px); box-shadow: 0 10px 20px rgba(0,0,0,0.5); display: flex; flex-direction: column; padding: 20px; transition: transform 0.4s, opacity 0.4s; }
  .dating-card.swipe-left { transform: translateX(-150%) rotate(-15deg); opacity: 0; }
  .dating-card.swipe-right { transform: translateX(150%) rotate(15deg); opacity: 0; }
  
  .dc-avatar { font-size: 6rem; text-align: center; margin-bottom: 10px; filter: drop-shadow(0 10px 10px rgba(0,0,0,0.3)); }
  .dc-name { font-size: 1.8rem; font-weight: 800; color: #fff; margin-bottom: 5px; text-align: center; }
  .dc-scenario { font-size: 0.9rem; color: #facc15; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; text-align: center; margin-bottom: 20px; }
  
  .signals { flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .signal { background: rgba(255,255,255,0.05); border-left: 3px solid #f43f5e; padding: 12px; border-radius: 8px; font-size: 0.95rem; color: #e2e8f0; display: flex; gap: 10px; }
  
  /* Swipe Controls */
  .controls { padding: 20px; display: flex; justify-content: center; gap: 30px; position: relative; z-index: 5; background: #1e293b; }
  .btn-swipe { width: 70px; height: 70px; border-radius: 50%; border: none; font-size: 2rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
  .btn-nope { background: #0f172a; color: #f43f5e; border: 2px solid #f43f5e; }
  .btn-nope:hover { background: #f43f5e; color: #fff; transform: scale(1.1); }
  .btn-like { background: #0f172a; color: #10b981; border: 2px solid #10b981; }
  .btn-like:hover { background: #10b981; color: #fff; transform: scale(1.1); }

  /* Overlay Result */
  .result-overlay { position: absolute; inset: 0; background: rgba(15, 23, 42, 0.95); z-index: 100; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center; }
  .ro-icon { font-size: 4rem; margin-bottom: 15px; }
  .ro-title { font-size: 2rem; font-weight: 900; margin-bottom: 10px; text-transform: uppercase; }
  .ro-desc { font-size: 1rem; color: #cbd5e1; line-height: 1.5; margin-bottom: 25px; }
  .ro-btn { background: #f43f5e; color: #fff; border: none; padding: 12px 25px; border-radius: 30px; font-weight: 800; font-size: 1rem; cursor: pointer; text-transform: uppercase; }

  .game-over { display: none; text-align: center; padding: 50px; }
</style>

<div class="radar-container">
  <h1>Çekim Radarı</h1>
  <p class="desc">Flörtlerinizi veya partner adaylarınızı vücut dillerinden analiz edin. Gerçekten ilgileniyorlar mı, yoksa sadece nezaketten mi ordalar? Sağa (İLGİLİ) veya Sola (İLGİSİZ) kaydırın.</p>

  <div class="phone-frame" id="phone">
    <div class="notch"></div>
    <div class="top-bar">
      <span>Radar</span>
      <span>🔥</span>
    </div>

    <div class="card-area" id="cardArea">
      <!-- Injected Card -->
    </div>

    <div class="controls" id="controls">
      <button class="btn-swipe btn-nope" onclick="swipe('left')">❌</button>
      <button class="btn-swipe btn-like" onclick="swipe('right')">💚</button>
    </div>

    <div class="result-overlay" id="resOverlay">
      <div class="ro-icon" id="roIcon">✅</div>
      <div class="ro-title" id="roTitle">DOĞRU OKUMA!</div>
      <div class="ro-desc" id="roDesc">...</div>
      <button class="ro-btn" onclick="nextCard()">Sıradaki Kişi</button>
    </div>

  </div>

  <div class="game-over" id="gameOver">
    <div style="font-size: 5rem; margin-bottom:20px;">💘</div>
    <h2 style="font-size:2.5rem; color:#f43f5e; margin:0 0 15px 0;">Flört Ustası</h2>
    <p style="color:#94a3b8; font-size:1.1rem; margin-bottom:30px;">Kelimelerin arkasındaki gerçek çekimi ve ilgisizliği okuma sanatında uzmanlaştınız!</p>
    <a href="/bedendili" style="background:#f43f5e; color:#fff; padding:15px 30px; border-radius:30px; text-decoration:none; font-weight:800;">Akademiye Dön</a>
  </div>

</div>

<script>
  const profiles = [
    {
      name: "Buluşma #1",
      avatar: "👩",
      scenario: "Kahve İçiyorsunuz",
      signals: [
        "Sizinle konuşurken saçlarıyla / boynuyla oynuyor.",
        "Kahve fincanını ikinizin arasına (bariyer) koymak yerine kenara itti.",
        "Ayakuçları doğrudan size bakıyor."
      ],
      isInterested: true, // Right swipe
      successMsg: "Harika! Saçla oynamak (preening), engelleri kaldırmak ve ayakuçlarının hedefi göstermesi, biyolojik olarak çok net 'Çekim ve İlgi' (Attraction) sinyalleridir.",
      failMsg: "Yanlış! Bu kişi size karşı oldukça ilgiliydi. Açık beden dili sinyallerini kaçırdınız."
    },
    {
      name: "Buluşma #2",
      avatar: "👨",
      scenario: "Akşam Yemeği",
      signals: [
        "Gövdesi size değil, çıkış kapısına doğru hafifçe dönük.",
        "Sürekli boğazını temizliyor ve ensesini kaşıyor.",
        "Gülümserken sadece dudakları kıvrılıyor (gözleri düz)."
      ],
      isInterested: false, // Left swipe
      successMsg: "Doğru tespit! Gövdenin/ayakların çıkışı göstermesi 'kaçma arzusu'dur. Ense kaşımak stresi (yatıştırıcı jest) ve sahte gülümseme nezaketen orada olduğunu gösterir.",
      failMsg: "Yanlış! O kişi sizinle ilgilenmiyordu, sadece nezaketen vakit geçiriyordu. Kapıya dönük gövde en net 'sıkılma' sinyalidir."
    },
    {
      name: "Buluşma #3",
      avatar: "👩‍🦰",
      scenario: "Barda Yan Yana",
      signals: [
        "Siz güldüğünüzde o da eş zamanlı gülüyor (Aynalama).",
        "Göz bebekleri ortamın ışığına göre oldukça büyümüş (Dilatasyon).",
        "Konuşurken kafasını hafifçe yana yatırıp (boynunu açarak) sizi dinliyor."
      ],
      isInterested: true,
      successMsg: "Mükemmel! Göz bebeklerinin büyümesi kontrol edilemeyen biyolojik bir uyarılma (ilgi) refleksidir. Aynalama ve boyun açmak (savunmasızlık) yüksek çekimi gösterir.",
      failMsg: "Yanlış okuma! Bu kişi kelimenin tam anlamıyla sizden büyülenmişti. Göz bebeği büyümesi en net biyolojik çekim kanıtıdır."
    },
    {
      name: "Buluşma #4",
      avatar: "🧔",
      scenario: "İş Çıkışı Yürüyüş",
      signals: [
        "Konuşurken kollarını göğsünde çapraz bağladı.",
        "Size bakarken çenesini hafifçe yukarı/geriye kaldırıyor.",
        "Sohbet esnasında sizinle arasına hep en az 1 metre fiziksel mesafe koyuyor."
      ],
      isInterested: false,
      successMsg: "Kesinlikle ilgisiz! Kapanmış kollar (savunma), geriye/yukarı kalkan çene (üstünlük/uzaklaşma) ve fiziksel mesafeyi koruma çabası aranızda bir duvar olduğunu gösterir.",
      failMsg: "Yanlış! Bu kişinin beden dili 'Benim alanıma girme ve bana yaklaşma' diye bağırıyordu."
    }
  ];

  let currIndex = 0;

  function loadCard() {
    if(currIndex >= profiles.length) {
      document.getElementById('phone').style.display = 'none';
      document.getElementById('gameOver').style.display = 'block';
      return;
    }

    const p = profiles[currIndex];
    const area = document.getElementById('cardArea');
    
    let html = `
      <div class="dating-card" id="activeCard">
        <div class="dc-avatar">${p.avatar}</div>
        <div class="dc-name">${p.name}</div>
        <div class="dc-scenario">${p.scenario}</div>
        <div class="signals">
    `;
    
    p.signals.forEach((sig, i) => {
      html += `<div class="signal"><span>${i+1}.</span> <span>${sig}</span></div>`;
    });

    html += `</div></div>`;
    area.innerHTML = html;
  }

  function swipe(dir) {
    const card = document.getElementById('activeCard');
    const p = profiles[currIndex];
    
    // User choice: right = interested, left = not interested
    const userChoice = (dir === 'right'); 
    const isCorrect = (userChoice === p.isInterested);

    if(dir === 'right') {
      card.classList.add('swipe-right');
    } else {
      card.classList.add('swipe-left');
    }

    // Show overlay after animation
    setTimeout(() => {
      showResult(isCorrect, p);
    }, 400);
  }

  function showResult(isCorrect, profile) {
    const overlay = document.getElementById('resOverlay');
    const rIcon = document.getElementById('roIcon');
    const rTitle = document.getElementById('roTitle');
    const rDesc = document.getElementById('roDesc');

    overlay.style.display = 'flex';

    if(isCorrect) {
      rIcon.textContent = '🔥';
      rIcon.style.color = '#10b981';
      rTitle.textContent = "DOĞRU OKUMA!";
      rTitle.style.color = '#10b981';
      rDesc.textContent = profile.successMsg;
    } else {
      rIcon.textContent = '💔';
      rIcon.style.color = '#f43f5e';
      rTitle.textContent = "YANLIŞ OKUMA!";
      rTitle.style.color = '#f43f5e';
      rDesc.textContent = profile.failMsg;
    }
  }

  function nextCard() {
    document.getElementById('resOverlay').style.display = 'none';
    currIndex++;
    loadCard();
  }

  // Init
  loadCard();

</script>

<%- include('partials/main-footer') %>
