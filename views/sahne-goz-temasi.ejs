<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #ffffff; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .z-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; position: relative; }
  
  .instruction-panel { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 40px; z-index: 10; backdrop-filter: blur(10px); }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #cbd5e1; margin: 0; max-width: 600px; line-height: 1.5; }

  /* AUDIENCE GRID */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 30px;
    width: 100%;
    max-width: 1000px;
    flex-grow: 1;
    margin-bottom: 40px;
  }

  .zone {
    background: rgba(255,255,255,0.02);
    border: 2px dashed rgba(255,255,255,0.1);
    border-radius: 20px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    transition: all 0.3s;
    position: relative;
  }
  
  .zone-label { color: rgba(255,255,255,0.2); font-weight: 800; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 2px; }
  .zone-icon { font-size: 3rem; opacity: 0.1; margin-bottom: 10px; }

  /* ACTIVE STATE */
  .zone.active {
    background: rgba(14, 165, 233, 0.15);
    border: 2px solid #0ea5e9;
    box-shadow: 0 0 40px rgba(14, 165, 233, 0.3);
    transform: scale(1.05);
  }
  .zone.active .zone-label { color: #38bdf8; }
  .zone.active .zone-icon { opacity: 1; color: #38bdf8; text-shadow: 0 0 20px rgba(56, 189, 248, 0.5); }

  .controls { display: flex; gap: 20px; }
  .btn-control {
    background: #0ea5e9; color: #ffffff; border: none; padding: 16px 40px; border-radius: 30px;
    font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 10px 20px rgba(14,165,233,0.3);
  }
  .btn-control:hover { background: #0284c7; transform: translateY(-2px); }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(255,255,255,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #ffffff; }

</style>

<a href="/sahne" class="btn-back">← Sahne'ye Dön</a>

<div class="z-container">
  
  <div class="instruction-panel">
    <h1 class="instruction-title">Z Kuralı Göz Teması</h1>
    <p class="instruction-desc">Bir konuşma yaparken sabit bir noktaya bakmak seyirciyi dışlar. "Başla" butonuna bastığınızda, sistem "Z" kuralına göre rastgele bir seyirci bölgesini işaret edecektir. Gözlerinizi o bölgeye çevirin ve kameraya/ekrana değil, o açıyla ufka bakın.</p>
  </div>

  <div class="audience-grid" id="grid">
    <div class="zone" id="z-0"><div class="zone-icon">👤</div><div class="zone-label">Sol Arka</div></div>
    <div class="zone" id="z-1"><div class="zone-icon">👤</div><div class="zone-label">Orta Arka</div></div>
    <div class="zone" id="z-2"><div class="zone-icon">👤</div><div class="zone-label">Sağ Arka</div></div>
    
    <div class="zone" id="z-3"><div class="zone-icon">👤</div><div class="zone-label">Sol Ön</div></div>
    <div class="zone" id="z-4"><div class="zone-icon">👤</div><div class="zone-label">Orta Ön (Odak)</div></div>
    <div class="zone" id="z-5"><div class="zone-icon">👤</div><div class="zone-label">Sağ Ön</div></div>
  </div>

  <div class="controls">
    <button class="btn-control" id="btnStart" onclick="toggleSim()">Simülatörü Başlat</button>
  </div>

</div>

<script>
  let isRunning = false;
  let intervalId = null;
  let currentZone = -1;
  const btnStart = document.getElementById('btnStart');

  // Z-pattern array (Left Back -> Right Back -> Left Front -> Right Front, with Center variations)
  // We'll just pick randomly but avoid picking the same twice in a row.
  
  function highlightZone() {
    // clear old
    if (currentZone !== -1) {
      document.getElementById(`z-${currentZone}`).classList.remove('active');
    }
    
    // pick new (not same)
    let newZone;
    do {
      newZone = Math.floor(Math.random() * 6);
    } while (newZone === currentZone);
    
    currentZone = newZone;
    document.getElementById(`z-${currentZone}`).classList.add('active');
  }

  function toggleSim() {
    if (isRunning) {
      // Stop
      clearInterval(intervalId);
      if (currentZone !== -1) document.getElementById(`z-${currentZone}`).classList.remove('active');
      currentZone = -1;
      isRunning = false;
      btnStart.textContent = 'Simülatörü Başlat';
      btnStart.style.background = '#0ea5e9';
    } else {
      // Start
      isRunning = true;
      btnStart.textContent = 'Durdur';
      btnStart.style.background = '#ef4444';
      
      highlightZone(); // instant first
      intervalId = setInterval(() => {
        highlightZone();
      }, 3500); // changes every 3.5 seconds
    }
  }
</script>
