<%- include('partials/main-header') %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');
  
  body { background: #f8fafc !important; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; margin: 0; padding: 0; }
  .hub-container { padding: 40px 20px; max-width: 1400px; margin: 0 auto; min-height: 85vh; display: flex; flex-direction: column; lg:flex-row; gap: 40px; }
  
  h1 { font-family: 'Playfair Display', serif; font-size: 3.5rem; font-weight: 800; margin-bottom: 5px; color: #1e1b4b; line-height: 1.1; }
  p.desc { font-family: 'Outfit', sans-serif; color: #64748b; font-size: 1.1rem; line-height: 1.6; margin-bottom: 30px; max-width: 500px; }

  /* Left Panel: Fallacy List */
  .list-panel { flex: 1; display: flex; flex-direction: column; gap: 12px; max-height: 800px; overflow-y: auto; padding-right: 15px; }
  
  /* Scrollbar styles for list */
  .list-panel::-webkit-scrollbar { width: 6px; }
  .list-panel::-webkit-scrollbar-track { background: transparent; }
  .list-panel::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  .list-panel::-webkit-scrollbar-thumb:hover { background: #a855f7; }

  .fallacy-btn { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 18px 24px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .fallacy-btn::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: transparent; transition: all 0.3s; }
  
  .fallacy-btn:hover { background: #faf5ff; transform: translateX(5px); border-color: #d8b4fe; box-shadow: 0 10px 20px rgba(168, 85, 247, 0.05); }
  .fallacy-btn.active { background: #f3e8ff; border-color: #a855f7; box-shadow: 0 10px 20px rgba(168, 85, 247, 0.1); }
  .fallacy-btn.active::before { background: #a855f7; }

  .fb-content { display: flex; flex-direction: column; }
  .fb-title { font-family: 'Outfit', sans-serif; font-weight: 800; color: #1e1b4b; font-size: 1.15rem; margin-bottom: 4px; }
  .fb-eng { font-family: 'Outfit', sans-serif; font-size: 0.75rem; color: #9333ea; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }
  .fb-icon { font-size: 1.8rem; filter: grayscale(100%); opacity: 0.4; transition: all 0.3s; }
  .fallacy-btn.active .fb-icon { filter: grayscale(0%); opacity: 1; transform: scale(1.1); }

  /* Right Panel: Matrix Display -> Now Light Mode Encyclopedia */
  .matrix-panel { flex: 2; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; position: relative; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 30px 60px rgba(0,0,0,0.05); }
  
  .matrix-bg { position: absolute; inset: 0; opacity: 0.03; font-family: monospace; font-size: 12px; color: #a855f7; user-select: none; pointer-events: none; overflow: hidden; white-space: pre-wrap; line-height: 1; z-index: 0; }
  
  .mp-content { padding: 50px; position: relative; z-index: 10; flex-grow: 1; overflow-y: auto; }
  
  .mp-header { border-bottom: 2px dashed #f1f5f9; padding-bottom: 25px; margin-bottom: 30px; }
  .mp-title { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 900; color: #1e1b4b; margin: 0 0 10px 0; }
  .mp-latin { font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: #9333ea; font-style: italic; font-weight: 600; }

  .mp-def { font-family: 'Outfit', sans-serif; font-size: 1.2rem; color: #475569; line-height: 1.8; margin-bottom: 40px; border-left: 5px solid #a855f7; padding-left: 25px; background: linear-gradient(90deg, #faf5ff, transparent); padding-top: 15px; padding-bottom: 15px; border-radius: 0 12px 12px 0; }

  /* Formula Box */
  .formula-box { background: #ffffff; border: 2px solid #e9d5ff; padding: 30px; border-radius: 20px; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(168, 85, 247, 0.05); }
  .form-title { font-family: 'Outfit', sans-serif; font-size: 0.85rem; font-weight: 800; color: #7e22ce; text-transform: uppercase; margin-bottom: 15px; letter-spacing: 2px; display: flex; align-items: center; gap: 10px; }
  .form-title::before { content: '⚡'; }
  .form-code { font-family: 'Inter', sans-serif; font-size: 1.1rem; color: #1e293b; font-weight: 600; line-height: 1.8; }

  /* Examples */
  .ex-grid { display: grid; grid-template-columns: 1fr; gap: 25px; }
  .ex-card { background: #f8fafc; border-radius: 16px; padding: 25px; border: 1px solid #e2e8f0; position: relative; transition: 0.3s; }
  .ex-card:hover { border-color: #cbd5e1; box-shadow: 0 10px 20px rgba(0,0,0,0.03); }
  .ex-card::before { content: '💬'; position: absolute; top: -15px; left: 25px; font-size: 1.5rem; background: #fff; border-radius: 50%; padding: 5px; box-shadow: 0 5px 10px rgba(0,0,0,0.05); }
  .ex-text { font-family: 'Playfair Display', serif; font-size: 1.25rem; color: #0f172a; font-style: italic; margin-bottom: 20px; margin-top: 10px; line-height: 1.6; }
  .ex-analysis { background: #ffffff; padding: 20px; border-radius: 12px; font-family: 'Outfit', sans-serif; font-size: 0.95rem; color: #64748b; border-left: 3px solid #ef4444; line-height: 1.6; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }

  /* Navigation to Games */
  .games-nav { display: flex; gap: 15px; margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 30px; }
  .g-btn { flex: 1; padding: 15px 20px; border-radius: 16px; font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 0.9rem; text-align: center; text-decoration: none; text-transform: uppercase; letter-spacing: 1px; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; }
  
  .g-btn-pol { background: #fff1f2; border: 1px solid #fda4af; color: #e11d48; }
  .g-btn-pol:hover { background: #e11d48; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(225, 29, 72, 0.2); }
  
  .g-btn-det { background: #f0f9ff; border: 1px solid #bae6fd; color: #0284c7; }
  .g-btn-det:hover { background: #0284c7; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(2, 132, 199, 0.2); }
  
  .g-btn-kal { background: #ecfdf5; border: 1px solid #a7f3d0; color: #059669; }
  .g-btn-kal:hover { background: #059669; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(5, 150, 105, 0.2); }
  
  .g-btn-kar { background: #fdf2f8; border: 1px solid #fbcfe8; color: #db2777; }
  .g-btn-kar:hover { background: #db2777; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(219, 39, 119, 0.2); }
  
  .g-btn-trol { background: #fefce8; border: 1px solid #fde047; color: #ca8a04; }
  .g-btn-trol:hover { background: #ca8a04; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(202, 138, 4, 0.2); }
  
  .g-btn-mah { background: #faf5ff; border: 1px solid #e9d5ff; color: #9333ea; }
  .g-btn-mah:hover { background: #9333ea; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(147, 51, 234, 0.2); }

  @media (min-width: 1024px) {
    .hub-container { flex-direction: row; }
  }
  @media (max-width: 768px) {
    h1 { font-size: 2.5rem; }
    .mp-title { font-size: 2rem; }
  }
</style>

<div class="hub-container">
  
  <!-- Left: Dictionary List -->
  <div class="list-panel">
    <div style="margin-bottom: 20px;">
      <h1>Safsata Ansiklopedisi</h1>
      <p class="desc">Mantık hatalarını tanıyın. Karşınızdakinin zihinsel illüzyonlarını ve manipülasyonlarını anında deşifre edin.</p>
    </div>
    <div id="fallacyList">
      <!-- Generated by JS -->
    </div>
    
    <div class="games-nav" style="flex-wrap: wrap;">
      <a href="/safsata/spin-doctor" class="g-btn g-btn-pol" style="min-width: 30%;">📺 Politikacı</a>
      <a href="/safsata/dedektif" class="g-btn g-btn-det" style="min-width: 30%;">🕵️ Dedektif</a>
      <a href="/safsata/kalkan" class="g-btn g-btn-kal" style="min-width: 30%;">🛡️ Çürütme</a>
      <a href="/safsata/karanlik" class="g-btn g-btn-kar" style="min-width: 30%;">😈 Karanlık</a>
      <a href="/safsata/trol-avcisi" class="g-btn g-btn-trol" style="min-width: 30%;">📱 Trol Avcısı</a>
      <a href="/safsata/mahkeme" class="g-btn g-btn-mah" style="min-width: 30%;">⚖️ İtiraz!</a>
    </div>
  </div>

  <!-- Right: Matrix Panel -->
  <div class="matrix-panel">
    <div class="matrix-bg" id="matrixBg"></div>
    
    <div class="mp-content" id="mpContent">
      <div class="mp-header">
        <h2 class="mp-title" id="mTitle">Ad Hominem</h2>
        <div class="mp-latin" id="mLatin">(Kişiye Saldırı / Argumentum ad Hominem)</div>
      </div>
      
      <div class="mp-def" id="mDef">
        Karşıdaki kişinin öne sürdüğü argümanı veya fikri mantıksal olarak çürütmek yerine, o fikri savunan kişinin karakterine, geçmişine veya özelliklerine saldırma eylemidir.
      </div>

      <div class="formula-box">
        <div class="form-title">Mantıksal Formül</div>
        <div class="form-code" id="mForm">
          1. A kişisi X iddiasında bulunur.<br>
          2. B kişisi A'nın karakterine saldırır.<br>
          3. Dolayısıyla X iddiası yanlıştır (Mantıksız Sonuç).
        </div>
      </div>

      <div class="ex-grid" id="mExamples">
        <!-- Generated by JS -->
      </div>
    </div>
  </div>

</div>

<script>
  // Dynamic Matrix Background Effect
  const mBg = document.getElementById('matrixBg');
  let bgText = "";
  for(let i=0; i<100; i++) {
    bgText += "01001010 01101111 01101000 01101110 " + Math.random().toString(36).substring(2, 8) + " ";
  }
  mBg.textContent = bgText;

  const fallacies = [
    {
      id: 'adhominem', title: 'Kişiye Saldırı', latin: 'Ad Hominem', icon: '🎯',
      def: 'Karşıdaki kişinin öne sürdüğü argümanı veya fikri mantıksal olarak çürütmek yerine, o fikri savunan kişinin karakterine, geçmişine, kimliğine veya niyetine saldırma eylemidir. Tartışmayı fikirlerden koparıp kişisel kavgaya çeker.',
      form: 'A kişisi X iddiasında bulunur.\nB kişisi A\'nın kötü bir özelliği olduğunu söyler.\nBu nedenle X iddiası yanlıştır.',
      examples: [
        {
          quote: '"Doktor bana sigarayı bırakmam gerektiğini söyledi ama kendisi günde bir paket içiyor, neden onu dinleyeyim ki?"',
          analysis: 'Doktorun sigara içmesi (karakter/davranış) sigaranın zararlı olduğu (argüman) gerçeğini değiştirmez. Bu bir Tu Quoque (Sen de) türü Ad Hominem\'dir.'
        },
        {
          quote: '"Onun ekonomi politikalarını ciddiye alamayız, daha geçen yıl vergi kaçırmakla suçlanmıştı."',
          analysis: 'Kişinin geçmiş suçları, öne sürdüğü ekonomi teorisinin matematiksel olarak yanlış olduğunu kanıtlamaz.'
        },
        {
          quote: '"Senin yaşın kaç ki bana hayat dersi veriyorsun?"',
          analysis: 'Argümanın doğruluğu kişinin yaşıyla değil, içeriğin mantığıyla ölçülür.'
        },
        {
          quote: '"Bunu söylemen şaşırtıcı değil, sonuçta sen de bir erkeksin/kadınsın."',
          analysis: 'Fikirler cinsiyete göre kategorize edilerek çürütülmeye çalışılmış, mantıksal argümana cevap verilmemiştir.'
        }
      ]
    },
    {
      id: 'niteliksel', title: 'Niteliksel Kişi Karalama', latin: 'Circumstantial Ad Hominem', icon: '👤',
      def: 'Argümanın kendisi yerine argümanı ileri süren kişinin etnik kökeni, politik tutumu, mesleği veya dini görüşü gibi niteliklerini kullanarak argümanı çürütmeye çalışma.',
      form: 'A kişisi X iddiasında bulunur.\nA kişisi Y grubuna veya özelliğine aittir.\nÖyleyse X iddiası yanlıştır.',
      examples: [
        {
          quote: '"Onun önerisini kabul edemeyiz, çünkü o karşı partiden."',
          analysis: 'Önerinin mantıklı olup olmadığına bakılmaksızın, sırf kişinin politik tutumuna (niteliğine) dayanılarak reddedilmesi.'
        },
        {
          quote: '"Tabii ki maaşlara zam yapılmasını savunacaksın, sonuçta sen de bir sendikacısın!"',
          analysis: 'Kişinin mesleği ve çıkarları, zam gereksinimine dair sunduğu rasyonel argümanları geçersiz kılmaz.'
        },
        {
          quote: '"O yabancı uyruklu olduğu için ülkemizin sorunlarını anlaması mümkün değil."',
          analysis: 'Bir kişinin yabancı olması, nesnel gerçekleri veya sorunları analiz edemeyeceği anlamına gelmez.'
        }
      ]
    },
    {
      id: 'tuquoque', title: 'Sen de Safsatası', latin: 'Tu Quoque', icon: '🪞',
      def: 'Bir kişinin iddiası veya söyledikleri kendi eylemleriyle çelişiyor diye iddianın yanlış olduğunu savunma hatası. Bir nevi "Sen kendi yaptıklarına bak" savunmasıdır.',
      form: 'A kişisi X\'in kötü/yanlış olduğunu söyler.\nA kişisi kendisi X\'i yapmaktadır.\nDemek ki X kötü/yanlış değildir.',
      examples: [
        {
          quote: '"İçki içmemem gerektiğini söylüyorsun, ama seni de hiç ayık görmedim."',
          analysis: 'Karşısındakinin içki içmesi (çelişkili davranış), içkinin sağlığa zararlı olduğu argümanını çürütmez.'
        },
        {
          quote: '"Benim sınavda kopya çektiğimi söylüyorsun ama sen de lisedeyken çok kavgaya karışırdın."',
          analysis: 'Karşı tarafın geçmişteki hataları, şu anki suçlamayı veya gerçeği ortadan kaldırmaz.'
        },
        {
          quote: '"Bize tasarruf yapmamızı öğütleyen patron, dün kendine yeni bir lüks spor araba aldı!"',
          analysis: 'Patronun israf etmesi ahlaki bir çelişki olsa da, şirketin tasarruf yapması gerektiği yönündeki matematiksel gerçeği değiştirmez.'
        }
      ]
    },
    {
      id: 'poisoning', title: 'Önyargı Oluşturma', latin: 'Poisoning The Well', icon: '☠️',
      def: 'Bir insan hakkında o daha konuşmadan önce olumsuz bilgiler verilerek (doğru ya da yanlış), onun söyleyeceklerini baştan gözden düşürme ve dinleyicide önyargı oluşturma.',
      form: 'B kişisi A hakkında olumsuz bir bilgi verir.\nA kişisi argümanını sunar.\nDinleyiciler A\'nın argümanını baştan reddeder.',
      examples: [
        {
          quote: '"Şimdi konuşacak olan kişi eski bir dolandırıcıdır, sözlerine dikkat edin."',
          analysis: 'Kişi kürsüye çıkmadan önce "dolandırıcı" etiketi yapıştırılarak, sunacağı geçerli kanıtların bile dinlenmesi engellenmiştir.'
        },
        {
          quote: '"Hasan ünlü bir avukat olmuş, öyle mi? Ayol, o lisedeyken iki lâfı bir araya getiremezdi."',
          analysis: 'Hasan\'ın şimdiki avukatlık yetenekleri, geçmişteki veya iddia edilen beceriksizliğiyle baştan zehirleniyor.'
        },
        {
          quote: '"Benim rakibim, sadece zenginleri koruyan yasaları desteklemesiyle bilinir. Şimdi size halk için bir şeyler yapacağını söyleyecek."',
          analysis: 'Rakibin yapacağı savunma henüz duyulmadan kitle manipüle edilmiş ve önleyici bir psikolojik bariyer kurulmuştur.'
        }
      ]
    },
    {
      id: 'strawman', title: 'Saman Adam', latin: 'Straw Man Fallacy', icon: '🌾',
      def: 'Karşınızdaki kişinin gerçek argümanını alıp, onu aşırı, saçma veya kolayca çürütülebilecek zayıf bir versiyona ("saman adam"a) çevirmek ve bu uydurma argümana saldırmaktır.',
      form: 'A kişisi X fikrini savunur.\nB kişisi X\'i çarpıtarak Y (Saman Adam) fikrini yaratır.\nB kişisi Y fikrine saldırır ve X\'i çürüttüğünü iddia eder.',
      examples: [
        {
          quote: 'A: "Savunma bütçesinden biraz kısıp eğitime yatırmalıyız."\nB: "Yani ülkemizi düşmanlara karşı tamamen savunmasız bırakalım, askerleri terhis edelim diyorsun!"',
          analysis: 'A kişisi "bütçeyi kısalım" dedi, B kişisi bunu "ülkeyi savunmasız bırakalım" şeklinde aşırı uç bir noktaya (saman adam) çarpıtarak saldırdı.'
        },
        {
          quote: 'A: "Çocukların çok fazla şeker tüketmesi zararlı olabilir."\nB: "Yani çocukların hiçbir zaman çikolata yememesini, çocukluklarını yaşayamamasını istiyorsun, ne kadar gaddarsın!"',
          analysis: 'Kontrollü tüketim önerisi, "hiç şeker yedirmeme" gibi uç bir kısıtlamaya çevrilip eleştirildi.'
        },
        {
          quote: 'A: "Şirket toplantılarını 1 saate indirmeliyiz, çok zaman kaybediyoruz."\nB: "Toplantıları tamamen iptal edip herkesin kafasına göre çalışmasını savunuyorsan bu şirket hemen batar!"',
          analysis: 'Zaman kısıtlaması talebi, "toplantıları tamamen iptal etme" fikrine çarpıtılarak kolayca hezimete uğratılıyor.'
        }
      ]
    },
    {
      id: 'redherring', title: 'Kırmızı Ringa Balığı', latin: 'Red Herring / Ignoratio Elenchi', icon: '🐟',
      def: 'Tartışmada zor duruma düşüldüğünde, karşı tarafın dikkatini dağıtmak ve asıl meseleden kaçmak için konuyu tamamen alakasız ama duygusal olarak kışkırtıcı başka bir yöne çekme taktiğidir.',
      form: 'Konu A tartışılmaktadır.\nB kişisi, A ile ilgisiz olan Konu B\'yi (Kırmızı Ringa) ortaya atar.\nKonu A terk edilir ve Konu B tartışılmaya başlanır.',
      examples: [
        {
          quote: 'Gazeteci: "Şirketinizin nehri zehirlediğine dair raporlar var, ne diyorsunuz?"\nCEO: "Biz bu ülkenin en büyük vergi rekortmeniyiz, binlerce aileye ekmek kapısı açıyoruz. Bu vatanseverliği kimse sorgulayamaz!"',
          analysis: 'Nehrin zehirlenmesi (Asıl konu), vergi vermek ve vatanseverlik (Kırmızı Ringa) konusuyla örtbas ediliyor.'
        },
        {
          quote: 'Eş: "Neden kredi kartı borcumuz bu kadar fazla?"\nKoca: "Sen de geçen ay anneni ziyarete gittiğinde bir sürü masraf yapmıştın, onu ne yapacağız?"',
          analysis: 'Asıl sorun olan kredi kartı borcu, eşin geçmişteki eylemi gündeme getirilerek (konu değiştirilerek) hasıraltı edilmeye çalışılıyor.'
        },
        {
          quote: 'Öğretmen: "Ödevini neden yapmadın?"\nÖğrenci: "Hocam dünyada bu kadar aç insan varken bizim ödev düşünmemiz sizce de tuhaf değil mi?"',
          analysis: 'Öğrenci, ödev yapmama sorununu duygusal ve küresel bir meseleye çekerek sorumluluktan kaçıyor.'
        }
      ]
    },
    {
      id: 'equivocation', title: 'Cinaslı Safsata', latin: 'Fallacy of Equivocation', icon: '🎭',
      def: 'Aynı kelimenin ifadenin iki farklı kısmında farklı anlamlarda kullanılarak mantıksız bir çıkarım yaratılması.',
      form: 'X kelimesi 1. anlamda kullanılır.\nX kelimesi 2. anlamda kullanılır ve 1. anlama bağlanarak hatalı sonuca varılır.',
      examples: [
        {
          quote: '"Kanuna karşı gelenler hapse atılır. Sen yerçekimi kanununa karşı geldin. O halde hapse atılman lazım!"',
          analysis: 'Hukuksal kanun ile fiziksel kanun kelimelerinin eşsesliliği (cinas) üzerinden yanlış bir mantık zinciri kurulmuştur.'
        },
        {
          quote: '"Gerçek bir centilmen sözünü tutar. O da bize sessiz kalacağına dair söz verdi, tam bir centilmen!"',
          analysis: 'Bir erdem olan centilmenlik ile, suç ortaklığı olan suskunluk aynı "söz tutma" kelimesi üzerinden birleştirilmiştir.'
        },
        {
          quote: '"Sağduyu çok değerlidir. O halde herkes sağ elini kullanmalıdır."',
          analysis: '"Sağ" kelimesinin zihinsel sağduyu ile fiziksel sağ yön anlamları kasıtlı olarak birbirine karıştırılmış.'
        }
      ]
    },
    {
      id: 'amphiboly', title: 'Çok Anlamlılık', latin: 'Fallacy of Amphiboly', icon: '🧩',
      def: 'Birden fazla yoruma açık olan, gramer yapısı veya kelime dizilimi belirsiz cümleler üzerinden hatalı çıkarım yapmak.',
      form: 'Belirsiz cümle söylenir.\nİki farklı yoruma açık olduğu için kasıtlı olarak yanlış yorumlanır.',
