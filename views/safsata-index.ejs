  function loadFallacy(id) {
    document.querySelectorAll('.fallacy-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('btn-' + id).classList.add('active');

    const f = fallacies.find(x => x.id === id);
    
    document.getElementById('mTitle').textContent = f.title;
    document.getElementById('mLatin').textContent = f.latin;
    document.getElementById('mDef').textContent = f.def;
    
    // Format formula
    document.getElementById('mForm').innerHTML = f.form.replace(/\n/g, '<br>');

    // Format examples
    const exCont = document.getElementById('mExamples');
    exCont.innerHTML = '';
    f.examples.forEach(ex => {
      exCont.innerHTML += `
        <div class="ex-card">
          <div class="ex-text">${ex.quote}</div>
          <div class="ex-analysis"><strong>Dedektif Analizi:</strong> ${ex.analysis}</div>
        </div>
      `;
    });
  }

  // Render Left List
  const listCont = document.getElementById('fallacyList');
  fallacies.forEach(f => {
    const btn = document.createElement('div');
    btn.className = 'fallacy-btn';
    btn.id = 'btn-' + f.id;
    btn.onclick = () => loadFallacy(f.id);
    btn.innerHTML = `
      <div class="fb-content">
        <span class="fb-title">${f.title}</span>
        <span class="fb-eng">${f.latin.split(' / ')[0]}</span>
      </div>
      <div class="fb-icon">${f.icon}</div>
    `;
    listCont.appendChild(btn);
  });

  // Init
  loadFallacy(fallacies[0].id);

</script>

