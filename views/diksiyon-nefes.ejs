<style>
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* ── Hero ────────────────────── */
  .dks-hero {
    min-height: 45vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 100px 24px 60px; position: relative; overflow: hidden;
  }
  .dks-hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% 30%, #10b98122, transparent 70%);
  }
  .dks-hero::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 120px;
    background: linear-gradient(to top, #f8fafc, transparent);
  }
  .hero-emoji { font-size: 5rem; margin-bottom: 16px; filter: drop-shadow(0 0 30px #10b98166); animation: float 3s ease-in-out infinite; }
  @keyframes float { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-12px); } }

  .hero-badge {
    background: rgba(16,185,129, 0.15); border: 1px solid rgba(16,185,129, 0.3);
    color: #6ee7b7; font-size: 0.8rem; font-weight: 600; padding: 6px 14px; border-radius: 20px;
    letter-spacing: 1px; margin-bottom: 20px; text-transform: uppercase;
  }
  .dks-hero h1 { font-size: 3rem; font-weight: 800; line-height: 1.1; margin-bottom: 16px; position: relative; z-index: 1; }
  .dks-hero p { font-size: 1.2rem; color: #475569; max-width: 600px; line-height: 1.6; position: relative; z-index: 1; }

  /* ── Content Area ──────────────── */
  .dks-wrap { max-width: 800px; margin: 0 auto; padding: 0 24px 80px; position: relative; z-index: 10; }
  
  .glass {
    background: rgba(30,30,40, 0.4); border: 1px solid rgba(15,23,42, 0.05);
    border-radius: 24px; padding: 32px; backdrop-filter: blur(12px);
    margin-bottom: 32px;
  }
  
  .glass h2 { font-size: 1.8rem; font-weight: 700; color: #fff; margin-bottom: 16px; display: flex; align-items: center; gap: 12px; }
  .glass p { color: #334155; line-height: 1.8; font-size: 1.05rem; margin-bottom: 20px; }
  .glass ul { color: #334155; line-height: 1.8; font-size: 1.05rem; padding-left: 20px; margin-bottom: 20px; }
  .glass li { margin-bottom: 12px; }

  /* ── CTA ─────────────────────── */
  .cta-box {
    background: linear-gradient(135deg, rgba(16,185,129, 0.1), rgba(16,185,129, 0.02));
    border: 1px solid rgba(16,185,129, 0.3); border-radius: 20px; padding: 32px;
    text-align: center; margin-top: 48px;
  }
  .cta-btn {
    display: inline-block; background: #10b981; color: #fff; font-weight: 600; font-size: 1.1rem;
    padding: 14px 32px; border-radius: 30px; text-decoration: none; margin-top: 20px;
    transition: all 0.3s ease; box-shadow: 0 10px 30px -10px #10b981;
  }
  .cta-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 40px -10px #10b981; background: #059669; }

</style>

