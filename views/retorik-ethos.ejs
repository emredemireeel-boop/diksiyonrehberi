<%- include('partials/main-header') %>
<link rel="stylesheet" href="/retorik.css?v=8" />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --ethos-bg: #0b1120; /* Deep navy */
    --ethos-card: rgba(30, 41, 59, 0.7);
    --ethos-border: rgba(255, 255, 255, 0.1);
    --ethos-accent: #38bdf8;
    --ethos-gold: #fbbf24;
    --ethos-text: #f8fafc;
    --ethos-subtext: #94a3b8;
  }

  body.ethos-active {
    background-color: var(--ethos-bg);
    color: var(--ethos-text);
    font-family: 'Inter', sans-serif;
  }

  /* Override general page bg just for this container */
  .ethos-wrapper {
    background-color: var(--ethos-bg);
    color: var(--ethos-text);
    min-height: 100vh;
    padding-bottom: 80px;
    position: relative;
    overflow: hidden;
  }

  /* Decorative Background Orbs */
  .ethos-orb-1 {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(56,189,248,0.15) 0%, rgba(11,17,32,0) 70%);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }
  
  .ethos-orb-2 {
    position: absolute;
    bottom: 20%;
    right: -5%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(251,191,36,0.1) 0%, rgba(11,17,32,0) 70%);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  .ethos-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 10;
  }

  /* Pill Navigation override for dark mode */
  .ret-cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 40px 0;
  }
  .ret-cat-pill {
    padding: 10px 20px;
    border-radius: 30px;
    background: rgba(255,255,255,0.05);
    color: var(--ethos-subtext);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid rgba(255,255,255,0.1);
    transition: all 0.3s ease;
  }
  .ret-cat-pill:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
  }
  .ret-cat-pill.active {
    background: var(--ethos-accent);
    color: #0b1120;
    border-color: var(--ethos-accent);
    font-weight: 600;
    box-shadow: 0 0 15px rgba(56,189,248,0.4);
  }

  /* Hero Section */
  .ethos-hero {
    text-align: center;
    padding: 60px 0;
  }
  .ethos-hero h1 {
    font-family: 'Outfit', sans-serif;
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #fff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -1px;
  }
  .ethos-hero p {
    font-size: 1.2rem;
    color: var(--ethos-subtext);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Ethos Simulator Application */
  .sim-app {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--ethos-border);
    border-radius: 24px;
    padding: 40px;
    margin-bottom: 60px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 40px;
  }
  
  @media(max-width: 800px) {
    .sim-app {
      grid-template-columns: 1fr;
    }
  }

  .sim-main-panel h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    margin-bottom: 10px;
    color: #fff;
  }
  .sim-main-panel p.sim-desc {
    color: var(--ethos-subtext);
    margin-bottom: 30px;
    line-height: 1.5;
  }

  .scenario-box {
    background: rgba(56, 189, 248, 0.05);
    border-left: 4px solid var(--ethos-accent);
    padding: 15px 20px;
    border-radius: 0 8px 8px 0;
    margin-bottom: 30px;
  }
  .scenario-box span {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ethos-accent);
    margin-bottom: 5px;
    font-weight: 700;
  }

  .sim-steps {
    position: relative;
  }
  
  .sim-step {
    display: none;
    animation: fadeIn 0.4s ease forwards;
  }
  .sim-step.active {
    display: block;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .sim-question {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: #fff;
  }

  .sim-option {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--ethos-border);
    padding: 18px 20px;
    border-radius: 12px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 1rem;
    line-height: 1.5;
    color: #cbd5e1;
  }
  .sim-option:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.3);
  }
  .sim-option.selected {
    background: rgba(56, 189, 248, 0.1);
    border-color: var(--ethos-accent);
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
  }

  .sim-feedback {
    display: none;
    margin-top: 20px;
    padding: 15px;
    border-radius: 8px;
    font-size: 0.95rem;
    line-height: 1.5;
    background: rgba(255,255,255,0.05);
    border-left: 4px solid var(--ethos-subtext);
    animation: fadeIn 0.3s ease;
  }

  .sim-next-btn {
    display: none;
    margin-top: 20px;
    background: #fff;
    color: #0f172a;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .sim-next-btn:hover {
    background: #e2e8f0;
    transform: translateY(-2px);
  }

  /* Stats Sidebar */
  .sim-stats-panel {
    background: rgba(0,0,0,0.2);
    border-radius: 16px;
    padding: 25px;
  }
  .sim-stats-panel h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.2rem;
    margin-bottom: 25px;
    color: #fff;
    border-bottom: 1px solid var(--ethos-border);
    padding-bottom: 15px;
  }

  .stat-bar-wrap {
    margin-bottom: 25px;
  }
  .stat-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ethos-subtext);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .stat-label span.stat-val {
    color: #fff;
  }
  .stat-track {
    width: 100%;
    height: 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
  }
  .stat-fill {
    height: 100%;
    width: 0%;
    background: var(--ethos-accent);
    border-radius: 4px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .stat-fill.phronesis { background: #38bdf8; } /* Blue for Expertise */
  .stat-fill.arete { background: #fbbf24; }    /* Gold for Character */
  .stat-fill.eunoia { background: #34d399; }   /* Green for Goodwill */

  .sim-result {
    display: none;
    text-align: center;
    padding: 40px 20px;
  }
  .sim-result h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    margin-bottom: 10px;
    color: var(--ethos-gold);
  }
  .sim-result p {
    font-size: 1.1rem;
    color: var(--ethos-subtext);
    line-height: 1.6;
    margin-bottom: 30px;
  }
  .sim-result-speech {
    background: rgba(0,0,0,0.3);
    padding: 20px;
    border-radius: 12px;
    font-style: italic;
    color: #cbd5e1;
    border-left: 3px solid var(--ethos-gold);
    text-align: left;
  }

  /* Masterclass Section */
  .masterclass-section {
    margin-top: 80px;
  }
  .mc-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .mc-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 10px;
  }
  .mc-header p {
    color: var(--ethos-subtext);
    font-size: 1.1rem;
  }

  .mc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
  }

  .mc-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--ethos-border);
    border-radius: 16px;
    padding: 30px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: default;
  }
  .mc-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.4);
    border-color: rgba(255,255,255,0.2);
  }
  
  .mc-author {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--ethos-border);
  }
  .mc-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }
  .mc-author-info h4 {
    margin: 0;
    color: #fff;
    font-size: 1.1rem;
  }
  .mc-author-info span {
    font-size: 0.8rem;
    color: var(--ethos-subtext);
  }

  .mc-quote {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 20px;
    position: relative;
  }
  
  .mc-quote::before {
    content: '"';
    font-family: 'Outfit', sans-serif;
    font-size: 4rem;
    color: rgba(255,255,255,0.05);
    position: absolute;
    top: -20px;
    left: -10px;
    line-height: 1;
    z-index: -1;
  }

  .mc-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .mc-tag {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 20px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  .mc-tag.phro { background: rgba(56,189,248,0.1); color: #38bdf8; border: 1px solid rgba(56,189,248,0.2); }
  .mc-tag.are { background: rgba(251,191,36,0.1); color: #fbbf24; border: 1px solid rgba(251,191,36,0.2); }
  .mc-tag.eun { background: rgba(52,211,153,0.1); color: #34d399; border: 1px solid rgba(52,211,153,0.2); }

  .mc-explanation {
    margin-top: 15px;
    font-size: 0.9rem;
    color: #94a3b8;
    background: rgba(0,0,0,0.2);
    padding: 12px;
    border-radius: 8px;
    border-left: 3px solid var(--ethos-subtext);
    display: none;
  }
  .mc-card:hover .mc-explanation {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  /* Ethos Shield Section */
  .ethos-shield-section {
    margin-top: 80px;
    background: linear-gradient(180deg, rgba(30,41,59,0.3) 0%, rgba(11,17,32,0) 100%);
    border-top: 1px solid var(--ethos-border);
    padding: 60px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  @media(max-width: 800px) {
    .ethos-shield-section { grid-template-columns: 1fr; }
  }
  
  .shield-content h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.2rem;
    color: #fff;
    margin-bottom: 15px;
  }
  .shield-content p {
    color: var(--ethos-subtext);
    line-height: 1.6;
    margin-bottom: 30px;
    font-size: 1.1rem;
  }
  
  .shield-checklist {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .shield-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    background: rgba(255,255,255,0.03);
    padding: 15px 20px;
    border-radius: 12px;
    border: 1px solid transparent;
    transition: all 0.3s;
    cursor: pointer;
  }
  .shield-item:hover {
    background: rgba(255,255,255,0.08);
  }
  .shield-item.checked {
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.3);
  }
  .shield-checkbox {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 2px solid var(--ethos-subtext);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    flex-shrink: 0;
  }
  .shield-item.checked .shield-checkbox {
    background: var(--ethos-accent);
    border-color: var(--ethos-accent);
  }
  .shield-checkbox::after {
    content: '✓';
    color: #0b1120;
    font-weight: bold;
    font-size: 14px;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.3s;
  }
  .shield-item.checked .shield-checkbox::after {
    opacity: 1;
    transform: scale(1);
  }
  
  .shield-text h4 {
    margin: 0 0 5px 0;
    color: #fff;
    font-size: 1.05rem;
  }
  .shield-text p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ethos-subtext);
  }

  .shield-visual-container {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .shield-icon {
    font-size: 120px;
    filter: drop-shadow(0 0 10px rgba(0,0,0,0.5));
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.3;
    transform: scale(0.9);
  }
  .shield-icon.level-1 { opacity: 0.5; filter: drop-shadow(0 0 20px rgba(56,189,248,0.2)); transform: scale(0.95); }
  .shield-icon.level-2 { opacity: 0.75; filter: drop-shadow(0 0 40px rgba(56,189,248,0.4)); transform: scale(1); }
  .shield-icon.level-3 { opacity: 1; filter: drop-shadow(0 0 60px rgba(56,189,248,0.7)); transform: scale(1.1); color: #38bdf8; }
  
  .shield-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(56,189,248,0.4) 0%, rgba(0,0,0,0) 70%);
    border-radius: 50%;
    z-index: -1;
    opacity: 0;
    transition: all 0.5s;
    transform: scale(0.5);
  }
  .shield-icon.level-3 + .shield-glow {
    opacity: 1;
    transform: scale(1.5);
  }

  /* Power of Pause Section */
  .pause-section {
    margin-top: 80px;
    padding: 60px 0;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.5) 100%);
    border-radius: 24px;
    border: 1px solid var(--ethos-border);
    text-align: center;
  }
  .pause-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 15px;
  }
  .pause-header p {
    color: var(--ethos-subtext);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 40px auto;
  }
  .pause-game-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }
  .interviewer-question {
    background: rgba(255,255,255,0.05);
    padding: 20px 30px;
    border-radius: 12px;
    font-size: 1.2rem;
    color: #fff;
    border-left: 4px solid var(--ethos-accent);
    max-width: 600px;
  }
  .timer-display {
    font-size: 4rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    color: var(--ethos-accent);
    font-variant-numeric: tabular-nums;
  }
  .action-buttons {
    display: flex;
    gap: 15px;
  }
  .btn-start-question, .btn-answer {
    padding: 15px 40px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 30px;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }
  .btn-start-question {
    background: #fff;
    color: #0f172a;
  }
  .btn-start-question:hover {
    transform: scale(1.05);
  }
  .btn-answer {
    background: var(--ethos-accent);
    color: #0f172a;
    display: none;
  }
  .btn-answer:hover {
    background: #0284c7;
    color: #fff;
  }
  .pause-feedback {
    margin-top: 20px;
    font-size: 1.1rem;
    padding: 20px;
    border-radius: 12px;
    max-width: 500px;
    display: none;
    animation: fadeIn 0.4s;
  }
  .pause-feedback.panik { background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; color: #fca5a5; }
  .pause-feedback.otorite { background: rgba(52, 211, 153, 0.1); border: 1px solid #34d399; color: #a7f3d0; }
  .pause-feedback.gec { background: rgba(251, 191, 36, 0.1); border: 1px solid #fbbf24; color: #fde68a; }

  /* Scroll Animations */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .reveal-on-scroll.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Ethos Destroyers Section */
  .destroyers-section {
    margin-top: 80px;
    padding: 60px 0;
  }
  .destroyers-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .destroyers-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    color: #ef4444; /* red accent */
    margin-bottom: 10px;
  }
  .destroyers-header p {
    color: var(--ethos-subtext);
    font-size: 1.1rem;
  }
  .destroyer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  .destroyer-card {
    background: rgba(239, 68, 68, 0.05);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 16px;
    padding: 30px;
    text-align: center;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .destroyer-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
  }
  .destroyer-icon {
    font-size: 3rem;
    margin-bottom: 15px;
  }
  .destroyer-card h3 {
    color: #fff;
    margin-bottom: 15px;
    font-family: 'Outfit', sans-serif;
  }
  .destroyer-card p {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Vocabulary of Authority Section */
  .vocab-section {
    margin-top: 80px;
    padding: 60px 0;
    background: rgba(0,0,0,0.2);
    border-radius: 24px;
    border: 1px solid var(--ethos-border);
  }
  .vocab-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .vocab-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 2.5rem;
    color: #fff;
    margin-bottom: 10px;
  }
  .vocab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 20px;
    padding: 0 30px;
  }
  .vocab-card {
    background: rgba(255,255,255,0.03);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  .vocab-phrase {
    padding: 15px;
    border-radius: 8px;
    font-size: 1rem;
    line-height: 1.5;
    position: relative;
  }
  .vocab-weak {
    background: rgba(239, 68, 68, 0.1);
    border-left: 3px solid #ef4444;
    color: #cbd5e1;
  }
  .vocab-strong {
    background: rgba(52, 211, 153, 0.1);
    border-left: 3px solid #34d399;
    color: #fff;
    display: none;
    animation: fadeIn 0.4s ease;
  }
  .vocab-toggle-btn {
    align-self: center;
    background: transparent;
    border: 1px solid var(--ethos-accent);
    color: var(--ethos-accent);
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.85rem;
    transition: all 0.3s;
  }
  .vocab-toggle-btn:hover {
    background: var(--ethos-accent);
    color: #0f172a;
  }
</style>

<div class="ethos-wrapper">
  <div class="ethos-orb-1"></div>
  <div class="ethos-orb-2"></div>
  
  <div class="ethos-container">
    
    <!-- CATEGORIES -->
    <div class="ret-cat-pills">
      <a href="/retorik" class="ret-cat-pill">Tümü</a>
      <a href="/retorik/ethos" class="ret-cat-pill active">Ethos</a>
      <a href="/retorik/pathos" class="ret-cat-pill">Pathos</a>
      <a href="/retorik/logos" class="ret-cat-pill">Logos</a>
