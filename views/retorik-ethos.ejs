<script>
  // Script for Ethos Simulator
  let stats = { phronesis: 0, arete: 0, eunoia: 0 };
  let selectedSentences = [];
  let isAnswered = [false, false, false];

  function selectOption(stepIndex, optIndex, trait, score, feedback, element) {
    if (isAnswered[stepIndex]) return;
    isAnswered[stepIndex] = true;

    // UI Updates
    const parent = element.parentElement;
    const options = parent.querySelectorAll('.sim-option');
    options.forEach(opt => opt.style.opacity = '0.5');
    element.style.opacity = '1';
    element.classList.add('selected');

    // Show feedback
    const fbDiv = document.getElementById('fb' + stepIndex);
    fbDiv.innerHTML = `<strong>Analiz:</strong> ${feedback}`;
    fbDiv.style.display = 'block';
    
    if(score > 0) fbDiv.style.borderLeftColor = '#34d399';
    else fbDiv.style.borderLeftColor = '#ef4444';

    // Show next button
    document.getElementById('next' + stepIndex).style.display = 'block';

    // Update Stats
    stats[trait] += score;
    if(stats[trait] > 100) stats[trait] = 100;
    if(stats[trait] < 0) stats[trait] = 0;

    // Save sentence for final result
    selectedSentences[stepIndex] = element.innerText;

    updateBars();
  }

  function updateBars() {
    document.getElementById('valPhro').innerText = stats.phronesis + '%';
    document.getElementById('barPhro').style.width = stats.phronesis + '%';

    document.getElementById('valArete').innerText = stats.arete + '%';
    document.getElementById('barArete').style.width = stats.arete + '%';

    document.getElementById('valEunoia').innerText = stats.eunoia + '%';
    document.getElementById('barEunoia').style.width = stats.eunoia + '%';

    let total = Math.round((stats.phronesis + stats.arete + stats.eunoia) / 3);
    document.getElementById('totalScore').innerText = total + '/100';
  }

  function goToStep(nextStep) {
    document.querySelectorAll('.sim-step').forEach(step => step.classList.remove('active'));
    document.getElementById('step' + nextStep).classList.add('active');
  }

  function showResults() {
    document.querySelectorAll('.sim-step').forEach(step => step.classList.remove('active'));
    
    const resultDiv = document.getElementById('simResult');
    resultDiv.classList.add('active');
    resultDiv.style.display = 'block';

    const finalSpeech = selectedSentences.join(' ');
    document.getElementById('resSpeech').innerText = finalSpeech;

    let total = Math.round((stats.phronesis + stats.arete + stats.eunoia) / 3);
    let rankTitle, desc;

    if (total >= 30) {
      rankTitle = '🏆 İkna Ustası';
      desc = 'Mükemmel bir liderlik sergilediniz. Sorumluluk aldınız, uzmanlığınızı gösterdiniz ve müşteriyi korudunuz. Basın size güvenecektir.';
    } else if (total > 10) {
      rankTitle = '👍 Ortalama Lider';
      desc = 'Krizi idare ettiniz ancak bazı noktalarda güven (Ethos) inşa etmekte eksik kaldınız. Biraz daha dürüstlük ve uzmanlık katmalısınız.';
    } else {
      rankTitle = '⚠️ Felaket Senaryosu';
      desc = 'Bu konuşma şirketin hisselerini daha da dibe çekecektir. Sorumluluktan kaçtınız ve güveni yok ettiniz.';
      document.getElementById('resRank').style.color = '#ef4444';
    }

    document.getElementById('resRank').innerText = rankTitle;
    document.getElementById('resDesc').innerText = desc;
  }

  // Shield Checkup Logic
  function toggleShieldItem(el) {
    el.classList.toggle('checked');
    updateShieldVisual();
  }
  
  function updateShieldVisual() {
    const checkedCount = document.querySelectorAll('.shield-item.checked').length;
    const shieldIcon = document.getElementById('mainShieldIcon');
    
    shieldIcon.className = 'shield-icon'; // reset
    if (checkedCount === 1) shieldIcon.classList.add('level-1');
    else if (checkedCount === 2) shieldIcon.classList.add('level-2');
    else if (checkedCount === 3) shieldIcon.classList.add('level-3');
  }

  // Scroll Animations (Intersection Observer)
  document.addEventListener("DOMContentLoaded", function() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Elements to animate
    const elementsToReveal = document.querySelectorAll('.sim-app, .masterclass-section, .mc-card, .destroyers-section, .destroyer-card, .vocab-section, .vocab-card, .ethos-shield-section, .pause-section');
    elementsToReveal.forEach(el => {
      el.classList.add('reveal-on-scroll');
      observer.observe(el);
    });
  });

  // Vocabulary Toggle
  function toggleVocab(btn) {
    const card = btn.parentElement;
    const weak = card.querySelector('.vocab-weak');
    const strong = card.querySelector('.vocab-strong');
    
    if (strong.style.display === 'block') {
      strong.style.display = 'none';
      weak.style.display = 'block';
      btn.innerText = 'Ethos Ekle ⚡';
      btn.style.background = 'transparent';
      btn.style.color = 'var(--ethos-accent)';
    } else {
      weak.style.display = 'none';
      strong.style.display = 'block';
      btn.innerText = 'Geri Al ↺';
      btn.style.background = 'var(--ethos-accent)';
      btn.style.color = '#0f172a';
    }
  }

  // Power of Pause Game
  let pauseStartTime = 0;
  let pauseInterval;

  function startPauseGame() {
    document.getElementById('pauseQuestion').style.opacity = '1';
    document.getElementById('btnStartQ').style.display = 'none';
    document.getElementById('btnAnswerQ').style.display = 'block';
    document.getElementById('pauseFeedback').style.display = 'none';
    document.getElementById('pauseFeedback').className = 'pause-feedback';
    
    pauseStartTime = Date.now();
    pauseInterval = setInterval(() => {
      let elapsed = (Date.now() - pauseStartTime) / 1000;
      document.getElementById('pauseTimer').innerText = elapsed.toFixed(1) + 's';
    }, 100);
  }

  function answerPauseGame() {
    clearInterval(pauseInterval);
    document.getElementById('btnAnswerQ').style.display = 'none';
    document.getElementById('btnStartQ').style.display = 'block';
    document.getElementById('btnStartQ').innerText = 'Tekrar Dene';
    
    let elapsed = (Date.now() - pauseStartTime) / 1000;
    const fbDiv = document.getElementById('pauseFeedback');
    fbDiv.style.display = 'block';
    
    if (elapsed < 1.5) {
      fbDiv.classList.add('panik');
      fbDiv.innerHTML = `<strong>Tepki Süresi: ${elapsed.toFixed(1)}s</strong><br>Savunmacı ve panik! Sorunun üstüne atladınız. Bu acelecilik suçluluk veya güvensizlik (düşük Ethos) hissi yaratır.`;
    } else if (elapsed >= 1.5 && elapsed <= 3.5) {
      fbDiv.classList.add('otorite');
      fbDiv.innerHTML = `<strong>Tepki Süresi: ${elapsed.toFixed(1)}s</strong><br>Kusursuz otorite! Soruyu dinlediniz, içselleştirdiniz ve kontrolün sizde olduğunu hissettirerek cevap verdiniz. Ethos'unuz zirvede.`;
    } else {
      fbDiv.classList.add('gec');
      fbDiv.innerHTML = `<strong>Tepki Süresi: ${elapsed.toFixed(1)}s</strong><br>Çok geç! Sessizlik uzadıkça dinleyici cevabı bilmediğinizi veya yalan uydurduğunuzu düşünür.`;
    }
  }
</script>

