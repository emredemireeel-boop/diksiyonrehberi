// RADAR CHART (Canvas)
// ═══════════════════════════════════════════════════════════════════════════
function drawRadar(canvasId, e, p, l){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W/2, cy = H/2 + 5;
  const R = Math.min(W,H)/2 - 20;

  ctx.clearRect(0,0,W,H);

  // Draw grid
  for(let i=1; i<=4; i++){
    const r = R * i/4;
    ctx.beginPath();
    const angles = [-Math.PI/2, Math.PI/6, 5*Math.PI/6];
    angles.forEach((a,j) => {
      const x = cx + r * Math.cos(a), y = cy + r * Math.sin(a);
      j===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
    });
    ctx.closePath();
    ctx.strokeStyle = 'rgba(255,255,255,0.06)';
    ctx.stroke();
  }

  // Draw axes
  const labels = [{a:-Math.PI/2, c:'#10b981', t:'E'}, {a:Math.PI/6, c:'#3b82f6', t:'L'}, {a:5*Math.PI/6, c:'#f43f5e', t:'P'}];
  labels.forEach(lb => {
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + R*Math.cos(lb.a), cy + R*Math.sin(lb.a));
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.stroke();
    // Label
    const lx = cx + (R+14)*Math.cos(lb.a), ly = cy + (R+14)*Math.sin(lb.a);
    ctx.fillStyle = lb.c;
    ctx.font = 'bold 10px JetBrains Mono, monospace';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(lb.t, lx, ly);
  });

  // Draw data triangle
  const vals = [
    Math.min(e/100,1),
    Math.min(l/100,1),
    Math.min(p/100,1)
  ];
  const pts = vals.map((v,i) => ({
    x: cx + R*v*Math.cos(labels[i].a),
    y: cy + R*v*Math.sin(labels[i].a)
  }));

  ctx.beginPath();
  pts.forEach((pt,i) => i===0 ? ctx.moveTo(pt.x,pt.y) : ctx.lineTo(pt.x,pt.y));
  ctx.closePath();
  const grad = ctx.createLinearGradient(0,0,W,H);
  grad.addColorStop(0, 'rgba(16,185,129,0.25)');
  grad.addColorStop(0.5, 'rgba(59,130,246,0.25)');
  grad.addColorStop(1, 'rgba(244,63,94,0.25)');
  ctx.fillStyle = grad;
  ctx.fill();
  ctx.strokeStyle = 'rgba(255,255,255,0.4)';
  ctx.lineWidth = 1.5;
  ctx.stroke();

  // Data points
  pts.forEach((pt,i) => {
    ctx.beginPath();
    ctx.arc(pt.x, pt.y, 4, 0, Math.PI*2);
    ctx.fillStyle = labels[i].c;
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1;
    ctx.stroke();
  });
}

