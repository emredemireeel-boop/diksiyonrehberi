let audioCtx;
function toggleSound(){
  state.soundOn = !state.soundOn;
  document.getElementById('soundToggle').textContent = state.soundOn ? '🔊 Ses Açık' : '🔇 Ses Kapalı';
  if(state.soundOn && !audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}
function playTone(freq, dur, type='sine'){
  if(!state.soundOn || !audioCtx) return;
  const o = audioCtx.createOscillator(); const g = audioCtx.createGain();
  o.type = type; o.frequency.value = freq;
  g.gain.setValueAtTime(0.08, audioCtx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
  o.connect(g); g.connect(audioCtx.destination);
  o.start(); o.stop(audioCtx.currentTime + dur);
}
function sfxCorrect(){ playTone(880,.15); setTimeout(()=>playTone(1100,.2),100); }
function sfxWrong(){ playTone(200,.3,'sawtooth'); }
function sfxCombo(){ playTone(660,.1); setTimeout(()=>playTone(880,.1),80); setTimeout(()=>playTone(1320,.2),160); }

