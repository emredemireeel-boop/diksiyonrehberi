// TIMER
// ═══════════════════════════════════════════════════════════════════════════
function startTimer(duration, onExpire){
  const bar = document.getElementById('gameTimer');
  const fill = document.getElementById('timerFill');
  bar.style.display = 'block';
  fill.style.width = '100%';
  fill.classList.remove('danger');

  let elapsed = 0;
  state.timer = setInterval(()=>{
    elapsed += 50;
    const pct = Math.max(0, 100 - (elapsed/duration)*100);
    fill.style.width = pct+'%';
    if(pct < 25) fill.classList.add('danger');
    if(elapsed >= duration){ clearTimer(); onExpire(); }
  },50);
}
function clearTimer(){
  if(state.timer){ clearInterval(state.timer); state.timer=null; }
  document.getElementById('gameTimer').style.display = 'none';
}

// ═══════════════════════════════════════════════════════════════════════════
// FEEDBACK MODAL
// ═══════════════════════════════════════════════════════════════════════════
function showFeedback(icon, title, desc, xp, cb){
  document.getElementById('fbIcon').textContent = icon;
  document.getElementById('fbTitle').textContent = title;
  document.getElementById('fbTitle').style.color = xp>=0?'var(--arena-green)':'var(--arena-red)';
  document.getElementById('fbDesc').textContent = desc;
  document.getElementById('fbXp').textContent = xp>=0?`+${xp} XP`:`${xp} XP`;
  document.getElementById('fbXp').style.color = xp>=0?'var(--arena-gold)':'var(--arena-red)';
  fbCallback = cb;
  document.getElementById('feedbackModal').classList.add('active');
}
function closeFeedback(){
  document.getElementById('feedbackModal').classList.remove('active');
  if(fbCallback) fbCallback();
}

// ═══════════════════════════════════════════════════════════════════════════
// END GAME
// ═══════════════════════════════════════════════════════════════════════════
function endGame(failed){
  clearTimer();
  document.getElementById('gameScreen').classList.remove('active');
  document.getElementById('feedbackModal').classList.remove('active');

  const total = state.totalCorrect + state.totalWrong;
  const accuracy = total>0 ? Math.round(state.totalCorrect/total*100) : 0;

  let rank, badge;
  if(failed || accuracy < 30){ rank='Çırak'; badge='📜'; }
  else if(accuracy < 50){ rank='Hatip Adayı'; badge='🎓'; }
  else if(accuracy < 70){ rank='Hatip'; badge='🏆'; }
  else if(accuracy < 90){ rank='Demagog Avcısı'; badge='⚔️'; }
  else { rank='Grandmaster'; badge='👑'; }

  document.getElementById('endBadge').textContent = badge;
  document.getElementById('endTitle').textContent = failed?'Arena Sona Erdi':'Arena Tamamlandı!';
  document.getElementById('endRank').textContent = 'Rütbeniz: '+rank;

  const statsHtml = `
    <div class="end-stat"><div class="end-stat-n" style="color:var(--arena-gold)">${state.xp}</div><div class="end-stat-l">Toplam XP</div></div>
    <div class="end-stat"><div class="end-stat-n" style="color:var(--arena-green)">${accuracy}%</div><div class="end-stat-l">İsabet</div></div>
    <div class="end-stat"><div class="end-stat-n" style="color:var(--arena-blue)">${state.totalCorrect}</div><div class="end-stat-l">Doğru</div></div>
    <div class="end-stat"><div class="end-stat-n" style="color:var(--arena-red)">${state.totalWrong}</div><div class="end-stat-l">Yanlış</div></div>
    <div class="end-stat"><div class="end-stat-n" style="color:var(--arena-purple)">${Math.round(state.trust)}%</div><div class="end-stat-l">Halk Güveni</div></div>
  `;
  document.getElementById('endStats').innerHTML = statsHtml;

  drawRadar('endRadar', state.ethos, state.pathos, state.logos);

  document.getElementById('endScreen').classList.add('active');
}

function backToModes(){
  document.getElementById('endScreen').classList.remove('active');
  document.getElementById('gameScreen').classList.remove('active');
  document.getElementById('modeScreen').style.display = 'flex';
}

// Initial radar
drawRadar('radarCanvas', 40, 40, 40);
</script>

