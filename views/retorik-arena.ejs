<%- include('partials/main-header') %>

<style>
  

  :root {
    --arena-bg: #050510;
    --arena-surface: rgba(15,20,40,0.85);
    --arena-border: rgba(255,255,255,0.06);
    --arena-gold: #eab308;
    --arena-gold-glow: rgba(234,179,8,0.3);
    --arena-red: #ef4444;
    --arena-green: #10b981;
    --arena-blue: #38bdf8;
    --arena-purple: #a855f7;
    --arena-orange: #f97316;
    --arena-pink: #ec4899;
    --arena-text: #f1f5f9;
    --arena-text2: #94a3b8;
    --arena-text3: #64748b;
  }

  body { background: var(--arena-bg) !important; color: var(--arena-text);  overflow-x: hidden; margin: 0; }
  .main-header, .main-footer, .mp-footer { display: none !important; }

  /* ═══════════════════════════════════════
     CINEMATIC BACKGROUND
     ═══════════════════════════════════════ */
  .arena-cosmos {
    position: fixed; inset: 0; z-index: 0;
    background: radial-gradient(ellipse at 50% 0%, #1a1040 0%, #0a0a1a 40%, #050510 100%);
  }
  .arena-grid-floor {
    position: fixed; bottom: 0; left: 0; right: 0; height: 45%; z-index: 1; pointer-events: none;
    background: linear-gradient(0deg, rgba(234,179,8,0.03) 0%, transparent 100%);
    mask-image: linear-gradient(0deg, rgba(0,0,0,1) 0%, transparent 100%);
    background-image:
      linear-gradient(rgba(234,179,8,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(234,179,8,0.04) 1px, transparent 1px);
    background-size: 50px 50px;
    transform: perspective(500px) rotateX(45deg);
    transform-origin: bottom center;
  }
  .arena-spotlight {
    position: fixed; top: -200px; left: 50%; transform: translateX(-50%); z-index: 1; pointer-events: none;
    width: 600px; height: 600px; border-radius: 50%;
    background: radial-gradient(circle, rgba(234,179,8,0.08) 0%, transparent 70%);
    animation: spotPulse 4s ease-in-out infinite;
  }
  @keyframes spotPulse { 0%,100%{opacity:.6;transform:translateX(-50%) scale(1)} 50%{opacity:1;transform:translateX(-50%) scale(1.1)} }

  .arena-particles { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
  .a-particle {
    position: absolute; border-radius: 50%; opacity: 0;
    animation: particleFloat linear infinite;
  }
  @keyframes particleFloat {
    0% { opacity:0; transform: translateY(100vh) scale(.3); }
    15% { opacity:.7; }
    85% { opacity:.2; }
    100% { opacity:0; transform: translateY(-10vh) scale(.1); }
  }

  /* ═══════════════════════════════════════
     MAIN WRAPPER
     ═══════════════════════════════════════ */
  .arena-world {
    position: relative; z-index: 10;
    min-height: 100vh; display: flex; flex-direction: column;
  }

  /* ═══════════════════════════════════════
     TOP NAV BAR
     ═══════════════════════════════════════ */
  .arena-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 24px;
    background: rgba(10,10,25,0.9); backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--arena-border);
  }
  .arena-back { color: var(--arena-text2); text-decoration: none; font-weight: 700; font-size: .9rem; display: flex; align-items: center; gap: 6px; transition: color .2s; }
  .arena-back:hover { color: var(--arena-gold); }
  .arena-logo {  font-size: 1.3rem; font-weight: 900; color: var(--arena-gold); letter-spacing: -0.5px; }
  .arena-sound-btn {
    background: rgba(255,255,255,0.05); border: 1px solid var(--arena-border); color: var(--arena-text2);
    padding: 8px 16px; border-radius: 50px; font-size: .8rem; cursor: pointer; transition: all .2s;
  }
  .arena-sound-btn:hover { border-color: var(--arena-gold); color: var(--arena-gold); }

  /* ═══════════════════════════════════════
     MODE SELECTION SCREEN
     ═══════════════════════════════════════ */
  .mode-screen {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 40px 20px; text-align: center;
  }
  .mode-overline {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 20px; border-radius: 50px;
    background: rgba(234,179,8,0.08); border: 1px solid rgba(234,179,8,0.2);
     font-size: .6rem; letter-spacing: 3px;
    text-transform: uppercase; color: var(--arena-gold); font-weight: 700; margin-bottom: 20px;
  }
  .mode-overline::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--arena-gold);
    box-shadow: 0 0 10px var(--arena-gold); animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

  .mode-title {
     font-size: 3.5rem; font-weight: 900;
    background: linear-gradient(135deg, #fff 0%, var(--arena-gold) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin: 0 0 12px; line-height: 1.1;
  }
  .mode-subtitle { font-size: 1.1rem; color: var(--arena-text2); margin-bottom: 50px; max-width: 600px; line-height: 1.7; }

  .mode-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
    max-width: 800px; width: 100%;
  }

  .mode-card {
    background: var(--arena-surface); border: 1.5px solid var(--arena-border);
    border-radius: 20px; padding: 30px; cursor: pointer; text-align: left;
    transition: all .4s cubic-bezier(.34,1.56,.64,1); position: relative; overflow: hidden;
  }
  .mode-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--mc-c), transparent); opacity: 0; transition: opacity .3s;
  }
  .mode-card:hover { transform: translateY(-6px); border-color: var(--mc-c); box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .mode-card:hover::before { opacity: 1; }

  .mc-icon { font-size: 2.5rem; margin-bottom: 12px; }
  .mc-name { font-size: 1.3rem; font-weight: 800; color: var(--mc-c); margin-bottom: 8px; }
  .mc-desc { font-size: .88rem; color: var(--arena-text2); line-height: 1.6; margin-bottom: 15px; }
  .mc-diff {  font-size: .65rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--arena-text3); }
  .mc-diff span { color: var(--mc-c); }

  /* ═══════════════════════════════════════
     GAME HUD
     ═══════════════════════════════════════ */
  .game-screen { flex: 1; display: none; flex-direction: column; padding: 16px; max-width: 1100px; margin: 0 auto; width: 100%; }
  .game-screen.active { display: flex; }

  .hud-row { display: flex; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }

  /* Radar Chart */
  .hud-radar {
    flex: 0 0 200px; background: var(--arena-surface); border: 1px solid var(--arena-border);
    border-radius: 18px; padding: 16px; display: flex; flex-direction: column; align-items: center;
  }
  .hud-radar-title {  font-size: .6rem; letter-spacing: 2px; text-transform: uppercase; color: var(--arena-text3); margin-bottom: 8px; }
  .radar-canvas { width: 160px; height: 140px; }
  .radar-labels { display: flex; gap: 12px; margin-top: 6px; }
  .radar-label { font-size: .65rem; font-weight: 700; display: flex; align-items: center; gap: 4px; }
  .radar-dot { width: 6px; height: 6px; border-radius: 50%; }

  /* Stats Panel */
  .hud-stats {
    flex: 1; background: var(--arena-surface); border: 1px solid var(--arena-border);
    border-radius: 18px; padding: 16px 20px; display: flex; flex-direction: column; justify-content: center;
  }
  .hud-stats-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .hud-mode-name {  font-size: 1.4rem; font-weight: 900; color: var(--arena-gold); }
  .hud-round {  font-size: .7rem; color: var(--arena-text3); letter-spacing: 1px; }

  .hud-meters { display: flex; gap: 20px; flex-wrap: wrap; }
  .hud-meter { flex: 1; min-width: 120px; }
  .hud-meter-label { display: flex; justify-content: space-between; font-size: .7rem; font-weight: 700; margin-bottom: 4px; }
  .hud-meter-bar { height: 8px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden; }
  .hud-meter-fill { height: 100%; border-radius: 4px; transition: width .5s cubic-bezier(.34,1.56,.64,1); }

  /* Combo */
  .hud-combo {
    flex: 0 0 130px; background: var(--arena-surface); border: 1px solid var(--arena-border);
    border-radius: 18px; padding: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center;
  }
  .combo-label {  font-size: .6rem; letter-spacing: 2px; text-transform: uppercase; color: var(--arena-text3); margin-bottom: 6px; }
  .combo-value { font-size: 2.8rem; font-weight: 900; color: var(--arena-gold); line-height: 1; transition: all .3s; }
  .combo-value.hot { color: var(--arena-red); animation: comboPulse .5s ease; }
  .combo-value.fire { color: var(--arena-orange); animation: comboPulse .5s ease; text-shadow: 0 0 20px var(--arena-orange); }
  .combo-value.legendary { color: var(--arena-purple); animation: comboPulse .5s ease; text-shadow: 0 0 30px var(--arena-purple); }
  @keyframes comboPulse { 0%{transform:scale(1)} 50%{transform:scale(1.4)} 100%{transform:scale(1)} }
  .combo-streak { font-size: .7rem; color: var(--arena-text2); margin-top: 4px; }

  /* ═══════════════════════════════════════
     CROWD BAR
     ═══════════════════════════════════════ */
  .crowd-bar {
    background: var(--arena-surface); border: 1px solid var(--arena-border);
    border-radius: 14px; padding: 12px 20px; margin-bottom: 16px;
    display: flex; align-items: center; gap: 16px;
  }
  .crowd-faces {
    display: flex; gap: 3px; font-size: 1.3rem; transition: all .5s;
  }
  .crowd-face { transition: transform .3s, opacity .3s; }
  .crowd-mood-text { font-size: .8rem; font-weight: 700; flex: 1; }
  .crowd-meter { flex: 0 0 200px; height: 10px; background: rgba(255,255,255,.06); border-radius: 5px; overflow: hidden; }
  .crowd-meter-fill { height: 100%; border-radius: 5px; transition: width .5s, background .3s; }

  /* ═══════════════════════════════════════
     OPPONENT / SCENARIO BOX
     ═══════════════════════════════════════ */
  .scenario-box {
    background: rgba(239,68,68,0.06); border: 2px solid rgba(239,68,68,0.3);
    border-radius: 20px; padding: 28px 30px; position: relative; margin-bottom: 16px;
    transition: all .4s;
  }
  .scenario-box.neutral { background: rgba(56,189,248,0.06); border-color: rgba(56,189,248,0.3); }
  .scenario-box.success { background: rgba(16,185,129,0.06); border-color: rgba(16,185,129,0.3); }

  .scenario-speaker {
    position: absolute; top: -12px; left: 24px;
    padding: 4px 16px; border-radius: 20px; font-weight: 900; font-size: .75rem;
    letter-spacing: 1px; text-transform: uppercase;
  }
  .scenario-speaker.opponent { background: var(--arena-red); color: #fff; }
  .scenario-speaker.narrator { background: var(--arena-blue); color: #000; }
  .scenario-speaker.you { background: var(--arena-green); color: #000; }

  .scenario-text { font-size: 1.25rem; font-weight: 700; line-height: 1.5; margin: 0; font-style: italic; }
  .scenario-context { font-size: .85rem; color: var(--arena-text2); margin-top: 10px; font-style: normal; }

  /* ═══════════════════════════════════════
     TIMER
     ═══════════════════════════════════════ */
  .game-timer { height: 5px; background: rgba(255,255,255,.04); border-radius: 3px; margin-bottom: 16px; overflow: hidden; }
  .game-timer-fill { height: 100%; background: var(--arena-gold); transition: width .1s linear, background .3s; border-radius: 3px; }
  .game-timer-fill.danger { background: var(--arena-red); }

  /* ═══════════════════════════════════════
     OPTIONS / CHOICES
     ═══════════════════════════════════════ */
  .choices-area {
    background: var(--arena-surface); border: 1px solid var(--arena-border);
    border-radius: 20px; padding: 24px; flex: 1;
  }
  .choices-title {
     font-size: .7rem; letter-spacing: 2px;
    text-transform: uppercase; color: var(--arena-gold); margin-bottom: 16px; text-align: center;
  }

  .choices-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }

  .choice-btn {
    background: rgba(255,255,255,0.03); border: 1.5px solid var(--arena-border);
    border-radius: 14px; padding: 18px 22px; cursor: pointer; text-align: left;
    transition: all .3s; display: flex; flex-direction: column; gap: 6px; color: var(--arena-text);
  }
  .choice-btn:hover { border-color: var(--arena-blue); background: rgba(56,189,248,0.06); transform: translateX(8px); }
  .choice-btn .choice-tag {
     font-size: .65rem; font-weight: 900;
    text-transform: uppercase; letter-spacing: 1px; color: var(--arena-blue);
  }
  .choice-btn .choice-text { font-size: 1rem; font-weight: 600; line-height: 1.5; }

  .choice-btn.correct { border-color: var(--arena-green); background: rgba(16,185,129,0.12); pointer-events: none; }
  .choice-btn.wrong { border-color: var(--arena-red); background: rgba(239,68,68,0.12); pointer-events: none; opacity: .6; }
  .choice-btn.disabled { pointer-events: none; opacity: .4; }

  /* ═══════════════════════════════════════
     FEEDBACK OVERLAY
     ═══════════════════════════════════════ */
  .feedback-modal {
    position: fixed; inset: 0; z-index: 200; display: none;
    background: rgba(5,5,16,0.95); backdrop-filter: blur(30px);
    flex-direction: column; align-items: center; justify-content: center;
    padding: 40px; text-align: center;
  }
  .feedback-modal.active { display: flex; }
  .fb-icon { font-size: 5rem; margin-bottom: 16px; animation: fbBounce .6s ease; }
  @keyframes fbBounce { 0%{transform:scale(0) rotate(-20deg)} 60%{transform:scale(1.2) rotate(5deg)} 100%{transform:scale(1) rotate(0)} }
  .fb-title {  font-size: 2.5rem; font-weight: 900; margin-bottom: 12px; }
  .fb-desc { font-size: 1.05rem; color: var(--arena-text2); max-width: 550px; line-height: 1.7; margin-bottom: 30px; }
  .fb-xp {  font-size: 1.2rem; font-weight: 900; color: var(--arena-gold); margin-bottom: 24px; }
  .fb-btn {
    background: var(--arena-gold); color: #000; border: none; padding: 14px 40px;
    border-radius: 50px; font-size: 1rem; font-weight: 900; cursor: pointer;
    text-transform: uppercase; letter-spacing: 1px; transition: all .3s;
  }
  .fb-btn:hover { transform: scale(1.05); box-shadow: 0 10px 30px var(--arena-gold-glow); }

  /* ═══════════════════════════════════════
     END GAME SCREEN
     ═══════════════════════════════════════ */
  .end-screen {
    position: fixed; inset: 0; z-index: 300; display: none;
    background: var(--arena-bg);
    flex-direction: column; align-items: center; justify-content: center;
    padding: 40px; text-align: center;
  }
  .end-screen.active { display: flex; }
  .end-badge { font-size: 6rem; margin-bottom: 16px; animation: fbBounce .8s ease; }
  .end-title {  font-size: 3rem; font-weight: 900; margin-bottom: 8px; }
  .end-rank { font-size: 1.3rem; color: var(--arena-gold); font-weight: 800; margin-bottom: 24px; }

  .end-stats {
    display: flex; gap: 30px; margin-bottom: 30px; flex-wrap: wrap; justify-content: center;
  }
  .end-stat { display: flex; flex-direction: column; align-items: center; }
  .end-stat-n {  font-size: 2.5rem; font-weight: 900; line-height: 1; }
  .end-stat-l {  font-size: .6rem; letter-spacing: 2px; text-transform: uppercase; color: var(--arena-text3); margin-top: 4px; }

  .end-radar { margin-bottom: 30px; }
  .end-btns { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .end-btn-primary { background: var(--arena-gold); color: #000; border: none; padding: 14px 36px; border-radius: 50px; font-size: 1rem; font-weight: 900; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; transition: all .3s; }
  .end-btn-primary:hover { transform: scale(1.05); box-shadow: 0 10px 30px var(--arena-gold-glow); }
  .end-btn-secondary { background: transparent; color: var(--arena-text2); border: 1.5px solid var(--arena-border); padding: 14px 36px; border-radius: 50px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all .3s; text-decoration: none; }
  .end-btn-secondary:hover { border-color: var(--arena-gold); color: var(--arena-gold); }

  /* ═══════════════════════════════════════
     SHAKE ANIMATION
     ═══════════════════════════════════════ */
  .shake { animation: shakeIt .4s cubic-bezier(.36,.07,.19,.97) both; }
  @keyframes shakeIt { 10%,90%{transform:translateX(-2px)} 20%,80%{transform:translateX(4px)} 30%,50%,70%{transform:translateX(-6px)} 40%,60%{transform:translateX(6px)} }

  /* ═══════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════ */
  @media (max-width: 900px) {
    .mode-grid { grid-template-columns: 1fr; max-width: 450px; }
    .mode-title { font-size: 2.5rem; }
    .hud-row { flex-direction: column; }
    .hud-radar { flex: auto; flex-direction: row; gap: 16px; }
    .hud-combo { flex: auto; flex-direction: row; gap: 12px; }
  }
  @media (max-width: 500px) {
    .mode-title { font-size: 2rem; }
    .scenario-text { font-size: 1.05rem; }
    .crowd-meter { flex: 0 0 100px; }
    .end-title { font-size: 2rem; }
  }
</style>

<!-- ═══════════ CINEMATIC BACKGROUND ═══════════ -->
<div class="arena-cosmos"></div>
<div class="arena-grid-floor"></div>
<div class="arena-spotlight"></div>
<div class="arena-particles" id="arenaParticles"></div>

<div class="arena-world">

  <!-- ═══ TOP BAR ═══ -->
  <div class="arena-topbar">
    <a href="/retorik" class="arena-back">← Retorik</a>
    <div class="arena-logo">⚔️ Retorik Arena</div>
    <button class="arena-sound-btn" id="soundToggle" onclick="toggleSound()">🔇 Ses Kapalı</button>
  </div>

  <!-- ═══════════════════════════════════════════════════
       MODE SELECTION SCREEN
       ═══════════════════════════════════════════════════ -->
  <div class="mode-screen" id="modeScreen">
    <div class="mode-overline">İnteraktif Simülatör</div>
    <h1 class="mode-title">Retorik Arena</h1>
    <p class="mode-subtitle">Sadece soru cevaplama değil — gerçek zamanlı strateji, zamanlama baskısı, combo zincirleri ve canlı kalabalık tepkileriyle dolu sinematik bir ikna savaşı.</p>

    <div class="mode-grid">
      <div class="mode-card" style="--mc-c:#eab308;" onclick="startMode('senate')">
        <div class="mc-icon">🏛️</div>
        <div class="mc-name">Senato Münazarası</div>
        <div class="mc-desc">Demagog rakibiniz safsatalarla saldırıyor. Önce teşhis edin, sonra retorik judosuyla karşılık verin. Üst üste doğru hamleler = combo zinciri!</div>
        <div class="mc-diff">Zorluk: <span>⭐⭐⭐</span></div>
      </div>
      <div class="mode-card" style="--mc-c:#ef4444;" onclick="startMode('press')">
        <div class="mc-icon">📰</div>
        <div class="mc-name">Basın Krizi</div>
        <div class="mc-desc">Şirketiniz skandala battı. Gazeteciler kan istiyor. Her soruya doğru teknikle (Çerçeveleme, Köprü, Prolepsis) yanıt verin.</div>
        <div class="mc-diff">Zorluk: <span>⭐⭐⭐⭐</span></div>
      </div>
      <div class="mode-card" style="--mc-c:#38bdf8;" onclick="startMode('pitch')">
        <div class="mc-icon">💼</div>
        <div class="mc-name">Yatırımcı Pitch</div>
        <div class="mc-desc">Melek yatırımcıları ikna edin. Her adımda Ethos/Pathos/Logos dengenizi ayarlayın. Yatırımcının profili rastgele değişir!</div>
        <div class="mc-diff">Zorluk: <span>⭐⭐</span></div>
      </div>
      <div class="mode-card" style="--mc-c:#a855f7;" onclick="startMode('crisis')">
        <div class="mc-icon">🔥</div>
        <div class="mc-name">Kriz Yönetimi</div>
        <div class="mc-desc">Veri sızıntısı skandalı! Basın toplantısı, sosyal medya ve yönetim kurulu — 3 farklı kitleye 3 farklı mesaj.</div>
        <div class="mc-diff">Zorluk: <span>⭐⭐⭐⭐⭐</span></div>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════
       GAME SCREEN
       ═══════════════════════════════════════════════════ -->
  <div class="game-screen" id="gameScreen">

    <!-- HUD Row -->
    <div class="hud-row">
      <div class="hud-radar">
        <div class="hud-radar-title">Retorik Dengesi</div>
        <canvas class="radar-canvas" id="radarCanvas" width="160" height="140"></canvas>
        <div class="radar-labels">
          <div class="radar-label"><div class="radar-dot" style="background:#10b981"></div>Ethos</div>
          <div class="radar-label"><div class="radar-dot" style="background:#f43f5e"></div>Pathos</div>
          <div class="radar-label"><div class="radar-dot" style="background:#3b82f6"></div>Logos</div>
        </div>
      </div>

      <div class="hud-stats">
        <div class="hud-stats-top">
          <div class="hud-mode-name" id="hudModeName">—</div>
          <div class="hud-round" id="hudRound">ROUND 1/5</div>
        </div>
        <div class="hud-meters">
          <div class="hud-meter">
            <div class="hud-meter-label"><span>🏆 XP</span><span id="xpText">0</span></div>
            <div class="hud-meter-bar"><div class="hud-meter-fill" id="xpFill" style="width:0%; background: linear-gradient(90deg, #eab308, #f59e0b);"></div></div>
