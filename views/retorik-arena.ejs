// UI UPDATES
// ═══════════════════════════════════════════════════════════════════════════
function updateHUD(){
  document.getElementById('xpText').textContent = state.xp;
  document.getElementById('xpFill').style.width = Math.min(state.xp/500*100,100)+'%';
  document.getElementById('trustText').textContent = Math.round(state.trust)+'%';
  document.getElementById('trustFill').style.width = Math.max(0,Math.min(state.trust,100))+'%';
  document.getElementById('momentumText').textContent = Math.round(state.momentum);
  document.getElementById('momentumFill').style.width = Math.max(0,Math.min(state.momentum,100))+'%';

  const cv = document.getElementById('comboValue');
  cv.textContent = '×'+state.comboMultiplier;
  cv.className = 'combo-value' + (state.combo>=5?' legendary':state.combo>=3?' fire':state.combo>=2?' hot':'');
  document.getElementById('comboStreak').textContent = state.combo+' seri';

  drawRadar('radarCanvas', state.ethos, state.pathos, state.logos);
  updateCrowd();
}

function updateCrowd(){
  const m = state.crowdMood;
  const faces = document.getElementById('crowdFaces');
  const mood = document.getElementById('crowdMood');
  const fill = document.getElementById('crowdFill');

  let emoji, text, color;
  if(m >= 80){ emoji='🥳'; text='Kalabalık coşku içinde!'; color='#10b981'; }
  else if(m >= 60){ emoji='😊'; text='Kalabalık sizi destekliyor.'; color='#22c55e'; }
  else if(m >= 40){ emoji='😐'; text='Kalabalık kararsız...'; color='#eab308'; }
  else if(m >= 20){ emoji='😒'; text='Kalabalık huzursuzlanıyor.'; color='#f97316'; }
  else { emoji='😡'; text='Kalabalık yuhalıyor!'; color='#ef4444'; }

  faces.textContent = emoji.repeat(8);
  mood.textContent = text;
  mood.style.color = color;
  fill.style.width = Math.max(0,Math.min(m,100))+'%';
  fill.style.background = color;
}

// ═══════════════════════════════════════════════════════════════════════════
// GAME FLOW
// ═══════════════════════════════════════════════════════════════════════════
const MODE_NAMES = { senate: '🏛️ Senato Münazarası', press: '📰 Basın Krizi', pitch: '💼 Yatırımcı Pitch', crisis: '🔥 Kriz Yönetimi' };
let fbCallback = null;
let scenarios = [];

function startMode(mode){
  state = { mode, round:0, phase:0, xp:0, trust:50, momentum:0, combo:0, comboMultiplier:1, ethos:40, pathos:40, logos:40, totalCorrect:0, totalWrong:0, crowdMood:50, timer:null, soundOn:state.soundOn };

  scenarios = [...SCENARIOS[mode]];
  // Shuffle scenarios
  for(let i=scenarios.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [scenarios[i],scenarios[j]]=[scenarios[j],scenarios[i]]; }

  document.getElementById('modeScreen').style.display = 'none';
  document.getElementById('gameScreen').classList.add('active');
  document.getElementById('hudModeName').textContent = MODE_NAMES[mode];

  updateHUD();
  playDiagnosePhase();
}

function playDiagnosePhase(){
  if(state.round >= scenarios.length){ return endGame(); }
  state.phase = 0;
  const sc = scenarios[state.round];
  const total = scenarios.length;

  document.getElementById('hudRound').textContent = `ROUND ${state.round+1}/${total}`;

  const box = document.getElementById('scenarioBox');
  box.className = 'scenario-box';
  const sp = document.getElementById('scenarioSpeaker');
  sp.className = 'scenario-speaker '+(state.mode==='pitch'?'narrator':'opponent');
  sp.textContent = state.mode==='pitch'?'💼 YATIRIMCI':state.mode==='press'?'📰 GAZETECİ':state.mode==='crisis'?'📺 HABER':'🎙️ DEMAGOG';
  document.getElementById('scenarioText').textContent = '"'+sc.attack+'"';
  document.getElementById('scenarioContext').textContent = sc.context;

  const diag = sc.diagnose;
  document.getElementById('choicesTitle').textContent = diag.title;
  renderOptions(diag.options, handleDiagnose);
  startTimer(diag.time, ()=>handleDiagnose(null));
}

function playRespondPhase(){
  state.phase = 1;
  const sc = scenarios[state.round];
  const resp = sc.respond;

  document.getElementById('choicesTitle').textContent = resp.title;
  renderOptions(resp.options, handleRespond);
  startTimer(resp.time, ()=>handleRespond(null));
}

function renderOptions(options, handler){
  const grid = document.getElementById('choicesGrid');
  grid.innerHTML = '';
  const shuffled = [...options].sort(()=>Math.random()-0.5);

  shuffled.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'choice-btn';
    btn.innerHTML = (opt.tag?`<span class="choice-tag">${opt.tag}</span>`:'')+`<span class="choice-text">${opt.text}</span>`;
    btn.onclick = () => { clearTimer(); handler(opt); };
    grid.appendChild(btn);
  });
}

function handleDiagnose(opt){
  clearTimer();
  if(!opt){
    applyPenalty(-10);
    showFeedback('⏱️','SÜRE BİTTİ','Teşhis yapmakta çok geciktiniz. Rakip avantaj kazandı.', -10, ()=>playRespondPhase());
  } else if(opt.correct){
    applyReward(15, opt);
    sfxCorrect();
    showFeedback('🎯','DOĞRU TEŞHİS!', opt.fb, 15, ()=>playRespondPhase());
  } else {
    applyPenalty(-10);
    sfxWrong();
    showFeedback('❌','YANLIŞ TEŞHİS', opt.fb, -10, ()=>playRespondPhase());
  }
}

function handleRespond(opt){
  clearTimer();
  if(!opt){
    applyPenalty(-20);
    showFeedback('⏱️','SESSİZ KALDINIZ','Sessizlik yenilgi olarak algılandı.', -20, ()=>nextRound());
  } else if(opt.correct){
    const pts = opt.effect * state.comboMultiplier;
    applyReward(pts, opt);
    sfxCombo();
    showFeedback('🥋','MÜKEMMEL HAMLE!', opt.fb, pts, ()=>nextRound());
  } else {
    applyPenalty(opt.effect);
    sfxWrong();
    showFeedback('💀','DARBE ALDINIZ', opt.fb, opt.effect, ()=>nextRound());
  }
}

function applyReward(pts, opt){
  state.combo++;
  state.comboMultiplier = state.combo >= 5 ? 5 : state.combo >= 3 ? 3 : state.combo >= 2 ? 2 : 1;
  state.xp += Math.abs(pts);
  state.trust = Math.min(100, state.trust + Math.abs(pts)/3);
  state.momentum = Math.min(100, state.momentum + 10);
  state.crowdMood = Math.min(100, state.crowdMood + Math.abs(pts)/3);
  state.totalCorrect++;
  if(opt.ethos) state.ethos = Math.max(0, Math.min(100, state.ethos + opt.ethos));
  if(opt.pathos) state.pathos = Math.max(0, Math.min(100, state.pathos + opt.pathos));
  if(opt.logos) state.logos = Math.max(0, Math.min(100, state.logos + opt.logos));
  updateHUD();
}

function applyPenalty(pts){
  state.combo = 0;
  state.comboMultiplier = 1;
  state.trust = Math.max(0, state.trust + pts/2);
  state.momentum = Math.max(0, state.momentum - 10);
  state.crowdMood = Math.max(0, state.crowdMood + pts/2);
  state.totalWrong++;
  document.getElementById('gameScreen').classList.add('shake');
  setTimeout(()=>document.getElementById('gameScreen').classList.remove('shake'),400);
  updateHUD();
}

function nextRound(){
  state.round++;
  if(state.trust <= 0){ return endGame(true); }
  playDiagnosePhase();
}

