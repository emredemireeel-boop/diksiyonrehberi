<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc !important; color: #0f172a !important; font-family: "Inter", sans-serif; overflow-x: hidden; margin: 0; padding: 0; }
  
  .court-container { padding: 40px 20px; max-width: 900px; margin: 0 auto; min-height: 85vh; display: flex; flex-direction: column; align-items: center; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #a855f7; text-transform: uppercase; letter-spacing: 1px; text-align: center; }
  p.desc { color: #475569; font-size: 1rem; line-height: 1.6; margin-bottom: 40px; text-align: center; max-width: 600px; }

  /* Court Room */
  .court-room { width: 100%; background: #f0f4f8; border: 4px solid #e2e8f0; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.1); position: relative; }
  
  /* Top: Judge */
  .judge-area { background: #f8fafc; padding: 15px; border-bottom: 4px solid #e2e8f0; text-align: center; position: relative; }
  .judge-avatar { font-size: 4rem; margin-bottom: -15px; }
  .case-file { font-size: 0.9rem; color: #facc15; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; }

  /* Middle: Opposing Lawyer */
  .lawyer-area { padding: 40px; background: url('data:image/svg+xml;utf8,<svg width="20" height="20" xmlns="http://www.w3.org/2000/svg"><rect width="20" height="20" fill="%231e293b"/><path d="M0 0l20 20M20 0L0 20" stroke="%23334155" stroke-width="1" opacity="0.3"/></svg>'); display: flex; flex-direction: column; align-items: center; position: relative; }
  
  .lawyer-sprite { font-size: 6rem; filter: drop-shadow(0 10px 10px rgba(0,0,0,0.5)); transition: transform 0.2s; }
  .lawyer-sprite.shock { transform: scale(1.1) rotate(-5deg); filter: grayscale(100%) contrast(200%); }

  .speech-bubble { background: #fff; color: #f8fafc; padding: 25px; border-radius: 20px; border-bottom-right-radius: 0; font-size: 1.3rem; font-weight: 700; line-height: 1.5; max-width: 80%; position: relative; margin-top: -20px; margin-bottom: 30px; box-shadow: 5px 5px 0 #475569; }
  .speech-bubble::after { content: ''; position: absolute; bottom: -20px; right: 20px; border-width: 20px 20px 0 0; border-style: solid; border-color: #fff transparent transparent transparent; }

  /* Action Area */
  .action-area { background: #f8fafc; padding: 30px; border-top: 4px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; gap: 20px; position: relative; z-index: 10; }
  
  .btn-objection { background: #f43f5e; color: #0f172a; font-size: 2rem; font-weight: 900; text-transform: uppercase; border: none; padding: 20px 50px; border-radius: 50px; cursor: pointer; box-shadow: 0 10px 0 #9f1239, 0 20px 30px rgba(244,63,94,0.5); transition: all 0.1s; letter-spacing: 2px; }
  .btn-objection:active { transform: translateY(10px); box-shadow: 0 0 0 #9f1239, 0 10px 15px rgba(244,63,94,0.5); }
  .btn-objection:disabled { background: #475569; box-shadow: 0 10px 0 #e2e8f0; cursor: not-allowed; color: #475569; transform: translateY(10px); }

  /* Options Panel (Hidden by default) */
  .options-panel { display: none; width: 100%; grid-template-columns: 1fr; gap: 15px; animation: slideUp 0.3s forwards; }
  @media(min-width:600px){ .options-panel { grid-template-columns: 1fr 1fr; } }
  
  .opt-btn { background: #f0f4f8; border: 2px solid #a855f7; color: #e2e8f0; font-size: 1.1rem; font-weight: 800; padding: 15px; border-radius: 12px; cursor: pointer; transition: all 0.2s; }
  .opt-btn:hover { background: #a855f7; color: #0f172a; transform: translateY(-3px); }

  /* Objection Animation Overlay */
  .obj-overlay { position: absolute; inset: 0; background: rgba(244, 63, 94, 0.9); z-index: 100; display: none; align-items: center; justify-content: center; overflow: hidden; pointer-events: none; }
  .obj-text { font-size: 8rem; font-weight: 900; color: #0f172a; text-transform: uppercase; text-shadow: 10px 10px 0 #f8fafc; transform: scale(0) rotate(-10deg); animation: smashIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

  @keyframes smashIn { 
    0% { transform: scale(3) rotate(20deg); opacity: 0; } 
    50% { transform: scale(0.8) rotate(-5deg); opacity: 1; }
    100% { transform: scale(1) rotate(-10deg); opacity: 1; }
  }
  @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  @keyframes screenShake { 0%{transform:translate(0)} 20%{transform:translate(-15px,15px)} 40%{transform:translate(15px,-15px)} 60%{transform:translate(-15px,-15px)} 80%{transform:translate(15px,15px)} 100%{transform:translate(0)} }

  /* Verdict Banner */
  .verdict-banner { background: #10b981; color: #f8fafc; width: 100%; padding: 20px; font-size: 1.5rem; font-weight: 900; text-align: center; text-transform: uppercase; position: absolute; top: 30%; z-index: 50; display: none; box-shadow: 0 10px 30px rgba(16,185,129,0.5); }
  .verdict-banner.fail { background: #f43f5e; color: #0f172a; box-shadow: 0 10px 30px rgba(244,63,94,0.5); }
  
  .next-btn { background: #f8fafc; color: #0f172a; border: 2px solid #fff; padding: 10px 20px; border-radius: 8px; font-weight: 800; cursor: pointer; margin-top: 15px; }

  .game-over { display: none; text-align: center; padding: 50px; background: #f0f4f8; border-radius: 20px; border: 2px solid #a855f7; margin-top:30px; width: 100%; }
</style>

<div class="court-container">
  <h1>Mahkeme Salonu</h1>
  <p class="desc">Rakip avukatlar jüriyi manipüle etmek için mantık hatalarını kullanıyor. Doğru anda İTİRAZ EDİN ve hangi safsatayı yaptıklarını jüriye kanıtlayın!</p>

  <div class="court-room" id="courtRoom">
    
    <div class="obj-overlay" id="objOverlay">
      <div class="obj-text">İTİRAZ!</div>
    </div>

    <div class="verdict-banner" id="verdictBanner">
      <div id="vTitle">İTİRAZ KABUL EDİLDİ!</div>
      <div style="font-size: 1rem; font-weight:600; margin-top:10px; text-transform:none;" id="vDesc">...</div>
      <button class="next-btn" onclick="nextCase()">Sonraki Dava ➔</button>
    </div>

    <div class="judge-area">
      <div class="case-file" id="caseName">Dava #01: Belediye Bütçesi</div>
      <div class="judge-avatar">👨‍⚖️</div>
    </div>

    <div class="lawyer-area">
      <div class="speech-bubble" id="speechBubble">...</div>
      <div class="lawyer-sprite" id="lawyerSprite">🕴️</div>
    </div>

    <div class="action-area">
      <button class="btn-objection" id="btnObj" onclick="triggerObjection()">İtiraz Ediyorum!</button>
      
      <div class="options-panel" id="optPanel">
        <!-- Injected -->
      </div>
    </div>
  </div>

  <div class="game-over" id="gameOver">
    <div style="font-size: 5rem; margin-bottom:20px;">⚖️</div>
    <h2 style="font-size:2.5rem; color:#a855f7; margin:0 0 15px 0;">Adaletin Kılıcı!</h2>
    <p style="color:#334155; font-size:1.1rem; margin-bottom:30px;">Tüm manipülatif avukatları yendiniz. Safsatalar artık size karşı kullanılamaz.</p>
    <a href="/safsata" style="background:#a855f7; color: #0f172a; padding:15px 30px; border-radius:12px; text-decoration:none; font-weight:800; text-transform:uppercase;">Akademiye Dön</a>
  </div>

</div>

<script>
  const cases = [
    {
      caseName: "Dava #01: Belediye Bütçesi",
      speech: "Sayın Jüri! Savunma makamı şehrin parklarına daha fazla bütçe ayrılmasını istiyor. Yani yolları köstebek yuvasına çevirip, hastaneleri kapatıp bütün parayı çimenlere gömmemizi istiyorlar!",
      options: [
        { text: "Kırmızı Ringa Balığı", isCorrect: false },
        { text: "Saman Adam (Strawman)", isCorrect: true },
        { text: "Otoriteye Başvurma", isCorrect: false },
        { text: "Sürü Psikolojisi", isCorrect: false }
      ],
      fbSuccess: "Doğru! Savunmanın masum 'park bütçesi' teklifini, 'hastaneleri kapatmak' gibi aşırı bir noktaya (Saman Adam) çarpıttı.",
      fbFail: "Yanlış! İtirazınız reddedildi. Jüri manipüle oldu."
    },
    {
      caseName: "Dava #02: Gıda Güvenliği",
      speech: "Bu enerji içeceğinin kalp krizini tetiklediğini iddia ediyorlar. Sayın Jüri, şirketimiz 50 yıldır bu ülkeye hizmet ediyor, binlerce kişiye istihdam sağlıyoruz, milli gururumuzuz!",
      options: [
        { text: "Sahte İkilem", isCorrect: false },
        { text: "Kişiye Saldırı", isCorrect: false },
        { text: "Kaygan Zemin", isCorrect: false },
        { text: "Kırmızı Ringa (Red Herring)", isCorrect: true }
      ],
      fbSuccess: "Mükemmel İtiraz! Kalp krizi riskini (asıl konu) tartışmak yerine milli gurur ve istihdam gibi alakasız ama duygusal bir konuyla (Kırmızı Ringa) dikkat dağıttı.",
      fbFail: "Yanlış! İtirazınız reddedildi. Şirket jüriyi duygusal olarak ele geçirdi."
    },
    {
      caseName: "Dava #03: Teknoloji Patent İhlali",
      speech: "Rakip şirketin CEO'sunun bu patenti bizden çaldığı çok açık! Neden mi inanasınız? Çünkü dünyaca ünlü pop yıldızı X bile dünkü konserinde 'O CEO tam bir hırsız' dedi!",
      options: [
        { text: "Otoriteye Başvurma", isCorrect: true },
        { text: "Saman Adam", isCorrect: false },
        { text: "Sürü Psikolojisi", isCorrect: false },
        { text: "Yanlış Neden", isCorrect: false }
      ],
      fbSuccess: "Doğru Tespit! Bir pop yıldızının fikri, hukuki ve teknik bir patent davasında 'uzmanlık/otorite' sayılamaz.",
      fbFail: "Yanlış İtiraz! Jüri pop yıldızının sözüne inandı."
    },
    {
      caseName: "Dava #04: Eğitim Reformu",
      speech: "Eğer çocukların okulda 1 saat daha fazla sanat eğitimi almasına izin verirsek, yarın matematikten nefret edecekler, üniversiteyi kazanamayacaklar ve sonunda hepsi işsiz kalacak!",
      options: [
        { text: "Kırmızı Ringa Balığı", isCorrect: false },
        { text: "Sürü Psikolojisi", isCorrect: false },
        { text: "Kaygan Zemin (Slippery Slope)", isCorrect: true },
        { text: "Sahte İkilem", isCorrect: false }
      ],
      fbSuccess: "İtiraz Kabul Edildi! Sadece 1 saatlik sanat eğitimini zincirleme felaketlere bağlayarak (Slippery Slope) mantıksız bir korku yarattı.",
      fbFail: "Yanlış! Kaygan zemin safsatasına düştünüz."
    }
  ];

  let currIndex = 0;

  function loadCase() {
    if(currIndex >= cases.length) {
      document.getElementById('courtRoom').style.display = 'none';
      document.getElementById('gameOver').style.display = 'block';
      return;
    }

    const c = cases[currIndex];
    document.getElementById('caseName').textContent = c.caseName;
    document.getElementById('speechBubble').textContent = c.speech;
    
    // Reset UI
    document.getElementById('lawyerSprite').className = 'lawyer-sprite';
    document.getElementById('btnObj').style.display = 'block';
    document.getElementById('btnObj').disabled = false;
    document.getElementById('optPanel').style.display = 'none';
    document.getElementById('verdictBanner').style.display = 'none';

    // Populate options
    const panel = document.getElementById('optPanel');
    panel.innerHTML = '';
    
    const shuffled = [...c.options].sort(() => Math.random() - 0.5);
    shuffled.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'opt-btn';
      btn.textContent = opt.text;
      btn.onclick = () => selectVerdict(opt, btn);
      panel.appendChild(btn);
    });
  }

  function triggerObjection() {
    // 1. Shake screen
    const court = document.getElementById('courtRoom');
    court.style.animation = 'screenShake 0.4s ease-in-out';
    setTimeout(() => court.style.animation = '', 400);

    // 2. Flash OBJECTION overlay
    const overlay = document.getElementById('objOverlay');
    overlay.style.display = 'flex';
    setTimeout(() => {
      overlay.style.display = 'none';
    }, 1000);

    // 3. Shock Lawyer
    document.getElementById('lawyerSprite').classList.add('shock');

    // 4. Hide Button, Show Options
    document.getElementById('btnObj').style.display = 'none';
    
    setTimeout(() => {
      document.getElementById('optPanel').style.display = 'grid';
    }, 1000);
  }

  function selectVerdict(opt, btn) {
    const c = cases[currIndex];
    const banner = document.getElementById('verdictBanner');
    const vTitle = document.getElementById('vTitle');
    const vDesc = document.getElementById('vDesc');

    // Disable all options
    document.querySelectorAll('.opt-btn').forEach(b => b.style.pointerEvents = 'none');

    banner.style.display = 'block';

    if(opt.isCorrect) {
      btn.style.background = '#10b981';
      btn.style.borderColor = '#10b981';
      banner.className = 'verdict-banner';
      vTitle.textContent = "İTİRAZ KABUL EDİLDİ!";
      vDesc.textContent = c.fbSuccess;
    } else {
      btn.style.background = '#f43f5e';
      btn.style.borderColor = '#f43f5e';
      banner.className = 'verdict-banner fail';
      vTitle.textContent = "İTİRAZ REDDEDİLDİ!";
      vDesc.textContent = c.fbFail;
      
      // highlight correct
      document.querySelectorAll('.opt-btn').forEach(b => {
        if(b.textContent === c.options.find(o=>o.isCorrect).text) {
          b.style.borderColor = '#10b981';
          b.style.color = '#10b981';
        }
      });
    }
  }

  function nextCase() {
    currIndex++;
    loadCase();
  }

  // Init
  loadCase();

</script>

<%- include('partials/main-footer') %>


