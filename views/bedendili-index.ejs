<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Tab Script (Adım 2)
    const tabs = document.querySelectorAll('.comp-tab');
    const panes = document.querySelectorAll('.comp-pane');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));
        
        tab.classList.add('active');
        const target = document.getElementById(tab.dataset.target);
        if(target) target.classList.add('active');
      });
    });

    // Slider Script (Adım 4)
    const sliders = document.querySelectorAll('.comp-slider-container');
    sliders.forEach(slider => {
      const after = slider.querySelector('.comp-img-after');
      const handle = slider.querySelector('.comp-slider-handle');
      const afterInner = slider.querySelector('.comp-img-after .comp-content-inner');
      const beforeInner = slider.querySelector('.comp-img-before .comp-content-inner');
      
      const updateWidth = () => {
        const w = slider.offsetWidth + 'px';
        afterInner.style.width = w;
        beforeInner.style.width = w;
      };
      updateWidth();
      window.addEventListener('resize', updateWidth);

      let isDragging = false;
      
      const move = (clientX) => {
        const rect = slider.getBoundingClientRect();
        let x = clientX - rect.left;
        if(x < 0) x = 0;
        if(x > rect.width) x = rect.width;
        
        const percent = (x / rect.width) * 100;
        after.style.width = percent + '%';
        handle.style.left = percent + '%';
      };

      handle.addEventListener('mousedown', () => isDragging = true);
      window.addEventListener('mouseup', () => isDragging = false);
      slider.addEventListener('mousemove', (e) => {
        if(!isDragging) return;
        move(e.clientX);
      });

      // Touch support
      handle.addEventListener('touchstart', () => isDragging = true, {passive: true});
      window.addEventListener('touchend', () => isDragging = false);
      slider.addEventListener('touchmove', (e) => {
        if(!isDragging) return;
        move(e.touches[0].clientX);
      }, {passive: true});
    });

    // Simülatör Script (Adım 5)
    const simQuestions = [
      {
        text: "Senaryo 1: Kritik bir yatırımcı toplantısındasınız. Size bütçe ile ilgili çok zor ve beklenmedik bir soru soruldu. İlk beden dili tepkiniz ne olmalı?",
        options: [
          { text: "Hemen kollarımı kavuşturup geriye yaslanırım.", icon: "fa-person-falling", impact: -30, feedback: "Kolları kavuşturmak ve geriye yaslanmak savunmaya geçtiğinizi ve köşeye sıkıştığınızı bağırır. Liderlik puanınız düştü." },
          { text: "Ellerimi masaya açık bir şekilde koyar, göz teması kurarak hafifçe öne eğilirim.", icon: "fa-hands", impact: +10, feedback: "Mükemmel! Açık eller dürüstlüğü, öne eğilmek ise konudan kaçmadığınızı gösterir.", correct: true },
          { text: "Gözlerimi tavana diker, elimle çenemi kaşıyarak düşünürüm.", icon: "fa-face-rolling-eyes", impact: -20, feedback: "Göz temasını kesmek ve yüze dokunmak yalan söyleme veya aşırı gerginlik belirtisi olarak algılanır." }
        ]
      },
      {
        text: "Senaryo 2: Şirket içi bir kriz var ve 50 çalışanın karşısına geçip onlara durumu açıklayacaksınız. Sahneye çıktığınızda nerede durursunuz?",
        options: [
          { text: "Kürsünün arkasına geçer, iki elimle kürsüyü sıkıca tutarım.", icon: "fa-street-view", impact: -20, feedback: "Kürsü sizinle dinleyici arasında bir bariyerdir. Onlara korktuğunuzu ve aranıza duvar ördüğünüzü hissettirir." },
          { text: "Sahnede sürekli ve hızlı bir şekilde volta atarak konuşurum.", icon: "fa-person-running", impact: -15, feedback: "Sürekli hareket etmek panik havası yaratır, dinleyicinin odaklanmasını zorlaştırır." },
          { text: "Kürsüyü kullanmam, sahnenin ortasında dik bir duruşla, ellerim açık bir şekilde merkeze yerleşirim.", icon: "fa-person-rays", impact: +15, feedback: "Harika! Bariyersiz iletişim, tam şeffaflık (Arete) ve sahne hakimiyeti (Phronesis) sağlar.", correct: true }
        ]
      },
      {
        text: "Senaryo 3: Birisi size haksız bir eleştiri yöneltti. Yanıt vermeden önce yüz ifadeniz nasıl olmalı?",
        options: [
          { text: "Hafif ve samimi bir tebessüm ile göz teması kurarım.", icon: "fa-face-smile-beam", impact: +15, feedback: "Harika! Kontrolün sizde olduğunu, tahriklere kapılmadığınızı ve kendinize güvendiğinizi (Phronesis) gösterir.", correct: true },
          { text: "Gözlerimi kısar ve kaşlarımı çatarım.", icon: "fa-face-angry", impact: -20, feedback: "Agresif ve tehditkar bir tavır. Retorik ustası asla öfkesine yenik düşmez." },
          { text: "Donuk bir ifade takınır ve gözlerimi kaçırırım.", icon: "fa-face-meh", impact: -15, feedback: "Zayıf ve sindirilmiş görünürsünüz. Karşı tarafın eleştirisi psikolojik olarak üstünlük sağlar." }
        ]
      }
    ];

    let currentQ = 0;
    let ethosScore = 100;
    
    const qEl = document.getElementById('sim-question');
    const optEl = document.getElementById('sim-options');
    const fbEl = document.getElementById('sim-feedback');
    const nextBtn = document.getElementById('sim-next-btn');
    const scoreEl = document.getElementById('sim-score');

    function renderQuestion() {
      if(currentQ >= simQuestions.length) {
        qEl.innerHTML = `Simülasyon Tamamlandı! <br><br> Nihai Ethos Puanınız: <strong style="color:var(--bl-primary); font-size:2.5rem">${ethosScore}</strong>/100`;
        optEl.innerHTML = "";
        fbEl.style.display = "block";
        fbEl.className = "sim-feedback success";
        if(ethosScore > 80) {
          fbEl.innerHTML = "<strong>Mükemmel!</strong> Gerçek bir lider gibi beden dilinize hakimsiniz. Söylediklerinizi bedeniniz de onaylıyor.";
        } else if(ethosScore > 50) {
          fbEl.innerHTML = "<strong>Orta Seviye.</strong> Gelişime açık yönleriniz var. Stres anlarında beden dilinizi daha iyi kontrol etmelisiniz.";
        } else {
          fbEl.innerHTML = "<strong>Zayıf.</strong> Beden diliniz sizi ele veriyor. Retorik modülünün pratiklerini daha fazla uygulamalısınız.";
        }
        nextBtn.style.display = "none";
        return;
      }

      const q = simQuestions[currentQ];
      qEl.textContent = q.text;
      optEl.innerHTML = "";
      fbEl.style.display = "none";
      nextBtn.style.display = "none";

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('div');
        btn.className = 'sim-option';
        btn.innerHTML = `<i class="fa-solid ${opt.icon}"></i> <span>${opt.text}</span>`;
        btn.onclick = () => selectOption(opt, btn, idx);
        optEl.appendChild(btn);
      });
    }

    function selectOption(opt, btnEl, optIdx) {
      // Disable all options
      const allOpts = optEl.querySelectorAll('.sim-option');
      allOpts.forEach(b => b.style.pointerEvents = 'none');

      ethosScore += opt.impact;
      if(ethosScore > 100) ethosScore = 100;
      if(ethosScore < 0) ethosScore = 0;
      
      // Animate score
      scoreEl.style.transform = 'scale(1.5)';
      setTimeout(() => scoreEl.style.transform = 'scale(1)', 300);
      scoreEl.textContent = ethosScore;

      fbEl.style.display = "block";
      const impactText = opt.impact > 0 ? `+${opt.impact} Ethos` : `${opt.impact} Ethos`;
      fbEl.innerHTML = `<strong>${impactText}</strong><br>${opt.feedback}`;
      
      if(opt.correct) {
        btnEl.classList.add('correct');
        fbEl.className = "sim-feedback success";
      } else {
        btnEl.classList.add('wrong');
        fbEl.className = "sim-feedback error";
        // Highlight correct one
        simQuestions[currentQ].options.forEach((o, i) => {
          if(o.correct) allOpts[i].classList.add('correct');
        });
      }

      nextBtn.style.display = "block";
    }

    nextBtn.onclick = () => {
      currentQ++;
      renderQuestion();
    };

    renderQuestion();

    // Case Studies Script (Adım 6)
    const caseTabs = document.querySelectorAll('.case-tab');
    const casePanes = document.querySelectorAll('.case-pane');

    caseTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        caseTabs.forEach(t => t.classList.remove('active'));
        casePanes.forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        const target = document.getElementById(tab.dataset.target);
        if(target) target.classList.add('active');
      });
    });

    const casePoints = document.querySelectorAll('.case-point');
    casePoints.forEach(point => {
      point.addEventListener('click', (e) => {
        const pane = point.closest('.case-pane');
        const points = pane.querySelectorAll('.case-point');
        points.forEach(p => p.classList.remove('active'));
        point.classList.add('active');

        const analysisText = pane.querySelector('.case-analysis-text');
        const timeBadge = pane.querySelector('.case-time-badge');
        
        analysisText.style.opacity = 0;
        setTimeout(() => {
          analysisText.textContent = point.dataset.info;
          timeBadge.textContent = point.dataset.time;
          analysisText.style.opacity = 1;
        }, 200);
      });
    });

    // Checklist Script (Adım 7)
    const chkInputs = document.querySelectorAll('.chk-input');
    const chkFill = document.getElementById('chk-fill');
    const chkPct = document.getElementById('chk-pct');
    const chkSuccess = document.getElementById('chk-success');

    const updateChecklist = () => {
      let checkedCount = 0;
      chkInputs.forEach(input => {
        if(input.checked) checkedCount++;
      });
      
      const pct = Math.round((checkedCount / chkInputs.length) * 100);
      chkFill.style.width = pct + '%';
      chkPct.textContent = pct;

      if(pct === 100) {
        chkSuccess.style.display = 'block';
      } else {
        chkSuccess.style.display = 'none';
      }
    };

    chkInputs.forEach(input => {
      input.addEventListener('change', updateChecklist);
    });

    // Eğitim Modülü Script (Adım 8)
    const speedBtns = document.querySelectorAll('.speed-btn');
    speedBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        speedBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        // Normalde burada video.playbackRate ayarlanır.
      });
    });

    const trainPlayBtn = document.getElementById('train-play');
    const trainStepsDom = document.querySelectorAll('.train-steps li');
    let trainInterval;
    
    trainPlayBtn.addEventListener('click', () => {
      if(trainPlayBtn.innerHTML.includes('Oynat') || trainPlayBtn.innerHTML.includes('Tekrar')) {
        trainPlayBtn.innerHTML = '<i class="fa-solid fa-pause"></i> Duraklat';
        
        // Eğer en sondaysa başa sar
        let currentStepIdx = Array.from(trainStepsDom).findIndex(s => s.classList.contains('active'));
        if(currentStepIdx === trainStepsDom.length - 1 && !trainPlayBtn.innerHTML.includes('Duraklat')) {
           currentStepIdx = 0;
        }

        trainStepsDom.forEach(s => s.classList.remove('active'));
        trainStepsDom[currentStepIdx].classList.add('active');
        
        trainInterval = setInterval(() => {
          currentStepIdx++;
          if(currentStepIdx >= trainStepsDom.length) {
            clearInterval(trainInterval);
            trainPlayBtn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Tekrar';
            return;
          }
          trainStepsDom.forEach(s => s.classList.remove('active'));
          trainStepsDom[currentStepIdx].classList.add('active');
        }, 3000);
        
      } else {
        trainPlayBtn.innerHTML = '<i class="fa-solid fa-play"></i> Oynat';
        clearInterval(trainInterval);
      }
    });

    // Beden Dili Kütüphanesi Script (Adım 9)
    const gestureLibrary = [
      { title: "Steeple (Çatı) Duruşu", desc: "Parmak uçlarının birbirine değdiği, avuç içlerinin açık kaldığı pozisyon. Yüksek entelektüel güven (Phronesis) belirtisidir.", tag: "El Hareketi", icon: "fa-hands" },
      { title: "Açık Avuçlar", desc: "Avuç içlerinin dinleyiciye dönük olması. Tehdit oluşturmadığınızı ve dürüst olduğunuzu (Arete) sembolize eder.", tag: "El Hareketi", icon: "fa-hand" },
      { title: "Kolları Kavuşturmak", desc: "Savunmacı veya kapalı bir tutumu gösterir. Dinleyiciye 'aranızda bir duvar olduğu' hissini verir.", tag: "Duruş", icon: "fa-person-falling" },
      { title: "Gözleri Kısma", desc: "Şüphe veya yoğun odaklanma anlamına gelir. Negatif bağlamda kızgınlık (tehdit) sinyali de verebilir.", tag: "Yüz İfadesi", icon: "fa-face-angry" },
      { title: "Asimetrik Gülümseme", desc: "Dudağın tek tarafının yukarı kalkması. Çoğunlukla alaycılık, küçümseme veya güvensizlik yansıtır.", tag: "Yüz İfadesi", icon: "fa-face-meh" },
      { title: "Mikro İfadeler", desc: "Saniyenin beşte biri kadar süren, gizlenemeyen anlık yüz ifadeleri. Gerçek duyguyu açık eder.", tag: "Yüz İfadesi", icon: "fa-eye" },
      { title: "Boyna Dokunma", desc: "Bilinçdışı bir sakinleşme (pacifying) hareketidir. Strese girildiğinde rahatlama ihtiyacıyla yapılır.", tag: "Hareket", icon: "fa-hand-dots" },
      { title: "Baton Gestures", desc: "Kelimelerin ritmine (Logos) göre elleri bir orkestra şefi gibi kullanmak. Anlamı pekiştirir.", tag: "El Hareketi", icon: "fa-hands-clapping" },
      { title: "Omuz Silkme", desc: "Bilgisizlik, umursamazlık veya güvensizlik belirtisidir. Liderlik otoritesini zedeleyebilir.", tag: "Hareket", icon: "fa-person-circle-question" },
      { title: "Ayna Etkisi (Mirroring)", desc: "Karşınızdakinin beden dilini bilinçsizce (veya bilinçli) taklit etmek. Uyum ve Empati (Eunoia) kurar.", tag: "Mesafe", icon: "fa-people-arrows" }
    ];

    const libGrid = document.getElementById('lib-grid');
    const libSearch = document.getElementById('lib-search-input');

    const renderLibrary = (filter = "") => {
      libGrid.innerHTML = "";
      const term = filter.toLowerCase();
      
      const filtered = gestureLibrary.filter(g => 
        g.title.toLowerCase().includes(term) || 
        g.desc.toLowerCase().includes(term) || 
        g.tag.toLowerCase().includes(term)
      );

      if(filtered.length === 0) {
        libGrid.innerHTML = `<div class="lib-no-result">Aramanızla eşleşen bir sonuç bulunamadı.</div>`;
        return;
      }

      filtered.forEach(g => {
        const html = `
          <div class="lib-card">
             <div class="lib-card-header">
               <h4>${g.title}</h4>
               <i class="fa-solid ${g.icon}"></i>
             </div>
             <p>${g.desc}</p>
             <span class="lib-tag">${g.tag}</span>
          </div>
        `;
        libGrid.innerHTML += html;
      });
    };

    if(libGrid) {
      renderLibrary();
      libSearch.addEventListener('input', (e) => {
        renderLibrary(e.target.value);
      });
    }

  });
</script>

<%- include('partials/main-footer') %>
