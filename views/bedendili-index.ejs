<%- include('partials/main-header') %>

<style>
  /* BEDEN DİLİ - ADIM 1: KONSEPT TANIMI VE TEORİK TEMEL */
  :root {
    --bl-bg: #0A0A0A;
    --bl-surface: #171717;
    --bl-primary: #3B82F6; /* Mavi */
    --bl-accent: #10B981;  /* Zümrüt Yeşili */
    --bl-text: #F8FAFC;
    --bl-muted: #94A3B8;
    --font-heading: 'Inter', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  body {
    background-color: var(--bl-bg);
    color: var(--bl-text);
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
  }

  /* 1. Hero Section */
  .bl-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(135deg, #0f172a 0%, #000000 100%);
    padding: 20px;
  }

  .bl-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at center, rgba(59, 130, 246, 0.15) 0%, transparent 60%);
    z-index: 1;
  }

  /* Animasyonlu / Video Alanı */
  .bl-hero-video-container {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    opacity: 0.3;
    z-index: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bl-hero-video-container video {
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .bl-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .bl-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -2px;
    margin-bottom: 20px;
    background: linear-gradient(to right, #ffffff, var(--bl-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .bl-hero h2 {
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--bl-muted);
    margin-bottom: 40px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .bl-btn {
    display: inline-block;
    background: var(--bl-primary);
    color: white;
    padding: 16px 40px;
    border-radius: 30px;
    font-size: 1.2rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
  }
  .bl-btn:hover {
    background: #2563EB;
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(59, 130, 246, 0.5);
  }

  /* 2. Mehrabian Kuralı Infografik */
  .mehrabian-section {
    padding: 100px 20px;
    background: var(--bl-bg);
    position: relative;
  }

  .mehrabian-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .mehrabian-header {
    margin-bottom: 60px;
  }
  .mehrabian-header h3 {
    font-size: 2.5rem;
    color: white;
    margin-bottom: 15px;
  }
  .mehrabian-header p {
    font-size: 1.2rem;
    color: var(--bl-muted);
    max-width: 700px;
    margin: 0 auto;
  }

  .m-chart {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 30px;
    height: 400px;
    margin-bottom: 40px;
  }

  .m-bar-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 150px;
  }

  .m-bar {
    width: 100%;
    border-radius: 12px 12px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.5s ease;
  }

  .m-bar span {
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  .m-bar-words { height: 10%; background: #475569; }     /* %7 Kelimeler */
  .m-bar-voice { height: 38%; background: #0EA5E9; }     /* %38 Ses Tonu */
  .m-bar-body { height: 55%; background: var(--bl-accent); box-shadow: 0 0 30px rgba(16, 185, 129, 0.4); } /* %55 Beden Dili */

  .m-label {
    margin-top: 20px;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--bl-text);
  }
  .m-sublabel {
    font-size: 0.9rem;
    color: var(--bl-muted);
    margin-top: 5px;
  }

  /* Ethos Bağlantısı Info Box */
  .ethos-link-box {
    background: var(--bl-surface);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 40px;
    text-align: left;
    margin-top: 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .ethos-link-box h4 {
    grid-column: 1 / -1;
    font-size: 1.8rem;
    color: var(--bl-primary);
    margin-bottom: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 20px;
  }
  .ethos-item {
    display: flex;
    gap: 15px;
  }
  .ethos-item i {
    font-size: 2rem;
    color: var(--bl-accent);
  }
  .ethos-item h5 {
    font-size: 1.2rem;
    margin-bottom: 5px;
    color: white;
  }
  .ethos-item p {
    font-size: 0.95rem;
    color: var(--bl-muted);
  }

  @media (max-width: 768px) {
    .m-chart { height: 300px; gap: 15px; }
    .m-bar-wrapper { width: 90px; }
    .m-bar span { font-size: 1.5rem; }
    .ethos-link-box { grid-template-columns: 1fr; }
  }
  /* 3. Beden Dili Bileşenleri (Tab Yapısı) */
  .components-section { padding: 100px 20px; background: #000; }
  .comp-header { text-align: center; margin-bottom: 50px; }
  .comp-header h3 { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
  .comp-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .comp-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 40px; }
  
  .comp-tabs { flex: 1; display: flex; flex-direction: column; gap: 15px; }
  .comp-tab { 
    background: var(--bl-surface); border: 1px solid rgba(255,255,255,0.1); 
    padding: 20px 30px; border-radius: 12px; cursor: pointer; transition: all 0.3s;
    font-size: 1.2rem; font-weight: 700; color: var(--bl-muted);
    display: flex; justify-content: space-between; align-items: center;
  }
  .comp-tab:hover { background: rgba(59,130,246,0.1); border-color: rgba(59,130,246,0.5); color: #fff; }
  .comp-tab.active { background: var(--bl-primary); border-color: var(--bl-primary); color: #fff; box-shadow: 0 5px 20px rgba(59,130,246,0.4); }

  .comp-content-area { flex: 2; background: var(--bl-surface); border-radius: 16px; padding: 40px; border: 1px solid rgba(255,255,255,0.05); }
  .comp-pane { display: none; animation: fadeIn 0.4s ease; }
  .comp-pane.active { display: block; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .pane-title { font-size: 2rem; color: #fff; margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px; }
  
  .bl-item-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 25px; }
  
  .bl-item { background: #0A0A0A; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.05); transition: transform 0.3s; }
  .bl-item:hover { transform: translateY(-5px); border-color: rgba(255,255,255,0.2); }
  .bl-item-img { height: 160px; background: #222; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .bl-item-img i { font-size: 4rem; color: #475569; }
  
  .ethos-badge { position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.8); padding: 5px 12px; border-radius: 20px; font-weight: 800; font-size: 0.85rem; border: 1px solid; }
  .ethos-high { color: #10B981; border-color: #10B981; }
  .ethos-mid { color: #F59E0B; border-color: #F59E0B; }
  .ethos-low { color: #EF4444; border-color: #EF4444; }

  .bl-item-body { padding: 20px; }
  .bl-item-body h5 { font-size: 1.1rem; color: #fff; margin-bottom: 8px; }
  .bl-item-body p { font-size: 0.9rem; color: var(--bl-muted); line-height: 1.5; }

  @media (max-width: 900px) {
    .comp-container { flex-direction: column; }
  }
  /* 4. Görsel Referans Kütüphanesi (Adım 3) */
  .ref-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid rgba(255,255,255,0.05); }
  .ref-header { text-align: center; margin-bottom: 50px; }
  .ref-header h3 { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
  .ref-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .ref-grid { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 60px; }
  .ref-category { background: var(--bl-surface); padding: 40px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.05); }
  .ref-cat-title { font-size: 1.8rem; color: var(--bl-primary); margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; }
  
  .ref-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .ref-card { background: #0A0A0A; border-radius: 12px; overflow: hidden; position: relative; border: 1px solid rgba(255,255,255,0.1); transition: transform 0.3s; }
  .ref-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
  
  .ref-media { height: 180px; background: #222; position: relative; display: flex; align-items: center; justify-content: center; }
  .ref-media i { font-size: 3rem; color: #475569; }
  
  /* Overlays */
  .ref-overlay { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; align-items: center; }
  .ref-level { font-weight: 800; font-size: 0.75rem; padding: 4px 8px; border-radius: 20px; background: rgba(0,0,0,0.8); }
  .ref-score { font-weight: 800; font-size: 0.8rem; padding: 4px 8px; border-radius: 20px; background: rgba(0,0,0,0.8); border: 1px solid; }

  /* Colors per level */
  .level-1 { border-color: #EF4444; color: #EF4444; } /* YANLIŞ */
  .level-2 { border-color: #F97316; color: #F97316; } /* ZAYIF */
  .level-3 { border-color: #3B82F6; color: #3B82F6; } /* İYİ */
  .level-4 { border-color: #10B981; color: #10B981; } /* MÜKEMMEL */

  .ref-body { padding: 20px; }
  .ref-body h5 { font-size: 1.1rem; color: #fff; margin-bottom: 10px; }
  .ref-body p { font-size: 0.85rem; color: var(--bl-muted); line-height: 1.5; }

  @media (max-width: 1024px) { .ref-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .ref-cards { grid-template-columns: 1fr; } }

  /* 5. İnteraktif Karşılaştırma Aracı (Adım 4) */
  .slider-section { padding: 100px 20px; background: #000; border-top: 1px solid rgba(255,255,255,0.05); }
  .slider-header { text-align: center; margin-bottom: 50px; }
  .slider-header h3 { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
  .slider-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .slider-gallery { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 60px; }

  .slider-item { background: var(--bl-surface); border-radius: 20px; border: 1px solid rgba(255,255,255,0.05); padding: 30px; }
  .slider-item-title { font-size: 1.5rem; color: var(--bl-primary); margin-bottom: 20px; text-align: center; }

  .comp-slider-container {
    position: relative; width: 100%; height: 350px; overflow: hidden; border-radius: 12px;
    background: #111; user-select: none;
  }
  .comp-img-before, .comp-img-after {
    position: absolute; top: 0; left: 0; height: 100%;
    display: flex; align-items: center; justify-content: center; text-align: center;
  }
  .comp-img-before { width: 100%; background: linear-gradient(135deg, #450a0a, #1a0505); z-index: 1; }
  .comp-img-after { width: 50%; background: linear-gradient(135deg, #064e3b, #022c22); z-index: 2; overflow: hidden; border-right: 2px solid #fff; }
  
  .comp-content-inner {
    position: absolute; top: 0; left: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
  }

  .comp-slider-content {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px; width: 100%;
  }
  .comp-slider-content i { font-size: 5rem; color: rgba(255,255,255,0.8); }
  .comp-slider-content.bad i { color: #f87171; }
  .comp-slider-content.good i { color: #34d399; }
  
  .comp-ethos-tag { padding: 6px 14px; border-radius: 30px; font-weight: 800; font-size: 1rem; background: rgba(0,0,0,0.5); }
  .comp-slider-content.bad .comp-ethos-tag { border: 2px solid #ef4444; color: #ef4444; }
  .comp-slider-content.good .comp-ethos-tag { border: 2px solid #10b981; color: #10b981; }

  .comp-slider-content h4 { font-size: 1.5rem; color: #fff; margin: 0; }
  .comp-slider-content p { font-size: 1rem; color: #cbd5e1; max-width: 300px; }

  .comp-slider-handle {
    position: absolute; top: 0; bottom: 0; left: 50%; width: 40px; margin-left: -20px;
    background: transparent; z-index: 3; cursor: ew-resize;
    display: flex; align-items: center; justify-content: center;
  }
  .comp-slider-handle::before {
    content: '< >'; display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; background: #fff; color: #000; border-radius: 50%;
    font-weight: 900; box-shadow: 0 0 15px rgba(0,0,0,0.5); font-family: monospace;
    transition: transform 0.22s ease;
  }
  .comp-slider-handle:hover::before { transform: scale(1.1); }

  /* 6. Senaryo Simülatörü (Adım 5) */
  .sim-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid rgba(255,255,255,0.05); }
  .sim-header { text-align: center; margin-bottom: 50px; }
  .sim-header h3 { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
  .sim-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .sim-container { max-width: 800px; margin: 0 auto; }
  .sim-card { background: var(--bl-surface); border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); padding: 40px; position: relative; }
  
  .sim-ethos-tracker { position: absolute; top: -20px; right: 40px; background: var(--bl-primary); color: #fff; padding: 10px 25px; border-radius: 30px; font-weight: 800; font-size: 1.2rem; box-shadow: 0 5px 15px rgba(59,130,246,0.5); transition: transform 0.3s; }
  .sim-ethos-tracker span { font-size: 1.5rem; transition: all 0.3s; }

  .sim-scenario { font-size: 1.4rem; color: #fff; margin-bottom: 30px; margin-top: 10px; line-height: 1.6; }
  
  .sim-options { display: flex; flex-direction: column; gap: 15px; }
  .sim-option { background: #000; border: 1px solid rgba(255,255,255,0.1); padding: 20px; border-radius: 12px; color: var(--bl-muted); font-size: 1.1rem; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 15px; }
  .sim-option:hover { background: rgba(59,130,246,0.1); border-color: rgba(59,130,246,0.5); color: #fff; }
  .sim-option i { font-size: 1.5rem; width: 30px; text-align: center; }
  
  .sim-option.correct { background: rgba(16,185,129,0.1); border-color: #10b981; color: #10b981; pointer-events: none; }
  .sim-option.wrong { background: rgba(239,68,68,0.1); border-color: #ef4444; color: #ef4444; pointer-events: none; }

  .sim-feedback { margin-top: 25px; padding: 20px; border-radius: 12px; font-size: 1.1rem; line-height: 1.5; animation: fadeIn 0.3s ease; }
  .sim-feedback.success { background: rgba(16,185,129,0.1); color: #10b981; border: 1px solid rgba(16,185,129,0.3); }
  .sim-feedback.error { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }

  .sim-next-btn { margin-top: 25px; width: 100%; padding: 15px; background: var(--bl-primary); color: #fff; border: none; border-radius: 12px; font-size: 1.2rem; font-weight: 700; cursor: pointer; transition: background 0.3s; }
  .sim-next-btn:hover { background: #2563eb; }

  /* 7. Case Studies (Adım 6) */
  .case-section { padding: 100px 20px; background: #000; border-top: 1px solid rgba(255,255,255,0.05); }
  .case-header { text-align: center; margin-bottom: 50px; }
  .case-header h3 { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
  .case-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .case-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 40px; }
  
  .case-sidebar { flex: 1; display: flex; flex-direction: column; gap: 15px; }
  .case-tab { display: flex; align-items: center; gap: 15px; background: var(--bl-surface); padding: 15px; border-radius: 12px; cursor: pointer; border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s; }
  .case-tab:hover { background: rgba(59,130,246,0.1); border-color: rgba(59,130,246,0.5); }
  .case-tab.active { background: var(--bl-primary); border-color: var(--bl-primary); }
  .case-tab img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; background: #222; }
  .case-tab h4 { color: #fff; font-size: 1.1rem; margin: 0 0 5px 0; }
  .case-tab p { color: var(--bl-muted); font-size: 0.9rem; margin: 0; }
  .case-tab.active p { color: rgba(255,255,255,0.8); }

  .case-content-area { flex: 2.5; background: var(--bl-surface); border-radius: 16px; padding: 30px; border: 1px solid rgba(255,255,255,0.05); }
  .case-pane { display: none; animation: fadeIn 0.4s ease; }
  .case-pane.active { display: block; }

  .case-media { width: 100%; height: 400px; background: #111; border-radius: 12px; display: flex; align-items: center; justify-content: center; position: relative; margin-bottom: 30px; border: 1px solid rgba(255,255,255,0.05); }
  .case-media i { font-size: 5rem; color: #333; }
  
  .case-timeline { position: absolute; bottom: 20px; left: 30px; right: 30px; height: 6px; background: rgba(255,255,255,0.2); border-radius: 10px; display: flex; justify-content: space-between; align-items: center; padding: 0 10px; }
  .case-point { width: 16px; height: 16px; background: #fff; border-radius: 50%; cursor: pointer; position: relative; z-index: 2; transition: all 0.3s; }
  .case-point:hover { transform: scale(1.5); }
  .case-point.active { background: var(--bl-primary); box-shadow: 0 0 10px var(--bl-primary); transform: scale(1.3); }

  .case-analysis { background: #0A0A0A; padding: 25px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); border-left: 4px solid var(--bl-primary); }
  .case-analysis h4 { font-size: 1.2rem; color: #fff; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; }
  .case-time-badge { background: var(--bl-primary); color: #fff; padding: 3px 10px; border-radius: 20px; font-size: 0.9rem; font-weight: 800; }
  .case-analysis p { font-size: 1.05rem; color: var(--bl-muted); line-height: 1.6; margin: 0; transition: opacity 0.2s; }

  @media (max-width: 900px) { .case-container { flex-direction: column; } .case-media { height: 250px; } }

  /* 8. Checklist (Adım 7) */
  .chk-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid rgba(255,255,255,0.05); }
  .chk-header { text-align: center; margin-bottom: 50px; }
  .chk-header h3 { font-size: 2.5rem; color: #fff; margin-bottom: 15px; }
  .chk-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .chk-container { max-width: 700px; margin: 0 auto; background: var(--bl-surface); padding: 40px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.05); }
  
  .chk-progress-bar { width: 100%; height: 25px; background: #000; border-radius: 20px; margin-bottom: 40px; position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); }
  .chk-progress-fill { height: 100%; background: linear-gradient(90deg, var(--bl-primary), #10b981); width: 0%; transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
  .chk-progress-text { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 800; color: #fff; text-shadow: 1px 1px 2px rgba(0,0,0,0.8); }

  .chk-list { display: flex; flex-direction: column; gap: 20px; }
  .chk-item { display: flex; align-items: flex-start; gap: 20px; cursor: pointer; padding: 15px; border-radius: 12px; transition: background 0.2s; }
  .chk-item:hover { background: rgba(255,255,255,0.03); }
  
  .chk-input { display: none; }
  .chk-custom { width: 30px; height: 30px; border: 2px solid var(--bl-primary); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.2s; position: relative; margin-top: 5px; }
  .chk-input:checked + .chk-custom { background: var(--bl-primary); }
  .chk-input:checked + .chk-custom::after { content: '✔'; color: #fff; font-size: 1.2rem; font-weight: 900; }
  
