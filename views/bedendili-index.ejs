<%- include('partials/main-header') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600&family=JetBrains+Mono:wght@400;700&display=swap');

  /* ═══════════════════════════════════════════════════════════
     BEDEN DİLİ — Ultra Luxury Light Mode (Retorik altın standardı)
     Accent: Zümrüt Yeşili — Sözsüz dil
     ═══════════════════════════════════════════════════════════ */
  :root {
    --bl-bg: #faf9f7;
    --bl-bg2: #f5f3ef;
    --bl-surface: #ffffff;
    --bl-surface2: #f5f3ef;
    --bl-navy: #0f172a;
    --bl-primary: #059669;   /* Zümrüt - ana accent */
    --bl-primary2: #10b981;
    --bl-accent: #059669;
    --bl-warning: #d97706;
    --bl-gold: #b8860b;
    --bl-gold2: #d4a017;
    --bl-text: #1a1a2e;
    --bl-muted: #6b7280;
    --bl-border: rgba(0,0,0,0.06);
    --bl-border-h: rgba(5,150,105,0.22);
    --bl-shadow: 0 8px 30px rgba(0,0,0,0.05);
    --bl-shadow-h: 0 20px 60px rgba(0,0,0,0.10);
    --font-heading: 'Playfair Display', serif;
    --font-body: 'Outfit', sans-serif;
  }

  body {
    background-color: var(--bl-bg);
    color: var(--bl-text);
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  /* ── Ambient light blobs ── */
  .bl-ambient { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .bl-blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.28; animation: blobFloat 20s ease-in-out infinite alternate; }
  .bl-blob:nth-child(1) { width: 500px; height: 500px; top: -100px; right: -100px; background: linear-gradient(135deg, #a7f3d0, #34d399); animation-duration: 18s; }
  .bl-blob:nth-child(2) { width: 400px; height: 400px; bottom: -80px; left: -80px; background: linear-gradient(135deg, #bfdbfe, #60a5fa); animation-duration: 22s; animation-delay: -5s; }
  .bl-blob:nth-child(3) { width: 300px; height: 300px; top: 40%; left: 60%; background: linear-gradient(135deg, #fde68a, #fbbf24); opacity: 0.14; animation-duration: 25s; animation-delay: -10s; }
  @keyframes blobFloat {
    0% { transform: translate(0,0) scale(1); }
    33% { transform: translate(30px,-40px) scale(1.1); }
    66% { transform: translate(-20px,30px) scale(0.95); }
    100% { transform: translate(10px,-10px) scale(1.05); }
  }
  .bl-grid-overlay {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image: linear-gradient(rgba(0,0,0,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.015) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  section { position: relative; z-index: 10; }

  /* 1. Hero Section */
  .bl-hero {
    position: relative;
    z-index: 10;
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 90px 20px 60px;
  }

  .bl-hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at center, rgba(5,150,105, 0.15) 0%, transparent 60%);
    z-index: 1;
  }

  /* Animasyonlu / Video Alanı */
  .bl-hero-video-container {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    opacity: 0.3;
    z-index: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bl-hero-video-container video {
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
  }

  .bl-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .bl-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -1.5px;
    margin-bottom: 18px;
    color: var(--bl-navy);
    line-height: 1.08;
  }
  .bl-hero h1 .bl-hl {
    background: linear-gradient(120deg, var(--bl-primary), var(--bl-primary2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bl-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 22px; border-radius: 50px;
    background: var(--bl-surface); border: 1px solid var(--bl-border-h);
    color: var(--bl-primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
    margin-bottom: 28px; box-shadow: var(--bl-shadow);
  }
  .bl-badge::before {
    content: ''; width: 6px; height: 6px; border-radius: 50%;
    background: var(--bl-primary2); box-shadow: 0 0 8px var(--bl-primary2);
    animation: goldPulse 2s ease-in-out infinite;
  }
  @keyframes goldPulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.6); } }

  .bl-hero h2 {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--bl-muted);
    margin: 0 auto 40px;
    max-width: 620px;
    line-height: 1.7;
  }

  .bl-btn {
    display: inline-block;
    background: var(--bl-primary);
    color: #fff;
    padding: 15px 38px;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(5,150,105, 0.25);
  }
  .bl-btn:hover {
    background: #047857;
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(5,150,105, 0.4);
  }

  /* 2. Mehrabian Kuralı Infografik */
  .mehrabian-section {
    padding: 100px 20px;
    background: var(--bl-bg);
    position: relative;
  }

  .mehrabian-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .mehrabian-header {
    margin-bottom: 60px;
  }
  .mehrabian-header h3 {
    font-size: 2.5rem;
    color: var(--bl-navy);
    margin-bottom: 15px;
  }
  .mehrabian-header p {
    font-size: 1.2rem;
    color: var(--bl-muted);
    max-width: 700px;
    margin: 0 auto;
  }

  .m-chart {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 30px;
    height: 400px;
    margin-bottom: 40px;
  }

  .m-bar-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 150px;
  }

  .m-bar {
    width: 100%;
    border-radius: 12px 12px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: all 0.5s ease;
  }

  .m-bar span {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--bl-navy);
    text-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  .m-bar-words { height: 10%; background: #475569; }     /* %7 Kelimeler */
  .m-bar-voice { height: 38%; background: #0EA5E9; }     /* %38 Ses Tonu */
  .m-bar-body { height: 55%; background: var(--bl-accent); box-shadow: 0 0 30px rgba(16, 185, 129, 0.4); } /* %55 Beden Dili */

  .m-label {
    margin-top: 20px;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--bl-text);
  }
  .m-sublabel {
    font-size: 0.9rem;
    color: var(--bl-muted);
    margin-top: 5px;
  }

  /* Ethos Bağlantısı Info Box */
  .ethos-link-box {
    background: var(--bl-surface);
    border: 1px solid var(--bl-border);
    border-radius: 16px;
    padding: 40px;
    text-align: left;
    margin-top: 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .ethos-link-box h4 {
    grid-column: 1 / -1;
    font-size: 1.8rem;
    color: var(--bl-primary);
    margin-bottom: 10px;
    border-bottom: 1px solid var(--bl-border);
    padding-bottom: 20px;
  }
  .ethos-item {
    display: flex;
    gap: 15px;
  }
  .ethos-item i {
    font-size: 2rem;
    color: var(--bl-accent);
  }
  .ethos-item h5 {
    font-size: 1.2rem;
    margin-bottom: 5px;
    color: var(--bl-navy);
  }
  .ethos-item p {
    font-size: 0.95rem;
    color: var(--bl-muted);
  }

  @media (max-width: 768px) {
    .m-chart { height: 300px; gap: 15px; }
    .m-bar-wrapper { width: 90px; }
    .m-bar span { font-size: 1.5rem; }
    .ethos-link-box { grid-template-columns: 1fr; }
  }
  /* 3. Beden Dili Bileşenleri (Tab Yapısı) */
  .components-section { padding: 100px 20px; background: var(--bl-bg); }
  .comp-header { text-align: center; margin-bottom: 50px; }
  .comp-header h3 { font-size: 2.5rem; color: var(--bl-navy); margin-bottom: 15px; }
  .comp-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .comp-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 40px; }
  
  .comp-tabs { flex: 1; display: flex; flex-direction: column; gap: 15px; }
  .comp-tab { 
    background: var(--bl-surface); border: 1px solid var(--bl-border); 
    padding: 20px 30px; border-radius: 12px; cursor: pointer; transition: all 0.3s;
    font-size: 1.2rem; font-weight: 700; color: var(--bl-muted);
    display: flex; justify-content: space-between; align-items: center;
  }
  .comp-tab:hover { background: rgba(5,150,105,0.1); border-color: rgba(5,150,105,0.5); color: var(--bl-navy); }
  .comp-tab.active { background: var(--bl-primary); border-color: var(--bl-primary); color: #fff; box-shadow: 0 5px 20px rgba(5,150,105,0.4); }

  .comp-content-area { flex: 2; background: var(--bl-surface); border-radius: 16px; padding: 40px; border: 1px solid var(--bl-border); }
  .comp-pane { display: none; animation: fadeIn 0.4s ease; }
  .comp-pane.active { display: block; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .pane-title { font-size: 2rem; color: var(--bl-navy); margin-bottom: 30px; border-bottom: 1px solid var(--bl-border); padding-bottom: 15px; }
  
  .bl-item-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 25px; }
  
  .bl-item { background: var(--bl-surface2); border-radius: 12px; overflow: hidden; border: 1px solid var(--bl-border); transition: transform 0.3s; }
  .bl-item:hover { transform: translateY(-5px); border-color: var(--bl-border-h); }
  .bl-item-img { height: 160px; background: var(--bl-surface2); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .bl-item-img i { font-size: 4rem; color: #475569; }
  
  .ethos-badge { position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.8); padding: 5px 12px; border-radius: 20px; font-weight: 800; font-size: 0.85rem; border: 1px solid; }
  .ethos-high { color: #10B981; border-color: #10B981; }
  .ethos-mid { color: #F59E0B; border-color: #F59E0B; }
  .ethos-low { color: #EF4444; border-color: #EF4444; }

  .bl-item-body { padding: 20px; }
  .bl-item-body h5 { font-size: 1.1rem; color: var(--bl-navy); margin-bottom: 8px; }
  .bl-item-body p { font-size: 0.9rem; color: var(--bl-muted); line-height: 1.5; }

  @media (max-width: 900px) {
    .comp-container { flex-direction: column; }
  }
  /* 4. Görsel Referans Kütüphanesi (Adım 3) */
  .ref-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid var(--bl-border); }
  .ref-header { text-align: center; margin-bottom: 50px; }
  .ref-header h3 { font-size: 2.5rem; color: var(--bl-navy); margin-bottom: 15px; }
  .ref-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .ref-grid { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 60px; }
  .ref-category { background: var(--bl-surface); padding: 40px; border-radius: 20px; border: 1px solid var(--bl-border); }
  .ref-cat-title { font-size: 1.8rem; color: var(--bl-primary); margin-bottom: 30px; border-bottom: 1px solid var(--bl-border); padding-bottom: 10px; }
  
  .ref-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .ref-card { background: var(--bl-surface2); border-radius: 12px; overflow: hidden; position: relative; border: 1px solid var(--bl-border); transition: transform 0.3s; }
  .ref-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.5); }
  
  .ref-media { height: 180px; background: var(--bl-surface2); position: relative; display: flex; align-items: center; justify-content: center; }
  .ref-media i { font-size: 3rem; color: #475569; }
  
  /* Overlays */
  .ref-overlay { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; justify-content: space-between; align-items: center; }
  .ref-level { font-weight: 800; font-size: 0.75rem; padding: 4px 8px; border-radius: 20px; background: rgba(0,0,0,0.8); }
  .ref-score { font-weight: 800; font-size: 0.8rem; padding: 4px 8px; border-radius: 20px; background: rgba(0,0,0,0.8); border: 1px solid; }

  /* Colors per level */
  .level-1 { border-color: #EF4444; color: #EF4444; } /* YANLIŞ */
  .level-2 { border-color: #F97316; color: #F97316; } /* ZAYIF */
  .level-3 { border-color: #3B82F6; color: #3B82F6; } /* İYİ */
  .level-4 { border-color: #10B981; color: #10B981; } /* MÜKEMMEL */

  .ref-body { padding: 20px; }
  .ref-body h5 { font-size: 1.1rem; color: var(--bl-navy); margin-bottom: 10px; }
  .ref-body p { font-size: 0.85rem; color: var(--bl-muted); line-height: 1.5; }

  @media (max-width: 1024px) { .ref-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .ref-cards { grid-template-columns: 1fr; } }

  /* 5. İnteraktif Karşılaştırma Aracı (Adım 4) */
  .slider-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid var(--bl-border); }
  .slider-header { text-align: center; margin-bottom: 50px; }
  .slider-header h3 { font-size: 2.5rem; color: var(--bl-navy); margin-bottom: 15px; }
  .slider-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .slider-gallery { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 60px; }

  .slider-item { background: var(--bl-surface); border-radius: 20px; border: 1px solid var(--bl-border); padding: 30px; }
  .slider-item-title { font-size: 1.5rem; color: var(--bl-primary); margin-bottom: 20px; text-align: center; }

  .comp-slider-container {
    position: relative; width: 100%; height: 350px; overflow: hidden; border-radius: 12px;
    background: var(--bl-surface2); user-select: none;
  }
  .comp-img-before, .comp-img-after {
    position: absolute; top: 0; left: 0; height: 100%;
    display: flex; align-items: center; justify-content: center; text-align: center;
  }
  .comp-img-before { width: 100%; background: linear-gradient(135deg, #450a0a, #1a0505); z-index: 1; }
  .comp-img-after { width: 50%; background: linear-gradient(135deg, #064e3b, #022c22); z-index: 2; overflow: hidden; border-right: 2px solid #fff; }
  
  .comp-content-inner {
    position: absolute; top: 0; left: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
  }

  .comp-slider-content {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px; width: 100%;
  }
  .comp-slider-content i { font-size: 5rem; color: var(--bl-text); }
  .comp-slider-content.bad i { color: #f87171; }
  .comp-slider-content.good i { color: #34d399; }
  
  .comp-ethos-tag { padding: 6px 14px; border-radius: 30px; font-weight: 800; font-size: 1rem; background: rgba(0,0,0,0.5); }
  .comp-slider-content.bad .comp-ethos-tag { border: 2px solid #ef4444; color: #ef4444; }
  .comp-slider-content.good .comp-ethos-tag { border: 2px solid #10b981; color: #10b981; }

  .comp-slider-content h4 { font-size: 1.5rem; color: var(--bl-navy); margin: 0; }
  .comp-slider-content p { font-size: 1rem; color: var(--bl-muted); max-width: 300px; }

  .comp-slider-handle {
    position: absolute; top: 0; bottom: 0; left: 50%; width: 40px; margin-left: -20px;
    background: transparent; z-index: 3; cursor: ew-resize;
    display: flex; align-items: center; justify-content: center;
  }
  .comp-slider-handle::before {
    content: '< >'; display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; background: var(--bl-navy); color: #fff; border-radius: 50%;
    font-weight: 900; box-shadow: 0 0 15px rgba(0,0,0,0.5); font-family: monospace;
    transition: transform 0.22s ease;
  }
  .comp-slider-handle:hover::before { transform: scale(1.1); }

  /* 6. Senaryo Simülatörü (Adım 5) */
  .sim-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid var(--bl-border); }
  .sim-header { text-align: center; margin-bottom: 50px; }
  .sim-header h3 { font-size: 2.5rem; color: var(--bl-navy); margin-bottom: 15px; }
  .sim-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .sim-container { max-width: 800px; margin: 0 auto; }
  .sim-card { background: var(--bl-surface); border-radius: 20px; border: 1px solid var(--bl-border); padding: 40px; position: relative; }
  
  .sim-ethos-tracker { position: absolute; top: -20px; right: 40px; background: var(--bl-primary); color: #fff; padding: 10px 25px; border-radius: 30px; font-weight: 800; font-size: 1.2rem; box-shadow: 0 5px 15px rgba(5,150,105,0.5); transition: transform 0.3s; }
  .sim-ethos-tracker span { font-size: 1.5rem; transition: all 0.3s; }

  .sim-scenario { font-size: 1.4rem; color: var(--bl-navy); margin-bottom: 30px; margin-top: 10px; line-height: 1.6; }
  
  .sim-options { display: flex; flex-direction: column; gap: 15px; }
  .sim-option { background: var(--bl-bg); border: 1px solid var(--bl-border); padding: 20px; border-radius: 12px; color: var(--bl-muted); font-size: 1.1rem; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 15px; }
  .sim-option:hover { background: rgba(5,150,105,0.1); border-color: rgba(5,150,105,0.5); color: var(--bl-navy); }
  .sim-option i { font-size: 1.5rem; width: 30px; text-align: center; }
  
  .sim-option.correct { background: rgba(16,185,129,0.1); border-color: #10b981; color: #10b981; pointer-events: none; }
  .sim-option.wrong { background: rgba(239,68,68,0.1); border-color: #ef4444; color: #ef4444; pointer-events: none; }

  .sim-feedback { margin-top: 25px; padding: 20px; border-radius: 12px; font-size: 1.1rem; line-height: 1.5; animation: fadeIn 0.3s ease; }
  .sim-feedback.success { background: rgba(16,185,129,0.1); color: #10b981; border: 1px solid rgba(16,185,129,0.3); }
  .sim-feedback.error { background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }

  .sim-next-btn { margin-top: 25px; width: 100%; padding: 15px; background: var(--bl-primary); color: #fff; border: none; border-radius: 12px; font-size: 1.2rem; font-weight: 700; cursor: pointer; transition: background 0.3s; }
  .sim-next-btn:hover { background: #047857; }

  /* 7. Case Studies (Adım 6) */
  .case-section { padding: 100px 20px; background: var(--bl-bg); border-top: 1px solid var(--bl-border); }
  .case-header { text-align: center; margin-bottom: 50px; }
  .case-header h3 { font-size: 2.5rem; color: var(--bl-navy); margin-bottom: 15px; }
  .case-header p { color: var(--bl-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .case-container { max-width: 1200px; margin: 0 auto; display: flex; gap: 40px; }
  
  .case-sidebar { flex: 1; display: flex; flex-direction: column; gap: 15px; }
  .case-tab { display: flex; align-items: center; gap: 15px; background: var(--bl-surface); padding: 15px; border-radius: 12px; cursor: pointer; border: 1px solid var(--bl-border); transition: all 0.3s; }
  .case-tab:hover { background: rgba(5,150,105,0.1); border-color: rgba(5,150,105,0.5); }
  .case-tab.active { background: var(--bl-primary); border-color: var(--bl-primary); }
  .case-tab img { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; background: var(--bl-surface2); }
  .case-tab h4 { color: var(--bl-navy); font-size: 1.1rem; margin: 0 0 5px 0; }
  .case-tab p { color: var(--bl-muted); font-size: 0.9rem; margin: 0; }
  .case-tab.active p { color: var(--bl-text); }

  .case-content-area { flex: 2.5; background: var(--bl-surface); border-radius: 16px; padding: 30px; border: 1px solid var(--bl-border); }
  .case-pane { display: none; animation: fadeIn 0.4s ease; }
  .case-pane.active { display: block; }

