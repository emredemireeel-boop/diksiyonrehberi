<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .mz-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; max-width: 1200px; margin: 0 auto; width: 100%; }
  
  .instruction-panel { background: rgba(56,189,248,0.08); border: 1px solid rgba(56,189,248,0.15); padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 20px; z-index: 10; backdrop-filter: blur(10px); }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #0369a1; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #64748b; margin: 0; max-width: 600px; line-height: 1.5; }

  /* Müzakere UI */
  .boss-box { background: #ffffff; padding: 30px; border-radius: 20px; text-align: center; border: 2px solid #e2e8f0; margin-bottom: 30px; width: 100%; max-width: 800px; position: relative; }
  .boss-icon { font-size: 4rem; margin-bottom: 10px; }
  .boss-text { font-size: 1.5rem; font-weight: 700; color: #1e293b; line-height: 1.4; }

  /* İkna Barı */
  .persuasion-meter { width: 100%; max-width: 800px; background: rgba(15,23,42,0.1); height: 20px; border-radius: 10px; margin-bottom: 40px; position: relative; overflow: hidden; box-shadow: inset 0 2px 5px rgba(0,0,0,0.08); }
  .persuasion-fill { height: 100%; width: 20%; background: linear-gradient(90deg, #ef4444, #f59e0b, #10b981); transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1); border-radius: 10px; }
  .persuasion-label { position: absolute; width: 100%; text-align: center; top: 0; left: 0; line-height: 20px; font-size: 0.8rem; font-weight: 800; color: #0f172a; text-shadow: 0 1px 2px rgba(255,255,255,0.5); }

  .options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; width: 100%; max-width: 800px; }
  .tactic-btn {
    background: #ffffff; border: 1px solid #e2e8f0; color: #0f172a; padding: 20px; border-radius: 16px;
    font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: all 0.2s; text-align: left; line-height: 1.5; display: flex; flex-direction: column;
  }
  .tactic-btn:hover { background: #f8fafc; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(14, 165, 233, 0.1); }
  .tactic-name { color: #38bdf8; font-size: 0.8rem; font-weight: 900; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 1px; }

  .feedback-box { position: absolute; inset: 0; background: rgba(248,250,252,0.95); z-index: 20; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center; backdrop-filter: blur(5px); }
  .feedback-title { font-size: 3rem; font-weight: 900; margin-bottom: 20px; }
  .feedback-desc { font-size: 1.2rem; color: #64748b; max-width: 600px; line-height: 1.6; margin-bottom: 40px; }
  
  .btn-next { background: #38bdf8; color: #f8fafc; border: none; padding: 15px 40px; border-radius: 30px; font-size: 1.1rem; font-weight: 800; cursor: pointer; text-transform: uppercase; }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(15,23,42,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #0f172a; }

</style>

<a href="/retorik" class="btn-back">← Retorik'e Dön</a>

<div class="mz-container">
  
  <div class="instruction-panel">
    <h1 class="instruction-title">Müzakere Ringi</h1>
    <p class="instruction-desc">Karşınızdaki zorlu karakteri Cialdini'nin İkna Psikolojisi prensiplerini kullanarak ikna etmeye çalışın. Yanlış taktikler İkna Barı'nı düşürür, doğru taktikler zirveye taşır.</p>
  </div>

  <div class="persuasion-meter">
    <div class="persuasion-fill" id="pFill" style="width: 20%"></div>
    <div class="persuasion-label">İKNA BARI: DÜŞÜK</div>
  </div>

  <div class="boss-box">
    <div class="boss-icon" id="bossIcon">👔</div>
    <div class="boss-text" id="bossText">"Bana bu yeni yazılım projesini neden almam gerektiğini söyle. Bütçemiz zaten çok kısıtlı ve risk alamayız."</div>
  </div>

  <div class="options-grid" id="optionsGrid">
    <!-- Options will be injected here -->
  </div>

</div>

<div class="feedback-box" id="feedbackBox">
  <div class="feedback-title" id="fTitle">Yanlış Hamle!</div>
  <div class="feedback-desc" id="fDesc">Açıklama burada olacak.</div>
  <button class="btn-next" onclick="nextRound()">Devam Et</button>
</div>

<script>
  const rounds = [
    {
      boss: "👔 Patron",
      text: "Bana bu yeni yazılım projesini neden almam gerektiğini söyle. Bütçemiz zaten çok kısıtlı ve piyasa kötü.",
      options: [
        { tactic: "Mantık (Logos)", text: "Çünkü bu yazılım iş akışımızı %30 hızlandıracak ve uzun vadede maliyetleri düşürecek.", result: "bad", score: -10, title: "Çok Sıkıcı!", desc: "İnsanlar sadece mantıkla karar vermez. Bütçesi kısıtlı bir patron uzun vadeli vaatlere hemen inanmaz." },
        { tactic: "Sosyal Kanıt", text: "Sektördeki en büyük 3 rakibimiz geçen ay bu sisteme geçti. Onların gerisinde kalamayız.", result: "good", score: +40, title: "Mükemmel Hamle!", desc: "Sosyal Kanıt (Social Proof) ve Rekabet (FOMO) korkusunu tetiklediniz. Patronlar rakiplerinden geri kalmaktan nefret eder." },
        { tactic: "Hoşlanma", text: "Siz vizyoner bir lidersiniz. Bu sisteme geçmek vizyonunuza çok yakışacak.", result: "bad", score: -10, title: "Yalakalık Geri Tepti!", desc: "Altı boş iltifatlar zorlu müzakerelerde güvensizlik yaratır." },
        { tactic: "Kıtlık", text: "Yazılım firması bu fiyattan sadece 2 gün daha satış yapacak, sonra %50 zamlanıyor.", result: "mid", score: +10, title: "Fena Değil", desc: "Kıtlık (Scarcity) aciliyet yaratır ama patron sistemin kendisine ihtiyacı olduğuna henüz tam ikna olmamış." }
      ]
    },
    {
      boss: "😠 Müşteri",
      text: "Sizin verdiğiniz fiyat teklifi diğer firmadan %20 daha pahalı. Neden size fazla para ödeyeyim ki?",
      options: [
        { tactic: "Savunma", text: "Çünkü biz daha kaliteliyiz. Onların malzemeleri ucuz Çin malı.", result: "bad", score: -15, title: "Zayıf Argüman!", desc: "Rakibi kötülemek sizi yüceltmez. Müşteri somut bir değer görmek istiyor." },
        { tactic: "Karşılıklılık", text: "Fiyatımız bu, ancak anlaşmayı imzalarsak size 1 yıllık bakım paketini ücretsiz hediye edebiliriz.", result: "good", score: +35, title: "Karşılıklılık Başarılı!", desc: "Karşılıklılık (Reciprocity) prensibi ile müşteriye 'özel bir iyilik' yaptınız. Bu, aradaki fiyat farkını psikolojik olarak kapatır." },
        { tactic: "Otorite", text: "Sayın müşterimiz, biz 25 yıllık bir firmayız ve ISO 9001 belgemiz var.", result: "mid", score: +5, title: "Eski Moda!", desc: "Otorite işe yarar ama 25 yıllık olmak %20 fazla ödemek için tek başına yeterli bir sebep değildir." },
        { tactic: "Taviz (Door-in-the-Face)", text: "Peki, fiyatı %20 düşürüyorum.", result: "bad", score: -30, title: "Değerinizi Düşürdünüz!", desc: "Anında taviz vermek, baştan müşteriyi kandırmaya çalıştığınız hissini yaratır." }
      ]
    }
  ];

  let currentRound = 0;
  let currentScore = 20;

  function renderRound() {
    if (currentRound >= rounds.length) {
      document.getElementById('bossIcon').textContent = "🎉";
      document.getElementById('bossText').textContent = "Tebrikler! Müzakereyi kazandınız ve ikna psikolojisini çok iyi kullanıyorsunuz.";
      document.getElementById('optionsGrid').innerHTML = '<button class="tactic-btn" style="text-align:center" onclick="location.reload()">Tekrar Oyna</button>';
      return;
    }

    const rd = rounds[currentRound];
    document.getElementById('bossIcon').textContent = rd.boss.split(' ')[0];
    document.getElementById('bossText').textContent = `"${rd.text}"`;

    const grid = document.getElementById('optionsGrid');
    grid.innerHTML = '';

    rd.options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'tactic-btn';
      btn.innerHTML = `<span class="tactic-name">${opt.tactic}</span>${opt.text}`;
      btn.onclick = () => handleChoice(opt);
      grid.appendChild(btn);
    });
  }

  function updateBar() {
    if (currentScore < 0) currentScore = 0;
    if (currentScore > 100) currentScore = 100;
    document.getElementById('pFill').style.width = currentScore + '%';
    document.querySelector('.persuasion-label').textContent = `İKNA BARI: %${currentScore}`;
  }

  function handleChoice(opt) {
    currentScore += opt.score;
    updateBar();

    const fBox = document.getElementById('feedbackBox');
    const fTitle = document.getElementById('fTitle');
    const fDesc = document.getElementById('fDesc');

    if (opt.result === 'good') fTitle.style.color = '#10b981';
    else if (opt.result === 'mid') fTitle.style.color = '#f59e0b';
    else fTitle.style.color = '#ef4444';

    fTitle.textContent = opt.title;
    fDesc.textContent = opt.desc;
    fBox.style.display = 'flex';
  }

  function nextRound() {
    document.getElementById('feedbackBox').style.display = 'none';
    currentRound++;
    renderRound();
  }

  // Init
  renderRound();
  updateBar();
</script>
