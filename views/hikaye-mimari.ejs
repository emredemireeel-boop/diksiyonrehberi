<%- include('partials/main-header') %>

<style>
  /* HİKAYE MİMARİ - LIGHT MODE & GLASSMORPHISM WIZARD */
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  main.main-content, div.content-wrapper, div.architect-page { 
    max-width: 100% !important; padding: 0 !important; margin: 0 !important; width: 100% !important; background: transparent !important;
  }
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600;1,800&display=swap');
  
  :root {
    --ar-primary: #059669;
    --ar-light: #d1fae5;
    --ar-dark: #064e3b;
    --ar-accent: #d97706;
    --text-main: #1c1917;
    --text-muted: #57534e;
  }

  /* ARKA PLAN VE LAYOUT */
  .architect-page {
    position: relative; min-height: 100vh;
    background: radial-gradient(circle at top left, #fefce8 0%, #fafaf9 100%);
    padding: 80px 20px;
    overflow-x: hidden;
  }
  .architect-page::before {
    content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
    background-image: radial-gradient(var(--ar-primary) 0.5px, transparent 0.5px);
    background-size: 40px 40px; opacity: 0.05; z-index: 0;
  }

  .architect-header {
    text-align: center; max-width: 800px; margin: 0 auto 50px auto; position: relative; z-index: 2;
    animation: headerIn 0.8s ease-out;
  }
  @keyframes headerIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

  .ar-badge {
    display: inline-block; padding: 8px 24px; border-radius: 30px;
    background: rgba(5, 150, 105, 0.1); border: 1px solid rgba(5, 150, 105, 0.3);
    color: var(--ar-dark); font-size: 0.85rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 20px;
  }
  .architect-header h1 {
    font-family: 'Playfair Display', serif; font-size: 4rem; color: var(--text-main); margin: 0 0 15px 0; line-height: 1.1;
  }
  .architect-header p {
    font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: var(--text-muted); line-height: 1.6;
  }

  /* WIZARD CONTAINER */
  .wizard-container {
    max-width: 900px; margin: 0 auto;
    background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(24px);
    border: 1px solid rgba(5, 150, 105, 0.2); border-radius: 30px;
    box-shadow: 0 40px 80px rgba(5, 150, 105, 0.08); position: relative; z-index: 2; overflow: hidden;
  }

  /* PROGRESS BAR */
  .wizard-progress {
    display: flex; background: rgba(255, 255, 255, 0.9); border-bottom: 1px solid rgba(0,0,0,0.05);
    position: relative;
  }
  .wizard-progress::after {
    content: ''; position: absolute; bottom: 0; left: 0; height: 3px; width: var(--progress, 0%);
    background: linear-gradient(90deg, var(--ar-primary), var(--ar-accent));
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 0 3px 3px 0;
  }
  .wp-step {
    flex: 1; text-align: center; padding: 20px 10px; font-family: 'Outfit', sans-serif;
    font-weight: 700; font-size: 0.95rem; color: #a8a29e; position: relative; transition: 0.3s;
    cursor: default;
  }
  .wp-step.active { color: var(--ar-primary); }
  .wp-step.completed { color: var(--ar-dark); }
  .wp-step::before {
    content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 0; height: 0; border-radius: 50%; background: rgba(5, 150, 105, 0.05);
    transition: all 0.4s;
  }
  .wp-step.active::before { width: 80px; height: 80px; }

  /* WIZARD PANELS */
  .wizard-body { padding: 50px; position: relative; overflow: hidden; }
  .w-panel { display: none; }
  .w-panel.active { display: block; animation: panelSlide 0.5s ease; }
  .w-panel.slide-out { animation: panelSlideOut 0.3s ease forwards; }
  @keyframes panelSlide { 
    from { opacity: 0; transform: translateX(40px); } 
    to { opacity: 1; transform: translateX(0); } 
  }
  @keyframes panelSlideOut { 
    from { opacity: 1; transform: translateX(0); } 
    to { opacity: 0; transform: translateX(-40px); } 
  }

  .panel-title { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--text-main); margin: 0 0 10px 0; }
  .panel-desc { font-family: 'Outfit', sans-serif; font-size: 1.05rem; color: var(--text-muted); margin: 0 0 30px 0; line-height: 1.6; }

  /* FORMS & INPUTS */
  .ar-label { display: block; font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--text-main); margin-bottom: 10px; font-size: 1rem; }
  .ar-textarea {
    width: 100%; background: #ffffff; border: 2px solid #e5e7eb; border-radius: 16px;
    padding: 20px; font-family: 'Outfit', sans-serif; font-size: 1.1rem; color: var(--text-main);
    resize: vertical; min-height: 150px; transition: 0.3s; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
  }
  .ar-textarea:focus { outline: none; border-color: var(--ar-primary); box-shadow: 0 0 0 4px var(--ar-light); }
  
  /* Character counter */
  .char-counter {
    font-family: 'Outfit', sans-serif; font-size: 0.85rem; color: #a8a29e;
    text-align: right; margin-top: 8px; transition: color 0.3s;
  }
  .char-counter.good { color: var(--ar-primary); }

  .tip-box {
    background: #fffbeb; border-left: 4px solid var(--ar-accent); border-radius: 0 12px 12px 0;
    padding: 15px 20px; margin-top: 20px; font-family: 'Outfit', sans-serif; font-size: 0.95rem; color: var(--text-muted); line-height: 1.5;
    animation: tipFade 0.6s 0.3s ease backwards;
  }
  @keyframes tipFade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .tip-box strong { color: var(--ar-accent); }

  /* BUTTONS */
  .w-footer { display: flex; justify-content: space-between; margin-top: 40px; padding-top: 30px; border-top: 1px solid rgba(0,0,0,0.05); }
  .btn-ar {
    font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 1.05rem;
    padding: 14px 30px; border-radius: 30px; cursor: pointer; transition: all 0.3s; display: inline-flex; align-items: center; gap: 10px;
  }
  .btn-back { background: transparent; border: 2px solid #e5e7eb; color: var(--text-muted); }
  .btn-back:hover { background: #f5f5f4; color: var(--text-main); }
  
  .btn-next { background: var(--ar-primary); border: 2px solid var(--ar-primary); color: #fff; box-shadow: 0 10px 20px rgba(5, 150, 105, 0.2); }
  .btn-next:hover { background: var(--ar-dark); border-color: var(--ar-dark); transform: translateY(-2px); box-shadow: 0 15px 30px rgba(5, 150, 105, 0.3); }

  /* RESULT SCREEN */
  .result-script {
    background: #ffffff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 40px; margin-top: 30px;
    font-family: 'Outfit', sans-serif; font-size: 1.15rem; color: var(--text-main); line-height: 1.9; position: relative;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }
  .dir-note {
    display: inline-block; background: var(--ar-light); color: var(--ar-dark);
    font-size: 0.75rem; font-weight: 800; padding: 2px 8px; border-radius: 4px;
    text-transform: uppercase; margin: 0 5px; vertical-align: middle; letter-spacing: 1px;
    animation: dirNotePop 0.3s ease backwards;
  }
  .sc-badge { position: absolute; top: -15px; left: 40px; background: var(--ar-accent); color: #fff; font-size: 0.8rem; font-weight: 800; padding: 5px 15px; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 5px 10px rgba(217, 119, 6, 0.3); }

  /* Typewriter cursor */
  .typewriter-cursor {
    display: inline-block; width: 2px; height: 1.2em; background: var(--ar-primary);
    margin-left: 2px; vertical-align: text-bottom;
    animation: blink 0.8s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  @media(max-width: 768px) {
    .architect-header h1 { font-size: 2.5rem; }
    .wizard-body { padding: 30px 20px; }
    .wp-step { font-size: 0.8rem; padding: 15px 5px; }
  }
</style>

<div class="architect-page">
  <div class="architect-header">
    <div class="ar-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> 3 Perde Tasarımcısı</div>
    <h1>Hikaye Mimarı</h1>
    <p>Sıkıcı bir raporu veya sıradan bir konuyu, dinleyicilerinizi koltuğa çivileyecek gişe rekortmeni bir hikayeye dönüştürün. Adımları doldurun, yönetmen direktifli senaryonuzu alın.</p>
  </div>

  <div class="wizard-container">
    <div class="wizard-progress" id="wizardProgress" style="--progress: 0%;">
      <div class="wp-step active" id="step1-tab">1. Sıradan Dünya</div>
      <div class="wp-step" id="step2-tab">2. Çatışma (Kriz)</div>
      <div class="wp-step" id="step3-tab">3. Çözüm (Sentez)</div>
      <div class="wp-step" id="step4-tab">Sonuç</div>
    </div>

    <div class="wizard-body">
      
      <!-- STEP 1 -->
      <div class="w-panel active" id="panel1">
        <h2 class="panel-title">Perde 1: Sıradan Dünya</h2>
        <p class="panel-desc">Hikayenin başında her şeyin ne kadar "normal" veya "sıkıcı" olduğunu anlatın. Bu, dinleyicinin empati kuracağı zemindir.</p>
        
        <label class="ar-label">Kriz patlak vermeden önce durum nasıldı?</label>
        <textarea id="val1" class="ar-textarea" placeholder="Örn: 2023 yılında her zamanki gibi sabah 09:00'da ofise gelmiş, standart kahvemi almış ve masama oturmuştum. Şirketin satışları stabil gidiyordu ve hiçbir sorun yok gibi görünüyordu..." oninput="updateCounter(this, 'counter1')"></textarea>
        <div class="char-counter" id="counter1">0 karakter</div>
        
        <div class="tip-box"><strong>İpucu:</strong> Kahramanın (sizin veya şirketinizin) ne kadar sıradan ve insani olduğunu gösterin. Başarılarla övünmeyin.</div>
        
        <div class="w-footer">
          <div></div>
          <button class="btn-ar btn-next" onclick="nextStep(1, 2)">Sonraki Adım <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>

      <!-- STEP 2 -->
      <div class="w-panel" id="panel2">
        <h2 class="panel-title">Perde 2: Çatışma ve Kriz</h2>
        <p class="panel-desc">Hikayenin kırılma anı. Her şeyin tepetaklak olduğu, engelin veya problemin ortaya çıktığı o kara geceyi anlatın.</p>
        
        <label class="ar-label">O "Sıradan Dünya"yı yerle bir eden sorun neydi?</label>
        <textarea id="val2" class="ar-textarea" placeholder="Örn: Ancak saat 10:15'te ekranımda o kırmızı hata kodunu gördüm. Tüm müşteri veri tabanımız çökmüştü. Sadece 2 saatimiz vardı ve panik halinde ne yapacağımızı bilmiyorduk..." oninput="updateCounter(this, 'counter2')"></textarea>
        <div class="char-counter" id="counter2">0 karakter</div>
        
        <div class="tip-box"><strong>İpucu:</strong> Kriz anındaki duygularınızı (korku, çaresizlik, panik) saklamayın. Zayıflık göstermek dinleyiciyle aranızdaki güveni (Pathos) artırır.</div>
        
        <div class="w-footer">
          <button class="btn-ar btn-back" onclick="nextStep(2, 1)"><i class="fa-solid fa-arrow-left"></i> Geri</button>
          <button class="btn-ar btn-next" onclick="nextStep(2, 3)">Sonraki Adım <i class="fa-solid fa-arrow-right"></i></button>
        </div>
      </div>

      <!-- STEP 3 -->
      <div class="w-panel" id="panel3">
        <h2 class="panel-title">Perde 3: Çözüm ve Sentez</h2>
        <p class="panel-desc">Kriz nasıl aşıldı? Hangi ders çıkarıldı veya hangi "ürün/fikir" hayat kurtardı?</p>
        
        <label class="ar-label">Karanlıktan nasıl çıkıldı ve ulaştığınız yeni dünya nasıl?</label>
        <textarea id="val3" class="ar-textarea" placeholder="Örn: İşte tam o an, yeni geliştirdiğimiz yedekleme protokolünü devreye soktuk. Sistem 45 dakika içinde tamamen geri geldi. O gün öğrendik ki, krizler aslında sistemimizin ne kadar güçlü olduğunu kanıtlamak için birer fırsattır." oninput="updateCounter(this, 'counter3')"></textarea>
        <div class="char-counter" id="counter3">0 karakter</div>
        
        <div class="tip-box"><strong>İpucu:</strong> Çözümü anlatırken kibrten uzak durun. Kahramanı kurtaran şeyin bulduğunuz "yeni fikir, ürün veya sistem" olduğuna vurgu yapın.</div>
        
        <div class="w-footer">
          <button class="btn-ar btn-back" onclick="nextStep(3, 2)"><i class="fa-solid fa-arrow-left"></i> Geri</button>
          <button class="btn-ar btn-next" onclick="generateStory()"><i class="fa-solid fa-wand-magic-sparkles"></i> Hikayemi Oluştur</button>
        </div>
      </div>

      <!-- STEP 4 (RESULT) -->
      <div class="w-panel" id="panel4">
        <h2 class="panel-title">Epik Senaryonuz Hazır!</h2>
        <p class="panel-desc">Sıradan metniniz retorik analizden geçti. Sunumunuzu yaparken aşağıdaki "Yönetmen Direktiflerine" (Mavi Kutucuklar) harfiyen uyun.</p>
        
        <div class="result-script" id="storyResult">
          <!-- JS ile doldurulacak -->
        </div>
        
        <div class="w-footer">
          <button class="btn-ar btn-back" onclick="location.reload()"><i class="fa-solid fa-rotate-right"></i> Yeni Hikaye Yaz</button>
          <button class="btn-ar btn-next" onclick="window.print()"><i class="fa-solid fa-print"></i> PDF Olarak Kaydet</button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function updateCounter(textarea, counterId) {
    const counter = document.getElementById(counterId);
    const len = textarea.value.length;
    counter.textContent = len + ' karakter';
    counter.classList.toggle('good', len >= 30);
  }

  function updateProgress(step) {
    const pct = ((step - 1) / 3) * 100;
    document.getElementById('wizardProgress').style.setProperty('--progress', pct + '%');
  }

  function nextStep(current, next) {
    // Input validation for going forward
    if(next > current) {
      const val = document.getElementById('val' + current).value.trim();
      if(val.length < 10) {
        // Shake the textarea instead of alert
        const ta = document.getElementById('val' + current);
        ta.style.borderColor = '#ef4444';
        ta.style.animation = 'none';
        ta.offsetHeight; // trigger reflow
        ta.style.animation = 'shakeInput 0.4s ease';
        setTimeout(() => { ta.style.borderColor = ''; ta.style.animation = ''; }, 1000);
        return;
      }
    }
    
    // Slide out current panel
    const currPanel = document.getElementById('panel' + current);
    currPanel.classList.add('slide-out');
    
    setTimeout(() => {
      currPanel.classList.remove('active', 'slide-out');
      document.getElementById('panel' + next).classList.add('active');
      
      // Progress Bar Update
      updateProgress(next);
      document.querySelectorAll('.wp-step').forEach((el, index) => {
        el.classList.remove('active', 'completed');
        if(index + 1 < next) el.classList.add('completed');
        if(index + 1 === next) el.classList.add('active');
      });
    }, 300);
  }

  function generateStory() {
    const s1 = document.getElementById('val1').value.trim();
    const s2 = document.getElementById('val2').value.trim();
    const s3 = document.getElementById('val3').value.trim();
    
    if(s3.length < 10) {
      const ta = document.getElementById('val3');
      ta.style.borderColor = '#ef4444';
      ta.style.animation = 'shakeInput 0.4s ease';
      setTimeout(() => { ta.style.borderColor = ''; ta.style.animation = ''; }, 1000);
      return;
    }

    // Direktifli metin birleştirme
    const finalStory = `
      <div class="sc-badge">Sunum Senaryosu</div>
      <p><span class="dir-note">Gülümse ve 2 saniye sessiz kal</span> Herkese merhaba. Söze şöyle başlamak istiyorum... <br><br>
      ${escapeHtml(s1)} 
      </p>
      <p><span class="dir-note">Yüz hatlarını ciddileştir</span> <span class="dir-note">Sesini Alçalt</span> 
      Ancak işler her zaman planlandığı gibi gitmiyor... <br><br>
      ${escapeHtml(s2)}
      </p>
      <p><span class="dir-note">Göz temasını artır</span> <span class="dir-note">Sesine enerji kat</span> 
      Fakat tam bu karanlık noktada bir karar verdik... <br><br>
      ${escapeHtml(s3)}
      </p>
      <p><span class="dir-note">Yavaşla ve vurgula</span>
      İşte bu yüzden, bu anlattığım sadece bir anı değil, bizim dayanıklılığımızın kanıtıdır. Teşekkür ederim.</p>
    `;

    // Typewriter effect
    const resultDiv = document.getElementById('storyResult');
    resultDiv.innerHTML = '';
    
    nextStep(3, 4);
    
    // Start typewriter after panel transition
    setTimeout(() => {
      typewriterHTML(resultDiv, finalStory, 5);
    }, 500);
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Typewriter that preserves HTML
  function typewriterHTML(element, html, speed) {
    element.innerHTML = html;
    const fullHTML = element.innerHTML;
    element.innerHTML = '';
    
    let idx = 0;
    let inTag = false;
    let buffer = '';
    
    function tick() {
      if (idx >= fullHTML.length) return;
      
      const char = fullHTML[idx];
      
      if (char === '<') inTag = true;
      if (inTag) {
        buffer += char;
        if (char === '>') {
          inTag = false;
          element.innerHTML += buffer;
          buffer = '';
        }
        idx++;
        tick(); // Process tags instantly
        return;
      }
      
      element.innerHTML += char;
      idx++;
      setTimeout(tick, speed);
    }
    
    tick();
  }
</script>

<style>
  @keyframes shakeInput {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-6px); }
    40%, 80% { transform: translateX(6px); }
  }
</style>

<%- include('partials/main-footer') %>
