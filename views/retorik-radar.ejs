<%- include('partials/main-header') %>

<style>
  body { background: #000000; color: #ffffff; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .rr-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; max-width: 900px; margin: 0 auto; width: 100%; }
  
  .instruction-panel { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 20px; z-index: 10; backdrop-filter: blur(10px); transition: opacity 0.3s; }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #ef4444; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #cbd5e1; margin: 0; max-width: 600px; line-height: 1.5; }

  /* Radar Screen */
  .radar-screen { background: #0f172a; width: 100%; height: 300px; border-radius: 20px; border: 2px solid #334155; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 40px; box-shadow: inset 0 0 50px rgba(0,0,0,0.8); margin-bottom: 40px; }
  
  /* Scanning line */
  .radar-scan { position: absolute; width: 100%; height: 4px; background: rgba(239, 68, 68, 0.5); box-shadow: 0 0 20px #ef4444; top: 0; left: 0; animation: scanAnim 3s linear infinite; display: none; }
  @keyframes scanAnim { 0% { top: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 100%; opacity: 0; } }

  .subtitle-text { font-size: 2.5rem; font-weight: 800; color: #94a3b8; text-align: center; line-height: 1.4; transition: color 0.2s; }
  .subtitle-text.highlight { color: #ffffff; text-shadow: 0 0 20px rgba(255,255,255,0.5); }

  .controls { display: flex; gap: 20px; z-index: 10; }
  .btn-hata {
    background: #ef4444; color: #ffffff; border: none; padding: 25px 60px; border-radius: 40px;
    font-size: 1.5rem; font-weight: 900; cursor: pointer; transition: all 0.1s; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 10px 30px rgba(239, 68, 68, 0.4);
  }
  .btn-hata:active { transform: scale(0.95); background: #dc2626; }
  
  .btn-start { background: #38bdf8; color: #0f172a; border: none; padding: 15px 40px; border-radius: 30px; font-size: 1.1rem; font-weight: 800; cursor: pointer; text-transform: uppercase; }

  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(255,255,255,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #ffffff; }

  /* Result overlay */
  .result-box { position: absolute; inset: 0; background: rgba(15,23,42,0.95); z-index: 20; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center; backdrop-filter: blur(10px); }
  .result-title { font-size: 4rem; font-weight: 900; margin-bottom: 20px; }
  .result-desc { font-size: 1.2rem; color: #cbd5e1; max-width: 600px; line-height: 1.6; margin-bottom: 40px; }

</style>

<a href="/retorik" class="btn-back">← Retorik'e Dön</a>

<div class="rr-container">
  
  <div class="instruction-panel" id="panel">
    <h1 class="instruction-title">Logos Radarı</h1>
    <p class="instruction-desc">Ekranda akan konuşmayı dikkatle okuyun. Cümlelerin içine gizlenmiş "Mantık Hatalarını" (Safsataları) gördüğünüz saniye HATA butonuna basın. Yanlış yerde basarsanız puan kaybedersiniz.</p>
  </div>

  <div class="radar-screen">
    <div class="radar-scan" id="scanner"></div>
    <div class="subtitle-text" id="subText">Sistemi başlatmak için butona basın.</div>
  </div>

  <div class="controls" id="controlsBox">
    <button class="btn-start" onclick="startRadar()">Radarı Başlat</button>
  </div>

</div>

<div class="result-box" id="resultBox">
  <div class="result-title" id="rTitle">Yakalandı!</div>
  <div class="result-desc" id="rDesc">Açıklama</div>
  <button class="btn-start" onclick="location.reload()">Tekrar Oyna</button>
</div>

<script>
  // Timing in ms
  const scriptLines = [
    { text: "Değerli halkımız...", time: 2000, isFallacy: false },
    { text: "Bugün ekonomiyi düzeltmek için toplandık.", time: 3000, isFallacy: false },
    { text: "Biliyorum, bazı uzmanlar planımı eleştiriyor.", time: 3500, isFallacy: false },
    { text: "Ama o eleştiren adam zaten geçen yıl eşinden boşandı, karakteri bozuk!", time: 4000, isFallacy: true, fallacyName: "Ad Hominem (Kişiye Saldırı)", desc: "Eleştirilen şey plan değil, eleştiren kişinin özel hayatı. Mantık hatasını başarıyla tespit ettiniz!" },
    { text: "Siz böyle ahlaksız insanların lafına mı inanacaksınız?", time: 3000, isFallacy: false }
  ];

  let currentLine = -1;
  let isRunning = false;
  let timeoutId = null;

  const subText = document.getElementById('subText');
  const panel = document.getElementById('panel');
  const controlsBox = document.getElementById('controlsBox');
  const scanner = document.getElementById('scanner');
  const rBox = document.getElementById('resultBox');
  const rTitle = document.getElementById('rTitle');
  const rDesc = document.getElementById('rDesc');

  function startRadar() {
    isRunning = true;
    panel.style.opacity = '0.1';
    scanner.style.display = 'block';
    
    // Switch controls to HATA button
    controlsBox.innerHTML = '<button class="btn-hata" onclick="hitRadar()">HATA VAR!</button>';
    
    nextLine();
  }

  function nextLine() {
    currentLine++;
    if (currentLine >= scriptLines.length) {
      endGame(false, "Konuşma Bitti", "Maalesef mantık hatasını kaçırdınız. Konuşmacı sizi kandırdı.");
      return;
    }

    const line = scriptLines[currentLine];
    subText.textContent = `"${line.text}"`;
    subText.classList.add('highlight');
    setTimeout(() => subText.classList.remove('highlight'), 500);

    timeoutId = setTimeout(nextLine, line.time);
  }

  function hitRadar() {
    if (!isRunning) return;
    clearTimeout(timeoutId);
    isRunning = false;
    scanner.style.display = 'none';

    const line = scriptLines[currentLine];
    if (line.isFallacy) {
      endGame(true, "MÜKEMMEL YAKALADIN!", `${line.fallacyName}. ${line.desc}`);
    } else {
      endGame(false, "YANLIŞ ALARM!", "Bu cümlede bir mantık hatası yoktu. Müzakereyi bozdunuz.");
    }
  }

  function endGame(win, title, desc) {
    rTitle.textContent = title;
    rTitle.style.color = win ? '#10b981' : '#ef4444';
    rDesc.textContent = desc;
    rBox.style.display = 'flex';
  }
</script>
