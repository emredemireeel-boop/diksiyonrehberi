<%- include('partials/main-header') %>

<style>
  /* LIGHT MODE PREMIUM UIX OVERRIDES - FULL SCREEN STAGE */
  body { background: #fafaf9 !important; color: #1c1917; margin: 0; padding: 0;  }
  main.main-content, div.content-wrapper, div.sahne-page { 
    max-width: 100% !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    width: 100% !important;
    background: transparent !important;
  }
  
  /* FONTS & VARIABLES */
  
  
  :root {
    --sh-primary: #0284c7; /* Elegant Deep Sky Blue */
    --sh-dark: #075985;
    --sh-light: #e0f2fe;
    --sh-accent: #38bdf8;
    --gold-primary: #C59D5F; 
    --light-bg: #fafaf9;
    --glass-bg: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(2, 132, 199, 0.2);
    --text-main: #0f172a;
    --text-muted: #475569;
  }

  /* HERO SECTION */
  .sh-hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(circle at top, #ffffff 0%, #f0f9ff 100%);
    overflow: hidden;
  }
  .sh-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    /* Subtle stage lights background image */
    background: url('https://images.unsplash.com/photo-1516280440504-6298579d46af?auto=format&fit=crop&w=1920&q=80') center/cover;
    opacity: 0.04;
    z-index: 0;
    mix-blend-mode: multiply;
  }
  
  /* Spotlight effect */
  .sh-hero::after {
    content: '';
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(2, 132, 199, 0.08) 0%, transparent 60%);
    pointer-events: none;
    z-index: 1;
  }

  .sh-hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    padding: 0 20px;
    animation: fadeUp 1s ease-out;
  }
  .sh-badge {
    display: inline-block;
    padding: 8px 24px;
    border-radius: 30px;
    background: rgba(2, 132, 199, 0.1);
    border: 1px solid var(--sh-primary);
    color: var(--sh-dark);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 30px;
    backdrop-filter: blur(10px);
  }
  .sh-title {
    
    font-size: 5.5rem;
    line-height: 1.1;
    margin: 0 0 20px 0;
    color: var(--text-main);
    text-shadow: 0 10px 30px rgba(2, 132, 199, 0.1);
  }
  .sh-title span {
    color: var(--sh-primary);
    font-style: italic;
  }
  .sh-subtitle {
    
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 400;
    max-width: 650px;
    margin: 0 auto 50px auto;
    line-height: 1.8;
  }

  .sh-stats-container {
    display: flex;
    justify-content: center;
    gap: 50px;
    margin-top: 20px;
  }
  .sh-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sh-stat-num {
    
    font-size: 2.8rem;
    color: var(--sh-dark);
    font-weight: 700;
    line-height: 1;
  }
  .sh-stat-label {
    
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 8px;
    font-weight: 600;
  }

  /* SIMULATIONS BANNER */
  .sh-lab-banner {
    max-width: 1400px;
    margin: -60px auto 60px auto;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 30px;
    padding: 60px 40px;
    position: relative;
    z-index: 10;
    box-shadow: 0 30px 60px rgba(2, 132, 199, 0.08);
    text-align: center;
  }
  .sh-lab-banner::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px;
    background: linear-gradient(90deg, var(--sh-light), var(--sh-primary), var(--sh-dark), var(--sh-light));
    border-radius: 30px 30px 0 0;
  }
  .lab-title {  font-size: 2.5rem; color: var(--text-main); margin: 0 0 15px 0; }
  .lab-desc {  color: var(--text-muted); font-size: 1.1rem; max-width: 800px; margin: 0 auto 40px auto; line-height: 1.6; }
  
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .btn-sim {
    background: #ffffff;
    border: 2px solid #e2e8f0;
    padding: 20px 20px;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    position: relative;
    overflow: hidden;
  }
  
  .btn-sim .sim-icon {
    font-size: 2rem;
    height: 60px; width: 60px;
    display: flex; align-items: center; justify-content: center;
    background: #f8fafc;
    border-radius: 16px;
    transition: all 0.3s;
  }

  .btn-sim .sim-name {
    
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-main);
  }

  .btn-sim:hover {
    transform: translateY(-5px);
    border-color: var(--sh-accent);
    box-shadow: 0 15px 30px rgba(2, 132, 199, 0.1);
  }
  .btn-sim:hover .sim-icon {
    background: var(--sh-primary);
    color: white;
    transform: scale(1.1);
  }

  /* NAVIGATION */
  .sh-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding: 20px 0;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    box-shadow: 0 5px 15px rgba(0,0,0,0.02);
  }
  .sh-nav-item {
    color: var(--text-muted);
    text-decoration: none;
    padding: 10px 25px;
    border-radius: 20px;
    
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }
  .sh-nav-item.active {
    background: rgba(2, 132, 199, 0.1);
    border-color: var(--sh-primary);
    color: var(--sh-dark);
  }
  .sh-nav-item:hover:not(.active) {
    background: #f1f5f9;
    color: var(--text-main);
  }

  /* CONTENT AREA */
  .sh-content-area {
    max-width: 1400px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .sh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 30px;
  }

  .sh-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 40px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .sh-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at top right, rgba(2, 132, 199, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }
  .sh-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(2, 132, 199, 0.08);
    border-color: var(--sh-primary);
  }
  
  .sh-card-num {
    
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--sh-primary);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 15px;
  }
  .sh-card-title {
    
    font-size: 2.2rem;
    color: var(--text-main);
    margin: 0 0 15px 0;
  }
  .sh-card-desc {
    
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 30px;
    flex-grow: 1;
  }
  
  .sh-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid rgba(0,0,0,0.05);
  }
  .sh-card-count {
    
    font-weight: 600;
    color: var(--sh-dark);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sh-card-btn {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--sh-light);
    color: var(--sh-dark);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
    transition: all 0.3s;
  }
  .sh-card:hover .sh-card-btn {
    background: var(--sh-primary);
    color: white;
    transform: translateX(5px);
  }

  /* KEYFRAMES */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .sh-title { font-size: 3.5rem; }
    .sh-stats-container { gap: 20px; }
    .lab-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .sh-grid { grid-template-columns: 1fr; }
  }
</style>

