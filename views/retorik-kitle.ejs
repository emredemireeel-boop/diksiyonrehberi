<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .ks-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; max-width: 900px; margin: 0 auto; width: 100%; gap: 30px; }
  
  .instruction-panel { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 20px 40px; border-radius: 20px; text-align: center; z-index: 10; backdrop-filter: blur(10px); width: 100%; }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #eab308; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #cbd5e1; margin: 0 auto; max-width: 600px; line-height: 1.5; }

  .crowd-box { background: #1e293b; padding: 40px; border-radius: 20px; text-align: center; border: 2px solid #334155; width: 100%; position: relative; box-shadow: 0 20px 40px rgba(0,0,0,0.4); display: flex; flex-direction: column; gap: 15px; }
  .crowd-emoji { font-size: 5rem; line-height: 1; margin: 0; animation: pulse 2s infinite; }
  .crowd-mood { font-size: 1.8rem; font-weight: 900; margin: 0; text-transform: uppercase; }
  .crowd-desc { color: #334155; font-size: 1.1rem; margin: 0; }

  @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1); } }

  .options-grid { display: grid; grid-template-columns: 1fr; gap: 15px; width: 100%; }
  .strategy-btn {
    background: #0f172a; border: 2px solid #475569; color: #ffffff; padding: 20px; border-radius: 16px;
    font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: all 0.2s; text-align: left; line-height: 1.5;
  }
  .strategy-btn:hover { border-color: #eab308; background: rgba(234, 179, 8, 0.1); transform: translateX(10px); }
  .strategy-btn .tactic { display: block; color: #eab308; font-size: 0.8rem; font-weight: 900; text-transform: uppercase; margin-bottom: 5px; }

  .feedback-box { position: absolute; inset: 0; background: rgba(15,23,42,0.95); z-index: 20; display: none; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center; backdrop-filter: blur(10px); }
  .feedback-title { font-size: 3rem; font-weight: 900; margin-bottom: 20px; }
  .feedback-desc { font-size: 1.2rem; color: #cbd5e1; max-width: 600px; line-height: 1.6; margin-bottom: 40px; }
  .btn-next { background: #eab308; color: #0f172a; border: none; padding: 15px 40px; border-radius: 30px; font-size: 1.1rem; font-weight: 800; cursor: pointer; text-transform: uppercase; }

  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(255,255,255,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #ffffff; }

</style>

<a href="/retorik" class="btn-back">← Retorik'e Dön</a>

<div class="ks-container">
  
  <div class="instruction-panel">
    <h1 class="instruction-title">Kitle Sörfü (Kalabalık Okuyucu)</h1>
    <p class="instruction-desc">Sahneye çıktınız. Karşınızdaki kitlenin psikolojik durumunu (Mood) okuyun ve onlara hitap edecek EN DOĞRU başlangıç stratejisini seçin. Yanlış strateji kitleyi tamamen kaybetmenize yol açar.</p>
  </div>

  <div class="crowd-box" id="crowdBox">
    <div class="crowd-emoji" id="cEmoji">👀</div>
    <div class="crowd-mood" id="cMood">KİTLE BEKLİYOR</div>
    <div class="crowd-desc" id="cDesc">Simülasyonu başlatmak için hazır mısınız?</div>
  </div>

  <div class="options-grid" id="optionsGrid">
    <button class="strategy-btn" style="text-align:center" onclick="startGame()">SAHNEYE ÇIK</button>
  </div>

</div>

<div class="feedback-box" id="feedbackBox">
  <div class="feedback-title" id="fTitle">Sonuç</div>
  <div class="feedback-desc" id="fDesc">Açıklama</div>
  <button class="btn-next" onclick="nextQuestion()">Devam Et</button>
</div>

<script>
  const scenarios = [
    {
      emoji: "😠", mood: "DÜŞMANCA (HOSTILE)", desc: "Kitle size ve anlattıklarınıza ön yargılı. Kollarını bağlamışlar ve açık arıyorlar.", color: "#ef4444",
      options: [
        { tactic: "Mizah", text: "Gülümseyerek komik bir fıkra anlatmak.", isCorrect: false, feedback: "HATA! Düşmanca bir kitleye şaka yapmak onların ciddiye alınmadığını hissetmesine ve öfkelenmesine neden olur." },
        { tactic: "Ortak Zemin (Common Ground)", text: "Onlarla aynı fikirde olduğunuz küçük bir konuyu kabul ederek başlamak.", isCorrect: true, feedback: "DOĞRU! Düşmanca kitlelerde önce 'Ben de sizdenim, bu noktada haklısınız' diyerek kalkanları indirmelisiniz." },
        { tactic: "Otorite", text: "Ünvanlarınızı ve başarılarınızı sayarak üstünlük kurmak.", isCorrect: false, feedback: "HATA! Zaten size düşman olan birine üstünlük taslamak sadece nefreti körükler." }
      ]
    },
    {
      emoji: "🥱", mood: "SIKILMIŞ (BORED)", desc: "Kitle sizden önce 4 konuşmacı dinledi. Telefonlarına bakıyorlar ve enerjileri sıfır.", color: "#8b5cf6",
      options: [
        { tactic: "İstatistik (Logos)", text: "Konunun önemini anlatan karmaşık veriler ve grafikler sunmak.", isCorrect: false, feedback: "HATA! Zaten sıkılmış bir kitleye rakam vermek onları tamamen uyutur." },
        { tactic: "Sarsıcı Soru / Hikaye (Kanca)", text: "Sessizce durup, onları şok edecek beklenmedik bir soru sormak veya hikayeye girmek.", isCorrect: true, feedback: "DOĞRU! Dikkat dağınıklığını kırmanın tek yolu patern (kalıp) kırmaktır. Şok edici bir kanca onları telefondan ayırır." },
        { tactic: "Teşekkür", text: "Organizasyona ve önceki konuşmacılara uzun uzun teşekkür etmek.", isCorrect: false, feedback: "HATA! Sıkılmış kitle uzatılan girişleri sevmez, hemen sadede gelmek gerekir." }
      ]
    },
    {
      emoji: "😰", mood: "ENDİŞELİ (ANXIOUS)", desc: "Şirkette kriz var, işten çıkarmalar konuşuluyor. Kitle korku içinde sizden cevap bekliyor.", color: "#38bdf8",
      options: [
        { tactic: "Empati ve Şeffaflık", text: "Durumun ciddiyetini kabul edip, onların korkularını anladığınızı açıkça söylemek.", isCorrect: true, feedback: "DOĞRU! Endişeli kitle önce anlaşıldığını hissetmek ister (Pathos). Sonra mantıklı bir plan (Logos) sunabilirsiniz." },
        { tactic: "Aşırı Pozitiflik", text: "Her şeyin harika olduğunu, endişelenecek hiçbir şey olmadığını coşkuyla anlatmak.", isCorrect: false, feedback: "HATA! Gerçekleri inkar eden 'toksik pozitiflik', liderliğinize olan güveni (Ethos) yok eder." },
        { tactic: "Mizah", text: "Ortamı yumuşatmak için komik bir anınızı anlatmak.", isCorrect: false, feedback: "HATA! İnsanların işlerini kaybetme korkusu yaşadığı bir ortamda mizah empati yoksunluğu olarak algılanır." }
      ]
    }
  ];

  let currentS = 0;
  
  const cEmoji = document.getElementById('cEmoji');
  const cMood = document.getElementById('cMood');
  const cDesc = document.getElementById('cDesc');
  const crowdBox = document.getElementById('crowdBox');
  const optionsGrid = document.getElementById('optionsGrid');
  
  const feedbackBox = document.getElementById('feedbackBox');
  const fTitle = document.getElementById('fTitle');
  const fDesc = document.getElementById('fDesc');

  function startGame() {
    currentS = 0;
    renderScenario();
  }

  function renderScenario() {
    if (currentS >= scenarios.length) {
      cEmoji.textContent = "🏆";
      cMood.textContent = "ÜSTÜN BAŞARI";
      cDesc.textContent = "Kitle psikolojisini okumakta ustalaştınız!";
      crowdBox.style.borderColor = "#eab308";
      optionsGrid.innerHTML = '<button class="strategy-btn" style="text-align:center" onclick="location.reload()">Tekrar Oyna</button>';
      return;
    }

    const item = scenarios[currentS];
    cEmoji.textContent = item.emoji;
    cMood.textContent = item.mood;
    cMood.style.color = item.color;
    cDesc.textContent = item.desc;
    crowdBox.style.borderColor = item.color;
    
    // Shuffle options
    const opts = [...item.options].sort(() => Math.random() - 0.5);
    
    optionsGrid.innerHTML = '';
    opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'strategy-btn';
      btn.innerHTML = `<span class="tactic">${opt.tactic}</span>${opt.text}`;
      btn.onclick = () => handleChoice(opt);
      optionsGrid.appendChild(btn);
    });
  }

  function handleChoice(opt) {
    if (opt.isCorrect) {
      showFeedback(true, "DOĞRU STRATEJİ!", opt.feedback);
    } else {
      showFeedback(false, "KİTLEYİ KAYBETTİNİZ!", opt.feedback);
    }
  }

  function showFeedback(win, title, desc) {
    fTitle.textContent = title;
    fTitle.style.color = win ? '#10b981' : '#ef4444';
    fDesc.textContent = desc;
    feedbackBox.style.display = 'flex';
  }

  function nextQuestion() {
    feedbackBox.style.display = 'none';
    currentS++;
    renderScenario();
  }
</script>
