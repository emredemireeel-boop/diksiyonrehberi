<%- include('partials/main-header') %>

<style>
  /* 🎈 Overriding global dark theme specifically for this page 🎈 */
  body { background: #fdfaf6; color: #334155; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🎈 Hero 🎈 */
  .c-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 10%, #fef3c7 0%, #fdfaf6 70%);
  }
  .c-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fdfaf6,transparent); }

  .hero-shapes { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .shape { position:absolute; border-radius:30% 70% 70% 30% / 30% 30% 70% 70%; animation: morphFloat 12s ease-in-out infinite; opacity: 0.15; }
  .s1 { background: linear-gradient(135deg, #f59e0b, #fbbf24); width: 300px; height: 300px; left: -10%; top: 20%; animation-delay: 0s; }
  .s2 { background: linear-gradient(135deg, #10b981, #34d399); width: 250px; height: 250px; right: -5%; top: 10%; animation-delay: -4s; }
  .s3 { background: linear-gradient(135deg, #8b5cf6, #a78bfa); width: 200px; height: 200px; right: 20%; bottom: -10%; animation-delay: -8s; }

  @keyframes morphFloat { 0%,100%{ transform:translateY(0) scale(1) rotate(0deg); border-radius:30% 70% 70% 30% / 30% 30% 70% 70%; } 50%{ transform:translateY(-50px) scale(1.1) rotate(20deg); border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%; } }

  .c-icon { font-size: 6rem; margin-bottom: 20px; animation: bounceGently 3s ease-in-out infinite; filter: drop-shadow(0 10px 20px rgba(245,158,11,0.2)); }
  @keyframes bounceGently { 0%,100%{ transform: translateY(0); } 50%{ transform: translateY(-15px); } }

  .c-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color: #b45309; background: #fef3c7; border:1px solid #fde68a; margin-bottom:24px; box-shadow: 0 4px 15px rgba(245,158,11,0.1); }
  .c-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color: #0f172a; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .c-title span { background: linear-gradient(135deg, #f59e0b, #ec4899); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .c-subtitle { color: #64748b; font-size:1.15rem; max-width:700px; line-height:1.8; }

  /* 🎈 Container 🎈 */
  .c-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 🎈 Light Glass Cards (Playroom Style) 🎈 */
  .glass-play { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(20px); border: 2px solid #fff; border-radius: 32px; padding: 40px; margin-bottom: 40px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.04); }
  .glass-play:hover { transform: translateY(-5px); box-shadow: 0 25px 50px rgba(245, 158, 11, 0.08); border-color: #fef08a; }
  
  .section-label { font-size:1rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #ec4899; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label.blue { color: #0ea5e9; }
  .section-label.green { color: #10b981; }

  /* 🎈 Interactive Balloon Game (Breathing) 🎈 */
  .balloon-container { display: flex; justify-content: center; gap: 30px; margin: 40px 0; flex-wrap: wrap; }
  .balloon { width: 100px; height: 120px; border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%; position: relative; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 2rem; box-shadow: inset -10px -10px 20px rgba(0,0,0,0.1), 0 10px 20px rgba(0,0,0,0.1); transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); animation: floatBalloon 4s ease-in-out infinite alternate; }
  .balloon::after { content: ''; position: absolute; bottom: -15px; left: 50%; transform: translateX(-50%); border-left: 5px solid transparent; border-right: 5px solid transparent; border-bottom: 10px solid; }
  .balloon::before { content: ''; position: absolute; bottom: -60px; left: 50%; width: 2px; height: 50px; background: #cbd5e1; z-index: -1; }
  
  .balloon.b-red { background: linear-gradient(135deg, #f87171, #ef4444); animation-delay: 0s; }
  .balloon.b-red::after { border-bottom-color: #ef4444; }
  .balloon.b-blue { background: linear-gradient(135deg, #60a5fa, #3b82f6); animation-delay: 1s; }
  .balloon.b-blue::after { border-bottom-color: #3b82f6; }
  .balloon.b-green { background: linear-gradient(135deg, #34d399, #10b981); animation-delay: 2s; }
  .balloon.b-green::after { border-bottom-color: #10b981; }

  .balloon:hover { transform: scale(1.1) translateY(-10px); }
  .balloon:active { transform: scale(0.9); }
  .balloon.popped { transform: scale(0); opacity: 0; pointer-events: none; }

  @keyframes floatBalloon { 0% { transform: translateY(0) rotate(-5deg); } 100% { transform: translateY(-20px) rotate(5deg); } }

  .balloon-hint { text-align: center; font-size: 1.2rem; font-weight: 700; color: #f59e0b; min-height: 40px; margin-top: 40px; }

  /* 🎈 Flashcards (Twisters & Sounds) 🎈 */
  .flashcard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; perspective: 1000px; }
  .flashcard { height: 200px; position: relative; transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1); cursor: pointer; }
  .flashcard.flipped { transform: rotateY(180deg); }
  
  .fc-face { position: absolute; width: 100%; height: 100%; border-radius: 24px; backface-visibility: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
  
  .fc-front { background: linear-gradient(135deg, #ffffff, #f8fafc); border: 2px dashed #cbd5e1; }
  .fc-front .emoji { font-size: 4rem; margin-bottom: 10px; }
  .fc-front .title { font-size: 1.2rem; font-weight: 800; color: #334155; }
  
  .fc-back { background: linear-gradient(135deg, #8b5cf6, #6366f1); transform: rotateY(180deg); color: white; }
  .fc-back .letter { font-size: 3rem; font-weight: 900; margin-bottom: 10px; opacity: 0.2; position: absolute; top: -10px; right: 20px; }
  .fc-back p { font-size: 1.1rem; font-weight: 600; line-height: 1.5; margin: 0; z-index: 2; position: relative; }
  .fc-back .tip { font-size: 0.8rem; background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 100px; margin-top: 15px; }

  /* 🎈 Parent Guide Banner 🎈 */
  .guide-banner { background: #fef2f2; border: 2px solid #fecaca; border-radius: 24px; padding: 30px; display: flex; gap: 24px; align-items: center; }
  .guide-icon { font-size: 3rem; background: #fff; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 20px; box-shadow: 0 10px 20px rgba(239,68,68,0.1); flex-shrink: 0; }
  .guide-content h3 { color: #b91c1c; font-size: 1.3rem; font-weight: 800; margin: 0 0 8px 0; }
  .guide-content p { color: #7f1d1d; font-size: 0.95rem; line-height: 1.6; margin: 0; }

  @media(max-width: 768px) {
    .guide-banner { flex-direction: column; text-align: center; }
  }

  /* 🎈 Back Button 🎈 */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #e2e8f0; color:#475569; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#f8fafc; color:#0f172a; transform:translateX(-4px); border-color: #cbd5e1; }

  /* 🎈 Reveal 🎈 */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="c-hero">
  <div class="hero-shapes">
    <div class="shape s1"></div>
    <div class="shape s2"></div>
    <div class="shape s3"></div>
  </div>
  <div class="c-icon">🧸</div>
  <div class="c-badge">🎲 Oyunla Öğrenme Merkezi</div>
  <h1 class="c-title"><span>Çocuk Diksiyon</span> & Artikülasyon</h1>
  <p class="c-subtitle">3 ile 12 yaş arası çocuklarda pelteklik, harf yutma (R, S, Ş) ve ifade güçlüklerini "ders" gibi değil, eğlenceli oyunlar, masallar ve hayvan sesleriyle çözme rehberi.</p>
</section>

<div class="c-wrap">
  <a href="/diksiyon?cat=cocuk" class="back-btn">Tüm Çocuk Egzersizlerini Gör</a>

  <!-- 🎈 BREATHING BALLOONS (Interactive) 🎈 -->
  <div class="glass-play reveal">
    <div class="section-label blue">🌬️ Nefes & Tıslama Oyun Alanı</div>
    <p style="color:#475569; font-size:1rem; line-height:1.6; margin-bottom:10px;">Çocuğunuza diyafram nefesini öğretmek için balonları kullanın. Balona tıklayın ve çıkan komutu çocuğunuzla birlikte uygulayın!</p>

    <div class="balloon-container">
      <div class="balloon b-red" onclick="popBalloon(this, 'red')">🐍</div>
      <div class="balloon b-blue" onclick="popBalloon(this, 'blue')">🦁</div>
      <div class="balloon b-green" onclick="popBalloon(this, 'green')">🐝</div>
    </div>
    
    <div class="balloon-hint" id="balloonHint">Bir balona tıklayıp patlatın!</div>
  </div>

  <!-- 🎈 FLASHCARDS (Interactive) 🎈 -->
  <div class="glass-play reveal">
    <div class="section-label">🔤 Sihirli Ses Kartları (Çevir!)</div>
    <p style="color:#475569; font-size:1rem; line-height:1.6; margin-bottom:30px;">Zor harfler için hazırladığımız fonetik oyun kartlarına tıklayarak arkasındaki sırrı (oyunu) öğrenin.</p>
    
    <div class="flashcard-grid">
      <!-- Card 1 -->
      <div class="flashcard" onclick="this.classList.toggle('flipped')">
        <div class="fc-face fc-front">
          <div class="emoji">🏎️</div>
          <div class="title">R Harfi Motoru</div>
        </div>
        <div class="fc-face fc-back">
          <span class="letter">R</span>
          <p>"Tıdı-Tıdı-Tıdı" diyerek at koşturun. Hızlandıkça dil üst damağa vurup doğal "R" sesini çıkaracaktır.</p>
          <span class="tip">Zorlama: Sadece Titret</span>
        </div>
      </div>
      
      <!-- Card 2 -->
      <div class="flashcard" onclick="this.classList.toggle('flipped')">
        <div class="fc-face fc-front">
          <div class="emoji">🤫</div>
          <div class="title">Pelteklik S-Ş Kilidi</div>
        </div>
        <div class="fc-face fc-back" style="background: linear-gradient(135deg, #ec4899, #be185d);">
          <span class="letter">S</span>
          <p>Kocaman gülümse ve dişlerini kapa! Dilin ön dişlerin arkasına hapsolsun. Şimdi ince bir "Ssssss" tıslaması yap.</p>
          <span class="tip">Gülümse ve Kilitle</span>
        </div>
      </div>
      
      <!-- Card 3 -->
      <div class="flashcard" onclick="this.classList.toggle('flipped')">
        <div class="fc-face fc-front">
          <div class="emoji">🐸</div>
          <div class="title">Kurbağa Çenesi (A-O)</div>
        </div>
        <div class="fc-face fc-back" style="background: linear-gradient(135deg, #10b981, #047857);">
          <span class="letter">A</span>
          <p>Ağzını hiç açmadan konuşanlar için: Aynanın karşısına geç ve kurbağa gibi ağzını kocaman açarak esne.</p>
          <span class="tip">Ayna Oyunu</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 🎈 PARENT GUIDE 🎈 -->
  <div class="guide-banner reveal">
    <div class="guide-icon">👨‍👩‍👧</div>
    <div class="guide-content">
      <h3>Ebeveynlere Altın Kural</h3>
      <p>Çocuk psikolojisinde <strong>"Yanlış söyledin, doğrusu şu!"</strong> demek harika bir yıkım aracıdır ve çocuğu tamamen susturur. Çocuğunuz "Alaba" dediğinde onu eleştirmeyin; sadece <strong>"Evet tatlım, kırmızı bir A-ra-ba geçiyor"</strong> diyerek, kelimenin doğrusunu yavaşça modelleyin. Diksiyon, çocuklar için bir ders değil, ebeveynleriyle oynadıkları bir <strong>Taklit Oyunudur</strong>.</p>
    </div>
  </div>

</div>

<script>
// 🎈 Scroll Reveal 🎈
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🎈 Balloon Logic 🎈
const balloonHints = {
  red: "🐍 Yılan Tıslaması: Derin nefes al ve 'Ssssssss' diyerek 10 saniye boyunca nefesini yavaşça üfle! (Diyafram Kontrolü)",
  blue: "🦁 Aslan Esnemesi: Ağzını kocaman aç, bir aslan gibi sessizce esne. Bu senin çene kaslarını rahatlatacak! (Çene Açıklığı)",
  green: "🐝 Arı Vızıltısı: Dudaklarını birbirine değdir ve 'Zzzzzmm' diyerek dudaklarını titret. Ağzının karıncalandığını hisset! (Artikülasyon)"
};

function popBalloon(element, color) {
  element.classList.add('popped');
  const hintEl = document.getElementById('balloonHint');
  
  // Confetti effect (simple)
  createConfetti(element);
  
  hintEl.style.opacity = '0';
  setTimeout(() => {
    hintEl.innerHTML = balloonHints[color];
    hintEl.style.opacity = '1';
    hintEl.style.color = (color === 'red') ? '#ef4444' : (color === 'blue') ? '#3b82f6' : '#10b981';
  }, 300);
  
  // Respawn
  setTimeout(() => {
    element.classList.remove('popped');
    hintEl.innerHTML = "Harika! Başka bir balon seç.";
    hintEl.style.color = "#f59e0b";
  }, 5000);
}

function createConfetti(element) {
  const rect = element.getBoundingClientRect();
  const parent = element.parentElement;
  
  for(let i=0; i<8; i++) {
    const c = document.createElement('div');
    c.style.position = 'absolute';
    c.style.width = '10px';
    c.style.height = '10px';
    c.style.backgroundColor = ['#f87171', '#60a5fa', '#34d399', '#fbbf24'][Math.floor(Math.random()*4)];
    c.style.borderRadius = '50%';
    c.style.left = (element.offsetLeft + 40) + 'px';
    c.style.top = (element.offsetTop + 40) + 'px';
    c.style.transition = 'all 0.5s ease-out';
    c.style.zIndex = '10';
    
    parent.appendChild(c);
    
    setTimeout(() => {
      c.style.transform = `translate(${(Math.random()-0.5)*100}px, ${(Math.random()-0.5)*100}px) scale(0)`;
      c.style.opacity = '0';
    }, 10);
    
    setTimeout(() => { c.remove(); }, 500);
  }
}
</script>

<%- include('partials/main-footer') %>
