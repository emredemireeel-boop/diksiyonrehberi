<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; overflow-x: hidden; }
  .dc-container { padding: 40px 20px; max-width: 1100px; margin: 0 auto; min-height: 80vh; display: flex; flex-direction: column; align-items: center; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 10px; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; text-align: center; }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 40px; text-align: center; max-width: 600px; }

  /* Interactive Envelope Area */
  .invitation-area { width: 100%; display: flex; gap: 30px; flex-direction: column; lg:flex-row; justify-content: center; align-items: flex-start; }

  .invitation-list { display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 350px; }
  
  .inv-btn { background: #1e293b; border: 2px solid #334155; padding: 20px; border-radius: 12px; cursor: pointer; transition: all 0.3s; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; }
  .inv-btn:hover { background: #334155; transform: translateX(5px); }
  .inv-btn.active { background: #0284c7; border-color: #38bdf8; box-shadow: 0 10px 20px rgba(2, 132, 199, 0.3); }
  
  .inv-title { font-size: 1.1rem; font-weight: 900; color: #f8fafc; }
  .inv-icon { font-size: 1.5rem; }

  /* Decoder Panel */
  .decoder-panel { background: #1e293b; border: 1px solid #334155; border-radius: 20px; width: 100%; max-width: 700px; padding: 40px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); position: relative; }
  
  .dp-header { border-bottom: 2px solid #334155; padding-bottom: 20px; margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; }
  .dp-title { font-size: 2rem; font-weight: 900; color: #38bdf8; text-transform: uppercase; margin: 0; }
  .dp-badge { background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3); padding: 5px 15px; border-radius: 20px; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; }
  .dp-badge.easy { background: rgba(16, 185, 129, 0.1); color: #10b981; border-color: rgba(16, 185, 129, 0.3); }
  .dp-badge.mid { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3); }

  .dp-desc { font-size: 1rem; color: #cbd5e1; line-height: 1.6; margin-bottom: 30px; }

  .rules-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 600px) { .rules-grid { grid-template-columns: 1fr; } }
  
  .rule-box { padding: 20px; border-radius: 12px; }
  .rule-box.must { background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.3); }
  .rule-box.never { background: rgba(244, 63, 94, 0.05); border: 1px solid rgba(244, 63, 94, 0.3); }
  
  .rb-title { font-weight: 900; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; font-size: 1.1rem; }
  .rule-box.must .rb-title { color: #10b981; }
  .rule-box.never .rb-title { color: #f43f5e; }

  .rb-list { list-style: none; padding: 0; margin: 0; }
  .rb-list li { font-size: 0.9rem; color: #94a3b8; margin-bottom: 10px; padding-left: 20px; position: relative; line-height: 1.5; }
  .rule-box.must .rb-list li::before { content: '✓'; position: absolute; left: 0; color: #10b981; font-weight: 900; }
  .rule-box.never .rb-list li::before { content: '✕'; position: absolute; left: 0; color: #f43f5e; font-weight: 900; }

  /* Visual Hint */
  .visual-hint { margin-top: 30px; background: #0f172a; padding: 15px; border-radius: 10px; text-align: center; color: #cbd5e1; font-size: 0.85rem; border: 1px dashed #334155; }

  @media (min-width: 1024px) {
    .invitation-area { flex-direction: row; }
  }
</style>

<div class="dc-container">
  <h1>Dress Code Çözücü</h1>
  <p class="desc">Davetiyenin altında yazan o küçük İngilizce kelimeler hayat kurtarır. İhlali halinde sizi kapıdan çevirebilecek küresel giyim kurallarının kodlarını kırın.</p>

  <div class="invitation-area">
    
    <!-- Left: List -->
    <div class="invitation-list">
      <div class="inv-btn active" onclick="loadCode('whitetie')">
        <span class="inv-title">White Tie</span>
        <span class="inv-icon">🏛️</span>
      </div>
      <div class="inv-btn" onclick="loadCode('blacktie')">
        <span class="inv-title">Black Tie</span>
        <span class="inv-icon">🍸</span>
      </div>
      <div class="inv-btn" onclick="loadCode('business')">
        <span class="inv-title">Business Formal</span>
        <span class="inv-icon">💼</span>
      </div>
      <div class="inv-btn" onclick="loadCode('smart')">
        <span class="inv-title">Smart Casual</span>
        <span class="inv-icon">☕</span>
      </div>
    </div>

    <!-- Right: Decoder -->
    <div class="decoder-panel">
      <div class="dp-header">
        <h2 class="dp-title" id="dTitle">White Tie</h2>
        <div class="dp-badge" id="dBadge">Katılık: Aşırı Yüksek</div>
      </div>
      
      <p class="dp-desc" id="dDesc">Giyilebilecek en resmi, en üst düzey kıyafet kodudur. Kraliyet davetleri, devlet baloları ve Nobel ödül törenlerinde kullanılır. Kişisel yoruma kapalıdır, kurallar milimetriktir.</p>

      <div class="rules-grid">
        <!-- MUST -->
        <div class="rule-box must">
          <div class="rb-title"><span>✅</span> Kesinlikle Zorunlu</div>
          <ul class="rb-list" id="lMust">
            <li>Siyah frak ceket (arkası uzun)</li>
            <li>Kolalı, dik yakalı (kanat yaka) beyaz gömlek</li>
            <li>Beyaz papyon (el bağlaması)</li>
            <li>Siyah, rugan (parlak) klasik ayakkabı</li>
          </ul>
        </div>
        
        <!-- NEVER -->
        <div class="rule-box never">
          <div class="rb-title"><span>❌</span> Kesinlikle Yasak</div>
          <ul class="rb-list" id="lNever">
            <li>Kravat (Sadece beyaz papyon takılır)</li>
            <li>Siyah papyon (Siyah papyon Black Tie içindir)</li>
            <li>Kol saati (Zamanın önemi olmadığı vurgulanır)</li>
            <li>Normal yaka gömlek</li>
          </ul>
        </div>
      </div>

      <div class="visual-hint" id="dHint">
        💡 <strong>İpucu:</strong> "White Tie" davetlerinde ceketinizin önü iliklenmez, papyon ve yelek mutlaka beyaz olmalıdır.
      </div>
    </div>

  </div>
</div>

<script>
  const codeData = {
    whitetie: {
      title: "White Tie",
      badge: "Katılık: Zirve", bClass: "",
      desc: "Giyilebilecek en resmi, en üst düzey kıyafet kodudur. Kraliyet davetleri, devlet baloları ve Nobel ödül törenlerinde kullanılır. Kişisel yoruma %0 yer vardır.",
      must: ["Siyah frak ceket (arkası bacaklara uzanan)", "Kolalı, kanat yakalı beyaz gömlek", "Beyaz yelek ve Beyaz papyon", "Siyah rugan (parlak) şık ayakkabı"],
      never: ["Kravat takmak", "Siyah papyon (O Black Tie içindir)", "Kol saati takmak (Davete saygısızlık kabul edilir)", "Kemer takmak (Askı kullanılır)"],
      hint: "💡 White Tie'da hata yapma lüksünüz yoktur, kurallar yüzyıllar önce yazılmış ve dondurulmuştur."
    },
    blacktie: {
      title: "Black Tie",
      badge: "Katılık: Yüksek", bClass: "",
      desc: "Kırmızı halılar, gala yemekleri, şık düğünler. White Tie'dan bir adım geridedir ama hala katı kuralları olan çok resmi bir koddur.",
      must: ["Siyah veya Gece Mavisi Smokin (Tuxedo)", "Kanat veya klasik sivri yaka beyaz gömlek", "Siyah papyon (İsmi buradan gelir)", "Saten veya ipek yaka detayları"],
      never: ["Kravat (Kesinlikle papyon olmalı)", "Spor/Çelik kordonlu saat", "Renkli papyon (Eğer 'Creative Black Tie' yazmıyorsa)", "Açık renk takım elbise"],
      hint: "💡 Smokin ceketi takım elbiseden farklıdır; yakaları ipek veya saten kaplamadır. Gündüz 18:00'den önce smokin giyilmez."
    },
    business: {
      title: "Business Formal",
      badge: "Katılık: Orta", bClass: "mid",
      desc: "Geleneksel finans, hukuk veya üst düzey kurumsal şirketlerin günlük veya toplantı formasıdır. Otorite ve profesyonellik mesajı verir.",
      must: ["Lacivert, antrasit veya siyah takım elbise", "Klasik gömlek (Tercihen beyaz veya açık mavi)", "Kravat (Sade desenler veya düz)", "Deri Oxford veya Derby ayakkabı"],
      never: ["Ceketsiz sadece gömlek ile katılmak", "Ayakkabı ve kemer renginin uyuşmaması", "Kahverengi takım elbise (Kurumsalda ciddiyeti bozar)", "Açık yaka (Kravat zorunludur)"],
      hint: "💡 Takım elbisenizin omuzları tam oturmalı ve ceket kolu gömlek manşetini 1-1.5 cm açıkta bırakmalıdır."
    },
    smart: {
      title: "Smart Casual",
      badge: "Katılık: Esnek", bClass: "easy",
      desc: "Cuma ofisi, ilk buluşmalar, ajans ortamları. En çok yanlış anlaşılan, sınırları en bulanık dress code'dur. 'Smart' (Şık) kısmı unutulmamalıdır.",
      must: ["Blazer ceket veya kaliteli bir triko kazak", "Chino pantolon veya çok koyu yırtıksız Jean", "Deri Loafer, Chelsea Bot veya temiz sade Sneaker", "Gömlek (Kravatsız, yakası açık)"],
      never: ["Eşofman takımı veya kapşonlu sweatshirt (Hoodie)", "Parmak arası terlik veya koşu ayakkabısı", "Kravat ile tam takım elbise (Fazla resmi kaçar)", "Yırtık veya aşırı bol kıyafetler"],
      hint: "💡 Kural şudur: Eğer şüphede kalırsanız, fazla rahat olmaktansa, fazla şık ('overdressed') olmak her zaman daha güvenlidir."
    }
  };

  function loadCode(key) {
    document.querySelectorAll('.inv-btn').forEach(b => b.classList.remove('active'));
    event.currentTarget.classList.add('active');

    const data = codeData[key];
    
    document.getElementById('dTitle').textContent = data.title;
    document.getElementById('dDesc').textContent = data.desc;
    
    const badge = document.getElementById('dBadge');
    badge.textContent = data.badge;
    badge.className = 'dp-badge ' + data.bClass;

    document.getElementById('lMust').innerHTML = data.must.map(m => `<li>${m}</li>`).join('');
    document.getElementById('lNever').innerHTML = data.never.map(m => `<li>${m}</li>`).join('');
    
    document.getElementById('dHint').innerHTML = data.hint;
  }
</script>

<%- include('partials/main-footer') %>
