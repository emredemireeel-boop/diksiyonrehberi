<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 💋 Hero 💋 */
  .l-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 20%, #ec489922, transparent 70%);
  }
  .l-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#f8fafc,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: lFloat 7s ease-in-out infinite; background: linear-gradient(135deg, #ec4899, #f43f5e); }
  @keyframes lFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.2; } 50%{ transform:translateY(-60px) scale(1.6); opacity:.7; } }

  .l-icon { font-size: 6rem; margin-bottom: 20px; animation: lPulse 2s ease-in-out infinite; filter: drop-shadow(0 0 30px #ec489966); }
  @keyframes lPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.1); } }

  .l-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#fbcfe8; background:#ec489918; border:1px solid #ec489944; margin-bottom:24px; box-shadow: 0 0 20px #ec489922; }
  .l-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color:#0f172a; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .l-title span { background: linear-gradient(135deg, #f472b6, #fb7185); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .l-subtitle { color:#475569; font-size:1.15rem; max-width:650px; line-height:1.8; }

  /* 💋 Container 💋 */
  .l-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 💋 Glass Cards 💋 */
  .glass { background:rgba(15,23,42,.02); backdrop-filter:blur(20px); border:1px solid rgba(15,23,42,.05); border-radius:24px; padding:40px; margin-bottom:40px; transition:transform .4s,box-shadow .4s; position: relative; overflow: hidden; }
  .glass::before { content:''; position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg,transparent,rgba(15,23,42,.1),transparent); }
  .glass:hover { transform:translateY(-5px); box-shadow:0 30px 60px rgba(15,23,42,.4),0 0 40px #ec489911; border-color:rgba(236,72,153,.2); }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#f472b6; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background:#f472b6; border-radius:2px; }

  /* 💋 Lip Reading / Interactive Simulator 💋 */
  .lip-simulator { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #0f172a; border-radius: 20px; border: 2px solid #ec489933; padding: 40px; position: relative; overflow: hidden; margin-bottom: 30px; }
  .lip-display { font-size: 5rem; line-height: 1; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); margin: 20px 0; color: #fff; text-shadow: 0 0 20px #ec489955; }
  .lip-controls { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
  .lip-btn { padding: 12px 24px; border-radius: 12px; background: rgba(236,72,153,.15); border: 1px solid rgba(236,72,153,.3); color: #fbcfe8; font-weight: 700; cursor: pointer; transition: all .3s; }
  .lip-btn:hover { background: rgba(236,72,153,.3); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(236,72,153,.2); }

  /* 💋 Interactive Gym 💋 */
  .gym-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .gym-container { grid-template-columns: 1fr; } }
  
  .gym-card { background: rgba(15,23,42,.3); border: 1px solid rgba(236,72,153,.15); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all .3s; position: relative; overflow: hidden; }
  .gym-card::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at center, rgba(236,72,153,.1), transparent); opacity:0; transition:opacity .3s; }
  .gym-card:hover { border-color: #ec4899; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(236,72,153,.15); }
  .gym-card:hover::after { opacity: 1; }
  
  .gym-icon { font-size: 3rem; margin-bottom: 12px; display: inline-block; transition: transform .3s; }
  .gym-card:hover .gym-icon { transform: scale(1.2); }
  
  .gym-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .gym-desc { font-size: 0.85rem; color: #475569; line-height: 1.6; }

  /* 💋 Master Workout Panel 💋 */
  .workout-panel { background: linear-gradient(145deg, #2a1016, #f8fafc); border: 1px solid #ec489933; border-radius: 24px; padding: 40px; margin-top: 20px; text-align: center; position: relative; overflow: hidden; }
  .workout-panel::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle at center, rgba(236,72,153,.05) 0%, transparent 50%); animation: rotateGlow 15s linear infinite; pointer-events:none; }
  @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .workout-display { font-size: 2.5rem; font-weight: 900; color: #fff; letter-spacing: 2px; margin: 24px 0; min-height: 60px; display: flex; align-items: center; justify-content: center; }
  .workout-hint { color: #f472b6; font-size: 1rem; font-weight: 600; margin-bottom: 30px; }
  
  .workout-btn { padding: 16px 40px; border-radius: 100px; background: linear-gradient(135deg, #ec4899, #f43f5e); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(236,72,153,.4); transition: all .3s; text-transform: uppercase; letter-spacing: 2px; }
  .workout-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(236,72,153,.6); }
  .workout-btn:active { transform: scale(0.98); }

  /* 💋 Back Button 💋 */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(15,23,42,.05); border:1px solid rgba(15,23,42,.1); color:#475569; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(15,23,42,.1); color:#fff; transform:translateX(-4px); }

  /* 💋 Reveal 💋 */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="l-hero">
  <div class="hero-particles">
    <% for(let i=0; i<30; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 2+Math.random()*5 %>px; height:<%= 2+Math.random()*5 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 4+Math.random()*4 %>s;"></div>
    <% } %>
  </div>
  <div class="l-icon">👄</div>
  <div class="l-badge">✨ Artikülasyon Laboratuvarı</div>
  <h1 class="l-title"><span>Dudak Tembelliği</span> Çözüm Merkezi</h1>
  <p class="l-subtitle">Kelimeleri yuvarlamadan, net ve kusursuz bir artikülasyon için dudak kası güçlendirme ve esnetme egzersizleri. Dudaklarınızı bir enstrüman gibi akort edin.</p>
</section>

<div class="l-wrap">
  <a href="/diksiyon?cat=dudak" class="back-btn">Tüm Dudak Egzersizlerini Gör</a>

  <!-- 💋 SIMULATOR 💋 -->
  <div class="glass reveal">
    <div class="section-label">👀 Dudak Okuma & Form Simülatörü</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:20px;">Dudak şekillerinizi test edin. Mükemmel bir diksiyonda her harfin görsel bir imzası vardır. Seçtiğiniz harfin dudak formunu aynada taklit etmeye çalışın.</p>

    <div class="lip-simulator">
      <div class="lip-display" id="lipDisplay">👄</div>
      <div style="color:#475569; font-size:1.5rem; font-weight:900;" id="lipCharDisplay">...</div>
      
      <div class="lip-controls">
        <button class="lip-btn" onclick="animateLip('O', '⭕')">O Sesi</button>
        <button class="lip-btn" onclick="animateLip('İ', '😬')">İ Sesi</button>
        <button class="lip-btn" onclick="animateLip('U', '😗')">U Sesi</button>
        <button class="lip-btn" onclick="animateLip('P', '💥')">P Patlaması</button>
        <button class="lip-btn" onclick="animateLip('F', '🦷')">F Sesi</button>
      </div>
    </div>
  </div>

  <!-- 💋 THE GYM 💋 -->
  <div class="glass reveal">
    <div class="section-label">🏋️ Dudak Gym</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:30px;">Dudak kaslarınızı (Orbicularis oris) izole olarak çalıştıran, hızlı etki gösteren egzersiz serileri.</p>
    
    <div class="gym-container">
      <div class="gym-card" onclick="startWorkout('trill')">
        <div class="gym-icon">👄</div>
        <div class="gym-title">Lip Trill (Motor)</div>
        <div class="gym-desc">Dudakları pır pır titreterek kan akışını hızlandırır ve ses tellerini ısıtır.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('ox')">
        <div class="gym-icon">😘</div>
        <div class="gym-title">O-İ Geçişi</div>
        <div class="gym-desc">Yuvarlak ve düz ünlü geçişlerinde dudakların refleks hızını artırır.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('buzz')">
        <div class="gym-icon">🐝</div>
        <div class="gym-title">Buzz Lip</div>
        <div class="gym-desc">Arı vızıltısı gibi titreşimlerle dudak bariyeri direncini güçlendirir.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('pb')">
        <div class="gym-icon">💥</div>
        <div class="gym-title">P-B Patlaması</div>
        <div class="gym-desc">Dudakları içe kıvırıp patlatarak çift dudak ünsüzlerini netleştirir.</div>
      </div>
    </div>
  </div>

  <!-- 💋 MASTER WORKOUT PANEL 💋 -->
  <div class="workout-panel reveal" id="workoutPanel" style="display:none;">
    <div class="section-label" style="justify-content:center; color:#ec4899;" id="workoutTitle">🏋️ Egzersiz Başlıyor</div>
    <div class="workout-display" id="workoutDisplay">Hazır mısınız?</div>
    <div class="workout-hint" id="workoutHint">Ayna karşısında olmanız tavsiye edilir.</div>
    <button class="workout-btn" id="workoutActionBtn" onclick="nextWorkoutStep()">Başla</button>
  </div>

  <!-- 💋 PRO TIP 💋 -->
  <div style="background:linear-gradient(135deg,rgba(236,72,153,.1),rgba(244,63,94,.05)); border:1px solid rgba(236,72,153,.3); border-radius:24px; padding:30px; font-size:1rem; color:#e2e8f0; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">📸</span>
    <div>
      <strong style="color:#f472b6; display:block; margin-bottom:8px;">Altın Kural: Abartılı Tekrarlar</strong>
      Normal konuşurken dudaklarımızı genellikle az hareket ettiririz. Egzersizlerin işe yaraması için aynaya bakarken kendinize komik gelecek kadar <strong>abartılı</strong> şekiller yapmalısınız. Beyin ancak bu abartı sayesinde normal konuşma anında dudaklarınızı biraz daha fazla hareket ettirmeyi öğrenecektir.
    </div>
  </div>

</div>

<script>
// 💋 Scroll Reveal 💋
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 💋 Lip Simulator 💋
function animateLip(char, emoji) {
  const display = document.getElementById('lipDisplay');
  const charDisplay = document.getElementById('lipCharDisplay');
  
  display.style.transform = 'scale(0.8)';
  display.style.opacity = '0.5';
  
  setTimeout(() => {
    display.innerHTML = emoji;
    charDisplay.innerHTML = char + " Sesi";
    
    let scale = 'scale(1.2)';
    if(char === 'O' || char === 'U') scale = 'scale(1.1) scaleX(0.8)'; // Büzülme
    if(char === 'İ') scale = 'scale(1.1) scaleX(1.3)'; // Yayılma
    if(char === 'P') scale = 'scale(1.3)'; // Patlama
    
    display.style.transform = scale;
    display.style.opacity = '1';
    
    setTimeout(() => {
      display.style.transform = 'scale(1)';
    }, 300);
  }, 150);
}

// 💋 Workout Logic 💋
const workouts = {
  trill: {
    title: '👄 Lip Trill (Motor)',
    steps: [
      { text: 'Dudaklarınızı hafifçe bitiştirin', hint: 'Sıkı kapatmayın, rahat bırakın' },
      { text: 'Prrrrrrrrrrr...', hint: 'Nefesinizi dışarı iterken titreşim yaratın' },
      { text: 'Siren Sesi Yapın', hint: 'Prrrr derken sesi inceltip kalınlaştırın' },
      { text: 'Harika.', hint: 'Kan dolaşımı hızlandı, ses telleri ısındı.' }
    ]
  },
  ox: {
    title: '😘 O-İ Geçişi',
    steps: [
      { text: '<span style="font-size:4rem;color:#f472b6;">O</span>', hint: 'Dudakları kuyudan su çeker gibi büzün' },
      { text: '<span style="font-size:4rem;color:#fbcfe8;">İ</span>', hint: 'Sonuna kadar gülümseyerek yayın' },
      { text: '<span style="font-size:4rem;color:#f472b6;">O</span>', hint: 'Tekrar Büz!' },
      { text: '<span style="font-size:4rem;color:#fbcfe8;">İ</span>', hint: 'Tekrar Yay!' },
      { text: 'Bitti.', hint: 'Bu geçiş artikülasyon motor refleksini hızlandırır.' }
    ]
  },
  buzz: {
    title: '🐝 Buzz Lip',
    steps: [
      { text: 'Dudakları sıkıca kapatın', hint: 'Ama dişleri birbirine değdirmeyin' },
      { text: 'Vzzzzzzz...', hint: 'Arı gibi vızıldayın. Sesi dudaklarınızın ucunda hissedin.' },
      { text: 'Zzzzzzz...', hint: 'Nefes basıncını artırın.' },
      { text: 'Tamamdır.', hint: 'Rezonansınız (sesin tınlaması) ön bölgeye taşındı.' }
    ]
  },
  pb: {
    title: '💥 P-B Patlaması',
    steps: [
      { text: 'Dudakları içe doğru hafifçe kıvırın', hint: 'Ağız içinde basınç oluşturun' },
      { text: 'PA! BA!', hint: 'Dudaklarınızı patlatarak açın!' },
      { text: 'Pıt pıt pıt, pat pat pat', hint: 'Seri patlamalar yapın' },
      { text: 'Sonuç mükemmel.', hint: 'Mikrofonda mırıldanma sorunu bitti.' }
    ]
  }
};

let currentWorkout = null;
let currentStepIndex = 0;

function startWorkout(id) {
  currentWorkout = workouts[id];
  currentStepIndex = 0;
  
  const panel = document.getElementById('workoutPanel');
  panel.style.display = 'block';
  
  document.getElementById('workoutTitle').innerHTML = currentWorkout.title;
  document.getElementById('workoutDisplay').innerHTML = 'Hazır mısınız?';
  document.getElementById('workoutHint').innerHTML = 'Ayna karşısında olmanız tavsiye edilir.';
  document.getElementById('workoutActionBtn').innerHTML = 'Başla';
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function nextWorkoutStep() {
  if(!currentWorkout) return;
  
  if(currentStepIndex < currentWorkout.steps.length) {
    const step = currentWorkout.steps[currentStepIndex];
    document.getElementById('workoutDisplay').innerHTML = step.text;
    document.getElementById('workoutHint').innerHTML = step.hint;
    document.getElementById('workoutActionBtn').innerHTML = (currentStepIndex === currentWorkout.steps.length - 1) ? 'Bitir' : 'Sonraki Adım';
    currentStepIndex++;
  } else {
    document.getElementById('workoutDisplay').innerHTML = 'Egzersiz Tamamlandı! 🎉';
    document.getElementById('workoutHint').innerHTML = 'Günlük tekrar kalıcı etki sağlar.';
    document.getElementById('workoutActionBtn').innerHTML = 'Tekrar Yap';
    currentStepIndex = 0;
  }
}
</script>

<%- include('partials/main-footer') %>


