<%- include('partials/main-header') %>

<style>
  
  .troll-container { padding: 40px 20px; max-width: 800px; margin: 0 auto; min-height: 85vh; display: flex; flex-direction: column; align-items: center; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #1da1f2; text-transform: uppercase; letter-spacing: 1px; text-align: center; }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 30px; text-align: center; }

  /* App Screen */
  .app-screen { width: 100%; background: #15202b; border: 1px solid #38444d; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.6); display: flex; flex-direction: column; position: relative; }
  
  /* X Header */
  .x-header { padding: 15px 20px; border-bottom: 1px solid #38444d; display: flex; justify-content: space-between; align-items: center; }
  .x-logo { font-size: 1.5rem; color: #f1f5f9; font-weight: 900; letter-spacing: -2px; }
  .x-stats { display: flex; gap: 20px; }
  .stat { font-size: 0.9rem; font-weight: 700; color: #8899a6; display: flex; flex-direction: column; align-items: flex-end; }
  .stat-val { font-size: 1.2rem; color: #f1f5f9; font-weight: 900; transition: color 0.3s; }
  .stat-val.up { color: #10b981; }
  .stat-val.down { color: #f43f5e; }

  /* Main Tweet */
  .main-tweet { padding: 20px; border-bottom: 1px solid #38444d; display: flex; gap: 15px; }
  .avatar { width: 50px; height: 50px; border-radius: 50%; background: #1da1f2; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 900; color: #f1f5f9; flex-shrink: 0; }
  .tweet-content { flex: 1; }
  .t-name { font-weight: 800; color: #f1f5f9; display: flex; align-items: center; gap: 5px; }
  .t-handle { color: #8899a6; font-weight: 400; font-size: 0.9rem; }
  .verified { color: #1da1f2; font-size: 0.9rem; }
  .t-text { font-size: 1.2rem; color: #f1f5f9; line-height: 1.5; margin-top: 5px; }

  /* Troll Reply */
  .reply-sec { padding: 20px; position: relative; }
  .troll-tweet { display: flex; gap: 15px; background: rgba(244, 63, 94, 0.05); padding: 15px; border-radius: 15px; border-left: 4px solid #f43f5e; animation: slideIn 0.4s ease-out; }
  .troll-avatar { background: #38444d; }
  .tr-text { font-size: 1.1rem; color: #cbd5e1; line-height: 1.5; margin-top: 5px; }
  @keyframes slideIn { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  /* Ban Panel (Action Area) */
  .ban-panel { padding: 20px; background: #192734; border-top: 1px solid #38444d; }
  .bp-title { font-size: 0.9rem; font-weight: 800; color: #8899a6; text-transform: uppercase; margin-bottom: 15px; text-align: center; }
  
  .ban-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
  @media(min-width:600px){ .ban-grid { grid-template-columns: 1fr 1fr; } }
  
  .ban-btn { background: #22303c; border: 1px solid #38444d; color: #1da1f2; padding: 15px; border-radius: 10px; font-weight: 700; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .ban-btn:hover { background: rgba(29, 161, 242, 0.1); border-color: #1da1f2; }
  .ban-btn.banned { background: rgba(244, 63, 94, 0.2); border-color: #f43f5e; color: #f43f5e; text-decoration: line-through; pointer-events: none; }

  /* Outcome Alert */
  .outcome { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(21, 32, 43, 0.95); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 10; padding: 20px; text-align: center; }
  .out-icon { font-size: 5rem; margin-bottom: 20px; }
  .out-title { font-size: 2rem; font-weight: 900; color: #f1f5f9; margin-bottom: 10px; }
  .out-desc { font-size: 1.1rem; color: #8899a6; margin-bottom: 30px; line-height: 1.5; max-width: 500px; }
  .next-btn { background: #1da1f2; color: #f1f5f9; border: none; padding: 15px 30px; border-radius: 30px; font-weight: 800; font-size: 1.1rem; cursor: pointer; }

  .game-over { display: none; text-align: center; padding: 50px; }
</style>

<div class="troll-container">
  <h1>Trol Avcısı</h1>
  <p class="desc">X'te (Twitter) linç edilmek üzeresiniz! Trollerin mantık hatalarını (safsataları) teşhis edip onları engelleyin (Banla). Yanlış teşhis koyarsanız takipçi kaybedersiniz!</p>

  <div class="app-screen" id="appScreen">
    
    <!-- X Header -->
    <div class="x-header">
      <div class="x-logo">𝕏</div>
      <div class="x-stats">
        <div class="stat"><span>Takipçi</span> <span class="stat-val" id="followerCount">10.000</span></div>
        <div class="stat"><span>Saygınlık</span> <span class="stat-val" id="repCount">100%</span></div>
      </div>
    </div>

    <!-- Main Tweet -->
    <div class="main-tweet">
      <div class="avatar">S</div>
      <div class="tweet-content">
        <div class="t-name">Siz <span class="verified">✓</span> <span class="t-handle">@mantikuzmani · 1d</span></div>
        <div class="t-text" id="myTweet">...</div>
      </div>
    </div>

    <!-- Troll Reply -->
    <div class="reply-sec">
      <div class="troll-tweet">
        <div class="avatar troll-avatar">👤</div>
        <div class="tweet-content">
          <div class="t-name" id="trollName">Gizli_Trol_99 <span class="t-handle">@troll_king · 30s</span></div>
          <div class="tr-text" id="trollText">...</div>
        </div>
      </div>
    </div>

    <!-- Ban Panel -->
    <div class="ban-panel">
      <div class="bp-title">Silahını Seç ve Engelle (Ban)</div>
      <div class="ban-grid" id="banGrid">
        <!-- Injected -->
      </div>
    </div>

    <!-- Outcome Modal inside Screen -->
    <div class="outcome" id="outcomeBox">
      <div class="out-icon" id="oIcon">🔨</div>
      <div class="out-title" id="oTitle">Banlandı!</div>
      <div class="out-desc" id="oDesc">...</div>
      <button class="next-btn" onclick="nextTweet()">Sıradaki Linç ➔</button>
    </div>

  </div>

  <div class="game-over" id="gameOver">
    <div style="font-size: 5rem; margin-bottom:20px;">🎖️</div>
    <h2 style="font-size:2.5rem; color:#1da1f2; margin:0 0 15px 0;">İnterneti Temizlediniz!</h2>
    <p style="color:#94a3b8; font-size:1.1rem; margin-bottom:30px;">Trollerin tüm mantıksız argümanlarını çürüttünüz. Sosyal medyada algı yönetimine karşı bağışıklık kazandınız.</p>
    <a href="/safsata" style="background:#1da1f2; color: #f1f5f9; padding:15px 30px; border-radius:30px; text-decoration:none; font-weight:800;">Akademiye Dön</a>
  </div>

</div>

<script>
  let followers = 10000;
  let rep = 100;

  const tweets = [
    {
      myTweet: "Yeni araştırmalara göre, şehir içindeki hız sınırını 10 km/s düşürmek kazaları %30 oranında azaltıyor. Güvenlik için hız sınırlarını düşürmeliyiz.",
      trollName: "OtoHız_X",
      trollText: "Yani arabaları tamamen yasaklayıp hepimizi bisiklete bindirmek istiyorsun! İnsanların özgürlüğünü elinden alamazsın!",
      correctFallacy: "Saman Adam",
      fallacies: ["Kişiye Saldırı", "Saman Adam", "Sürü Psikolojisi", "Yanlış Neden"],
      fbSuccess: "Tam isabet! %30 düşürme önerisini 'arabaları tamamen yasaklamak' gibi uç bir noktaya (Saman Adam) çarpıttı. Trol engellendi!",
      fbFail: "Yanlış teşhis! Trolün linçi büyüyor, argümanınız çarpıtıldı."
    },
    {
      myTweet: "Ülkemizde okuma oranlarının son 5 yılda %15 düştüğünü görüyoruz. Kütüphanelere daha fazla bütçe ayrılmalı.",
      trollName: "Gerçekler_Burada",
      trollText: "Senin gibi geçen yıl vergi borcu olan birinin devletin bütçesi hakkında konuşmaya hakkı yok. Önce kendi işini düzelt!",
      correctFallacy: "Kişiye Saldırı",
      fallacies: ["Otoriteye Başvur", "Kırmızı Ringa Balığı", "Kişiye Saldırı", "Kaygan Zemin"],
      fbSuccess: "Doğru teşhis (Ad Hominem). Vergi borcu olması, okuma oranının düştüğü gerçeğini (matematiksel veriyi) yanlış çıkarmaz. Trol engellendi!",
      fbFail: "Yanlış teşhis! Trolün kişisel saldırısına yenik düştünüz, tartışma kavgaya dönüştü."
    },
    {
      myTweet: "Fabrikaların atık sularını nehre dökmesini engelleyecek sert yasalar çıkarılmalı. Çevreyi korumak zorundayız.",
      trollName: "SanayiBot_44",
      trollText: "Eğer fabrikalara ceza kesmeye başlarsan, fabrikalar kapanır, işsizlik artar, ülke iflas eder ve hepimiz açlıktan ölürüz!",
      correctFallacy: "Kaygan Zemin",
      fallacies: ["Saman Adam", "Sahte İkilem", "Kişiye Saldırı", "Kaygan Zemin"],
      fbSuccess: "Slippery Slope (Kaygan Zemin) teşhisi harika! Bir ceza yasasını kanıtsız zincirlerle 'hepimiz açlıktan ölürüz' sonucuna abartılı bağladı. Engellendi!",
      fbFail: "Korku imparatorluğuna yenildiniz. Teşhis yanlış olduğu için argümanınız ezildi."
    },
    {
      myTweet: "Gençlerin teknoloji bağımlılığından kurtulması için açık hava etkinliklerini artırmalıyız.",
      trollName: "Sokak_Sesi",
      trollText: "Sokaklar çok mu güvenli sanki? Ya gençlerimiz tamamen eve kapanacaklar ya da sokakta başlarına kötü bir şey gelecek. Başka çare yok!",
      correctFallacy: "Sahte İkilem",
      fallacies: ["Sürü Psikolojisi", "Sahte İkilem", "Kırmızı Ringa Balığı", "Yanlış Neden"],
      fbSuccess: "False Dilemma! (Ya o ya bu) diyerek sanki kontrollü spor alanları veya denetimli etkinlikler gibi 3. seçenekler yokmuş gibi davrandı. Banned!",
      fbFail: "Gri alanları göremediniz, trolün dayattığı 2 kötü seçenek arasında kaldınız."
    }
  ];

  let currIndex = 0;

  function updateStats(deltaF, deltaR) {
    followers += deltaF;
    rep += deltaR;
    
    const fEl = document.getElementById('followerCount');
    const rEl = document.getElementById('repCount');
    
    fEl.textContent = followers.toLocaleString();
    rEl.textContent = rep + "%";

    // Animations
    fEl.className = 'stat-val ' + (deltaF > 0 ? 'up' : 'down');
    rEl.className = 'stat-val ' + (deltaR > 0 ? 'up' : 'down');
    
    setTimeout(() => {
      fEl.className = 'stat-val';
      rEl.className = 'stat-val';
    }, 500);
  }

  function loadTweet() {
    if(currIndex >= tweets.length) {
      document.getElementById('appScreen').style.display = 'none';
      document.getElementById('gameOver').style.display = 'block';
      return;
    }

    const t = tweets[currIndex];
    document.getElementById('myTweet').textContent = t.myTweet;
    document.getElementById('trollName').innerHTML = `${t.trollName} <span class="t-handle">@troll_king · 30s</span>`;
    document.getElementById('trollText').textContent = t.trollText;

    const bg = document.getElementById('banGrid');
    bg.innerHTML = '';

    t.fallacies.forEach(f => {
      const btn = document.createElement('button');
      btn.className = 'ban-btn';
      btn.innerHTML = `🔨 BAN: ${f}`;
      btn.onclick = () => checkBan(f, btn);
      bg.appendChild(btn);
    });
  }

  function checkBan(selected, btnEl) {
    const t = tweets[currIndex];
    const outBox = document.getElementById('outcomeBox');
    
    outBox.style.display = 'flex';

    if(selected === t.correctFallacy) {
      document.getElementById('oIcon').textContent = '✅';
      document.getElementById('oIcon').style.color = '#10b981';
      document.getElementById('oTitle').textContent = "Trol Engellendi!";
      document.getElementById('oTitle').style.color = '#10b981';
      document.getElementById('oDesc').textContent = t.fbSuccess;
      updateStats(500, 5);
    } else {
      document.getElementById('oIcon').textContent = '📉';
      document.getElementById('oIcon').style.color = '#f43f5e';
      document.getElementById('oTitle').textContent = "Linç Edildin!";
      document.getElementById('oTitle').style.color = '#f43f5e';
      document.getElementById('oDesc').textContent = t.fbFail + " Doğrusu: " + t.correctFallacy + " olmalıydı.";
      updateStats(-1500, -15);
    }
  }

  function nextTweet() {
    document.getElementById('outcomeBox').style.display = 'none';
    currIndex++;
    loadTweet();
  }

  // Init
  loadTweet();

</script>

<%- include('partials/main-footer') %>
