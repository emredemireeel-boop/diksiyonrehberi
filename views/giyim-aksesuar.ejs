<%- include('partials/main-header') %>

<style>
  body { background: #0f172a; color: #f8fafc; font-family: 'Inter', sans-serif; }
  .aks-container { display: flex; flex-direction: column; lg:flex-row; gap: 40px; padding: 40px 20px; max-width: 1200px; margin: 0 auto; min-height: 80vh; }
  
  .panel { flex: 1; }
  
  h1 { font-size: 2.5rem; font-weight: 900; margin-bottom: 5px; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; }
  p.desc { color: #94a3b8; font-size: 1rem; line-height: 1.6; margin-bottom: 30px; }

  /* Visualizer */
  .detective-scene { background: #1e293b; border-radius: 20px; padding: 40px; display: flex; justify-content: center; align-items: center; position: relative; border: 1px solid #334155; height: 600px; overflow: hidden; box-shadow: inset 0 0 50px rgba(0,0,0,0.4); }
  
  .scene-bg { position: absolute; inset: 0; background: radial-gradient(circle at center, #334155 0%, #0f172a 100%); opacity: 0.5; z-index: 0; }

  .character { width: 280px; height: 500px; position: relative; z-index: 10; }
  
  /* SVG Character */
  #charSvg { width: 100%; height: 100%; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5)); }

  /* Clickable Hitboxes (Mistakes) */
  .hitbox { position: absolute; cursor: pointer; border: 2px dashed rgba(244, 63, 94, 0); border-radius: 50%; transition: all 0.3s; z-index: 20; }
  .hitbox:hover { border-color: rgba(244, 63, 94, 0.5); background: rgba(244, 63, 94, 0.1); }
  
  .hitbox.found { border-color: #10b981; border-style: solid; background: rgba(16, 185, 129, 0.2); animation: pulse 2s infinite; pointer-events: none; }

  /* Specific Hitboxes */
  #hb-watch { top: 210px; left: 30px; width: 60px; height: 60px; }
  #hb-belt { top: 230px; left: 100px; width: 80px; height: 50px; }
  #hb-tie { top: 120px; left: 120px; width: 40px; height: 80px; }
  #hb-shoes { top: 440px; left: 80px; width: 120px; height: 60px; }

  /* HUD */
  .hud { position: absolute; top: 20px; right: 20px; background: rgba(0,0,0,0.7); padding: 15px 25px; border-radius: 15px; border: 1px solid #334155; text-align: right; z-index: 30; backdrop-filter: blur(10px); }
  .hud-title { font-size: 0.8rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-bottom: 5px; }
  .hud-score { font-size: 2.5rem; font-weight: 900; color: #38bdf8; text-shadow: 0 0 20px rgba(56, 189, 248, 0.5); }

  /* Case File Panel (Right) */
  .case-file { background: #1e293b; border-radius: 20px; border: 1px solid #334155; padding: 30px; height: 100%; display: flex; flex-direction: column; }
  .case-title { font-size: 1.2rem; font-weight: 900; color: #e2e8f0; margin-bottom: 20px; border-bottom: 2px solid #334155; padding-bottom: 10px; display: flex; justify-content: space-between; }
  
  .log-list { flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 15px; padding-right: 10px; }
  
  .log-item { background: #0f172a; border-left: 4px solid #334155; padding: 15px; border-radius: 0 10px 10px 0; opacity: 0.5; transition: all 0.4s; }
  .log-item.found { opacity: 1; border-left-color: #10b981; background: rgba(16, 185, 129, 0.05); }
  
  .log-header { font-weight: 800; color: #e2e8f0; margin-bottom: 5px; display: flex; align-items: center; gap: 10px; }
  .log-icon { font-size: 1.2rem; }
  .log-desc { font-size: 0.85rem; color: #cbd5e1; line-height: 1.5; display: none; }
  .log-item.found .log-desc { display: block; animation: fadeIn 0.5s forwards; }

  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(16,185,129,0.4); } 70% { box-shadow: 0 0 0 15px rgba(16,185,129,0); } 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); } }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

  .btn-next { background: #10b981; color: #fff; border: none; padding: 15px; border-radius: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; display: none; margin-top: 20px; transition: transform 0.2s; box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3); text-align: center; }
  .btn-next:hover { transform: scale(1.02); }

  @media (min-width: 1024px) {
    .aks-container { flex-direction: row; }
  }
</style>

<div class="aks-container">
  
  <!-- Left: Scene -->
  <div class="panel" style="flex: 1.5;">
    <h1>Aksesuar Dedektifi</h1>
    <p class="desc">Aksesuarlar detaydır, ancak şeytan ayrıntıda gizlidir. Aşağıdaki "iddialı" karakterin üzerinde "Old Money" ve "Klasik Giyim" kurallarını ihlal eden 4 kritik hata var. Üzerine tıklayarak hataları tespit et.</p>

    <div class="detective-scene">
      <div class="scene-bg"></div>
      
      <div class="hud">
        <div class="hud-title">Tespit Edilen Hata</div>
        <div class="hud-score"><span id="foundCount">0</span> / 4</div>
      </div>

      <div class="character">
        <svg id="charSvg" viewBox="0 0 280 500" xmlns="http://www.w3.org/2000/svg">
          <!-- Head/Neck -->
          <circle cx="140" cy="50" r="35" fill="#fcd34d" />
          <rect x="125" y="80" width="30" height="30" fill="#fcd34d" />
          
          <!-- Shirt -->
          <path d="M 90,100 L 190,100 L 170,260 L 110,260 Z" fill="#ffffff" />
          
          <!-- Jacket -->
          <path d="M 80,100 L 135,180 L 125,280 L 60,280 Z" fill="#1e3a8a" />
          <path d="M 200,100 L 145,180 L 155,280 L 220,280 Z" fill="#1e3a8a" />
          
          <!-- Thick Tie (Mistake 1) -->
          <path id="svg-tie" d="M 130,100 L 150,100 L 160,220 L 140,240 L 120,220 Z" fill="#b91c1c" />

          <!-- Arm Left & Giant Watch (Mistake 2) -->
          <path d="M 80,100 L 40,200 L 50,250" stroke="#1e3a8a" stroke-width="25" stroke-linecap="round" fill="none" />
          <!-- Watch Box -->
          <rect id="svg-watch" x="35" y="220" width="40" height="40" rx="10" fill="#94a3b8" stroke="#f8fafc" stroke-width="4" />
          <circle cx="55" cy="240" r="15" fill="#0f172a" />

          <!-- Arm Right -->
          <path d="M 200,100 L 240,200 L 230,250" stroke="#1e3a8a" stroke-width="25" stroke-linecap="round" fill="none" />

          <!-- Giant Belt Logo (Mistake 3) -->
          <rect x="100" y="250" width="80" height="20" fill="#000000" />
          <!-- H Logo -->
          <rect id="svg-belt" x="120" y="240" width="40" height="40" fill="#facc15" rx="5" />
          <rect x="130" y="245" width="20" height="30" fill="#000000" />
          <rect x="120" y="255" width="40" height="10" fill="#facc15" />

          <!-- Pants -->
          <path d="M 100,270 L 180,270 L 175,460 L 145,460 L 140,300 L 135,460 L 105,460 Z" fill="#1e3a8a" />

          <!-- Brown Shoes (Mistake 4 - matches black belt) -->
          <path id="svg-shoes" d="M 85,460 L 145,460 L 145,480 L 85,480 Z M 135,460 L 195,460 L 195,480 L 135,480 Z" fill="#78350f" rx="10" />
        </svg>

        <!-- Hitboxes -->
        <div class="hitbox" id="hb-watch" onclick="discoverMistake('watch', this)"></div>
        <div class="hitbox" id="hb-belt" onclick="discoverMistake('belt', this)"></div>
        <div class="hitbox" id="hb-tie" onclick="discoverMistake('tie', this)"></div>
        <div class="hitbox" id="hb-shoes" onclick="discoverMistake('shoes', this)"></div>

      </div>
    </div>
  </div>

  <!-- Right: Case File -->
  <div class="panel" style="flex: 1;">
    <div class="case-file">
      <div class="case-title">
        <span>Vaka Raporu</span>
        <span>📁</span>
      </div>

      <div class="log-list">
        
        <div class="log-item" id="log-belt">
          <div class="log-header"><span class="log-icon">🪪</span> Devasa Logolu Kemer</div>
          <div class="log-desc">"H" veya "G" gibi devasa marka logolu tokalar, klasik takım elbise giyiminde "Yeni Zengin (Gösteriş)" algısı yaratır. Takım elbise kemeri sade ve ince tokalı olmalıdır.</div>
        </div>

        <div class="log-item" id="log-shoes">
          <div class="log-header"><span class="log-icon">👞</span> Siyah Kemer - Kahve Ayakkabı</div>
          <div class="log-desc">Giyimdeki en sert kurallardan biri ihlal edilmiş. Karakterin kemeri siyah, ancak ayakkabıları kahverengi. Deriler her zaman renk ve doku olarak eşleşmek zorundadır.</div>
        </div>

        <div class="log-item" id="log-watch">
          <div class="log-header"><span class="log-icon">⌚</span> Dev Çelik Akıllı/Spor Saat</div>
          <div class="log-desc">Resmi bir lacivert takım elbiseyle, gömlek manşetinin altına sığmayan devasa spor saatler takılmaz. Burada ince kadranlı ve siyah deri kordonlu bir "Dress Watch" kullanılmalıydı.</div>
        </div>

        <div class="log-item" id="log-tie">
          <div class="log-header"><span class="log-icon">👔</span> Orantısız Kravat Genişliği</div>
          <div class="log-desc">Kravatın genişliği, ceketin yaka genişliği (lapel) ile orantılı olmalıdır. Burada ceket yakası nispeten dar iken, kravat 90'lardan kalma gibi aşırı geniş (bib tie) seçilmiş. Görsel denge bozulmuş.</div>
        </div>

      </div>

      <a href="/giyim/stil" class="btn-next" id="btnNext">Sıradaki Teste Geç: Stil Kimliği ➔</a>
    </div>
  </div>

</div>

<script>
  let found = 0;

  function discoverMistake(type, el) {
    if (el.classList.contains('found')) return; // already found

    el.classList.add('found');
    
    // Update Log
    const logItem = document.getElementById('log-' + type);
    logItem.classList.add('found');
    
    // Move to top
    logItem.parentElement.prepend(logItem);

    // Update Counter
    found++;
    document.getElementById('foundCount').textContent = found;

    // Shake logic on svg element to show impact
    const svgEl = document.getElementById('svg-' + type);
    if(svgEl) {
      svgEl.style.transition = "all 0.1s";
      svgEl.style.transformOrigin = "center";
      let toggle = false;
      const interval = setInterval(() => {
        svgEl.style.transform = toggle ? "translateX(-2px)" : "translateX(2px)";
        toggle = !toggle;
      }, 50);
      setTimeout(() => {
        clearInterval(interval);
        svgEl.style.transform = "none";
      }, 400);
    }

    if (found === 4) {
      setTimeout(() => {
        document.getElementById('btnNext').style.display = 'block';
        alert("Tebrikler Dedektif! Tüm hataları buldunuz. Karakterin imajını kurtardınız.");
      }, 500);
    }
  }
</script>

<%- include('partials/main-footer') %>
