<%- include('partials/main-header') %>

<style>
  body { background: #000000; color: #ffffff; margin: 0; min-height: 100vh; display: flex; flex-direction: column; font-family: 'Inter', sans-serif; overflow: hidden; }
  .main-header, .main-footer { display: none !important; }

  .c-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
  
  .instruction-panel { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 40px; z-index: 10; backdrop-filter: blur(10px); transition: opacity 0.3s; }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #ef4444; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1rem; color: #cbd5e1; margin: 0; max-width: 600px; line-height: 1.5; }

  .question-box { font-size: 3.5rem; font-weight: 900; text-align: center; max-width: 900px; line-height: 1.3; color: #ffffff; margin-bottom: 60px; text-shadow: 0 10px 30px rgba(0,0,0,0.8); min-height: 150px; display: flex; align-items: center; justify-content: center; }
  
  .danger-bar-container { width: 100%; max-width: 800px; height: 12px; background: rgba(255,255,255,0.1); border-radius: 20px; overflow: hidden; display: none; margin-bottom: 40px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.5); }
  .danger-bar { height: 100%; width: 100%; background: #ef4444; transition: width 0.1s linear; box-shadow: 0 0 20px #ef4444; }

  .timer-text { font-size: 5rem; font-weight: 900; color: #ef4444; font-variant-numeric: tabular-nums; display: none; text-shadow: 0 0 30px rgba(239, 68, 68, 0.4); margin-bottom: 20px; }

  .controls { display: flex; gap: 20px; z-index: 10; }
  .btn-control {
    background: #ef4444; color: #ffffff; border: none; padding: 20px 60px; border-radius: 40px;
    font-size: 1.4rem; font-weight: 900; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 10px 30px rgba(239, 68, 68, 0.3);
  }
  .btn-control:hover { background: #dc2626; transform: translateY(-2px); box-shadow: 0 15px 40px rgba(239, 68, 68, 0.5); }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: rgba(255,255,255,0.6); text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #ffffff; }

  /* Effects */
  .flash { animation: flashRed 0.5s ease-out; }
  @keyframes flashRed { 0% { background: #7f1d1d; } 100% { background: #000000; } }

  .shake { animation: shakeH 0.4s cubic-bezier(.36,.07,.19,.97) both; }
  @keyframes shakeH { 10%, 90% { transform: translate3d(-2px, 0, 0); } 20%, 80% { transform: translate3d(4px, 0, 0); } 30%, 50%, 70% { transform: translate3d(-8px, 0, 0); } 40%, 60% { transform: translate3d(8px, 0, 0); } }

</style>

<a href="/sahne" class="btn-back">← Sahne'ye Dön</a>

<div class="c-container" id="mainBg">
  
  <div class="instruction-panel" id="panel">
    <h1 class="instruction-title">Çapraz Ateş (Zor Soru Simülatörü)</h1>
    <p class="instruction-desc">Ateşle butonuna bastığınızda ekrana kışkırtıcı, ters köşe veya agresif bir soru gelecek. Düşünmek için sadece 10 saniyeniz var. Soruyu gördüğünüz an yüksek sesle mantıklı bir cevap üretmeye başlayın. Kekelemek yok!</p>
  </div>

  <div class="timer-text" id="timerText">10.0</div>

  <div class="question-box" id="qBox">
    Hazırsanız butona basın.
  </div>

  <div class="danger-bar-container" id="barCont">
    <div class="danger-bar" id="dBar"></div>
  </div>

  <div class="controls">
    <button class="btn-control" id="btnAction" onclick="fireQuestion()">Ateşle!</button>
  </div>

</div>

<script>
  const questions = [
    "Bu projenin diğerlerinden hiçbir farkı yok, neden sizi dinleyelim?",
    "Anlattıklarınızın hiçbir bilimsel dayanağı olmadığını biliyorsunuz değil mi?",
    "Özetle, bize tamamen zaman kaybettirdiğinizi itiraf edebilir misiniz?",
    "Bunca başarısızlıktan sonra neden hala bu fikri savunuyorsunuz?",
    "En büyük rakibiniz sizden çok daha iyi. Neden sizi seçelim?",
    "Sürekli aynı şeyleri tekrarlıyorsunuz, yeni bir şey söylemeyecek misiniz?",
    "Sizce de bu anlattıklarınız sadece teoride kalan saçmalıklar değil mi?",
    "Ekibinizin bu işi yapabilecek kapasitede olduğundan şüpheliyim. Beni ikna edin."
  ];

  let isRunning = false;
  let timerInterval = null;
  let timeLeft = 10000; // 10 seconds
  
  const qBox = document.getElementById('qBox');
  const dBar = document.getElementById('dBar');
  const barCont = document.getElementById('barCont');
  const btnAction = document.getElementById('btnAction');
  const panel = document.getElementById('panel');
  const mainBg = document.getElementById('mainBg');
  const timerText = document.getElementById('timerText');

  function getRandomQuestion() {
    return questions[Math.floor(Math.random() * questions.length)];
  }

  function fireQuestion() {
    if (isRunning) {
      // stop
      clearInterval(timerInterval);
      isRunning = false;
      btnAction.textContent = 'Yeni Soru Gönder';
      dBar.style.width = '100%';
    } else {
      // prepare
      isRunning = true;
      panel.style.opacity = '0';
      btnAction.style.display = 'none';
      barCont.style.display = 'none';
      timerText.style.display = 'none';
      
      qBox.textContent = "Soru geliyor...";
      qBox.style.color = "#64748b";

      // suspense
      setTimeout(() => {
        // Boom
        mainBg.classList.add('flash');
        setTimeout(() => mainBg.classList.remove('flash'), 500);
        
        qBox.textContent = `"${getRandomQuestion()}"`;
        qBox.style.color = "#ffffff";
        qBox.classList.add('shake');
        setTimeout(() => qBox.classList.remove('shake'), 400);

        // Start timer
        barCont.style.display = 'block';
        timerText.style.display = 'block';
        timeLeft = 10000;
        
        timerInterval = setInterval(() => {
          timeLeft -= 50;
          dBar.style.width = (timeLeft / 10000 * 100) + '%';
          timerText.textContent = (timeLeft / 1000).toFixed(1);

          if (timeLeft <= 0) {
            clearInterval(timerInterval);
            isRunning = false;
            btnAction.style.display = 'block';
            btnAction.textContent = 'Tekrar Dene';
            timerText.textContent = "0.0";
          }
        }, 50);

      }, 2000); // 2 sec suspense
    }
  }
</script>
