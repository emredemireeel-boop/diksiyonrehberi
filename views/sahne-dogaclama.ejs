<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column; font-family: 'Inter', sans-serif; }
  
  .dogaclama-container {
    flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 40px 20px; position: relative; overflow: hidden;
  }

  /* BACKGROUND EFFECTS */
  .bg-glow {
    position: absolute; width: 600px; height: 600px; background: radial-gradient(circle, rgba(14, 165, 233, 0.08) 0%, transparent 70%);
    top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 0; pointer-events: none;
  }

  .dogaclama-card {
    background: linear-gradient(145deg, #ffffff, #f1f5f9); border: 1px solid #e2e8f0; border-radius: 24px;
    padding: 50px; width: 100%; max-width: 700px; text-align: center; z-index: 1;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05); position: relative; overflow: hidden;
  }
  .dogaclama-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: #0ea5e9;
  }

  .title-small { font-size: 0.9rem; font-weight: 800; color: #0284c7; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 20px; }
  
  .scenario-text {
    font-size: 1.8rem; font-weight: 900; line-height: 1.5; color: #0f172a; margin-bottom: 40px; min-height: 120px;
    display: flex; align-items: center; justify-content: center;
  }

  .emotion-badge {
    display: inline-block; background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.2);
    color: #0369a1; padding: 10px 24px; border-radius: 30px; font-weight: 800; font-size: 1.1rem; margin-bottom: 40px;
  }

  .timer-display {
    font-size: 4rem; font-weight: 900; color: #0f172a; font-variant-numeric: tabular-nums;
    margin-bottom: 40px; text-shadow: 0 0 20px rgba(0,0,0,0.05);
  }
  .timer-display.urgent { color: #dc2626; text-shadow: 0 0 20px rgba(220, 38, 38, 0.2); animation: pulse 1s infinite; }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  .btn-group { display: flex; gap: 16px; justify-content: center; }
  .btn-primary {
    background: #0ea5e9; color: #ffffff; border: none; padding: 18px 40px; border-radius: 12px;
    font-size: 1.1rem; font-weight: 900; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px;
  }
  .btn-primary:hover { background: #0284c7; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(14, 165, 233, 0.15); }
  
  .btn-secondary {
    background: transparent; color: #64748b; border: 2px solid #cbd5e1; padding: 16px 32px; border-radius: 12px;
    font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: all 0.2s;
  }
  .btn-secondary:hover { background: #e2e8f0; color: #0f172a; }

  .fade-in { animation: fadeIn 0.5s ease forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .btn-back { position: absolute; top: 30px; left: 30px; color: #64748b; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #0f172a; }
</style>

<a href="/sahne" class="btn-back">← Geri Dön</a>

<div class="dogaclama-container">
  <div class="bg-glow"></div>

  <div class="dogaclama-card">
    <div class="title-small">Doğaçlama Motoru</div>
    
    <div id="scenarioBox" class="scenario-text fade-in">
      "Yeni bir senaryo üretmek için aşağıdaki butona tıkla."
    </div>

    <div id="emotionBox" class="emotion-badge fade-in" style="opacity: 0;">
      Duygu Bekleniyor
    </div>

    <div id="timerBox" class="timer-display">01:00</div>

    <div class="btn-group">
      <button class="btn-primary" id="btnGenerate">Yeni Senaryo Üret</button>
      <button class="btn-secondary" id="btnTimer">Süreyi Başlat</button>
    </div>
  </div>
</div>

<script>
  const scenarios = [
    "İş yemeğinde yanlışlıkla patronunun üzerine kahve döktün. Durumu toparlaman gerekiyor.",
    "Büyük bir konferansta sahnedesin. Tam sunumun ortasında elektrikler kesildi.",
    "Çok önemli bir müşteriye ürün satıyorsun ama ürünün adını unuttun.",
    "Asansörde en büyük rakip firmanın CEO'su ile yalnız kaldın. 1 dakikan var.",
    "Tiyatrodasın. Diğer oyuncu repliğini unuttuğu için sana boş boş bakıyor.",
    "Mikrofonun açık kaldığını fark etmeden seyirci hakkında konuştun. Ve herkes duydu.",
    "Ödül töreninde başkasının ödülünü yanlışlıkla sen teslim aldın.",
    "Sahnedeyken bir seyirci sürekli sözünü kesiyor ve tezini çürütmeye çalışıyor.",
    "Yatırımcılara sunum yaparken projeksiyon cihazı patladı ve dumanlar çıkıyor.",
    "Sahnede yürürken ayağın takıldı ve yere düştün. Şimdi ayağa kalktın ve devam etmelisin."
  ];

  const emotions = [
    "Aşırı Özgüvenli", "Gizli Panik", "Otoriter", "Şakacı / Mizahi", "Derin Bir Sakinlik", "Filozofik", "Hafif Sinirli", "Aşırı Neşeli"
  ];

  const btnGenerate = document.getElementById('btnGenerate');
  const btnTimer = document.getElementById('btnTimer');
  const scenarioBox = document.getElementById('scenarioBox');
  const emotionBox = document.getElementById('emotionBox');
  const timerBox = document.getElementById('timerBox');

  let timerInterval;
  let timeLeft = 60;

  function generateScenario() {
    // Reset animations
    scenarioBox.classList.remove('fade-in');
    emotionBox.classList.remove('fade-in');
    void scenarioBox.offsetWidth; // trigger reflow
    
    const randomScen = scenarios[Math.floor(Math.random() * scenarios.length)];
    const randomEmo = emotions[Math.floor(Math.random() * emotions.length)];

    scenarioBox.innerText = `"${randomScen}"`;
    emotionBox.innerText = `İstenen Duygu: ${randomEmo}`;
    
    scenarioBox.classList.add('fade-in');
    emotionBox.classList.add('fade-in');
    emotionBox.style.opacity = '1';

    // Reset Timer
    clearInterval(timerInterval);
    timeLeft = 60;
    updateTimerDisplay();
    btnTimer.innerText = "Süreyi Başlat";
    timerBox.classList.remove('urgent');
  }

  function updateTimerDisplay() {
    const mins = Math.floor(timeLeft / 60);
    const secs = timeLeft % 60;
    timerBox.innerText = `0${mins}:${secs < 10 ? '0' : ''}${secs}`;
    
    if (timeLeft <= 10 && timeLeft > 0) {
      timerBox.classList.add('urgent');
    } else {
      timerBox.classList.remove('urgent');
    }
  }

  function toggleTimer() {
    if (btnTimer.innerText === "Süreyi Başlat") {
      btnTimer.innerText = "Durdur";
      timerInterval = setInterval(() => {
        if (timeLeft > 0) {
          timeLeft--;
          updateTimerDisplay();
        } else {
          clearInterval(timerInterval);
          btnTimer.innerText = "Süre Bitti!";
        }
      }, 1000);
    } else {
      clearInterval(timerInterval);
      btnTimer.innerText = "Süreyi Başlat";
      timerBox.classList.remove('urgent');
    }
  }

  btnGenerate.addEventListener('click', generateScenario);
  btnTimer.addEventListener('click', toggleTimer);

</script>
