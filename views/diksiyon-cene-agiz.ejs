<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 💎 Hero 💎 */
  .c-hero {
    min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(ellipse 70% 80% at 50% 20%, #8b5cf622, transparent 70%);
  }
  .c-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#f8fafc,transparent); }

  .hero-particles { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
  .hp { position:absolute; border-radius:50%; animation: cFloat 8s ease-in-out infinite; background: linear-gradient(135deg, #8b5cf6, #d946ef); }
  @keyframes cFloat { 0%,100%{ transform:translateY(0) scale(1); opacity:.2; } 50%{ transform:translateY(-50px) scale(1.5); opacity:.6; } }

  .c-icon { font-size: 6rem; margin-bottom: 20px; animation: cPulse 3s ease-in-out infinite; filter: drop-shadow(0 0 30px #8b5cf666); }
  @keyframes cPulse { 0%,100%{ transform: scale(1); } 50%{ transform: scale(1.1) translateY(-10px); } }

  .c-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 24px; border-radius:30px; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#c4b5fd; background:#8b5cf618; border:1px solid #8b5cf644; margin-bottom:24px; box-shadow: 0 0 20px #8b5cf622; }
  .c-title { font-size:clamp(2.5rem,6vw,4rem); font-weight:900; color:#0f172a; margin-bottom:12px; line-height:1.1; letter-spacing: -1px; }
  .c-title span { background: linear-gradient(135deg, #a78bfa, #f472b6); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .c-subtitle { color:#475569; font-size:1.15rem; max-width:650px; line-height:1.8; }

  /* 💎 Container 💎 */
  .c-wrap { max-width:1000px; margin:0 auto; padding:0 20px 100px; }

  /* 💎 Glass Cards 💎 */
  .glass { background:rgba(15,23,42,.02); backdrop-filter:blur(20px); border:1px solid rgba(15,23,42,.05); border-radius:24px; padding:40px; margin-bottom:40px; transition:transform .4s,box-shadow .4s; position: relative; overflow: hidden; }
  .glass::before { content:''; position:absolute; top:0; left:0; width:100%; height:1px; background:linear-gradient(90deg,transparent,rgba(15,23,42,.1),transparent); }
  .glass:hover { transform:translateY(-5px); box-shadow:0 30px 60px rgba(15,23,42,.4),0 0 40px #8b5cf611; border-color:rgba(139,92,246,.2); }
  .section-label { font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:4px; color:#a78bfa; margin-bottom:20px; display:flex; align-items:center; gap:12px; }
  .section-label::before { content:''; width:24px; height:2px; background:#a78bfa; border-radius:2px; }

  /* 💎 Anatomy SVG 💎 */
  .anatomy-wrap { display:flex; justify-content:center; margin:30px 0 40px; position: relative; }
  .anatomy-svg { width:380px; height:280px; filter: drop-shadow(0 20px 30px rgba(15,23,42,.5)); }
  .jaw-bone { fill:#f0f4f8; stroke:#475569; stroke-width:2; transition: all 0.3s; transform-origin: 220px 80px; }
  .jaw-muscle { fill:#8b5cf6; opacity:0.3; transition: all 0.3s; }
  .jaw-muscle.active { opacity:0.8; filter: drop-shadow(0 0 15px #a78bfa); }
  .anatomy-label { fill:#334155; font-size:12px; font-weight:700; letter-spacing: 1px; }

  /* 💎 Interactive Gym 💎 */
  .gym-container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media(max-width: 768px) { .gym-container { grid-template-columns: 1fr; } }
  
  .gym-card { background: rgba(15,23,42,.3); border: 1px solid rgba(139,92,246,.15); border-radius: 16px; padding: 24px; text-align: center; cursor: pointer; transition: all .3s; position: relative; overflow: hidden; }
  .gym-card::after { content:''; position:absolute; inset:0; background:radial-gradient(circle at center, rgba(139,92,246,.1), transparent); opacity:0; transition:opacity .3s; }
  .gym-card:hover { border-color: #8b5cf6; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(139,92,246,.15); }
  .gym-card:hover::after { opacity: 1; }
  
  .gym-icon { font-size: 3rem; margin-bottom: 12px; display: inline-block; transition: transform .3s; }
  .gym-card:hover .gym-icon { transform: scale(1.2) rotate(5deg); }
  
  .gym-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 8px; }
  .gym-desc { font-size: 0.85rem; color: #475569; line-height: 1.6; }

  /* 💎 Master Workout Panel 💎 */
  .workout-panel { background: linear-gradient(145deg, #16102b, #f8fafc); border: 1px solid #8b5cf633; border-radius: 24px; padding: 40px; margin-top: 20px; text-align: center; position: relative; overflow: hidden; }
  .workout-panel::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle at center, rgba(139,92,246,.05) 0%, transparent 50%); animation: rotateGlow 15s linear infinite; pointer-events:none; }
  @keyframes rotateGlow { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .workout-display { font-size: 2.5rem; font-weight: 900; color: #fff; letter-spacing: 2px; margin: 24px 0; min-height: 60px; display: flex; align-items: center; justify-content: center; }
  .workout-hint { color: #a78bfa; font-size: 1rem; font-weight: 600; margin-bottom: 30px; }
  
  .workout-btn { padding: 16px 40px; border-radius: 100px; background: linear-gradient(135deg, #8b5cf6, #d946ef); color: #fff; font-size: 1.1rem; font-weight: 800; border: none; cursor: pointer; box-shadow: 0 10px 30px rgba(139,92,246,.4); transition: all .3s; text-transform: uppercase; letter-spacing: 2px; }
  .workout-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 40px rgba(139,92,246,.6); }
  .workout-btn:active { transform: scale(0.98); }

  /* 💎 Back Button 💎 */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:rgba(15,23,42,.05); border:1px solid rgba(15,23,42,.1); color:#475569; font-size:.9rem; font-weight:600; text-decoration:none; transition:all .3s; margin-bottom:40px; }
  .back-btn:hover { background:rgba(15,23,42,.1); color:#fff; transform:translateX(-4px); }

  /* 💎 Reveal 💎 */
  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="c-hero">
  <div class="hero-particles">
    <% for(let i=0; i<30; i++) { %>
      <div class="hp" style="left:<%= Math.random()*100 %>%; top:<%= Math.random()*100 %>%; width:<%= 2+Math.random()*5 %>px; height:<%= 2+Math.random()*5 %>px; animation-delay:<%= Math.random()*8 %>s; animation-duration:<%= 5+Math.random()*5 %>s;"></div>
    <% } %>
  </div>
  <div class="c-icon">🦁</div>
  <div class="c-badge">💪 Artikülasyon Laboratuvarı</div>
  <h1 class="c-title"><span>Çene & Ağız Kasları</span> Geliştirme Merkezi</h1>
  <p class="c-subtitle">Sesin gücü ciğerlerden, netliği ise çeneden gelir. Dünyanın en zor tekerlemelerini bile takılmadan okumanızı sağlayacak özel kas geliştirme egzersizleri.</p>
</section>

<div class="c-wrap">
  <a href="/diksiyon?cat=cene" class="back-btn">Tüm Çene Egzersizlerini Gör</a>

  <!-- 💎 ANATOMY 💎 -->
  <div class="glass reveal">
    <div class="section-label">🦴 Çene Eklem Anatomisi (TMJ)</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:10px;">Çene ekleminiz (Temporomandibular Eklem) ve çiğneme kaslarınız, yüzünüzdeki en güçlü kas grubudur. Stres altında ilk kilitlenen yer burasıdır ve konuşma sırasında hece yutmalarının bir numaralı sebebidir.</p>

    <div class="anatomy-wrap">
      <svg class="anatomy-svg" viewBox="0 0 400 300">
        <!-- Skull Base -->
        <path d="M 150 50 C 250 50 280 150 220 200 C 200 220 120 220 100 200 C 60 150 80 50 150 50 Z" fill="#f0f4f8" stroke="#334155" stroke-width="2"/>
        
        <!-- Jaw Bone (Mandible) -->
        <g id="jawBone" class="jaw-bone">
          <path d="M 220 120 L 230 180 C 235 220 180 250 140 240 C 120 235 110 220 110 200 L 140 160" fill="#334155" stroke="#64748b" stroke-width="2"/>
        </g>

        <!-- Masseter Muscle (Cheek/Jaw Muscle) -->
        <path id="masseter" class="jaw-muscle" d="M 200 130 C 220 130 230 180 210 220 C 190 200 180 150 200 130 Z"/>

        <!-- Temporalis Muscle (Side of head) -->
        <path id="temporalis" class="jaw-muscle" d="M 160 60 C 200 50 240 80 210 120 C 180 100 140 100 160 60 Z"/>

        <!-- Nodes & Labels -->
        <circle cx="220" cy="120" r="6" fill="#f472b6"/>
        <text x="235" y="125" class="anatomy-label">TMJ Eklemi</text>
        
        <circle cx="210" cy="180" r="4" fill="#a78bfa"/>
        <text x="225" y="185" class="anatomy-label">Masseter Kası</text>

        <circle cx="180" cy="80" r="4" fill="#a78bfa"/>
        <text x="110" y="75" class="anatomy-label">Temporalis Kası</text>
      </svg>
    </div>
    
    <div style="display:flex; justify-content:center; gap:16px;">
      <button onclick="triggerAnatomy('chew')" style="background:rgba(139,92,246,.2); border:1px solid #8b5cf6; color:#fff; padding:10px 24px; border-radius:8px; cursor:pointer;">Çiğneme Simülasyonu</button>
      <button onclick="triggerAnatomy('tension')" style="background:rgba(244,114,182,.2); border:1px solid #f472b6; color:#fff; padding:10px 24px; border-radius:8px; cursor:pointer;">Gerginlik Simülasyonu</button>
    </div>
  </div>

  <!-- 💎 THE GYM 💎 -->
  <div class="glass reveal">
    <div class="section-label">🏋️ Çene & Ağız Gym</div>
    <p style="color:#475569; font-size:1rem; line-height:1.8; margin-bottom:30px;">Konuşma aparatınızı ısıtmak ve güçlendirmek için en etkili 4 temel egzersiz.</p>
    
    <div class="gym-container">
      <div class="gym-card" onclick="startWorkout('lion')">
        <div class="gym-icon">🦁</div>
        <div class="gym-title">Aslan Esnemesi</div>
        <div class="gym-desc">Tüm yüz kaslarını maksimum gererek kan akışını hızlandırır. Konuşma öncesi idealdir.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('pen')">
        <div class="gym-icon">✏️</div>
        <div class="gym-title">Kalemle Okuma</div>
        <div class="gym-desc">Ağırlıklı antrenman! Kalemi dudaklarınızın arasına alarak tekerleme okuyun.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('ox')">
        <div class="gym-icon">🅾️</div>
        <div class="gym-title">O-X Egzersizi</div>
        <div class="gym-desc">Dudakları büzme ve yayma kaslarını çalıştırarak ünlü harflerin netliğini kusursuzlaştırır.</div>
      </div>
      
      <div class="gym-card" onclick="startWorkout('trill')">
        <div class="gym-icon">🏍️</div>
        <div class="gym-title">Motor Sesi (Trill)</div>
        <div class="gym-desc">Dudakları pır pır titreterek dudak tembelliğini anında ortadan kaldırır.</div>
      </div>
    </div>
  </div>

  <!-- 💎 MASTER WORKOUT PANEL 💎 -->
  <div class="workout-panel reveal" id="workoutPanel" style="display:none;">
    <div class="section-label" style="justify-content:center;" id="workoutTitle">🏋️ Egzersiz Başlıyor</div>
    <div class="workout-display" id="workoutDisplay">Hazır mısınız?</div>
    <div class="workout-hint" id="workoutHint">Ayna karşısında olmanız tavsiye edilir.</div>
    <button class="workout-btn" id="workoutActionBtn" onclick="nextWorkoutStep()">Başla</button>
  </div>

  <!-- 💎 PRO TIP 💎 -->
  <div style="background:linear-gradient(135deg,rgba(139,92,246,.1),rgba(217,70,239,.05)); border:1px solid rgba(139,92,246,.3); border-radius:24px; padding:30px; font-size:1rem; color:#e2e8f0; line-height:1.8; display:flex; align-items:flex-start; gap:20px; margin-top:40px;" class="reveal">
    <span style="font-size:2rem; flex-shrink:0;">🔮</span>
    <div>
      <strong style="color:#d946ef; display:block; margin-bottom:8px;">Altın Kural: Yavaşlık ve Genişlik</strong>
      Çoğu insan konuşurken ağzını sadece 2 milim açar. Mükemmel bir diksiyon için ağzınızı normalden <strong>2 kat daha fazla</strong> açmaya alışmalısınız. Çene egzersizlerinin temel amacı, beyninizdeki "normal ağız açıklığı" algısını yeniden programlamaktır.
    </div>
  </div>

</div>

<script>
// 💎 Scroll Reveal 💎
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 💎 Anatomy Animations 💎
let animTimeout;
function triggerAnatomy(type) {
  clearTimeout(animTimeout);
  const jaw = document.getElementById('jawBone');
  const masseter = document.getElementById('masseter');
  const temporalis = document.getElementById('temporalis');
  
  if(type === 'chew') {
    let count = 0;
    const interval = setInterval(() => {
      jaw.style.transform = (count % 2 === 0) ? 'rotate(5deg)' : 'rotate(0deg)';
      masseter.classList.toggle('active');
      temporalis.classList.toggle('active');
      count++;
      if(count > 6) clearInterval(interval);
    }, 300);
  } else if (type === 'tension') {
    jaw.style.transform = 'translateY(-2px) rotate(-1deg)';
    masseter.style.fill = '#f472b6';
    masseter.classList.add('active');
    temporalis.style.fill = '#f472b6';
    temporalis.classList.add('active');
    
    animTimeout = setTimeout(() => {
      jaw.style.transform = 'translateY(0) rotate(0deg)';
      masseter.style.fill = '#8b5cf6';
      masseter.classList.remove('active');
      temporalis.style.fill = '#8b5cf6';
      temporalis.classList.remove('active');
    }, 2000);
  }
}

// 💎 Workout Logic 💎
const workouts = {
  lion: {
    title: '🦁 Aslan Esnemesi',
    steps: [
      { text: 'Derin bir nefes alın...', hint: 'Omuzları kasmadan' },
      { text: 'Ağzınızı KOCAMAN açın', hint: 'Gözler açık, dil dışarıya!' },
      { text: 'BEKLEYİN...', hint: 'Kas gerginliğini hissedin (5s)' },
      { text: 'Serbest bırakın.', hint: 'Harika.' }
    ]
  },
  ox: {
    title: '🅾️ O-X Egzersizi',
    steps: [
      { text: '<span style="font-size:4rem;color:#f472b6;">O</span>', hint: 'Dudakları sonuna kadar büzün' },
      { text: '<span style="font-size:4rem;color:#a78bfa;">X</span>', hint: 'Dudakları yanlara sonuna kadar yayın' },
      { text: '<span style="font-size:4rem;color:#f472b6;">O</span>', hint: 'Tekrar büzün!' },
      { text: '<span style="font-size:4rem;color:#a78bfa;">X</span>', hint: 'Tekrar yayın!' },
      { text: 'Bitti.', hint: 'Bunu her gün aynada 20 kez yapın.' }
    ]
  },
  pen: {
    title: '✏️ Kalemle Okuma',
    steps: [
      { text: 'Kalemi dişlerinize değdirmeden dudaklarınızla yatay tutun', hint: 'Hazır mısınız?' },
      { text: '"Şu köşe yaz köşesi, şu köşe kış köşesi..."', hint: 'Kalemi düşürmeden abartılı okuyun!' },
      { text: 'Kalemi çıkarın', hint: 'Derin bir nefes' },
      { text: '"Şu köşe yaz köşesi, şu köşe kış köşesi..."', hint: 'Aynı tekerlemeyi şimdi kalemsiz okuyun. Farkı hissedin.' }
    ]
  },
  trill: {
    title: '🏍️ Motor Sesi (Trill)',
    steps: [
      { text: 'Dudakları hafifçe birleştirin', hint: 'Yanaklar serbest' },
      { text: 'Prrrrrrrrrrr...', hint: 'Dudakları titreterek nefes verin' },
      { text: 'Siren Sesi Ekleyin', hint: 'Titreşimi bozmadan sesi inceden kalına kaydırın' },
      { text: 'Rahatlayın.', hint: 'Ses telleriniz artık hazır.' }
    ]
  }
};

let currentWorkout = null;
let currentStepIndex = 0;

function startWorkout(id) {
  currentWorkout = workouts[id];
  currentStepIndex = 0;
  
  const panel = document.getElementById('workoutPanel');
  panel.style.display = 'block';
  
  document.getElementById('workoutTitle').innerHTML = currentWorkout.title;
  document.getElementById('workoutDisplay').innerHTML = 'Hazır mısınız?';
  document.getElementById('workoutHint').innerHTML = 'Ayna karşısında olmanız tavsiye edilir.';
  document.getElementById('workoutActionBtn').innerHTML = 'Başla';
  
  setTimeout(() => {
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }, 100);
}

function nextWorkoutStep() {
  if(!currentWorkout) return;
  
  if(currentStepIndex < currentWorkout.steps.length) {
    const step = currentWorkout.steps[currentStepIndex];
    document.getElementById('workoutDisplay').innerHTML = step.text;
    document.getElementById('workoutHint').innerHTML = step.hint;
    document.getElementById('workoutActionBtn').innerHTML = (currentStepIndex === currentWorkout.steps.length - 1) ? 'Bitir' : 'Sonraki Adım';
    currentStepIndex++;
  } else {
    document.getElementById('workoutDisplay').innerHTML = 'Egzersiz Tamamlandı! 🎉';
    document.getElementById('workoutHint').innerHTML = 'Düzenli pratik kas hafızanızı kalıcı olarak değiştirir.';
    document.getElementById('workoutActionBtn').innerHTML = 'Tekrar Yap';
    currentStepIndex = 0;
  }
}
</script>

<%- include('partials/main-footer') %>


