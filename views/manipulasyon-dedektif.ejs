      dialogue: [
        { speaker: "Sen", class: "msg-a", text: "Geçen hafta bu raporu cuma gününe kadar bitireceğini söylemiştin ama hala bekliyorum." },
        { speaker: "İş Arkadaşı", class: "msg-b", text: "<span class='target'>Ben asla öyle bir şey söylemedim. Sen son günlerde çok streslisin, her şeyi yanlış hatırlıyorsun.</span>" }
      ],
      question: "İş arkadaşının kullandığı bu psikolojik savunma mekanizması hangi taktiktir?",
