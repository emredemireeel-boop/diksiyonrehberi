        { id: "o2", text: "Suçluluk Tripi", correct: false, fb: "Yanlış. Burada seni vicdanen suçlu hissettirecek bir fedakarlık vurgusu yapılmıyor." },
        { id: "o3", text: "Sessizlik Terapisi", correct: false, fb: "Yanlış. İletişimi tamamen koparma söz konusu değil." },
