<%- include('partials/main-header') %>

<style>
  /* 🌍 Diplomacy Protocol Light Theme 🌍 */
  body { background: #fdfdfd; color: #1e1b4b; font-family: 'Inter', sans-serif; overflow-x: hidden; }

  /* 🌍 Hero Section 🌍 */
  .p-hero {
    min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 140px 24px 80px; position: relative; overflow: hidden;
    background: radial-gradient(circle at 50% 0%, #e0e7ff 0%, #fdfdfd 80%);
  }
  .p-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:150px; background:linear-gradient(to top,#fdfdfd,transparent); }

  /* Map Background */
  .p-bg { position:absolute; inset:0; overflow:hidden; pointer-events:none; z-index:0; opacity: 0.05; background-image: url('data:image/svg+xml;utf8,<svg width="100" height="100" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="40" fill="none" stroke="%234338ca" stroke-width="2"/><path d="M10 50 Q50 90 90 50 Q50 10 10 50" fill="none" stroke="%234338ca" stroke-width="2"/><path d="M50 10 V90 M10 50 H90" fill="none" stroke="%234338ca" stroke-width="2"/></svg>'); background-size: 300px; animation: slowSpin 60s linear infinite; }
  @keyframes slowSpin { 0%{ transform: rotate(0deg) scale(1.5); } 100%{ transform: rotate(360deg) scale(1.5); } }

  .p-icon { font-size: 5rem; margin-bottom: 24px; position:relative; z-index:2; animation: floatGlobe 4s ease-in-out infinite; filter: drop-shadow(0 15px 25px rgba(67,56,202,0.3)); }
  @keyframes floatGlobe { 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-15px); } }

  .p-badge { display:inline-flex; align-items:center; gap:8px; padding:10px 28px; border-radius:40px; font-size:.9rem; font-weight:800; text-transform:uppercase; letter-spacing:3px; color: #3730a3; background: #e0e7ff; border:1px solid #a5b4fc; margin-bottom:24px; z-index:2; box-shadow: 0 8px 20px rgba(67,56,202,0.15); }
  .p-title { font-size:clamp(2.5rem,6vw,4.5rem); font-weight:900; color: #1e1b4b; margin-bottom:16px; line-height:1.1; letter-spacing: -1.5px; z-index:2; position:relative; }
  .p-title span { background: linear-gradient(135deg, #4338ca, #312e81); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .p-subtitle { color: #4f46e5; font-size:1.2rem; max-width:750px; line-height:1.8; z-index:2; position:relative; font-weight: 500; }

  /* 🌍 Container 🌍 */
  .p-wrap { max-width:1100px; margin:0 auto; padding:0 20px 100px; position:relative; z-index:10; }

  /* 🌍 Premium Cards 🌍 */
  .p-card { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(25px); border: 1px solid rgba(67, 56, 202, 0.2); border-radius: 32px; padding: 50px; margin-bottom: 50px; transition: transform 0.4s, box-shadow 0.4s; position: relative; overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04); }
  .p-card:hover { transform: translateY(-5px); box-shadow: 0 30px 60px rgba(67, 56, 202, 0.1); border-color: rgba(67, 56, 202, 0.4); }
  
  .section-label { font-size:1.1rem; font-weight:800; text-transform:uppercase; letter-spacing:2px; color: #4338ca; margin-bottom:24px; display:flex; align-items:center; gap:12px; }

  /* 🌍 Global Etiquette Map 🌍 */
  .map-box { display: flex; flex-direction: column; gap: 25px; }
  .country-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
  .c-btn { padding: 12px 16px; background: white; border: 2px solid #e0e7ff; border-radius: 12px; font-weight: 700; color: #3730a3; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 1.05rem; }
  .c-btn:hover, .c-btn.active { background: #4338ca; color: white; border-color: #4338ca; transform: translateY(-2px); box-shadow: 0 8px 15px rgba(67,56,202,0.2); }
  
  .c-info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 20px; padding: 30px; display: none; animation: fadeIn 0.4s ease; }
  .c-info-box.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  
  .c-info-title { font-size: 1.8rem; font-weight: 900; color: #1e1b4b; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
  .c-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .info-panel { background: white; padding: 20px; border-radius: 16px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); border-left: 4px solid #4338ca; }
  .info-panel.taboo { border-left-color: #ef4444; }
  .info-panel h4 { font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; color: #64748b; font-weight: 800; }
  .info-panel p { font-size: 1.05rem; color: #334155; line-height: 1.6; }

  /* 🌍 Faux Pas Finder 🌍 */
  .faux-box { background: #1e1b4b; border-radius: 24px; padding: 40px; color: white; }
  .faux-scenario { font-size: 1.25rem; line-height: 1.8; color: #e0e7ff; margin-bottom: 30px; font-weight: 500; font-style: italic; border-left: 4px solid #818cf8; padding-left: 20px; }
  
  .opt-grid { display: grid; grid-template-columns: 1fr; gap: 15px; margin-bottom: 25px; }
  .faux-btn { padding: 16px 24px; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.1); border-radius: 12px; font-weight: 600; font-size: 1.1rem; color: white; cursor: pointer; transition: all 0.3s; text-align: left; }
  .faux-btn:hover { background: rgba(255,255,255,0.1); border-color: #818cf8; }
  .faux-btn.correct { background: rgba(34,197,94,0.2); border-color: #22c55e; color: #bbf7d0; }
  .faux-btn.wrong { background: rgba(239,68,68,0.2); border-color: #ef4444; color: #fecaca; }

  .faux-feedback { min-height: 60px; font-size: 1.1rem; font-weight: 600; color: #a5b4fc; transition: all 0.3s; opacity: 0; }
  .faux-feedback.show { opacity: 1; }
  .next-btn { display: inline-block; padding: 12px 24px; background: #4f46e5; color: white; border: none; border-radius: 12px; font-weight: 700; cursor: pointer; transition: all 0.3s; display: none; margin-top: 15px; }
  .next-btn:hover { background: #6366f1; transform: translateY(-2px); }

  /* Back btn */
  .back-btn { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; border-radius:14px; background:#ffffff; border:2px solid #e0e7ff; color:#3730a3; font-size:.9rem; font-weight:700; text-decoration:none; transition:all .3s; margin-bottom:40px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
  .back-btn:hover { background:#f8fafc; color:#1e1b4b; transform:translateX(-4px); border-color: #c7d2fe; }

  .reveal { opacity:0; transform:translateY(40px); transition:all .7s cubic-bezier(.2,1,.3,1); }
  .reveal.visible { opacity:1; transform:translateY(0); }
</style>

<section class="p-hero">
  <div class="p-bg"></div>
  <div class="p-icon">💼</div>
  <div class="p-badge">Uluslararası İletişim Akademisi</div>
  <h1 class="p-title">Diplomatik <span>Zeka</span></h1>
  <p class="p-subtitle">Japonya'daki bir kartvizit değişiminden, Çin'deki hediyeleşme ritüellerine kadar çok kültürlü iş dünyasında güven inşa etmenin ve kültürel gaflardan kaçınmanın sırlarını öğrenin.</p>
</section>

<div class="p-wrap">
  <a href="/diksiyon?cat=protokol" class="back-btn">← Tüm Protokol Eğitimlerini Gör (25 Madde)</a>

  <!-- 🌍 GLOBAL ETIQUETTE MAP 🌍 -->
  <div class="p-card reveal">
    <div class="section-label">🗺️ Dünya Kültür Haritası</div>
    <p style="color:#4f46e5; font-size:1.05rem; line-height:1.6; margin-bottom:25px;">
      Bir ülkeyi seçerek oradaki temel iş toplantısı protokollerini, selamlaşma ritüellerini ve kesinlikle kaçınılması gereken tabuları inceleyin.
    </p>

    <div class="map-box">
      <div class="country-grid">
        <button class="c-btn active" onclick="showCountry('jp', this)">🇯🇵 Japonya</button>
        <button class="c-btn" onclick="showCountry('cn', this)">🇨🇳 Çin</button>
        <button class="c-btn" onclick="showCountry('ae', this)">🇦🇪 Orta Doğu</button>
        <button class="c-btn" onclick="showCountry('de', this)">🇩🇪 Almanya</button>
        <button class="c-btn" onclick="showCountry('br', this)">🇧🇷 Brezilya</button>
      </div>

      <!-- Japonya -->
      <div class="c-info-box active" id="c-jp">
        <div class="c-info-title">🇯🇵 Japon İş Protokolü</div>
        <div class="c-info-grid">
          <div class="info-panel">
            <h4>🤝 Selamlaşma & İlk İntiba</h4>
            <p><strong>Meishi (Kartvizit):</strong> Kartvizit iki elle, yazılar karşı tarafın okuyabileceği yönde sunulur. Kartvizit kişiyi temsil eder; asla hemen cebe atılmaz, masada özenle durur.</p>
          </div>
          <div class="info-panel">
            <h4>🗣️ İletişim Tarzı</h4>
            <p><strong>Honne ve Tatemae:</strong> Tatemae (toplum içindeki yüz) daima korunur. Direkt "Hayır" denmez, "Üzerinde düşüneceğiz" veya "Biraz zor olabilir" denmesi %90 hayır demektir.</p>
          </div>
          <div class="info-panel taboo">
            <h4>🛑 Kritik Tabular</h4>
            <p>Toplantıda birini herkesin içinde düzeltmek (Yüz kaybettirmek), yemekte çubukları (chopstick) pilava dik batırmak (Cenaze ritüelidir).</p>
          </div>
        </div>
      </div>

      <!-- Çin -->
      <div class="c-info-box" id="c-cn">
        <div class="c-info-title">🇨🇳 Çin İş Protokolü</div>
        <div class="c-info-grid">
          <div class="info-panel">
            <h4>🤝 Selamlaşma & İlk İntiba</h4>
            <p><strong>Guanxi (Ağ/İlişki):</strong> Çin'de iş yapmak sözleşmelerden önce kişisel ilişkilere (Guanxi) dayanır. İlk toplantılar işten çok güven inşası ve çay içme üzerinedir.</p>
          </div>
          <div class="info-panel">
            <h4>🗣️ İletişim Tarzı</h4>
            <p><strong>Mianzi (Yüz):</strong> Saygı göstermek (yüz vermek) kritik önem taşır. Hiyerarşiye kesinlikle uyulur; odaya önce en kıdemli kişi girer.</p>
          </div>
          <div class="info-panel taboo">
            <h4>🛑 Kritik Tabular</h4>
            <p>Hediye olarak "Saat" vermek (Ölümü çağrıştırır). Hediyeyi ilk sunulduğunda hemen kabul etmek (Geleneksel olarak 2-3 kez nazikçe reddedilir).</p>
          </div>
        </div>
      </div>

      <!-- Orta Doğu -->
      <div class="c-info-box" id="c-ae">
        <div class="c-info-title">🇦🇪 Orta Doğu (Arap) İş Kültürü</div>
        <div class="c-info-grid">
          <div class="info-panel">
            <h4>🤝 Selamlaşma & İlk İntiba</h4>
            <p><strong>Misafirperverlik:</strong> Toplantılar kahve/çay ikramıyla başlar ve uzun sohbetler (aile, sağlık) içerir. İş konuşulmadan önce güven bağının kurulması şarttır.</p>
          </div>
          <div class="info-panel">
            <h4>🗣️ İletişim Tarzı</h4>
            <p><strong>Zaman Algısı (Inshallah):</strong> Polikronik bir zaman algısı vardır. Toplantılar bölünebilir, başkaları odaya girebilir. Bu bir saygısızlık değil, kültürün esnekliğidir.</p>
          </div>
          <div class="info-panel taboo">
            <h4>🛑 Kritik Tabular</h4>
            <p>Yemek yerken veya bir şey uzatırken "Sol El" kullanmak (Sol el temizlik için kabul edilir). Otururken ayakkabı tabanını karşıya göstermek.</p>
          </div>
        </div>
      </div>

      <!-- Almanya -->
      <div class="c-info-box" id="c-de">
        <div class="c-info-title">🇩🇪 Alman İş Kültürü</div>
        <div class="c-info-grid">
          <div class="info-panel">
            <h4>🤝 Selamlaşma & İlk İntiba</h4>
            <p><strong>Formellik:</strong> Güçlü ve kısa bir tokalaşma. İsimden ziyade "Herr/Frau + Soyadı" kullanılır. Akademik ünvanlar (Dr. Herr Schmidt) çok önemlidir.</p>
          </div>
          <div class="info-panel">
            <h4>🗣️ İletişim Tarzı</h4>
            <p><strong>Direktlik ve Veri:</strong> Small talk (havadan sudan konuşma) sevilmez. Toplantıda direkt konuya, rakamlara ve verilere girilir. Verilen sözler mutlaka yazılı olmalıdır.</p>
          </div>
          <div class="info-panel taboo">
            <h4>🛑 Kritik Tabular</h4>
            <p>Toplantıya 5 dakika bile geç kalmak. Hazırlıksız/verisiz sunum yapmak. Aşırı samimi veya laubali şakalar yapmak.</p>
          </div>
        </div>
      </div>

      <!-- Brezilya -->
      <div class="c-info-box" id="c-br">
        <div class="c-info-title">🇧🇷 Brezilya İş Kültürü</div>
        <div class="c-info-grid">
          <div class="info-panel">
            <h4>🤝 Selamlaşma & İlk İntiba</h4>
            <p><strong>Samimiyet:</strong> Tokalaşmalar uzun sürer, erkekler omuzlara dokunabilir, kadınlar yanak yanağa öpüşür (bölgeye göre 1-3 kez). Yakın fiziksel mesafe normaldir.</p>
          </div>
          <div class="info-panel">
            <h4>🗣️ İletişim Tarzı</h4>
            <p><strong>Jeitinho:</strong> Kuralların esnemesi ve sorunları kişisel ilişkilerle çözme sanatı. Toplantılar hareketli, sesli ve bol müdahaleli geçer.</p>
          </div>
          <div class="info-panel taboo">
            <h4>🛑 Kritik Tabular</h4>
            <p>Arjantin ile kıyaslama yapmak. Toplantıya girer girmez soğuk bir şekilde işle ilgili konuşmaya başlamak.</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 🌍 FAUX PAS FINDER 🌍 -->
  <div class="p-card reveal" style="background:#1e1b4b; border:none;">
    <div class="section-label" style="color:#818cf8;">🕵️ Kültürel Gaf Dedektifi</div>
    <p style="color:#c7d2fe; font-size:1.05rem; line-height:1.6; margin-bottom:25px;">
      Aşağıdaki senaryoyu okuyun ve yöneticinin yaptığı uluslararası iletişim hatasını (faux pas) tespit edin.
    </p>

    <div class="faux-box">
      <div class="faux-scenario" id="fScen">
        "Amerikalı yönetici John, Tokyo'daki ilk büyük toplantısında çok enerjikti. Odaya girdiğinde en kıdemli yönetici Watanabe Bey'e ismiyle (Hey Watanabe!) hitap etti, ardından verilen kartviziti tek eliyle alıp hiç bakmadan arka cebine koydu ve hemen projeksiyona geçerek rakamları anlatmaya başladı."
      </div>
      
      <div class="opt-grid" id="fOpts">
        <button class="faux-btn" onclick="checkFaux(this, false)">A) Sunuma hemen geçmesi Japonları sıkmıştır.</button>
        <button class="faux-btn" onclick="checkFaux(this, true)">B) Kartviziti (Meishi) saygısızca alıp cebe atması ve hiyerarşik hitabı bozması büyük bir hatadır.</button>
        <button class="faux-btn" onclick="checkFaux(this, false)">C) Sadece Watanabe Bey ile konuşması diğer yöneticileri kızdırmıştır.</button>
      </div>

      <div class="faux-feedback" id="fBack"></div>
      <button class="next-btn" id="fNext" onclick="nextFaux()">Sonraki Vaka →</button>
    </div>
  </div>

</div>

<script>
// 🌍 Scroll Reveal
const obs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

// 🌍 Map Logic
function showCountry(id, btn) {
  document.querySelectorAll('.c-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  
  document.querySelectorAll('.c-info-box').forEach(b => b.classList.remove('active'));
  document.getElementById('c-' + id).classList.add('active');
}

// 🌍 Faux Pas Logic
const fauxCases = [
  {
    s: '"Amerikalı yönetici John, Tokyo\'daki ilk büyük toplantısında çok enerjikti. Odaya girdiğinde en kıdemli yönetici Watanabe Bey\'e ismiyle (Hey Watanabe!) hitap etti, ardından verilen kartviziti tek eliyle alıp hiç bakmadan arka cebine koydu ve hemen projeksiyona geçerek rakamları anlatmaya başladı."',
    o: [
      { t: 'A) Sunuma hemen geçmesi Japonları sıkmıştır.', v: false },
      { t: 'B) Kartviziti (Meishi) saygısızca alıp cebe atması ve hiyerarşik hitabı bozması büyük bir hatadır.', v: true },
      { t: 'C) Sadece Watanabe Bey ile konuşması diğer yöneticileri kızdırmıştır.', v: false }
    ],
    e: 'Doğru! Japonya\'da kartvizit kişiyi temsil eder, iki elle alınır ve toplantı boyunca masada saygıyla durur. Ayrıca isimden önce soyadı+san (Watanabe-san) kullanılmalıdır.'
  },
  {
    s: '"Alman heyetiyle yapılan toplantıda Türk yönetici ortamı yumuşatmak için 15 dakika boyunca İstanbul trafiğinden, futbol maçlarından ve yemeklerden bahsetti. Alman heyeti sürekli saatine bakıyordu."',
    o: [
      { t: 'A) Futbol konuşulması Almanları kızdırmıştır.', v: false },
      { t: 'B) Alman iş kültüründe "Small Talk" (havadan sudan konuşma) çok sevilmez, direkt konuya ve rakamlara girilmesi beklenir.', v: true },
      { t: 'C) Çay ikram edilmediği için zamanı yanlış kullanmıştır.', v: false }
    ],
    e: 'Doğru! Alman iş kültürü oldukça direkt (task-oriented) ve verimlilik odaklıdır. Zaman nakittir ve toplantıya anında başlanması gerekir.'
  },
  {
    s: '"Şanghay\'daki iş ortaklarına hediye olarak, markanın logosunun basılı olduğu şık ve pahalı masa saatleri dağıtıldı. Ancak Çinli yöneticilerin yüzü aniden düştü."',
    o: [
      { t: 'A) Hediyelerin üzerinde marka logosu olması saygısızlıktır.', v: false },
      { t: 'B) Pahalı hediye rüşvet olarak algılanmıştır.', v: false },
      { t: 'C) Çin kültüründe saat hediye etmek kelime oyunu olarak "ölüm/cenaze" anlamına gelir.', v: true }
    ],
    e: 'Doğru! Çince\'de "saat hediye etmek" (sòng zhōng) kelimesi "cenazeye katılmak" kelimesiyle aynı şekilde telaffuz edilir. Çok büyük bir tabudur.'
  }
];

let currFaux = 0;

function loadFaux() {
  const c = fauxCases[currFaux];
  document.getElementById('fScen').innerText = c.s;
  
  const cont = document.getElementById('fOpts');
  cont.innerHTML = '';
  c.o.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'faux-btn';
    btn.innerText = opt.t;
    btn.onclick = function() { checkFaux(this, opt.v, c.e); };
    cont.appendChild(btn);
  });
  
  document.getElementById('fBack').classList.remove('show');
  document.getElementById('fNext').style.display = 'none';
}

function checkFaux(btn, isCorrect, explanation) {
  const btns = document.getElementById('fOpts').querySelectorAll('.faux-btn');
  btns.forEach(b => b.style.pointerEvents = 'none');
  
  const fb = document.getElementById('fBack');
  if(isCorrect) {
    btn.classList.add('correct');
    fb.innerHTML = `✅ ${explanation}`;
  } else {
    btn.classList.add('wrong');
    fb.innerHTML = `❌ Yanlış Analiz. Kültürel kodları tekrar gözden geçirin.`;
  }
  fb.classList.add('show');
  
  if(currFaux < fauxCases.length - 1) {
    document.getElementById('fNext').style.display = 'inline-block';
  } else {
    document.getElementById('fNext').style.display = 'inline-block';
    document.getElementById('fNext').innerText = "Tüm Vakaları Çözdünüz 🌍";
    document.getElementById('fNext').onclick = null;
  }
}

function nextFaux() {
  currFaux++;
  loadFaux();
}

// init
loadFaux();
</script>

<%- include('partials/main-footer') %>
