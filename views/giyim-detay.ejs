<%- include('partials/main-header') %>
<link rel="stylesheet" href="/retorik.css?v=8" />

<style>
  .giyim-page { display: block !important; }
  .ret-cat-pill { text-decoration: none; }
  .ret-cat-pill.active { background: #0f172a; border-color: #0f172a; color: #fff; }
</style>

<main class="main-content">
  <div class="content-wrapper">
    <div id="giyim-container" class="giyim-page">

      <!-- ══ KATEGORİLER ══ -->
      <div style="margin-top:20px;margin-bottom:30px;text-align:center;">
        <div class="ret-cat-pills">
          <a href="/giyim" class="ret-cat-pill">Tumu</a>
          <a href="/giyim/dresscode" class="ret-cat-pill <%= activeCat === 'dresscode' ? 'active' : '' %>">Dress Code</a>
          <a href="/giyim/renk" class="ret-cat-pill <%= activeCat === 'renk' ? 'active' : '' %>">Renk Psikolojisi</a>
          <a href="/giyim/vucut-tipi" class="ret-cat-pill <%= activeCat === 'vucut-tipi' ? 'active' : '' %>">Vucut Tipine Gore</a>
          <a href="/giyim/aksesuar" class="ret-cat-pill <%= activeCat === 'aksesuar' ? 'active' : '' %>">Aksesuar Sanati</a>
          <a href="/giyim/stil" class="ret-cat-pill <%= activeCat === 'stil' ? 'active' : '' %>">Stil Testi</a>
        </div>
      </div>

      <!-- ══ SAYFA BAŞLIĞI ══ -->
      <section style="background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:35px 30px;margin-bottom:30px">
        <div style="display:flex;align-items:center;gap:18px;margin-bottom:10px">
          <div style="width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:900;background:#f8fafc;border:1px solid #e2e8f0;color:#0f172a;flex-shrink:0"><%= activeCat.substring(0,2).toUpperCase() %></div>
          <div>
            <h1 style="font-size:1.6rem;font-weight:800;color:#0f172a;margin:0"><%= meta.h1 %></h1>
            <p style="font-size:0.9rem;color:#64748b;margin-top:4px"><%= exercises.length %> detayli egitim ve analiz</p>
          </div>
        </div>
      </section>

      <!-- ══ EGZERSİZLER ══ -->
      <% exercises.forEach((ex, index) => { %>
        <section style="background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:30px;margin-bottom:24px;overflow:hidden">

          <!-- Ders Başlığı -->
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:14px">
              <div style="width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:0.95rem;font-weight:800;background:#f8fafc;color:#0f172a;border:1px solid #e2e8f0"><%= ex.num %></div>
              <h2 style="font-size:1.25rem;font-weight:800;color:#0f172a;margin:0"><%= ex.title %></h2>
            </div>
            <span style="font-size:0.75rem;padding:5px 14px;border-radius:20px;font-weight:700;background:#f8fafc;color:#475569;border:1px solid #e2e8f0"><%= ex.badge %></span>
          </div>

          <!-- Görsel -->
          <% if (ex.image) { %>
            <div style="margin-bottom:24px;border-radius:16px;overflow:hidden;border:1px solid #e2e8f0;background:#f8fafc;display:flex;justify-content:center">
              <img src="<%= ex.image %>" alt="<%= ex.title %>" style="max-width:100%;height:auto;max-height:400px;object-fit:cover;display:block" />
            </div>
          <% } %>

          <!-- Açıklama -->
          <p style="color:#475569;font-size:0.95rem;line-height:1.75;margin-bottom:24px;padding:18px 22px;background:#f8fafc;border-radius:14px;border-left:3px solid #0f172a"><%= ex.desc %></p>

          <!-- Adımlar -->
          <div style="margin-bottom:24px">
            <div style="font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;margin-bottom:12px">Stil Adimlari</div>
            <div style="display:flex;flex-direction:column;gap:10px">
              <% ex.steps.forEach((step, i) => { %>
                <div style="display:flex;gap:14px;align-items:flex-start;padding:14px 18px;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0">
                  <div style="width:28px;height:28px;min-width:28px;border-radius:50%;background:#0f172a;color:#fff;font-size:0.72rem;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0"><%= i + 1 %></div>
                  <div style="font-size:0.9rem;color:#334155;line-height:1.6"><%= step %></div>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- Test -->
          <% if (ex.quiz) { %>
          <div style="background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:16px;padding:24px;margin-bottom:24px">
            <div style="font-size:1rem;font-weight:800;color:#0f172a;margin-bottom:16px;padding-left:16px;border-left:4px solid #0f172a;line-height:1.5"><%= ex.quiz.q %></div>
            <div style="display:flex;flex-direction:column;gap:10px">
              <% ex.quiz.opts.forEach((opt, i) => { %>
                <div class="ret-quiz-option" onclick="handleQuiz(this, <%= ex.quiz.correct %>, <%= i %>)" style="padding:14px 18px;background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;color:#475569;cursor:pointer;font-size:0.92rem;display:flex;align-items:center;gap:14px;transition:all .2s">
                  <span style="width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.85rem;font-weight:800;background:#f8fafc;color:#64748b;flex-shrink:0;border:1px solid #e2e8f0"><%= String.fromCharCode(65 + i) %></span> <%= opt %>
                </div>
              <% }); %>
            </div>
            <div class="quiz-feedback" style="margin-top:14px;padding:14px 18px;border-radius:12px;font-size:0.9rem;line-height:1.6;display:none"></div>
          </div>
          <% } %>

          <!-- Senaryo -->
          <% if (ex.scenario) { %>
          <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:22px;margin-bottom:22px;position:relative">
            <div style="position:absolute;top:-11px;left:20px;background:#0f172a;color:#fff;font-size:0.7rem;font-weight:700;padding:4px 14px;border-radius:20px;text-transform:uppercase;letter-spacing:0.5px"><%= ex.scenario.label %></div>
            <div style="color:#334155;font-size:0.92rem;line-height:1.7;margin-top:8px;font-style:italic"><%= ex.scenario.text %></div>
            <div style="margin-top:16px;padding-top:16px;border-top:1px solid #e2e8f0">
              <h5 style="color:#0f172a;font-size:0.82rem;margin:0 0 8px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px">Analiz</h5>
              <p style="color:#475569;font-size:0.88rem;line-height:1.6;margin:0"><%= ex.scenario.analysis %></p>
            </div>
          </div>
          <% } %>

          <!-- Uygulama -->
          <% if (ex.practice) { %>
          <div style="margin-bottom:16px">
            <div style="font-size:0.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;margin-bottom:8px">Uygulama</div>
            <textarea style="width:100%;min-height:80px;background:#fff;border:1.5px solid #e2e8f0;border-radius:12px;padding:16px;color:#0f172a;font-size:0.9rem;line-height:1.6;resize:vertical;font-family:inherit" placeholder="<%= ex.practice %>"></textarea>
          </div>
          <% } %>

          <!-- Tamamla -->
          <button onclick="this.innerHTML='Tamamlandi';this.style.background='#0f172a';this.style.color='#fff';this.style.borderColor='#0f172a'" style="padding:12px 28px;border-radius:12px;border:2px solid #0f172a;background:transparent;color:#0f172a;font-weight:800;font-size:0.9rem;cursor:pointer;transition:all .2s">Tamamla</button>

        </section>
      <% }); %>

    </div>
  </div>
</main>

<%- include('partials/main-footer') %>

<script>
  function handleQuiz(el, correctIdx, currentIdx) {
    const parent = el.parentElement;
    const feedback = parent.parentElement.querySelector('.quiz-feedback');

    parent.querySelectorAll('.ret-quiz-option').forEach(o => {
      o.style.background = '#fff';
      o.style.color = '#475569';
      o.style.borderColor = '#e2e8f0';
    });

    if (currentIdx === correctIdx) {
      el.style.background = '#ecfdf5';
      el.style.borderColor = '#10b981';
      el.style.color = '#065f46';
      feedback.textContent = 'Dogru cevap!';
      feedback.style.background = '#ecfdf5';
      feedback.style.color = '#065f46';
    } else {
      el.style.background = '#fef2f2';
      el.style.borderColor = '#ef4444';
      el.style.color = '#991b1b';
      feedback.textContent = 'Yanlis, tekrar deneyin.';
      feedback.style.background = '#fef2f2';
      feedback.style.color = '#991b1b';
    }
    feedback.style.display = 'block';
  }
</script>