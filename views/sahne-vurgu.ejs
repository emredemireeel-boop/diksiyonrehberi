<%- include('partials/main-header') %>

<style>
  body { background: #f8fafc; color: #0f172a; margin: 0; min-height: 100vh; display: flex; flex-direction: column;  }
  .main-header, .main-footer { display: none !important; }

  .v-container { flex-grow: 1; padding: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
  
  .instruction-panel { background: #ffffff; border: 1px solid #e2e8f0; padding: 20px 40px; border-radius: 20px; text-align: center; margin-bottom: 60px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
  .instruction-title { font-size: 1.5rem; font-weight: 900; margin: 0 0 10px; color: #0284c7; text-transform: uppercase; letter-spacing: 1px; }
  .instruction-desc { font-size: 1.05rem; color: #475569; margin: 0; max-width: 600px; line-height: 1.6; }

  .sentence-box { font-size: 4rem; font-weight: 900; text-align: center; letter-spacing: -1px; margin-bottom: 40px; color: #94a3b8; transition: all 0.3s; }
  .sentence-box span { display: inline-block; margin: 0 10px; transition: all 0.2s; }
  
  .sentence-box span.active { color: #ef4444; transform: scale(1.15); text-shadow: 0 10px 20px rgba(239, 68, 68, 0.2); border-bottom: 4px solid #ef4444; }

  .subtext-box { background: rgba(239, 68, 68, 0.05); border-left: 4px solid #ef4444; padding: 20px 30px; border-radius: 0 16px 16px 0; min-height: 80px; display: flex; align-items: center; font-size: 1.2rem; font-weight: 700; color: #b91c1c; font-style: italic; opacity: 0; transition: opacity 0.3s; max-width: 600px; text-align: center; justify-content: center; margin-bottom: 60px; }
  .subtext-box.show { opacity: 1; }

  .controls { display: flex; gap: 20px; }
  .btn-control {
    background: #0f172a; color: #ffffff; border: none; padding: 16px 40px; border-radius: 30px;
    font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 10px 20px rgba(15,23,42,0.15);
  }
  .btn-control:hover { background: #1e293b; transform: translateY(-2px); }
  
  .btn-back { position: absolute; top: 30px; left: 30px; color: #64748b; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: color 0.2s; z-index: 10; }
  .btn-back:hover { color: #0f172a; }

</style>

<a href="/sahne" class="btn-back">← Sahne'ye Dön</a>

<div class="v-container">
  
  <div class="instruction-panel">
    <h1 class="instruction-title">Vurgu ve Tonlama Matrisi</h1>
    <p class="instruction-desc">Aşağıdaki cümleyi yüksek sesle okuyun. Kırmızı ile işaretlenmiş kelimeye <strong>abartılı bir vurgu</strong> yapın. Alt metnin nasıl tamamen değiştiğine şahit olun.</p>
  </div>

  <div class="sentence-box" id="sentence">
    <span id="w0">BEN</span>
    <span id="w1">onun</span>
    <span id="w2">parasını</span>
    <span id="w3">çalmadım.</span>
  </div>

  <div class="subtext-box" id="subtext">
    Alt Metin: (Başka biri çaldı, ben değil!)
  </div>

  <div class="controls">
    <button class="btn-control" onclick="nextWord()">Sonraki Vurgu ➔</button>
  </div>

</div>

<script>
  const data = [
    { idx: 0, meaning: 'Alt Metin: "Ben yapmadım, o eylemi başkası yaptı!"' },
    { idx: 1, meaning: 'Alt Metin: "Başka birinin parasını çaldım ama ONUN parasını çalmadım!"' },
    { idx: 2, meaning: 'Alt Metin: "Onun eşyasını, arabasını veya fikrini çalmış olabilirim ama PARASINI çalmadım!"' },
    { idx: 3, meaning: 'Alt Metin: "Kesinlikle hırsızlık yapmadım! (Sadece ödünç aldım veya hiç dokunmadım.)"' }
  ];

  let currentIndex = 0;

  function renderState() {
    // reset all
    for(let i=0; i<4; i++) {
      document.getElementById('w'+i).classList.remove('active');
    }
    
    // activate current
    const current = data[currentIndex];
    document.getElementById('w' + current.idx).classList.add('active');
    
    // update text
    const box = document.getElementById('subtext');
    box.classList.remove('show');
    
    setTimeout(() => {
      box.textContent = current.meaning;
      box.classList.add('show');
    }, 150);
  }

  function nextWord() {
    currentIndex = (currentIndex + 1) % data.length;
    renderState();
  }

  // Init
  setTimeout(() => {
    renderState();
  }, 500);
</script>
